            <!-- Ph.3 -->
            <MudItem xs="12" lg="4">
                <MudPaper Elevation="0" Class="surface-card is-interactive col-span-12 lg:col-span-6 p-3 lg:p-4 animate-rise-in infect-card" Style="animation-delay: 0s; height: 258px;">
                    <div class="d-flex align-center justify-space-between gap-3 mb-3">
