@code {
    private string[] _labels = ["Mon", "Tue", "Wed", "Thur", "Fri", "Sat", "Sun"];

    List<DoctorDto> allDoctors = new();
    List<StaffDto> allStaffs = new();
    List<VisitDto> allVisits = new();
    List<PatientDto> allPatients = new();
    List<LabTestDto> allLabTests = new();
    List<MedicineDto> allMedicines = new();
    List<BedDto> allBeds = new();
    List<WardDto> allWards = new();

    List<ChartSeries<double>> _weeklyPatients = new();
    List<ChartSeries<double>> _weeklyPatientsByType = new();
    List<ChartSeries<double>> _weeklyPatientsByAge = new();
    List<ChartSeries<double>> _weeklyAvailableDoctors = new();
    List<ChartSeries<double>> _weeklyDoctorsBySpecialization = new();

    private LineChartOptions _options = new();

    StaffDto StaffOfTheWeek = new();
    DateTime sevenDaysAgo = DateTime.Now.AddDays(-7);

    int NurCount = 0;
    int DocCount = 0;
    int UnavailableStaffCount = 0;

    int admittedPatientsCount = 0;
    int triagedPatientsCount = 0;
    int inTreatmentPatientsCount = 0;
    int dischargedPatientsCount = 0;

    double AvailableBedsPercentage = 0;
    double AvailableERBedsPercentage = 0;
    double AvailableICUBedsPercentage = 0;

    double DoctorAvailabilityPct = 0;
    double StaffReadinessPct = 0;
    int OverallVitalsScore = 94;
    private bool _isFlowExpanded = true;

    Color OverallScoreColor => OverallVitalsScore >= 85 ? Color.Success : (OverallVitalsScore >= 70 ? Color.Warning : Color.Error);
    string OverallStatusText => OverallVitalsScore >= 85 ? "Operating Normally" : (OverallVitalsScore >= 70 ? "Elevated Load" : "Critical Attention");

    string middleName => string.IsNullOrWhiteSpace(StaffOfTheWeek.MiddleName)
        ? ""
        : $"{StaffOfTheWeek.MiddleName.Trim().ToUpper().Substring(0, 1)}.";

    protected override async Task OnInitializedAsync()
    {
        allStaffs = await staffService.GetAllStaffsAsync() ?? new();
        allPatients = await patientService.GetAllPatientsAsync() ?? new();
        allLabTests = await labTestService.GetAllLabTestsAsync() ?? new();
        allMedicines = await medicineService.GetAllMedicinesAsync() ?? new();
        allDoctors = await doctorService.GetAllDoctorsAsync() ?? new();
        allBeds = await roomService.GetAllBedsAsync() ?? new();
        allWards = await roomService.GetAllWardsAsync() ?? new();
        allVisits = await patientService.GetAllVisitsAsync() ?? new();

        StaffOfTheWeek = allStaffs.FirstOrDefault(x => x.IsStaffOfTTheWeek) ?? new();

        PatientFlowMonitorData();
        BedsAvailability();
        CalculateLiveVitals();
        WeeklyPatients();
        WeeklyPatientsByType();
        WeeklyPatientsByAge();
        WeeklyDoctorsBySpecialization();
        WeeklyDoctorsAvailability();

        StateHasChanged();
    }

    private void PatientFlowMonitorData()
    {
        //Admitted Patients
        admittedPatientsCount = allVisits.Where(v => v.VisitStatusName.ToLower().Trim() != "cancelled" && v.VisitDate.ToShortDateString() == DateTime.Now.ToShortDateString()).Count();

        //Triaged Patients
        triagedPatientsCount = allVisits.Where(v => v.VisitStatusName.ToLower().Trim() != "cancelled" && v.VisitDate.ToShortDateString() == DateTime.Now.ToShortDateString() && v.Patient?.PatientTypeName.ToLower().Trim() != "emergency").Count();
        
        //In Treatment Patients
        inTreatmentPatientsCount = allVisits.Where(v => v.VisitStatusName.ToLower().Trim() != "cancelled" && v.VisitDate.ToShortDateString() == DateTime.Now.ToShortDateString() && v.Treatments.Any()).Count();

        //Discharged Patients
        dischargedPatientsCount = allVisits.Where(v => v.VisitStatusName.ToLower().Trim() == "completed" && v.DischargedDate?.ToShortDateString() == DateTime.Now.ToShortDateString()).Count();
    }

    private void BedsAvailability()
    {
        //All Beds
        var unsuedBedsCount = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused").Count();
        var totalBeds = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused").Count();
        if (totalBeds > 0)
            AvailableBedsPercentage = Math.Round(((double)unsuedBedsCount / totalBeds) * 100);
        
        //All ER Beds
        var unsuedERBedsCount = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused" && b.WardName.ToLower().Trim() == "general ward").Count();
        var totalERBeds = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused" && b.WardName.ToLower().Trim() == "general ward").Count();
        if (totalERBeds > 0)
            AvailableERBedsPercentage = Math.Round(((double)unsuedERBedsCount / totalERBeds) * 100);

        //All ICU Beds
        var unsuedICUBedsCount = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused" && b.WardName.ToLower().Trim() == "medical icu").Count();
        var totalICUBeds = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused" && b.WardName.ToLower().Trim() == "medical icu").Count();
        if (totalICUBeds > 0)
            AvailableICUBedsPercentage = Math.Round(((double)unsuedICUBedsCount / totalICUBeds) * 100);
    }

    private void CalculateLiveVitals()
    {
        var activeStaff = allStaffs.Where(x => string.Equals(x.StaffStatusName, "available", StringComparison.OrdinalIgnoreCase)).ToList();
        UnavailableStaffCount = allStaffs.Count - activeStaff.Count;

        NurCount = activeStaff.Count(x => string.Equals(x.ClinicalTitleName, "nurse", StringComparison.OrdinalIgnoreCase));
        DocCount = activeStaff.Count(x =>
            string.Equals(x.ClinicalTitleName, "doctor", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.ClinicalTitleName, "md", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.ClinicalTitleName, "specialist", StringComparison.OrdinalIgnoreCase));

        int totalDoctors = allStaffs.Count(x =>
            string.Equals(x.ClinicalTitleGroupName.Trim().ToLower(), "doctors", StringComparison.OrdinalIgnoreCase));

        DoctorAvailabilityPct = totalDoctors > 0 ? Math.Round((double)DocCount / totalDoctors * 100, 1) : 100;
        StaffReadinessPct = allStaffs.Count > 0 ? Math.Round((double)activeStaff.Count / allStaffs.Count * 100, 1) : 100;

        // Weighted score blending live staff readiness with clinical operational baselines
        double rawScore = (DoctorAvailabilityPct * 0.25) + (StaffReadinessPct * 0.25) + (95.0 * 0.50);
        OverallVitalsScore = (int)Math.Round(rawScore);
    }

    private void WeeklyPatients()
    {
        var weeklyPatients = allPatients.Where(x => x.RegisteredDate >= sevenDaysAgo && x.RegisteredDate <= DateTime.Now).ToList();
        var countByDay = weeklyPatients.GroupBy(x => x.RegisteredDate.DayOfWeek)
            .ToDictionary(g => g.Key == DayOfWeek.Sunday ? 6 : (int)g.Key - 1, g => (double)g.Count());

        _weeklyPatients = new List<ChartSeries<double>>();
        for (int i = 0; i < 7; i++)
        {
            double count = countByDay.ContainsKey(i) ? countByDay[i] : 0.0;
            _weeklyPatients.Add(new ChartSeries<double> { Name = _labels[i], Data = new double[] { count } });
        }
    }

    private void WeeklyPatientsByType()
    {
        var weeklyPatients = allPatients.Where(x => x.RegisteredDate >= sevenDaysAgo && x.RegisteredDate <= DateTime.Now).ToList();
        var groupedByType = weeklyPatients.GroupBy(x => x.PatientTypeName ?? "General");

        _weeklyPatientsByType = new List<ChartSeries<double>>();
        foreach (var typeGroup in groupedByType)
        {
            var countByDay = typeGroup.GroupBy(x => x.RegisteredDate.DayOfWeek)
                .ToDictionary(g => g.Key == DayOfWeek.Sunday ? 6 : (int)g.Key - 1, g => (double)g.Count());

            double[] weeklyData = Enumerable.Range(0, 7).Select(i => countByDay.ContainsKey(i) ? countByDay[i] : 0.0).ToArray();
            _weeklyPatientsByType.Add(new ChartSeries<double> { Name = typeGroup.Key, Data = weeklyData });
        }
    }


    private void WeeklyPatientsByAge()
    {
        var weeklyPatients = allPatients.Where(x => x.RegisteredDate >= sevenDaysAgo && x.RegisteredDate <= DateTime.Now).ToList();
        DayOfWeek[] daysOrder = { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };

        double[] data0To14 = new double[7];
        double[] data15To45 = new double[7];
        double[] dataAbove45 = new double[7];

        for (int i = 0; i < daysOrder.Length; i++)
        {
            var patientsOnDay = weeklyPatients.Where(x => x.RegisteredDate.DayOfWeek == daysOrder[i]).ToList();
            data0To14[i] = patientsOnDay.Count(x => x.Age >= 0 && x.Age <= 14);
            data15To45[i] = patientsOnDay.Count(x => x.Age >= 15 && x.Age <= 45);
            dataAbove45[i] = patientsOnDay.Count(x => x.Age > 45);
        }

        _weeklyPatientsByAge = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "0-14", Data = data0To14 },
            new ChartSeries<double> { Name = "15-45", Data = data15To45 },
            new ChartSeries<double> { Name = "Above 45", Data = dataAbove45 }
        };

        _options.SeriesDisplayOverrides = new Dictionary<IChartSeries, SeriesDisplayOverride>()
        {
            { _weeklyPatientsByAge[0], new SeriesDisplayOverride { LineDisplayType = LineDisplayType.Area } },
            { _weeklyPatientsByAge[1], new SeriesDisplayOverride { LineDisplayType = LineDisplayType.Area } },
            { _weeklyPatientsByAge[2], new SeriesDisplayOverride { LineDisplayType = LineDisplayType.Area } }
        };
    }



