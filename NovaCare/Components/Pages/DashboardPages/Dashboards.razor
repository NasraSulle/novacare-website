    private void WeeklyDoctorsBySpecialization()
    {
        var availableDoctors = allStaffs.Where(x =>
            string.Equals(x.StaffStatusName, "available", StringComparison.OrdinalIgnoreCase) &&
            (string.Equals(x.ClinicalTitleName, "doctor", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(x.ClinicalTitleName, "md", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(x.ClinicalTitleName, "specialist", StringComparison.OrdinalIgnoreCase))).ToList();

        double countMd = availableDoctors.Count(x => string.Equals(x.ClinicalTitleName, "md", StringComparison.OrdinalIgnoreCase));
        double countSpecialist = availableDoctors.Count(x => !string.Equals(x.ClinicalTitleName, "md", StringComparison.OrdinalIgnoreCase));

        _weeklyDoctorsBySpecialization = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "MD", Data = new double[] { countMd, 0 } },
            new ChartSeries<double> { Name = "Specialists", Data = new double[] { 0, countSpecialist } }
        };
    }

    private void WeeklyDoctorsAvailability()
    {
        var weeklyDoctors = allStaffs.Where(x =>
            string.Equals(x.StaffStatusName, "available", StringComparison.OrdinalIgnoreCase) &&
            (string.Equals(x.ClinicalTitleName, "doctor", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(x.ClinicalTitleName, "md", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(x.ClinicalTitleName, "specialist", StringComparison.OrdinalIgnoreCase)) &&
            x.RegisteredDate >= sevenDaysAgo && x.RegisteredDate <= DateTime.Now).ToList();

        var groupedByType = weeklyDoctors.GroupBy(x => x.StaffStatusName ?? "Available");

        _weeklyAvailableDoctors = new List<ChartSeries<double>>();
        foreach (var typeGroup in groupedByType)
        {
            var countByDay = typeGroup.GroupBy(x => x.RegisteredDate.DayOfWeek)
                .ToDictionary(g => g.Key == DayOfWeek.Sunday ? 6 : (int)g.Key - 1, g => (double)g.Count());

            double[] weeklyData = Enumerable.Range(0, 7).Select(i => countByDay.ContainsKey(i) ? countByDay[i] : 0.0).ToArray();
            _weeklyAvailableDoctors.Add(new ChartSeries<double> { Name = typeGroup.Key, Data = weeklyData });
        }
    }
}
