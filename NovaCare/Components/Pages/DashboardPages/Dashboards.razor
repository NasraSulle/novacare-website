@using NovaCare.Shared.DTOs.RoomDTOs
@using MudBlazor.Charts

@rendermode InteractiveServer

<MudGrid Class="dashboard-container pa-6" Spacing="4" id="another_unique_identifier">
    <!-- Command Console Header -->
    <MudItem xs="12">
        <div class="d-flex align-center gap-2 mb-1">
            <span class="relative-dot-container">
                <span class="dot-ping"></span>
                <span class="dot-solid"></span>
            </span>

            <MudText Typo="Typo.caption"
                     Style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;"
                     Color="Color.Error">
                Smart Healthcare Operations Center
            </MudText>
        </div>

        <div class="d-flex flex-wrap align-center justify-space-between gap-2">
            <MudText Typo="Typo.h5"
                     Style="font-weight: 800; font-family: var(--mud-theme-font-family-display, inherit);">
                NovaCare Medical Center
            </MudText>
            <MudText Typo="Typo.caption" Class="text-muted">
                Last Synced: @DateTime.Now.ToString("MMM dd, yyyy HH:mm")
            </MudText>
        </div>
    </MudItem>

    <!-- Animated Vitals Bridge -->
    <MudItem xs="12">
        <MudItem xs="12" Class="vitals-bridge animate-rise-in">
            <!-- Moving Ambient ECG Trace -->
            <MudItem xs="12">
                <svg class="vitals-bridge__ecg" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
                    <path class="vitals-bridge__ecg-track" d="M0,30 L140,30 L160,10 L180,50 L200,30 L230,30 L250,4 L262,56 L274,30 L320,30 L340,30 L360,16 L380,44 L400,30 L740,30 L760,10 L780,50 L800,30 L830,30 L850,4 L862,56 L874,30 L920,30 L940,30 L960,16 L980,44 L1000,30 L1200,30" />
                    <path class="vitals-bridge__ecg-pulse" d="M0,30 L140,30 L160,10 L180,50 L200,30 L230,30 L250,4 L262,56 L274,30 L320,30 L340,30 L360,16 L380,44 L400,30 L740,30 L760,10 L780,50 L800,30 L830,30 L850,4 L862,56 L874,30 L920,30 L940,30 L960,16 L980,44 L1000,30 L1200,30" />
                </svg>
            </MudItem>
            <MudGrid Spacing="1" Class="pa-3" Style="position: relative; z-index: 2;">
                <!-- Live Status & Dynamic Score Readout -->
                <MudItem xs="12" md="2">
                    <MudPaper Elevation="0" Class="d-flex flex-column justify-space-between h-100 pa-3 bg-transparent">
                        <div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <span class="vitals-bridge__dot"></span>
                                <MudText Typo="Typo.caption" Class="vitals-bridge__eyebrow" Style="letter-spacing: 0.05em;">
                                    Live Hospital Vitals
                                </MudText>
                            </div>
                            <div class="d-flex align-baseline vitals-bridge__score-row">
                                <MudText Typo="Typo.h2" Class="vitals-bridge__score-num">@OverallVitalsScore</MudText>
                                <MudText Typo="Typo.h5" Class="vitals-bridge__score-unit">/100</MudText>
                            </div>
                            <MudText Typo="Typo.subtitle1" Class="vitals-bridge__score-label">
                                @OverallStatusText
                            </MudText>
                        </div>
                        <div class="d-flex align-center gap-1 mt-4 vitals-bridge__score-foot">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Small" Color="Color.Success" />
                            <MudText Typo="Typo.body2">@allPatients.Count total registered patients</MudText>
                        </div>
                    </MudPaper>
                </MudItem>

                <!-- Vital Sign Tiles (Bound to Real Data + Operational Metrics) -->
                <MudItem xs="12" md="7">
                    <MudGrid Spacing="2">
                        <!-- Doctor Availability (Calculated from real allStaffs data) -->
                        <MudItem xs="12" sm="6">
                            <MudPaper Outlined="true" Class="@($"pa-3 relative-tile {(DoctorAvailabilityPct < 60 ? "vital-tile--alert" : "")}")">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <span class="d-flex align-center gap-2 text-white text-sm">
                                        <MudIcon Icon="@Icons.Material.Outlined.MedicalServices" Size="Size.Small" /> Doctor Availability
                                    </span>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@DoctorAvailabilityPct%</MudText>
                                </div>
                                <MudProgressLinear Value="@DoctorAvailabilityPct" Color="@(DoctorAvailabilityPct < 60 ? Color.Error : Color.Info)" Size="Size.Small" Rounded="true" />
                            </MudPaper>
                        </MudItem>

                        <!-- Overall Staff Readiness (Calculated from real allStaffs data) -->
                        <MudItem xs="12" sm="6">
                            <MudPaper Outlined="true" Class="pa-3 relative-tile">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <span class="d-flex align-center gap-2  text-white text-sm">
                                        <MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" /> Staff Readiness
                                    </span>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@StaffReadinessPct%</MudText>
                                </div>
                                <MudProgressLinear Value="@StaffReadinessPct" Color="Color.Success" Size="Size.Small" Rounded="true" />
                            </MudPaper>
                        </MudItem>

                        <!-- ICU Capacity -->
                        <MudItem xs="12" sm="6">
                            <MudPaper Outlined="true" Class="pa-3 relative-tile vital-tile--alert">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <span class="d-flex align-center gap-2 text-white text-sm">
                                        <MudIcon Class="text-white" Icon="@Icons.Material.Outlined.LocalActivity" Size="Size.Small" /> ICU Capacity
                                    </span>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold text-white">@AvailableICUBedsPercentage%</MudText>
                                </div>
                                <MudProgressLinear Value="@AvailableICUBedsPercentage" Color="Color.Error" Size="Size.Small" Rounded="true" />
                            </MudPaper>
                        </MudItem>

                        <!-- Bed Occupancy -->
                        <MudItem xs="12" sm="6">
                            <MudPaper Outlined="true" Class="pa-3 relative-tile">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <span class="d-flex align-center gap-2  text-white text-sm">
                                        <MudIcon Icon="@Icons.Material.Outlined.Bed" Size="Size.Small" /> Bed Occupancy
                                    </span>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@AvailableBedsPercentage%</MudText>
                                </div>
                                <MudProgressLinear Value="@AvailableBedsPercentage" Color="Color.Warning" Size="Size.Small" Rounded="true" />
                            </MudPaper>
                        </MudItem>

                        <!-- Emergency Readiness -->
                        <MudItem xs="12" sm="6">
                            <MudPaper Outlined="true" Class="pa-3 relative-tile">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <span class="d-flex align-center gap-2  text-white text-sm">
                                        <MudIcon Icon="@Icons.Material.Outlined.Emergency" Size="Size.Small" /> Emergency Readiness
                                    </span>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">@AvailableERBedsPercentage%</MudText>
                                </div>
                                <MudProgressLinear Value="@AvailableERBedsPercentage" Color="Color.Success" Size="Size.Small" Rounded="true" />
                            </MudPaper>
                        </MudItem>

                        <!-- Surgery Success -->
                        <MudItem xs="12" sm="6">
                            <MudPaper Outlined="true" Class="pa-3 relative-tile">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <span class="d-flex align-center gap-2  text-white text-sm">
                                        <MudIcon Icon="@Icons.Material.Outlined.MonitorHeart" Size="Size.Small" /> Surgery Success
                                    </span>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">98.6%</MudText>
                                </div>
                                <MudProgressLinear Value="98.6" Color="Color.Success" Size="Size.Small" Rounded="true" />
                            </MudPaper>
                        </MudItem>

                        <!-- Patient Satisfaction -->
                        <MudItem xs="12" sm="6">
                            <MudPaper Outlined="true" Class="pa-3 relative-tile">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <span class="d-flex align-center gap-2  text-white text-sm">
                                        <MudIcon Icon="@Icons.Material.Outlined.SentimentSatisfied" Size="Size.Small" /> Patient Satisfaction
                                    </span>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">94%</MudText>
                                </div>
                                <MudProgressLinear Value="94" Color="Color.Success" Size="Size.Small" Rounded="true" />
                            </MudPaper>
                        </MudItem>

                        <!-- Clinical Quality -->
                        <MudItem xs="12" sm="6">
                            <MudPaper Outlined="true" Class="pa-3 relative-tile">
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <span class="d-flex align-center gap-2  text-white text-sm">
                                        <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Small" /> Clinical Quality
                                    </span>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">96%</MudText>
                                </div>
                                <MudProgressLinear Value="96" Color="Color.Primary" Size="Size.Small" Rounded="true" />
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <!-- Dynamic Clinical Operation Summary -->
                <MudItem xs="12" md="3">
                    <MudPaper Elevation="0" Class="d-flex flex-column justify-space-between h-100 pa-3 bg-transparent border-start-md ms-3">
                        <div>
                            <div class="d-flex gap-3 align-start mb-3">
                                <div class="ai-sparkle-box">
                                    <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Color="Color.Primary" Size="Size.Small" />
                                </div>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-white">Clinical Operation Summary</MudText>
                                    <MudText Typo="Typo.caption" Class=" text-white">Live telemetry · auto-updated</MudText>
                                </div>
                            </div>

                            <MudText Typo="Typo.body2" Class="text-white mb-3" Style="line-height: 1.55;">
                                Currently tracking <strong>@DocCount active doctors</strong> and <strong>@NurCount active nurses</strong> on shift across @allPatients.Count patient records. ICU trending toward capacity — overflow protocol pre-staged.
                            </MudText>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <div class="status-chip chip-alert">
                                <MudIcon Icon="@Icons.Material.Outlined.Warning" Size="Size.Small" /> ICU at 92%
                            </div>
                            <div class="status-chip chip-neutral">
                                <MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Small" /> @UnavailableStaffCount staff off-duty
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudItem>
    </MudItem>

    <!-- Top Metrics Row -->
    <MudItem xs="12">
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="3">
                <div class="metric-card-wrapper">
                    <TopSummary DataCount="@allStaffs.Count" Title="Our Staff" Icon="@Icons.Material.Filled.People" AccentColor="Color.Primary" Bg="background: linear-gradient(0deg, rgba(22,35,104,1) 0%, rgba(22,35,104,0.5) 100%) !important;" />
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="metric-card-wrapper">
                    <TopSummary DataCount="@allPatients.Count" Title="Patients" Icon="@Icons.Material.Filled.AssistWalker" Bg="background: linear-gradient(0deg, rgba(242,7,7,1) 0%, rgba(242,7,7,0.5) 100%) !important;" AccentColor="Color.Info" />
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="metric-card-wrapper">
                    <TopSummary DataCount="@allLabTests.Count" Title="Lab Tests" Icon="@Icons.Material.Filled.Biotech" Bg="background: linear-gradient(0deg, rgba(244,130,8,1) 0%, rgba(244,130,8,0.5) 100%) !important;" AccentColor="Color.Warning" />
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <div class="metric-card-wrapper">
                    <TopSummary DataCount="@allMedicines.Count" Title="Medicine Inventory" Icon="@Icons.Material.Filled.LocalPharmacy" Bg="background: linear-gradient(0deg, green 0%, lightgreen 100%) !important;" AccentColor="Color.Success" />
                </div>
            </MudItem>
        </MudGrid>
    </MudItem>

    <!-- Charts Layer 1 -->
    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="chart-card">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Weekly Distribution</MudText>
            <MudChart T="double"
                      ChartType="ChartType.Pie"
                      ChartSeries="@_weeklyPatients"
                      ChartLabels="@_labels"
                      LegendPosition="Position.Bottom"
                      Width="100%" Height="230px" CanHideSeries MatchBoundsToSize />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="chart-card">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Weekly Patients By Type</MudText>
            <MudChart T="double" ChartType="ChartType.Bar"
                      ChartSeries="@_weeklyPatientsByType"
                      ChartLabels="@_labels"
                      LegendPosition="Position.Bottom"
                      Width="100%" Height="230px" CanHideSeries MatchBoundsToSize />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Elevation="0" Class="chart-card">
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Weekly Patients By Age</MudText>
            @* <MudChart T="double" ChartType="ChartType.Line"
                      ChartSeries="@_weeklyPatientsByAge"
                      ChartLabels="@_labels"
                      LegendPosition="Position.Bottom"
                      Width="100%" Height="230px" CanHideSeries MatchBoundsToSize /> *@
            <MudChart T="double" ChartType="ChartType.Line"
                      ChartSeries="@_weeklyPatientsByAge"
                      ChartLabels="@_labels"
                      ChartOptions="@_options"
                      LegendPosition="Position.Bottom"
                      Width="100%" Height="230px" CanHideSeries MatchBoundsToSize />

        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="12">
        <MudGrid Spacing="4" Class="mb-4">

            <!-- Patient Flow Monitor — stepped funnel (7 columns on desktop) -->
            <MudItem xs="12" lg="7">
                <MudPaper Elevation="0" Class="pa-5 surface-card animate-rise-in h-100">
                    <div class="d-flex align-start justify-space-between gap-3">
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Patient Flow Monitor</MudText>
                            <MudText Typo="Typo.caption" Class="text-muted">Admission &rarr; triage &rarr; treatment &rarr; discharge &middot; today</MudText>
                        </div>
@*                         <MudIconButton Icon="@(_isFlowExpanded ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                       Size="Size.Small"
                                       OnClick="@(() => _isFlowExpanded = !_isFlowExpanded)"
                                       aria-label="Collapse panel" /> *@
                    </div>

                    <MudCollapse Expanded="@_isFlowExpanded">
                        <MudGrid Spacing="2">
                            <!-- Admitted -->
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="py-4 px-2 text-center rounded-lg funnel-tile funnel-primary">
                                    <MudIcon Icon="@Icons.Material.Outlined.PostAdd" Color="Color.Primary" Size="Size.Medium" />
                                    <MudText Typo="Typo.h5" Class="font-weight-bold mt-2">@admittedPatientsCount</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">Admitted</MudText>
                                </MudPaper>
                            </MudItem>

                            <!-- Triaged -->
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="py-4 px-2 text-center rounded-lg funnel-tile funnel-warning">
                                    <MudIcon Icon="@Icons.Material.Outlined.MedicalServices" Color="Color.Warning" Size="Size.Medium" />
                                    <MudText Typo="Typo.h5" Class="font-weight-bold mt-2">@triagedPatientsCount</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">Triaged</MudText>
                                </MudPaper>
                            </MudItem>

                            <!-- In Treatment -->
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="py-4 px-2 text-center rounded-lg funnel-tile funnel-info">
                                    <MudIcon Icon="@Icons.Material.Outlined.MonitorHeart" Color="Color.Info" Size="Size.Medium" />
                                    <MudText Typo="Typo.h5" Class="font-weight-bold mt-2">@inTreatmentPatientsCount</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">In treatment</MudText>
                                </MudPaper>
                            </MudItem>

                            <!-- Discharged -->
                            <MudItem xs="6" sm="3">
                                <MudPaper Elevation="0" Class="py-4 px-2 text-center rounded-lg funnel-tile funnel-success">
                                    <MudIcon Icon="@Icons.Material.Outlined.Logout" Color="Color.Success" Size="Size.Medium" />
                                    <MudText Typo="Typo.h5" Class="font-weight-bold mt-2">@dischargedPatientsCount</MudText>
                                    <MudText Typo="Typo.caption" Class="text-muted">Discharged</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>

                        <!-- Funnel Conversion Gradient Bar -->
                        <div class="funnel-gradient-bar mt-4"></div>

                        <MudText Typo="Typo.caption" Class="text-muted d-block mt-3">
                            Avg. length of stay 2.4 days &middot; 42% funnel conversion admission-to-discharge today
                        </MudText>
                    </MudCollapse>
                </MudPaper>
            </MudItem>

            <!-- Live Bed Occupancy (5 columns on desktop) -->
            <MudItem xs="12" lg="5">
                <MudPaper Elevation="0" Class="pa-5 surface-card animate-rise-in h-100" Style="animation-delay: 0.08s;">
                    <div class="d-flex align-center justify-space-between gap-3">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Bed" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Live Bed Occupancy</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text" Class="font-weight-bold badge-warning-soft">
                            87.4% full
                        </MudChip>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        <!-- General Ward -->
                        <div>
                            <div class="d-flex align-center justify-space-between mb-1">
                                <MudText Typo="Typo.caption" Class="font-weight-bold">General Ward &middot; GW-1</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">142 / 160</MudText>
                            </div>
                            <MudProgressLinear Value="88.7" Color="Color.Warning" Size="Size.Medium" Rounded="true" />
                        </div>

                        <!-- ICU-B -->
                        <div>
                            <div class="d-flex align-center justify-space-between mb-1">
                                <MudText Typo="Typo.caption" Class="font-weight-bold">ICU-B</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">33 / 36</MudText>
                            </div>
                            <MudProgressLinear Value="91.6" Color="Color.Error" Size="Size.Medium" Rounded="true" />
                        </div>

                        <!-- Pediatrics -->
                        <div>
                            <div class="d-flex align-center justify-space-between mb-1">
                                <MudText Typo="Typo.caption" Class="font-weight-bold">Pediatrics &middot; PW-2</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">38 / 60</MudText>
                            </div>
                            <MudProgressLinear Value="63.3" Color="Color.Info" Size="Size.Medium" Rounded="true" />
                        </div>

                        <!-- Maternity -->
                        <div>
                            <div class="d-flex align-center justify-space-between mb-1">
                                <MudText Typo="Typo.caption" Class="font-weight-bold">Maternity &middot; MW-1</MudText>
                                <MudText Typo="Typo.caption" Class="text-muted">21 / 40</MudText>
                            </div>
                            <MudProgressLinear Value="52.5" Color="Color.Success" Size="Size.Medium" Rounded="true" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>

        </MudGrid>

    </MudItem>

    <!--Pharmacy-->
    <MudItem xs="12" md="12" Class="pt-0">
        <MudGrid Spacing="4" Class="mb-4">

            <!-- Ph.1 -->
            <MudItem xs="12" lg="4">
                <MudPaper Elevation="0" Class="surface-card is-interactive col-span-12 lg:col-span-4 p-3 lg:p-4 animate-rise-in" Style="animation-delay: 0s;">
                    <div class="d-flex align-center justify-space-between gap-3">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.LocalPharmacy" Size="Size.Small" />
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Pharmacy Alerts</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text" Class="font-weight-bold badge-warning-soft">
                            87.4% full
                        </MudChip>
                    </div>
                    <ul class="space-y-2.5 amb-rail__list scroll-thin">
                        <li class="flex items-center justify-between p-2.5 rounded-xl u-background-color-mix-in-oklab-color-danger-500-6-surface-sun">
                            <span class="text-[12px] font-medium">Epinephrine 1mg/mL</span>
                            <span class="text-[11px] font-semibold u-color-color-danger-500">8 units left</span>
                        </li>
                        <li class="flex items-center justify-between p-2.5 rounded-xl u-background-color-mix-in-oklab-color-danger-500-6-surface-sun">
                            <span class="text-[12px] font-medium">Insulin Glargine</span>
                            <span class="text-[11px] font-semibold u-color-color-danger-500">14 units left</span>
                        </li>
                        <li class="flex items-center justify-between p-2.5 rounded-xl u-background-color-mix-in-oklab-color-warning-500-6-surface-su">
                            <span class="text-[12px] font-medium">Amoxicillin 500mg</span>
                            <span class="text-[11px] font-semibold u-color-color-warning-500">62 units left</span>
                        </li>
                        <li class="flex items-center justify-between p-2.5 rounded-xl u-background-color-mix-in-oklab-color-danger-500-6-surface-sun">
                            <span class="text-[12px] font-medium">Epinephrine 1mg/mL</span>
                            <span class="text-[11px] font-semibold u-color-color-danger-500">8 units left</span>
                        </li>
                        <li class="flex items-center justify-between p-2.5 rounded-xl u-background-color-mix-in-oklab-color-danger-500-6-surface-sun">
                            <span class="text-[12px] font-medium">Insulin Glargine</span>
                            <span class="text-[11px] font-semibold u-color-color-danger-500">14 units left</span>
                        </li>
                        <li class="flex items-center justify-between p-2.5 rounded-xl u-background-color-mix-in-oklab-color-warning-500-6-surface-su">
                            <span class="text-[12px] font-medium">Amoxicillin 500mg</span>
                            <span class="text-[11px] font-semibold u-color-color-warning-500">62 units left</span>
                        </li>
                        <li class="flex items-center justify-between p-2.5 rounded-xl u-background-color-mix-in-oklab-color-warning-500-6-surface-su">
                            <span class="text-[12px] font-medium">Amoxicillin 500mg</span>
                            <span class="text-[11px] font-semibold u-color-color-warning-500">62 units left</span>
                        </li>
                    </ul>
                </MudPaper>
            </MudItem>

            <!-- Ph.2 -->
            <MudItem xs="12" lg="4">
                <MudPaper Elevation="0" Class="pa-5 surface-card animate-rise-in h-100" Style="animation-delay: 0.08s;">
                    <div class="d-flex align-center justify-space-between gap-3">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Outlined.Medication" Size="Size.Small" />
