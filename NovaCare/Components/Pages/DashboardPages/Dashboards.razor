            Scroll to top custom button
        </div> *@
        <MudFab StartIcon="@Icons.Material.Filled.ArrowUpward" Color="Color.Secondary" />
    </MudScrollToTop>
</MudItem>

@code {
    private string[] _labels = ["Mon", "Tue", "Wed", "Thur", "Fri", "Sat", "Sun"];
    private string[]? _docLabels;

    private Color[] _colors = [Color.Warning, Color.Info, Color.Primary, Color.Success, Color.Secondary, Color.Error];
    private int colorIndex = 0;

    List<DoctorDto> allDoctors = new();
    List<StaffDto> allStaffs = new();
    List<VisitDto> allVisits = new();
    List<PatientDto> allPatients = new();
    List<LabTestDto> allLabTests = new();
    List<MedicineDto> allMedicines = new();
    List<BedDto> allBeds = new();
    List<WardDto> allWards = new();
    List<BloodDto> AllBloods = new();

    List<ChartSeries<double>> _weeklyPatients = new();
    List<ChartSeries<double>> _weeklyPatientsByType = new();
    List<ChartSeries<double>> _weeklyPatientsByAge = new();
    List<ChartSeries<double>> _weeklyAvailableDoctors = new();
    List<ChartSeries<double>> _weeklyDoctorsBySpecialization = new();
    List<WardStatistics> wardStats = new();

    private BarChartOptions _options = new();
    private LineChartOptions _ageOptions = new();
    private BarChartOptions  _typeOptions = new();

    StaffDto StaffOfTheWeek = new();
    DateTime sevenDaysAgo = DateTime.Now.AddDays(-6);

    int NurCount = 0;
    int DocCount = 0;
    int UnavailableStaffCount = 0;

    int admittedPatientsCount = 0;
    int triagedPatientsCount = 0;
    int inTreatmentPatientsCount = 0;
    int dischargedPatientsCount = 0;

    double AvailableBedsPercentage = 0;
    double AvailableERBedsPercentage = 0;
    double AvailableICUBedsPercentage = 0;
    double ICUatBedsPercentage = 0;

    double PainkillersPerc = 0;
    double AntibioticsPerc = 0;
    double AntifungalsPerc = 0;
    double AntiviralsPerc = 0;
    double VaccinesPerc = 0;
    double AnthelminticsPerc = 0;
    double AntimalarialsPerc = 0;

    double DoctorAvailabilityPct = 0;
    double StaffReadinessPct = 0;
    double MedsAvailabilityPct  = 0;
    double BloodBankPct = 0;
    double overallOccupancy = 0;

    int OverallVitalsScore = 94;
    private bool _isFlowExpanded = true;

    Color OverallScoreColor => OverallVitalsScore >= 85 ? Color.Success : (OverallVitalsScore >= 70 ? Color.Warning : Color.Error);
    Color overallChipColor;
    Color barColor;

    string OverallStatusText => OverallVitalsScore >= 85 ? "Operating Normally" : (OverallVitalsScore >= 70 ? "Elevated Load" : "Critical Attention");

    string middleName => string.IsNullOrWhiteSpace(StaffOfTheWeek.MiddleName)
        ? ""
        : $"{StaffOfTheWeek.MiddleName.Trim().ToUpper().Substring(0, 1)}.";

    protected override async Task OnInitializedAsync()
    {
        allStaffs = await staffService.GetAllStaffsAsync() ?? new();
        allPatients = await patientService.GetAllPatientsAsync() ?? new();
        allLabTests = await labTestService.GetAllLabTestsAsync() ?? new();
        allMedicines = await medicineService.GetAllMedicinesAsync() ?? new();
        allDoctors = await doctorService.GetAllDoctorsAsync() ?? new();
        allBeds = await roomService.GetAllBedsAsync() ?? new();
        allWards = await roomService.GetAllWardsAsync() ?? new();
        allVisits = await patientService.GetAllVisitsAsync() ?? new();
        AllBloods = await medicineService.GetAllBloodsAsync();

        await MedsPercentageByGenre();
        await LiveBedOccupancy();

        StaffOfTheWeek = allStaffs.FirstOrDefault(x => x.IsStaffOfTTheWeek) ?? new();

        PatientFlowMonitorData();
        BedsAvailability();
        CalculateLiveVitals();
        WeeklyPatients();
        WeeklyPatientsByType();
        WeeklyPatientsByAge();
        WeeklyDoctorsBySpecialization();
        WeeklyDoctorsAvailability();

        _ageOptions.YAxisTicks = CalculateMaxTick(_weeklyPatientsByAge);
        _typeOptions.YAxisTicks = CalculateMaxTick(_weeklyPatientsByType);
        _options.YAxisTicks = CalculateMaxTick(_weeklyDoctorsBySpecialization);


        StateHasChanged();
    }

    public async Task MedsPercentageByGenre()
    {
        PainkillersPerc = (double)allMedicines.Count(m => m.MedicineGenreId == 1) / allMedicines.Count() * 100;
        AntibioticsPerc = (double)allMedicines.Count(m => m.MedicineGenreId == 2) / allMedicines.Count() * 100;
        AntifungalsPerc = (double)allMedicines.Count(m => m.MedicineGenreId == 3) / allMedicines.Count() * 100;
        AntiviralsPerc = (double)allMedicines.Count(m => m.MedicineGenreId == 4) / allMedicines.Count() * 100;
        VaccinesPerc = (double)allMedicines.Count(m => m.MedicineGenreId == 5) / allMedicines.Count() * 100;
        AnthelminticsPerc = (double)allMedicines.Count(m => m.MedicineGenreId == 6) / allMedicines.Count() * 100;
        AntimalarialsPerc = (double)allMedicines.Count(m => m.MedicineGenreId == 7) / allMedicines.Count() * 100;

    }

    private int CalculateMaxTick(List<ChartSeries<double>>? series)
    {
        var maxValue = series?
            .Where(s => s.Data != null)
            .SelectMany(s => s.Data)
            .DefaultIfEmpty(20)
            .Max() ?? 20;

        return Math.Max(1, (int)Math.Ceiling(maxValue));
    }

    private void PatientFlowMonitorData()
    {
        //Admitted Patients
        admittedPatientsCount = allVisits.Where(v => v.VisitStatusName.ToLower().Trim() != "cancelled" && v.VisitDate.ToShortDateString() == DateTime.Now.ToShortDateString()).Count();

        //Triaged Patients
        triagedPatientsCount = allVisits.Where(v => v.VisitStatusName.ToLower().Trim() != "cancelled" && v.VisitDate.ToShortDateString() == DateTime.Now.ToShortDateString() && v?.PatientTypeName.ToLower().Trim() != "emergency").Count();

        //In Treatment Patients
        inTreatmentPatientsCount = allVisits.Where(v => v.VisitStatusName.ToLower().Trim() != "cancelled" && v.VisitDate.ToShortDateString() == DateTime.Now.ToShortDateString() && v.Treatments.Any()).Count();

        //Discharged Patients
        dischargedPatientsCount = allVisits.Where(v => v.VisitStatusName.ToLower().Trim() == "completed" && v.DischargedDate?.ToShortDateString() == DateTime.Now.ToShortDateString()).Count();
    }

    private void BedsAvailability()
    {
        //All Beds
        var unsuedBedsCount = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused").Count();
        var totalBeds = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused").Count();
        if (totalBeds > 0)
            AvailableBedsPercentage = Math.Round(((double)unsuedBedsCount / totalBeds) * 100);

        //All ER Beds
        var unsuedERBedsCount = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused" && b.WardName.ToLower().Trim() == "general ward").Count();
        var totalERBeds = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused" && b.WardName.ToLower().Trim() == "general ward").Count();
        if (totalERBeds > 0)
            AvailableERBedsPercentage = Math.Round(((double)unsuedERBedsCount / totalERBeds) * 100);

        //All ICU Beds
        var unsuedICUBedsCount = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused" && b.WardName.ToLower().Trim() == "medical icu").Count();
        var totalICUBeds = allBeds.Where(b => b.BedAvailability.ToLower().Trim() == "unused" && b.WardName.ToLower().Trim() == "medical icu").Count();
        if (totalICUBeds > 0)
            AvailableICUBedsPercentage = Math.Round(((double)unsuedICUBedsCount / totalICUBeds) * 100);

        ICUatBedsPercentage = 100 - AvailableICUBedsPercentage;
    }

    public async Task LiveBedOccupancy()
    {
        var wardsList = allWards ?? new List<WardDto>();

        wardStats = wardsList.Select(w =>
        {
            var bedsInWard = (w.Beds != null && w.Beds.Any())
                ? w.Beds
                : (allBeds ?? new List<BedDto>()).Where(b => b.WardId == w.Id).ToList();

            var total = bedsInWard.Count > 0 ? bedsInWard.Count : w.BedsCount;
            var occupied = bedsInWard.Count(b => !string.Equals(b.BedAvailability, "UnUsed", StringComparison.OrdinalIgnoreCase));
            var pct = total > 0 ? Math.Round((double)occupied / total * 100, 1) : 0;

            var deptName = !string.IsNullOrWhiteSpace(w.MedicalDepartmentName)
                ? w.MedicalDepartmentName
                : w.MedicalDepartment?.MedicalDepartmentName;

            return new WardStatistics
            {
                WardName = w.WardName,
                DepartmentName = deptName,
                Occupied = occupied,
                Total = total,
                Percentage = pct
            };
        }).ToList();

        var totalHospitalBeds = wardStats.Sum(w => w.Total);
        var totalHospitalOccupied = wardStats.Sum(w => w.Occupied);
        overallOccupancy = totalHospitalBeds > 0
            ? Math.Round((double)totalHospitalOccupied / totalHospitalBeds * 100, 1)
            : 0;

        overallChipColor = overallOccupancy >= 90 ? Color.Error
                             : overallOccupancy >= 75 ? Color.Warning
                             : Color.Success;
    }

    private void CalculateLiveVitals()
    {
        const int targetBloodUnits = 100;

        var activeStaff = allStaffs
            .Where(x => string.Equals(x.StaffStatusName?.Trim(), "available", StringComparison.OrdinalIgnoreCase))
            .ToList();

        UnavailableStaffCount = allStaffs.Count - activeStaff.Count;

        NurCount = activeStaff.Count(x => string.Equals(x.ClinicalTitleName?.Trim(), "nurse", StringComparison.OrdinalIgnoreCase));
        DocCount = activeStaff.Count(x => string.Equals(x.ClinicalTitleGroupName?.Trim(), "doctors", StringComparison.OrdinalIgnoreCase));

        int totalDoctors = allStaffs.Count(x => string.Equals(x.ClinicalTitleGroupName?.Trim(), "doctors", StringComparison.OrdinalIgnoreCase));

        int totalMeds = allMedicines.Count();
        int inStockMeds = allMedicines.Count(m => string.Equals(m.MedicineStatusName?.Trim(), "instock", StringComparison.OrdinalIgnoreCase));

        int currentBloodUnits = AllBloods.Count();

        DoctorAvailabilityPct = totalDoctors > 0 ? Math.Round((double)DocCount / totalDoctors * 100, 1) : 100;
        StaffReadinessPct = allStaffs.Count > 0 ? Math.Round((double)activeStaff.Count / allStaffs.Count * 100, 1) : 100;
        MedsAvailabilityPct = totalMeds > 0 ? Math.Round((double)inStockMeds / totalMeds * 100, 1) : 100;
        BloodBankPct = targetBloodUnits > 0 ? Math.Min(Math.Round((double)currentBloodUnits / targetBloodUnits * 100, 1), 100.0) : 100;

        double rawScore = (DoctorAvailabilityPct * 0.25)
                        + (StaffReadinessPct * 0.25)
                        + (MedsAvailabilityPct * 0.25)
                        + (BloodBankPct * 0.25);

        OverallVitalsScore = (int)Math.Round(rawScore, MidpointRounding.AwayFromZero);
    }



    private void WeeklyPatients()
    {
        //var today = DateTime.Today;

        var weeklyPatients = allVisits.Where(x => x.VisitDate.Date >= sevenDaysAgo && x.VisitDate.Date <= DateTime.Now).ToList();

        var countByDay = weeklyPatients.GroupBy(x => x.VisitDate.DayOfWeek)
            .ToDictionary( g => g.Key == DayOfWeek.Sunday ? 6 : (int)g.Key - 1, g => (double)g.Count());

        var dailyCounts = new double[7];
        for (int i = 0; i < 7; i++)
        {
            dailyCounts[i] = countByDay.GetValueOrDefault(i, 0.0);
        }

        _weeklyPatients = new List<ChartSeries<double>>
        {
            new() { Name = "Patients", Data = dailyCounts }
        };
    }

    private void WeeklyPatientsByType()
    {
        var weeklyPatients = allVisits.Where(x => x.VisitDate >= sevenDaysAgo && x.VisitDate <= DateTime.Now).ToList();
        var groupedByType = weeklyPatients.GroupBy(x => x.PatientTypeName);

        _weeklyPatientsByType = new List<ChartSeries<double>>();
        foreach (var typeGroup in groupedByType)
        {
            var countByDay = typeGroup.GroupBy(x => x.VisitDate.DayOfWeek)
                .ToDictionary(g => g.Key == DayOfWeek.Sunday ? 6 : (int)g.Key - 1, g => (double)g.Count());

            double[] weeklyData = Enumerable.Range(0, 7).Select(i => countByDay.ContainsKey(i) ? countByDay[i] : 0.0).ToArray();
            _weeklyPatientsByType.Add(new ChartSeries<double> { Name = typeGroup.Key, Data = weeklyData });
        }
    }

    private void WeeklyPatientsByAge()
    {
        var weeklyPatients = allPatients.Where(x => x.RegisteredDate >= sevenDaysAgo && x.RegisteredDate <= DateTime.Now).ToList();
        DayOfWeek[] daysOrder = { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };

        double[] data0To14 = new double[7];
        double[] data15To45 = new double[7];
        double[] dataAbove45 = new double[7];

        for (int i = 0; i < daysOrder.Length; i++)
        {
            var patientsOnDay = weeklyPatients.Where(x => x.RegisteredDate.DayOfWeek == daysOrder[i]).ToList();
            data0To14[i] = patientsOnDay.Count(x => x.Age >= 0 && x.Age <= 14);
            data15To45[i] = patientsOnDay.Count(x => x.Age >= 15 && x.Age <= 45);
            dataAbove45[i] = patientsOnDay.Count(x => x.Age > 45);
        }

        _weeklyPatientsByAge = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "0-14", Data = data0To14 },
            new ChartSeries<double> { Name = "15-45", Data = data15To45 },
            new ChartSeries<double> { Name = "Above 45", Data = dataAbove45 }
        };

        _ageOptions.SeriesDisplayOverrides = new Dictionary<IChartSeries, SeriesDisplayOverride>()
        {
            { _weeklyPatientsByAge[0], new SeriesDisplayOverride { LineDisplayType = LineDisplayType.Area } },
            { _weeklyPatientsByAge[1], new SeriesDisplayOverride { LineDisplayType = LineDisplayType.Area } },
            { _weeklyPatientsByAge[2], new SeriesDisplayOverride { LineDisplayType = LineDisplayType.Area } }
        };
    }

    private void WeeklyDoctorsBySpecialization()
    {
        var avFocs = allDoctors.Where(doc => doc.Staff!.StaffStatusId == 1).ToList();

        var distinctTypes = avFocs.DistinctBy(x => x.DoctorTypeId).ToList();

        _docLabels = distinctTypes
            .Select(t => t.DoctorType!.DoctorTypeName)
            .ToArray();

        _weeklyDoctorsBySpecialization = distinctTypes
        .Select((typeDoc, index) =>
        {
            // Create an array of 0s matching the total number of distinct doctor types
            var dataArray = new double[distinctTypes.Count];

            // Set the count at the specific index for this doctor type
            dataArray[index] = avFocs.Count(d => d.DoctorTypeId == typeDoc.DoctorTypeId);


            return new ChartSeries<double>
            {
                // Replace 'DoctorType?.Name' with your actual navigation/name property
                Name = typeDoc.DoctorType?.DoctorTypeName ?? $"Type {typeDoc.DoctorType!.DoctorTypeName}",
                Data = dataArray
            };
        })
        .ToList();
    }

    private void WeeklyDoctorsAvailability()
    {
        var weeklyDoctors = allStaffs.Where(x =>
            string.Equals(x.StaffStatusName, "available", StringComparison.OrdinalIgnoreCase) &&
            (string.Equals(x.ClinicalTitleName, "doctor", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(x.ClinicalTitleName, "md", StringComparison.OrdinalIgnoreCase) ||
             string.Equals(x.ClinicalTitleName, "specialist", StringComparison.OrdinalIgnoreCase)) &&
            x.RegisteredDate >= sevenDaysAgo && x.RegisteredDate <= DateTime.Now).ToList();

        var groupedByType = weeklyDoctors.GroupBy(x => x.StaffStatusName ?? "Available");

        _weeklyAvailableDoctors = new List<ChartSeries<double>>();
        foreach (var typeGroup in groupedByType)
        {
            var countByDay = typeGroup.GroupBy(x => x.RegisteredDate.DayOfWeek)
                .ToDictionary(g => g.Key == DayOfWeek.Sunday ? 6 : (int)g.Key - 1, g => (double)g.Count());

            double[] weeklyData = Enumerable.Range(0, 7).Select(i => countByDay.ContainsKey(i) ? countByDay[i] : 0.0).ToArray();
            _weeklyAvailableDoctors.Add(new ChartSeries<double> { Name = typeGroup.Key, Data = weeklyData });
        }
    }


    public class WardStatistics
    {
        public string WardName { get; set; } = string.Empty;
        public string DepartmentName { get; set; } = string.Empty;
        public int Occupied { get; set; }
        public int Total { get; set; }
        public double Percentage { get; set; }
    }
}
