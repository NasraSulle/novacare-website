    <MudItem xs="12" md="6" Class="pt-0">
        <MudGrid Spacing="3">
            <!-- Staff of the Week Card -->
            <MudItem xs="12">
                <MudPaper Elevation="3" Class="vitals-bridge staff-card pa-4">
                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="12" sm="3" Class="d-flex justify-center">
                            @if (StaffOfTheWeek.StaffPhoto == null)
