            </MudItem>

            <MudItem xs="12" sm="5">
                <MudPaper Elevation="3" Class="carousel-metric-card pa-4 d-flex flex-column justify-center align-center" Style="height: 100%; min-height: 208px;">
                    <MudText Typo="Typo.subtitle2" Class="text-uppercase mb-2" Style="color: #90a4ae; font-weight: 700; letter-spacing: 0.05em;">
                        On Duty Today
                    </MudText>

                    <MudCarousel Class="mud-width-full" Style="height:115px;" ShowArrows="false" ShowBullets="false" AutoCycle="true" TData="object">
                        <MudCarouselItem Transition="Transition.Fade">
                            <div class="d-flex flex-column align-center justify-center">
                                <MudText Typo="Typo.h2" Class="font-weight-bold" Style="color: #ffffff;">@DocCount</MudText>
                                <MudText Typo="Typo.body1" Style="color: #cfd8dc;">Active Doctors</MudText>
                            </div>
                        </MudCarouselItem>
                        <MudCarouselItem Transition="Transition.Fade">
                            <div class="d-flex flex-column align-center justify-center">
                                <MudText Typo="Typo.h2" Class="font-weight-bold" Style="color: #ffffff;">@NurCount</MudText>
                                <MudText Typo="Typo.body1" Style="color: #cfd8dc;">Active Nurses</MudText>
