@page "/PatientIndex"

@using Microsoft.AspNetCore.Authorization

@rendermode InteractiveServer
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@attribute [Authorize]
<PageTitle>Patients - NovaCare</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-3 px-sm-6">
    @* Page Header *@
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center">
        <SectionTitle Icon="@icon" Title="@title" />
        <Briefer BriferNote="@briferNote" />
    </div>

    @* Primary Category Tabs + Sub-Filter Tabs TabPanelsClass="pa-3 pa-sm-6"*@
    <MudPaper Elevation="0" Outlined="true" Class="overflow-hidden" Style="background-color: rgba(246,246,246,1) !important;">
        <MudTabs Elevation="0"
                 Rounded="false" Border="true"
                 TabHeaderClass="bg-secondary-subtle"
                 Position="Position.Top"
                 SliderColor="Color.Primary"
                 Centered="false">
            <MudTabPanel Text="All Patients" Icon="@Icons.Material.Outlined.People" Style="text-transform: none; font-weight: 500;" OnClick="@(() => SetGenre("All Patients"))">
                @RenderSubTabs("All Patients")
            </MudTabPanel>

            @if (CurrentUser?.ClinicalTitleName?.Trim().ToLower() == "doctor")
            {
                <MudTabPanel Text="My Patients" Icon="@Icons.Material.Outlined.PersonPin" Style="text-transform: none; font-weight: 500;" OnClick="@(() => SetGenre("My Patients"))">
                    @RenderSubTabs("My Patients")
                </MudTabPanel>
                <MudTabPanel Text="Consultation Requests" Icon="@Icons.Material.Outlined.MedicalServices" Style="text-transform: none; font-weight: 500;" OnClick="@(() => SetGenre("Consultation Requests"))">
                    @RenderSubTabs("Consultation Requests")
                </MudTabPanel>
            }

            @if (CurrentUser?.ClinicalTitleName?.Trim().ToLower() == "nurse" || CurrentUser?.AdministrativeTitleName?.Trim().ToLower() == "receptionist")
            {
                <MudTabPanel Text="Vitals Requests" Icon="@Icons.Material.Outlined.MonitorHeart" Style="text-transform: none; font-weight: 500;" OnClick="@(() => SetGenre("Vitals Requests"))">
                    @RenderSubTabs("Vitals Requests")
                </MudTabPanel>
            }
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    StaffDto CurrentUser { get; set; } = new();
    public string icon = Icons.Material.Filled.AssistWalker;
    public string title = "Patients Directory";
    public string patientGenre = "All Patients";
    string briferNote = "Manage patient records, admissions, triage vitals, and consultations";

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await userService.GetLoggedInUserAsync() ?? new();
    }

    private void SetGenre(string genre)
    {
        patientGenre = genre;
        StateHasChanged();
    }

    private RenderFragment RenderSubTabs(string genre) => __builder =>
    {
        <div class="w-100" style="border-top: 1px solid rgba(0,0,0,0.08);">
            <MudTabs Elevation="0"
                     Rounded="false"
                     ApplyEffectsToContainer="true"
                     TabHeaderClass="bg-primary-subtle"
                     SliderColor="Color.Error"
                     TabPanelsClass="pa-3 pa-sm-6 w-100"
                     Centered="false">
                <MudTabPanel Text="All" Style="text-transform: none;">
                    <Patients PatientGenre="@genre" />
                </MudTabPanel>
                <MudTabPanel Text="Out Patients" Style="text-transform: none;">
                    <Patients PatientGenre="@genre" FilterBy="OutSide" />
                </MudTabPanel>
                <MudTabPanel Text="Hospitalized Patients" Style="text-transform: none;">
                    <Patients PatientGenre="@genre" FilterBy="Hospitalized" />
                </MudTabPanel>
                <MudTabPanel Text="Clinic Patients" Style="text-transform: none;">
                    <Patients PatientGenre="@genre" FilterBy="Clinic" />
                </MudTabPanel>
            </MudTabs>
        </div>
    };
}
