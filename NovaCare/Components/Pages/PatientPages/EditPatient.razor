                                                                </MudItem>

                                                                <MudItem md="12">
                                                                    <MudGrid Spacing="1" Justify="Justify.FlexEnd">
                                                                        <MudItem md="3">
                                                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddPrescriptionToBatch" Class="mt-2" FullWidth="true">Add To Batch</MudButton>
