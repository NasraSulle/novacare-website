                                                                            <MudTh>Total Cost</MudTh>
                                                                            <MudTh>@PrescriptionsBatch?.Sum(x => x.TotalPrice)</MudTh>
                                                                            <MudTh></MudTh>
                                                                        </FooterContent>
                                                                    </MudTable>
                                                                }
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    }
                                    else
                                    {
                                        <MudItem md="9">
                                            <MudGrid Spacing="1" Justify="Justify.Center" Class="pa-0" Style="border:none;">
                                                <MudItem md="12" Class="ps-6 pe-0 pt-0">
                                                    <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                                                        <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Consultations Information</MudText>
                                                        <MudGrid Class="pa-3">
                                                            <MudGrid Spacing="1" Class="pa-3 ps-6 pe-0 pb-0">
                                                                <MudItem md="4">
                                                                    <MudSelect For="@(() => selectedDocTypeId)"
                                                                               @bind-Value="selectedDocTypeId"
                                                                               @bind-Value:after="OnDoctorTypeChange"
                                                                               Disabled="@(CurrentVisit.VisitTypeId == 0)"
