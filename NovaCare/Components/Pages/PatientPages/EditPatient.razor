                                                                                <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveTreatmentFromBatch(docContext))" />
                                                                            </MudTd>
                                                                        </RowTemplate>
                                                                        <FooterContent>
                                                                            <MudTh>Total Cost</MudTh>
                                                                            <MudTh>@TreatmentsBatch?.Sum(x => x.TreatmentCost)</MudTh>
