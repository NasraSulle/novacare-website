                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Choose Specialist</MudSelectItem>

                                                                        @foreach (var item in AllDoctorTypes)
                                                                        {
                                                                            <MudSelectItem Value="@item.Id">@($"{item.DoctorTypeName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>
                                                                <MudItem md="4">
                                                                    <MudSelect For="@(() => selectedDocStaffId)"
                                                                               @bind-Value="selectedDocStaffId"
                                                                               @bind-Value:after="OnDoctorSelect"
                                                                               Label="Choose Doctor" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Choose Doctor</MudSelectItem>

                                                                        @foreach (var item in FilteredDoctors)
                                                                        {
                                                                            <MudSelectItem Value="@item.StaffId">@($"{item.DoctorFullName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>
                                                                <MudItem md="4">
                                                                    <MudDatePicker For="@(() => CurrentConsultation.StartDate)" @bind-Date="CurrentConsultation.StartDate" Margin="Margin.Dense"
                                                                                   Label="Start On" Variant="Variant.Outlined" Placeholder="Start On"
                                                                                   UserAttributes="@(new() { { "autocomplete", "licenceexpdate" }, { "aria-required", "true" } } )" />
                                                                </MudItem>
                                                                <MudItem md="12">
                                                                    <MudGrid Justify="Justify.FlexEnd" Spacing="1">
                                                                        <MudItem md="3">
                                                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddConsultationToBatch(selectedDocStaffId))" Class="mt-2" FullWidth="true">Add To Batch</MudButton>
                                                                        </MudItem>
                                                                        <MudItem md="3">
                                                                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ResetConsultationss" Class="mt-2" FullWidth="true">Reset Batch</MudButton>
                                                                        </MudItem>
                                                                    </MudGrid>
                                                                </MudItem>
                                                            </MudGrid>
                                                            <MudItem md="12">
                                                                @if (!ConsultationsBatch!.Any())
                                                                {
                                                                    <NoDataNotice NoDataMessage="No Doctor in Batch" />
                                                                }
                                                                else
                                                                {

                                                                    <MudTable Dense="true" FixedHeader="true" FixedFooter="true" Items="@ConsultationsBatch" Height="220px" Hover="true" Breakpoint="Breakpoint.Sm" Context="docContext">
                                                                        <HeaderContent>
                                                                            <MudTh>Name</MudTh>
                                                                            <MudTh>Cost</MudTh>
                                                                            <MudTh Class="text-end">
                                                                                @* <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.FolderDelete" OnClick="ResetTests" /> *@
                                                                            </MudTh>
                                                                        </HeaderContent>
                                                                        <RowTemplate>
                                                                            <MudTd DataLabel="Name">@docContext.DoctorFullName</MudTd>
                                                                            <MudTd DataLabel="Consultation Cost">@docContext.ConsultationCost</MudTd>
                                                                            <MudTd DataLabel="" Class="text-end">
                                                                                <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveConsultationFromBatch(docContext))" />
                                                                            </MudTd>
                                                                        </RowTemplate>
                                                                        <FooterContent>
                                                                            <MudTh>Total Cost</MudTh>
                                                                            <MudTh>@ConsultationsBatch?.Sum(x => x.ConsultationCost)</MudTh>
                                                                            <MudTh></MudTh>
                                                                        </FooterContent>
                                                                    </MudTable>
                                                                }
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudStep>
                            <MudStep Title="Step 3">
                                <MudGrid Class="mb-3">
                                    <MudItem md="2">
                                        <MudCheckBox @bind-Value="_step3Complete" ReadOnly="true" Dense="true" Color="Color.Success">Preliminary Test</MudCheckBox>
                                    </MudItem>
                                    <MudItem md="10">
                                        <MudText Color="Color.Error" Align="Align.End">Patient should proceed to the cashier to make payment for any of the requested service before proceeding with preliminary tests</MudText>
                                    </MudItem>
                                </MudGrid>
                                <MudGrid Spacing="5" Justify="Justify.Center" Class="rounded-2" Style="border:none; background-color: rgba(0,0,0,0.5)">
                                    <MudItem md="12" Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                                        <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Preliminary Tests</MudText>
                                        <MudGrid Class="pa-3">
                                            <MudItem md="4">
                                                <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryPressure)" @bind-Value="CurrentPreliminaryTest.PreliminaryPressure" Margin="Margin.Dense"
                                                                 Label="Pressure" Variant="Variant.Outlined" Placeholder="Pressure"
                                                                 ReadOnly="@(!(
                                                                                (CurrentVisit.Consultations?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.LabTests?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.Prescriptions?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.Treatments?.Any(x => x.BillItemId != null) ?? false)
                                                                            ))"
                                                                 UserAttributes="@(new() { { "autocomplete", "preliminarypressure" }, { "aria-required", "true" } } )" />
                                            </MudItem>
                                            <MudItem md="4">
                                                <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryWeight)" @bind-Value="CurrentPreliminaryTest.PreliminaryWeight" Margin="Margin.Dense"
                                                                 Label="Weight" Variant="Variant.Outlined" Placeholder="Weight"
                                                                 ReadOnly="@(!(
                                                                                (CurrentVisit.Consultations?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.LabTests?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.Prescriptions?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.Treatments?.Any(x => x.BillItemId != null) ?? false)
                                                                            ))"
                                                                 UserAttributes="@(new() { { "autocomplete", "preliminaryweight" }, { "aria-required", "true" } } )" />
                                            </MudItem>
                                            <MudItem md="4">
                                                <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryHeight)" @bind-Value="CurrentPreliminaryTest.PreliminaryHeight" Margin="Margin.Dense"
                                                                 Label="Height" Variant="Variant.Outlined" Placeholder="Height"
                                                                 ReadOnly="@(!(
                                                                                (CurrentVisit.Consultations?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.LabTests?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.Prescriptions?.Any(x => x.BillItemId != null) ?? false) ||
                                                                                (CurrentVisit.Treatments?.Any(x => x.BillItemId != null) ?? false)
                                                                            ))"
                                                                 UserAttributes="@(new() { { "autocomplete", "preliminaryheight" }, { "aria-required", "true" } } )" />
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>

                                </MudGrid>
                            </MudStep>
                        </MudStepper>

                        <MudItem md="12" Style="text-align:end">

                            <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit"
                                             Disabled="@(string.IsNullOrWhiteSpace(CurrentPatient.FisrtName) || string.IsNullOrWhiteSpace(CurrentPatient.PhoneNumber) || string.IsNullOrWhiteSpace(CurrentPatient.KinFullName) || string.IsNullOrWhiteSpace(CurrentPatient.KinPhoneNumber) || CurrentPatient.PatientStatusId == 0 || CurrentPatient.PatientTypeId == 0)">Save  Patient Details</MudStaticButton>
                            <MudButton Disabled="!string.IsNullOrWhiteSpace(CurrentPatient.PatientCode)" Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="">Reset Page</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToPatientsPage" Class="">Back</MudButton>
                        </MudItem>
                    </MudGrid>
                </EditForm>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    List<PatientStatusDto> PatientTypes = new();
    List<PatientTypeDto> PatientStatus = new();
    List<PaymentModeDto> PaymentModes = new();
    List<InsuaranceDto> InsuaranceCompanies = new();
    List<VisitTypeDto> allVisitTypes = new();
    List<DiseaseDto> AllDiseases = new();
    List<DoctorDto> AllDoctors = new();
    List<DoctorDto> FilteredDoctors = new();
    List<DoctorTypeDto> AllDoctorTypes = new();
    List<ConsultationDto>? ConsultationsBatch = new();
    List<LabTestDto>? LabTestsBatch = new();
    List<TreatmentDto>? TreatmentsBatch = new();
    List<PrescriptionDto>? PrescriptionsBatch = new();
    List<TreatmentTypeDto>? AllTreatmentTypes = new();
    List<SurgeryDto>? AllSurgeries = new();
    List<TherapyDto>? AllTherapies = new();
    List<MedicalDepartmentDto>? AllMedicalDepts = new();
    List<MedicineGenreDto>? AllMedicineGenres = new();
    List<MedicineTypeDto>? AllMedicineTypes = new();
    List<MedicineTypeDto>? FilteredMedicineTypes = new();
    List<MedicineDto>? AllMedicines = new();
    List<MedicineDto>? FilteredMedicines = new();
    List<WardDto>? AllWards = new();
    List<RoomDto>? AllRooms = new();

    PaymentModeDto CurrentPaymentMode = new();
    PatientDto CurrentPatient = new();
    VisitDto CurrentVisit = new();
    TreatmentDto CurrentTreatment = new();
    PrescriptionDto CurrentPrescription = new();
    PreliminaryTestDto CurrentPreliminaryTest = new();
    ConsultationDto CurrentConsultation = new();
    LabTestDto CurrentLabTest = new();
    InsuaranceDto CurrentInsuaranceCompany = new();
    DoctorDto CurrentDoctor = new();

    int selectedMedGenreId = 0;
    int selectedMedTypeId = 0;
    int selectedDocTypeId = 0;
    string selectedDocStaffId = string.Empty;
    string saveMessage = string.Empty;
    public string icon = Icons.Material.Filled.AssistWalker;
    public string title = "New Patient Form";
    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";

    bool isCreatedSuccessfully;
    bool isSaving;
    private bool? _step1Complete;
    private bool? _step2TextInput;
    private bool? _step3Complete;

    bool HasMedicineId;
    bool HasSurgeryId;
    bool HasTherapyId;
    bool HasMedicalDeptId;
    bool HasWardId;
    bool HasDoctorId;
    bool HasRoomId;

    protected override async Task OnInitializedAsync()
    {
        PatientTypes = await patientService.GetAllPatientTypesAsync();
        PatientStatus = await patientService.GetAllPatientStatusesAsync();
        PaymentModes = await paymentService.GetAllPaymentModesAsync();
        InsuaranceCompanies = await paymentService.GetAllInsuranceCompaniesAsync();
        allVisitTypes = await patientService.GetAllVisitTypesAsync();
        AllDiseases = await diseaseService.GetAllDiseasesAsync();
        AllDoctors = await doctorService.GetAllDoctorsAsync();
        AllDoctorTypes = await doctorService.GetDoctorTypesAsync();
        AllTreatmentTypes = await medicineService.GetAllTreatmentTypeAsync();
        AllMedicineGenres = await medicineService.GetAllMedicineGenresAsync();
        AllMedicineTypes = await medicineService.GetAllMedicineTypesAsync();
        AllMedicines = await medicineService.GetAllMedicinesAsync();
        AllSurgeries = await medicineService.GetAllSurgeriesAsync();
        AllTherapies = await medicineService.GetAllTherapiesAsync();
        AllMedicalDepts = await medicineService.GetAllMedicalDeptsAsync();
        AllWards = await roomService.GetAllWardsAsync();
        AllRooms = await roomService.GetAllRoomsAsync();
    }

    public async Task OnMedicineGenreChange()
    {
        //FilteredMedicineTypes = AllMedicineTypes?.Where(gen => gen.MedicineGenreId == selectedMedGenreId).ToList();
        FilteredMedicineTypes = AllMedicineTypes;

        // int selectedMedGenreId = 0;
        // int selectedMedTypeId = 0;
    }

    public async Task OnMedicineTypeChange()
    {
        FilteredMedicines = AllMedicines?.Where(gen => gen.MedicineGenreId == selectedMedGenreId && gen.MedicineTypeId == selectedMedTypeId && gen.MedicineStatusName.ToLower().Trim() == "instock").ToList();
    }

    public async Task OnMedicineChoose()
    {
        CurrentTreatment.TreatmentCost = AllMedicines?.FirstOrDefault(gen => gen.Id == CurrentPrescription.MedicineId)?.BuyingPrice ?? 0m;
    }

    public async Task OnSurgeryChosen()
    {
        CurrentTreatment.TreatmentCost = AllSurgeries?.FirstOrDefault(gen => gen.Id == CurrentTreatment.SurgeryId)?.SurgeryCost ?? 0m;
    }

    public async Task OnTherapyChosen()
    {
        CurrentTreatment.TreatmentCost = AllTherapies?.FirstOrDefault(gen => gen.Id == CurrentTreatment.TherapyId)?.TherapyCost ?? 0m;
    }

    public async Task OnWardChosen()
    {
        CurrentTreatment.TreatmentCost = AllWards?.FirstOrDefault(gen => gen.Id == CurrentTreatment.WardId)?.WardCost ?? 0m;
    }

    public async Task OnDoctorTypeChange()
    {
        FilteredDoctors = AllDoctors.Where(doc => doc.DoctorTypeId == selectedDocTypeId).ToList();
        CurrentConsultation.MedicalDepartmentId = AllDoctorTypes.FirstOrDefault(x => x.Id == selectedDocTypeId)?.MedicalDeptId;
    }

    public async Task OnDoctorSelect()
    {
        CurrentConsultation.DoctorId = AllDoctors.FirstOrDefault(doc => doc.Id == selectedDocTypeId)?.Id;
        CurrentConsultation.MedicalDepartmentId = AllDoctorTypes.FirstOrDefault(doc => doc.Id == selectedDocTypeId)?.MedicalDeptId;
        var deptConsultFee = AllDoctorTypes.FirstOrDefault(x => x.Id == selectedDocTypeId)?.DeptConsultationFee ?? 0m;
        var currentDoc = await doctorService.GetDoctorByStaffId(selectedDocStaffId);
        var docConsultFee = currentDoc?.DoctorConsultationFee ?? 0m;

        CurrentConsultation.ConsultationCost = deptConsultFee + docConsultFee;
    }

    public async Task OnPaymentModeChange()
    {
        CurrentPaymentMode.PaymentModeName = PaymentModes.Where(x => x.Id == CurrentPaymentMode.Id).Select(s => s.PaymentModeName).FirstOrDefault() ?? string.Empty;
    }

    public async Task RegisterPatient()
    {
        isCreatedSuccessfully = false;

        isSaving = true;

        if (string.IsNullOrWhiteSpace(CurrentPatient.FisrtName) || string.IsNullOrWhiteSpace(CurrentPatient.PhoneNumber) || string.IsNullOrWhiteSpace(CurrentPatient.KinFullName) || string.IsNullOrWhiteSpace(CurrentPatient.KinPhoneNumber) || CurrentPatient.PatientStatusId == 0 || CurrentPatient.PatientTypeId == 0)
        {
            saveMessage = "Please fill patient details";
            isSaving = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(CurrentPatient.PatientCode))
        {
            try
            {
                saveMessage = string.Empty;
                CurrentPatient.RegisteredDate = DateTime.Now;

                var patientCode = await patientService.AddPatientAsync(CurrentPatient);

                if (!string.IsNullOrWhiteSpace(patientCode))
                {
                    var code = Convert.ToInt32(patientCode.Substring(3));
                    var savedpatient = await patientService.GetPatientByCodeAsync(patientCode);

                    await patientService.UpdatePatientCodeAsync(savedpatient.Id, code);
                    CurrentPatient.Id = savedpatient.Id;

                    saveMessage = $"{CurrentPatient.FisrtName} registered sucessfully";
                    Snackbar.Add<MudChip<string>>(new Dictionary<string, object>() {
                        { "Text", $"{saveMessage}" },
                        { "Color", Color.Success }
                    });
                    Console.WriteLine(saveMessage);
                    //isCreatedSuccessfully = true;
                    CurrentPatient.PatientCode = patientCode;
                    _step1Complete = true;
                    StateHasChanged();
                }


            }
            catch (Exception ex)
            {
                saveMessage = "Save failed: " + ex.Message;
            }
            finally
            {
                isSaving = false;
            }
        }
        else
        {
            try
            {
                saveMessage = string.Empty;
                var savedpatient = await patientService.GetPatientByCodeAsync(CurrentPatient.PatientCode);

                if (!string.IsNullOrWhiteSpace(selectedDocStaffId))
                {
                    var currentDoc = await doctorService.GetDoctorByStaffId(selectedDocStaffId);

                    CurrentPatient.DoctorPatients = new List<DoctorPatientDto>
                    {
                        new DoctorPatientDto
                        {
                            DoctorId = currentDoc.Id,
                            PatientId = savedpatient.Id,
                        }
                    };
                }

                var success = await patientService.UpdatePatientAsync(CurrentPatient, savedpatient.Id);
                if (success)
                {
                    saveMessage = $"{CurrentPatient.FisrtName} updated sucessfully";
                    Snackbar.Add<MudChip<string>>(new Dictionary<string, object>() {
                        { "Text", $"{saveMessage}" },
                        { "Color", Color.Success }
                    });
                    Console.WriteLine(saveMessage);
                    //isCreatedSuccessfully = true;

                    int addedVisitId = 0;
                    //PreliminaryTestDto? result;


                    if (CurrentVisit.Id == 0 && CurrentVisit.VisitTypeId > 0)
                    {
                        CurrentVisit.VisitDate = DateTime.Now;
                        CurrentVisit.PatientId = CurrentPatient.Id;
                        CurrentVisit.VisitStatusId = 1;
                        addedVisitId = await patientService.AddVisitAsync(CurrentVisit);
                    }

                    CurrentVisit.Id = addedVisitId;

                    if (CurrentVisit.Id > 0)
                    {
                        if (LabTestsBatch != null && LabTestsBatch.Any())
                        {
                            foreach (var test in LabTestsBatch)
                            {
                                test.VisitId = CurrentVisit.Id;
                            }

                            await SaveLabTestAsync();

                            CurrentVisit.LabTests = LabTestsBatch;
                        }

                        if (ConsultationsBatch != null && ConsultationsBatch.Any())
                        {
                            foreach (var test in ConsultationsBatch)
                            {
                                test.VisitId = CurrentVisit.Id;
                            }

                            await SaveConsultationsAsync();

                            CurrentVisit.Consultations = ConsultationsBatch;
                        }

                        if (TreatmentsBatch != null && TreatmentsBatch.Any())
                        {

                            foreach (var test in TreatmentsBatch)
                            {
                                test.VisitId = CurrentVisit.Id;
                            }

                            await SaveTreatmentsAsync();

                            CurrentVisit.Treatments = TreatmentsBatch;
                        }

                        if (PrescriptionsBatch != null && PrescriptionsBatch.Any())
                        {

                            foreach (var test in PrescriptionsBatch)
                            {
                                test.VisitId = CurrentVisit.Id;
                            }

                            await SavePrescriptionsAsync();
                            CurrentVisit.Prescriptions = PrescriptionsBatch;
                        }

                        await patientService.UpdateVisitAsync(CurrentVisit, CurrentVisit.Id);
                    }

                    // if (CurrentPreliminaryTest.Id == 0)
                    // {
                    //     result = await patientService.AddPreliminaryTestAsync(CurrentPreliminaryTest);
                    //     if (result != null)
                    //         CurrentVisit.PreliminaryTest = result;
                    // }
                    var visitUpdateResponse = await patientService.UpdateVisitAsync(CurrentVisit, addedVisitId);

                    _step2TextInput = true;
                    StateHasChanged();
                }

            }
            catch (Exception ex)
            {
                saveMessage = "Save failed: " + ex.Message;
            }
            finally
            {
                isSaving = false;
            }
        }

    }

