                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Select Type</MudSelectItem>

                                                                        @foreach (var item in FilteredMedicineTypes)
                                                                        {
                                                                            <MudSelectItem Value="@item.Id">@($"{item.MedicineTypeName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>

                                                                <MudItem md="5">
                                                                    <MudSelect For="@(() => CurrentPrescription.MedicineId)"
                                                                               @bind-Value="CurrentPrescription.MedicineId"
                                                                               @bind-Value:after="@(() =>
                                                                               {
                                                                                   CurrentPrescription.MedicineName = FilteredMedicines.FirstOrDefault(x => x.Id == CurrentPrescription.MedicineId)?.MedicineName ?? string.Empty;
                                                                                   CurrentPrescription.UnitPrice = FilteredMedicines.FirstOrDefault(x => x.Id == CurrentPrescription.MedicineId)?.BuyingPrice ?? 0m;
                                                                               })"
                                                                               Disabled="@(CurrentVisit.VisitTypeId == 0)"
                                                                               Label="Select Medicine" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Select Medicine</MudSelectItem>

                                                                        @foreach (var item in FilteredMedicines)
                                                                        {
                                                                            <MudSelectItem Value="@item.Id">@($"{item.MedicineName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>

                                                                <MudItem md="2">
                                                                    <MudNumericField For="@(() => CurrentPrescription.Quantity)" @bind-Value="CurrentPrescription.Quantity" Margin="Margin.Dense"
                                                                                     Label="Quantity" Variant="Variant.Outlined" Placeholder="Quantity"
