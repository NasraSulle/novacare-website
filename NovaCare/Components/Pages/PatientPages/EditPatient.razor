@page "/EditPatient"

@rendermode InteractiveServer

@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* <MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider /> *@

@using NovaCare.Shared.DTOs.DiseaseDTOs
@using NovaCare.Shared.DTOs.JoinDTOs
@using NovaCare.Shared.DTOs.PatientDTOs
@using NovaCare.Shared.DTOs.PaymentDTOs
@using NovaCare.Shared.DTOs.RoomDTOs
@using NovaCare.Shared.DTOs.TreatmentDTOs

<PageTitle>New Patient</PageTitle>


<MudDialog>
    <DialogContent>
        <MudGrid Class="" Spacing="1" Justify="Justify.SpaceBetween">
            <MudItem>
                <SectionTitle Icon="@icon" Title="@title" />
            </MudItem>
            <MudItem Class="pe-3">
                <MudText Typo="Typo.h6" Class="text-center pa-1" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">ID : @(string.IsNullOrWhiteSpace(CurrentPatient.PatientCode) ? "######" : $"{CurrentPatient.PatientCode}")</MudText>
            </MudItem>
        </MudGrid>
        <MudGrid Justify="Justify.Center" Spacing="1" Class="">
            <MudItem Class="pa-0" md="12">
                <EditForm Model="CurrentPatient" method="post" OnValidSubmit="RegisterPatient" FormName="newpatient">
                    <MudGrid Spacing="3" Class="pa-3" Justify="Justify.Center">
                        <MudStepper Class="w-100" NonLinear ShowResetButton OnPreviewInteraction="OnPreviewInteraction">
                            <MudStep Title="Step 1" SecondaryText="Register the patient" HasError="@(string.IsNullOrWhiteSpace(CurrentPatient.PatientCode))">
                                <MudGrid>
                                    <MudItem md="3">
                                        <MudCheckBox @bind-Value="_step1Complete" ReadOnly="true" Dense="true" Color="Color.Success">Registration Completed</MudCheckBox>
                                    </MudItem>
                                    <MudItem md="9">
                                        @if (isCreatedSuccessfully)
                                        {
                                            <MudAlert Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@saveMessage</MudAlert>
                                        }
                                    </MudItem>
                                </MudGrid>
                                <MudGrid Spacing="1" Justify="Justify.Center" Class="" Style="border:none;">
                                    <MudItem md="12" Class="">
                                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Personal Information</MudText>
                                            <MudGrid Class="pa-3" Spacing="2">
                                                <MudItem md="4">
                                                    <MudStaticTextField For="@(() => CurrentPatient.FisrtName)" @bind-Value="CurrentPatient.FisrtName" Margin="Margin.Dense"
                                                                        Label="Fisrtname" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Fisrtname"
                                                                        UserAttributes="@(new() { { "autocomplete", "fisrtName" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                                <MudItem md="4">
                                                    <MudStaticTextField For="@(() => CurrentPatient.MiddleName)" @bind-Value="CurrentPatient.MiddleName" Margin="Margin.Dense"
                                                                        Label="Middlename" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Middlename"
                                                                        UserAttributes="@(new() { { "autocomplete", "middleName" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                                <MudItem md="4">
                                                    <MudStaticTextField For="@(() => CurrentPatient.LastName)" @bind-Value="CurrentPatient.LastName" Margin="Margin.Dense"
                                                                        Label="Lastname" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Lastname"
                                                                        UserAttributes="@(new() { { "autocomplete", "lastname" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                                <MudItem md="2">
                                                    <MudNumericField @bind-Value="CurrentPatient.Age" Margin="Margin.Dense"
                                                                     Label="Age" Variant="Variant.Outlined" Placeholder="Age" />
                                                </MudItem>
                                                <MudItem md="2">
                                                    <MudSelect T="Gender"
                                                               For="@(() => CurrentPatient.Gender)"
                                                               @bind-Value="CurrentPatient.Gender"
                                                               Label="Gender" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                        @foreach (Gender item in Enum.GetValues(typeof(Gender)))
                                                        {
                                                            <MudSelectItem T="Gender" Value="@item">@item.ToString()</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem md="8">
                                                    <MudStaticTextField For="@(() => CurrentPatient.HomeAddress)" @bind-Value="CurrentPatient.HomeAddress" Margin="Margin.Dense"
                                                                        Label="Home address" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Home address"
                                                                        UserAttributes="@(new() { { "autocomplete", "employeeid" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                                <MudItem md="2">
                                                    <MudSelect For="@(() => CurrentPatient.PatientTypeId)"
                                                               @bind-Value="CurrentPatient.PatientTypeId"
                                                               Label="Patient State" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Patient Type"
                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                        <MudSelectItem Value="0" Disabled>Patient Type</MudSelectItem>

                                                        @foreach (var item in PatientTypes)
                                                        {
                                                            <MudSelectItem Value="@item.Id">@item.PatientStatusName</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem md="2">
                                                    <MudSelect For="@(() => CurrentPatient.PatientStatusId)"
                                                               @bind-Value="CurrentPatient.PatientStatusId"
                                                               Label="Patient Type" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Patient State"
                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                        <MudSelectItem Value="0" Disabled>Patient State</MudSelectItem>

                                                        @foreach (var item in PatientStatus)
                                                        {
                                                            <MudSelectItem Value="@item.Id">@item.PatientTypeName</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem md="2">
                                                    <MudStaticTextField For="@(() => CurrentPatient.PhoneNumber)" @bind-Value="CurrentPatient.PhoneNumber" Margin="Margin.Dense"
                                                                        Label="Phonenumber" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Phonenumber"
                                                                        UserAttributes="@(new() { { "autocomplete", "Phonenumber" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                                <MudItem md="6">
                                                    <MudStaticTextField For="@(() => CurrentPatient.EmailAddress)" @bind-Value="CurrentPatient.EmailAddress" Margin="Margin.Dense"
                                                                        Label="Email address" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Email address"
                                                                        UserAttributes="@(new() { { "autocomplete", "Emailaddress" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudItem>
                                    <MudItem md="12" Class="mt-3">
                                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Next of Kin</MudText>
                                            <MudGrid Class="pa-3" Spacing="2">
                                                <MudItem md="6">
                                                    <MudStaticTextField For="@(() => CurrentPatient.KinFullName)" @bind-Value="CurrentPatient.KinFullName" Margin="Margin.Dense"
                                                                        Label="Kin Fullname" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Kin Fullname"
                                                                        UserAttributes="@(new() { { "autocomplete", "kinfullname" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                                <MudItem md="2">
                                                    <MudStaticTextField For="@(() => CurrentPatient.KinPhoneNumber)" @bind-Value="CurrentPatient.KinPhoneNumber" Margin="Margin.Dense"
                                                                        Label="Kin Phonenumber" Variant="Variant.Outlined" InputType="InputType.Number" Placeholder="Kin Phonenumber"
                                                                        UserAttributes="@(new() { { "autocomplete", "kinphonenumber" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                                <MudItem md="4">
                                                    <MudStaticTextField For="@(() => CurrentPatient.KinHomeAddress)" @bind-Value="CurrentPatient.KinHomeAddress" Margin="Margin.Dense"
                                                                        Label="Kin Home address" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Kin Home address"
                                                                        UserAttributes="@(new() { { "autocomplete", "kinhomeaddress" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudItem>
                                </MudGrid>
                            </MudStep>
                            <MudStep Title="Step 2" SecondaryText="Register new visit" HasError="@(CurrentVisit.Id == 0)">
                                <MudGrid>
                                    <MudItem md="3">
                                        <MudCheckBox @bind-Value="_step2TextInput" ReadOnly="true" Dense="true" Color="Color.Success">Visit Added</MudCheckBox>
                                    </MudItem>
                                    <MudItem md="9">
                                        @if (isCreatedSuccessfully)
                                        {
                                            <MudAlert Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@saveMessage</MudAlert>
                                        }
                                    </MudItem>
                                </MudGrid>
                                <MudGrid Spacing="1" Justify="Justify.Center" Class="ps-3 pt-3 pe-0" Style="border:none;">
                                    <MudItem md="3" Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                                        <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Visit Information</MudText>
                                        <MudGrid Class="pa-3">
                                            <MudItem md="12">
                                                <MudSelect For="@(() => CurrentVisit.VisitTypeId)"
                                                           @bind-Value="CurrentVisit.VisitTypeId"
                                                           Label="Visit Type" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Select visit type"
                                                           UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                    <MudSelectItem Value="0" Disabled>Select visit type</MudSelectItem>

                                                    @foreach (var item in allVisitTypes)
                                                    {
                                                        <MudSelectItem Value="@item.Id">@item.TypeName</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem md="12">
                                                <MudSelect For="@(() => CurrentPaymentMode.Id)"
                                                           @bind-Value="CurrentPaymentMode.Id"
                                                           @bind-Value:after="OnPaymentModeChange"
                                                           Immediate="true"
                                                           Label="Patient Payment Option" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                           UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                    <MudSelectItem Value="0" Disabled>Payment Option</MudSelectItem>

                                                    @foreach (var item in PaymentModes)
                                                    {
                                                        <MudSelectItem Value="@item.Id">@item.PaymentModeName</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            @if (CurrentPaymentMode.PaymentModeName.ToLower() == "insurance")
                                            {
                                                <MudItem md="12">
                                                    <MudSelect For="@(() => CurrentInsuaranceCompany.Id)"
                                                               @bind-Value="CurrentInsuaranceCompany.Id"
                                                               Label="Insuarance Company" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                        <MudSelectItem Value="0" Disabled>Insuarance Company</MudSelectItem>

                                                        @foreach (var item in InsuaranceCompanies)
                                                        {
                                                            <MudSelectItem Value="@item.Id">@item.InsuaranceName</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                                <MudItem md="12">
                                                    <MudStaticTextField For="@(() => CurrentInsuaranceCompany.InsuranceNumber)" @bind-Value="CurrentInsuaranceCompany.InsuranceNumber" Margin="Margin.Dense"
                                                                        Label="Insurance Number" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Insurance Number"
                                                                        UserAttributes="@(new() { { "autocomplete", "fisrtName" }, { "aria-required", "true" } } )" />
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    </MudItem>
                                    @if (CurrentVisit.VisitTypeId == 2)
                                    {
                                        <MudItem md="9">
                                            <MudGrid Spacing="1" Justify="Justify.Center" Class="pa-0" Style="border:none;">
                                                <MudItem md="12" Class="ps-6 pe-0 pt-0">
                                                    <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                                                        <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Check-Ups Information</MudText>
                                                        <MudGrid Class="pa-3">
                                                            <MudGrid Spacing="1" Class="pa-3 ps-6 pe-0 pb-0">
                                                                <MudItem md="7">
                                                                    <MudSelect For="@(() => CurrentLabTest.DiseaseName)"
                                                                               @bind-Value="CurrentLabTest.DiseaseName"
                                                                               Label="Choose Disease" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Choose Disease</MudSelectItem>

                                                                        @foreach (var item in AllDiseases)
                                                                        {
                                                                            <MudSelectItem Value="@item.DiseaseName">@($"{item.DiseaseName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>
                                                                <MudItem md="3">
                                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddLabTestToBatch(CurrentLabTest))" Class="mt-2" FullWidth="true">Add To Batch</MudButton>
                                                                </MudItem>
                                                                <MudItem md="2">
                                                                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ResetTests" Class="mt-2" FullWidth="true">Reset Batch</MudButton>
                                                                </MudItem>
                                                            </MudGrid>
                                                            <MudItem md="12">
                                                                @if (!LabTestsBatch!.Any())
                                                                {
                                                                    <NoDataNotice NoDataMessage="No LabTests in Batch" />
                                                                }
                                                                else
                                                                {

                                                                    <MudTable Dense="true" FixedHeader="true" FixedFooter="true" Items="@LabTestsBatch" Height="220px" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                                                        <HeaderContent>
                                                                            <MudTh>Lab Test</MudTh>
                                                                            <MudTh>Cost</MudTh>
                                                                            <MudTh Class="text-end">
                                                                                @* <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.FolderDelete" OnClick="ResetTests" /> *@
                                                                            </MudTh>
                                                                        </HeaderContent>
                                                                        <RowTemplate>
                                                                            <MudTd DataLabel="Lab Test">@medContext.DiseaseName</MudTd>
                                                                            <MudTd DataLabel="Patient_Id">@medContext.LabTestCost</MudTd>
                                                                            <MudTd DataLabel="" Class="text-end">
                                                                                <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveLabTestFromBatch(medContext))" />
                                                                            </MudTd>
                                                                        </RowTemplate>
                                                                        <FooterContent>
                                                                            <MudTh>Total Cost</MudTh>
                                                                            <MudTh>@LabTestsBatch.Sum(x => x.LabTestCost)</MudTh>
                                                                            <MudTh></MudTh>
                                                                        </FooterContent>
                                                                    </MudTable>
                                                                }
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    }
                                    else if (CurrentVisit.VisitTypeId == 3)
                                    {
                                        <MudItem md="9">
                                            <MudGrid Spacing="1" Justify="Justify.Center" Class="pa-0" Style="border:none;">
                                                <MudItem md="12" Class="ps-6 pe-0 pt-0">
                                                    <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                                                        <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Check-Ups Information</MudText>
                                                        <MudGrid Class="pa-3">
                                                            <MudGrid Spacing="1" Class="pa-3 ps-6 pe-0 pb-0">
                                                                <MudItem md="6">
                                                                    <MudSelect For="@(() => CurrentTreatment.TreatmentTypeId)"
                                                                               @bind-Value="CurrentTreatment.TreatmentTypeId"
                                                                               @bind-Value:after="OnTreatmentTypeChosen"
                                                                               Disabled="@(CurrentVisit.VisitTypeId == 0)"
                                                                               Label="Choose Treatment" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Choose Treatment</MudSelectItem>

                                                                        @foreach (var item in AllTreatmentTypes)
                                                                        {
                                                                            <MudSelectItem Value="@item.Id">@($"{item.TreatmentTypeName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>

                                                                <MudItem md="4">
                                                                    <MudDatePicker For="@(() => CurrentTreatment.StartDate)" @bind-Date="CurrentTreatment.StartDate" Margin="Margin.Dense"
                                                                                   Label="Start On" Variant="Variant.Outlined" Placeholder="Start On"
                                                                                   UserAttributes="@(new() { { "autocomplete", "StartDate" }, { "aria-required", "true" } } )" />
                                                                </MudItem>

                                                                <MudItem md="2">
                                                                    <MudNumericField For="@(() => CurrentTreatment.TreatmentQty)" @bind-Value="CurrentTreatment.TreatmentQty" Margin="Margin.Dense"
                                                                                     Label="Quantity" Variant="Variant.Outlined" Placeholder="Quantity"
                                                                                     UserAttributes="@(new() { { "autocomplete", "TreatmentQty" }, { "aria-required", "true" } } )" />
                                                                </MudItem>

                                                                <!--HasMedicalDept-->
                                                                @if (HasMedicalDeptId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.MedicalDeptId)"
                                                                                   @bind-Value="CurrentTreatment.MedicalDeptId"
                                                                                   Disabled="@(CurrentVisit.VisitTypeId == 0)"
                                                                                   Label="Choose Department" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Department</MudSelectItem>

                                                                            @foreach (var item in AllMedicalDepts)
                                                                            {
                                                                                <!-- 2. Explicitly cast item.Id to int? so it matches the parent MudSelect type -->
                                                                                <MudSelectItem Value="@((int?)item.Id)">@($"{item.MedicalDepartmentName}")</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudItem>
                                                                }
                                                                <!--HasDoctor-->
                                                                @if (HasDoctorId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.DoctorId)"
                                                                                   @bind-Value="CurrentTreatment.DoctorId"
                                                                                   Disabled="@(CurrentVisit.VisitTypeId == 0)"
                                                                                   Label="Choose Doctor" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Doctor</MudSelectItem>

                                                                            @foreach (var item in AllDoctors)
                                                                            {
                                                                                <!-- 2. Explicitly cast item.Id to int? so it matches CurrentTreatment.DoctorId -->
                                                                                <MudSelectItem Value="@((int?)item.Id)">@($"{item.DoctorFullName}")</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudItem>
                                                                }

                                                                <!--HasSurgery-->
                                                                @if (HasSurgeryId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.SurgeryId)"
                                                                                   @bind-Value="CurrentTreatment.SurgeryId"
                                                                                   @bind-Value:after="OnSurgeryChosen"
                                                                                   Disabled="@(CurrentVisit.VisitTypeId == 0)"
                                                                                   Label="Choose Surgery" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. FIXED: Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Surgery</MudSelectItem>

                                                                            @foreach (var item in AllSurgeries)
                                                                            {
                                                                                <!-- 2. FIXED: Explicitly cast item.Id to int? so it matches SurgeryId -->
                                                                                <MudSelectItem Value="@((int?)item.Id)">@($"{item.SurgeryName}")</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudItem>
                                                                }


                                                                <!--HasTherapy-->
                                                                @if (HasTherapyId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.TherapyId)"
                                                                                   @bind-Value="CurrentTreatment.TherapyId"
                                                                                   @bind-Value:after="OnTherapyChosen"
                                                                                   Disabled="@(CurrentVisit.VisitTypeId == 0)"
                                                                                   Label="Choose Therapy" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. FIXED: Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Therapy</MudSelectItem>

                                                                            @foreach (var item in AllTherapies)
                                                                            {
                                                                                <!-- 2. FIXED: Explicitly cast item.Id to int? so it matches TherapyId -->
                                                                                <MudSelectItem Value="@((int?)item.Id)">@($"{item.TherapyName}")</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudItem>
                                                                }


                                                                <!--HasWard-->
                                                                @if (HasWardId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.WardId)"
                                                                                   @bind-Value="CurrentTreatment.WardId"
                                                                                   @bind-Value:after="OnWardChosen"
                                                                                   Disabled="@(CurrentVisit.VisitTypeId == 0)"
                                                                                   Label="Choose Ward" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. FIXED: Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Ward</MudSelectItem>

                                                                            @foreach (var item in AllWards)
                                                                            {
                                                                                <!-- 2. FIXED: Explicitly cast item.Id to int? so it matches WardId -->
                                                                                <MudSelectItem Value="@((int?)item.Id)">@($"{item.WardName}")</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudItem>
                                                                }


                                                                <!--HasRoom-->
                                                                @if (HasRoomId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.RoomId)"
                                                                                   @bind-Value="CurrentTreatment.RoomId"
                                                                                   Disabled="@(CurrentVisit.VisitTypeId == 0)"
                                                                                   Label="Choose Room" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. FIXED: Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Room</MudSelectItem>

                                                                            @foreach (var item in AllRooms)
                                                                            {
                                                                                <!-- 2. FIXED: Explicitly cast item.Id to int? so it matches RoomId -->
                                                                                <MudSelectItem Value="@((int?)item.Id)">@($"{item.RoomName}")</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudItem>
                                                                }
                                                                <MudItem md="12">
                                                                    <MudGrid Spacing="1" Justify="Justify.FlexEnd">
                                                                        <MudItem md="3">
                                                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddTreatmentToBatch" Class="mt-2" FullWidth="true">Add To Batch</MudButton>
