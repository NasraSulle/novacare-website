                                                                            <MudTd DataLabel="Quantity">@docContext.UnitPrice</MudTd>
                                                                            <MudTd DataLabel="Quantity">@docContext.Quantity</MudTd>
                                                                            <MudTd DataLabel="Quantity">@docContext.TotalPrice</MudTd>
