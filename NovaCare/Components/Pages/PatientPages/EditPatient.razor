                                                                        <HeaderContent>
                                                                            <MudTh>Name</MudTh>
                                                                            <MudTh>Cost</MudTh>
                                                                            <MudTh Class="text-end">
                                                                                @* <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.FolderDelete" OnClick="ResetTests" /> *@
