@using NovaCare.Shared.DTOs.PatientDTOs
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredPatients == null || !FilteredPatients.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex flex-column flex-sm-row justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@($"All {firstPart} Patients")</MudText>
                    @if (CurrentUser != null && CurrentUser.IsCreateNewPatient && !isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToNewPatientPage" StartIcon="@Icons.Material.Filled.PersonAdd" Style="text-transform:none;">
                            Register Patient
                        </MudButton>
                    }
                </div>
                <NoDataNotice NoDataMessage="@messagePatient" />
            </MudPaper>
        }
        else if (FilteredPatients != null)
        {
            @* Quick Summary Metric Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total @(string.IsNullOrWhiteSpace(firstPart) ? "Patients" : $"{firstPart} Patients")</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredPatients.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-error);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Emergency</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight:700;">
                                @FilteredPatients.Count(x => string.Equals(x.PatientStatusName, "Emergency", StringComparison.OrdinalIgnoreCase))
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Error" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Standard / Active</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">
                                @FilteredPatients.Count(x => !string.Equals(x.PatientStatusName, "Emergency", StringComparison.OrdinalIgnoreCase))
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Main Data Table *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Elevation="0"
                         Outlined="true"
                         RowClick="@((args) => PreviewPatientProfile(args.Item.Id, args.Item.PatientCode))"
                         RowStyle="cursor: pointer;"
                         T="PatientDto"
                         Items="@FilteredPatients"
                         ReadOnly="@_readOnly"
                         Class="rounded-lg"
                         Bordered="false"
                         Dense="false">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@($"All {firstPart} Patients".Replace("  ", " "))</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredPatients.Count} records")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search name, MRN, phone, or type..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 270px;" />

                            @if (CurrentUser != null && CurrentUser.IsCreateNewPatient && !isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="GoToNewPatientPage"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Register Patient
                                </MudButton>
                            }
                            @if (isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="GeneratePdf"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Generate Pdf
                                </MudButton>
                            }
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    @* Patient Avatar, Full Name & MRN *@
                    <TemplateColumn Title="Patient" SortBy="@(x => x.FisrtName)">
                        <CellTemplate>
                            <div class="d-flex align-center py-1">
                                <MudAvatar Size="Size.Medium" Class="me-3 border">
                                    <MudImage Src="Images/dp.png" Alt="Patient Avatar" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; line-height: 1.2;">
                                        @($"{context.Item.FisrtName} {context.Item.MiddleName} {context.Item.LastName}".Replace("  ", " ").Trim())
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 500;">
                                        MRN: @context.Item.PatientCode
                                    </MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Patient Type Pill *@
                    <TemplateColumn Title="Patient Type" SortBy="@(x => x.PatientTypeName)">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                @(string.IsNullOrWhiteSpace(context.Item.PatientTypeName) ? "General" : context.Item.PatientTypeName)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Phone Number *@
                    <TemplateColumn Title="Phone Number" SortBy="@(x => x.PhoneNumber)">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Outlined.Phone" Size="Size.Small" Color="Color.Secondary" Class="me-2" />
                                <MudText Typo="Typo.body2">@context.Item.PhoneNumber</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Status Indicator *@
                    <TemplateColumn Title="Status" SortBy="@(x => x.PatientStatusName)">
                        <CellTemplate>
                            @{
                                bool isEmergency = string.Equals(context.Item.PatientStatusName, "Emergency", StringComparison.OrdinalIgnoreCase);
                            }
                            <MudChip T="string"
                                     Variant="Variant.Outlined"
                                     Icon="@(isEmergency ? Icons.Material.Outlined.Warning : Icons.Material.Outlined.CheckCircleOutline)"
                                     Color="@(isEmergency ? Color.Error : Color.Success)"
                                     Size="Size.Small"
                                     Style="font-weight: 500;">
                                @(string.IsNullOrWhiteSpace(context.Item.PatientStatusName) ? "Active" : context.Item.PatientStatusName)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Registered Date *@
                    <PropertyColumn Property="x => x.RegisteredDate.ToShortDateString()" Title="Registered Date" />

                    @* Action Chevron *@
                    <TemplateColumn Title="" CellStyle="width: 60px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="Open Patient Record">
                                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => PreviewPatientProfile(context.Item.Id, context.Item.PatientCode))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="PatientDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@* Vitals Dialog (Kept intact as requested) *@
<MudDialog @bind-Visible="showVitalDialog" Options="_vMaxWidth" Style="background-color: rgba(246,246,246,1) !important;">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudGrid Justify="Justify.SpaceBetween">
                <MudItem md="6" Class="d-flex align-items-center">
                    <MudIcon Class="me-1" Icon="@Icons.Material.Filled.MonitorHeart" />
                    <MudText Typo="Typo.h6">Vitals</MudText>
                </MudItem>
                <MudItem md="2" Class="">
                    <MudText Typo="Typo.subtitle2" Class="text-center pa-1" Style="">MRN : @(string.IsNullOrWhiteSpace(MRNn) ? "######" : $"{MRNn}")</MudText>
                </MudItem>
            </MudGrid>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="1">
            <MudItem md="12">
                <MudText Style="background: linear-gradient(to right, #4e3ee0ff, rgba(0, 123, 255, 0));" Class="p-2 text-white">
                    Preliminary Tests
                </MudText>
            </MudItem>
            <MudItem md="12" Class="">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.subtitle2">
                        Preliminary Tests
                    </MudText>
                    <MudGrid Class="pa-3" Spacing="2">
                        <MudItem md="4">
                            <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryPressure)" @bind-Value="CurrentPreliminaryTest.PreliminaryPressure" Margin="Margin.Dense"
                                             Label="Pressure" Variant="Variant.Outlined" Placeholder="Pressure"
                                             UserAttributes="@(new() { { "autocomplete", "preliminarypressure" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="4">
                            <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryWeight)" @bind-Value="CurrentPreliminaryTest.PreliminaryWeight" Margin="Margin.Dense"
                                             Label="Weight" Variant="Variant.Outlined" Placeholder="Weight"
                                             UserAttributes="@(new() { { "autocomplete", "preliminaryweight" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="4">
                            <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryHeight)" @bind-Value="CurrentPreliminaryTest.PreliminaryHeight" Margin="Margin.Dense"
                                             Label="Height" Variant="Variant.Outlined" Placeholder="Height"
                                             UserAttributes="@(new() { { "autocomplete", "preliminaryheight" }, { "aria-required", "true" } } )" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudGrid Spacing="1" Class="pe-7" Justify="Justify.FlexEnd">
            <MudItem>
                <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Error" OnClick="@(() => showVitalDialog = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Success" OnClick="SavePreliminaryTestAsync">Save Tests</MudButton>
            </MudItem>
        </MudGrid>
    </DialogActions>
</MudDialog>

@code {
    string? searchString;
    string messageStaff = string.Empty;
    string? pdfBase64;

    bool isSearchLoading;
    private bool _readOnly = true;
    private bool _isCellEditMode;

    [Parameter] public List<PatientDto>? AllPatients { get; set; } = new();
    List<PatientDto> FilteredPatients = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public bool isReport { get; set; }
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [Parameter] public string PatientGenre { get; set; } = string.Empty;
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    private readonly DialogOptions _vMaxWidth = new() { MaxWidth = MaxWidth.Large, BackdropClick = false };

    PatientDto? CurrentPatient;
    PreliminaryTestDto CurrentPreliminaryTest = new();
    dynamic? currentDoc;

    string messagePatient = string.Empty;
    string firstPart = string.Empty;
    string? searchWord;

    bool isLoading;
    bool isEdit;
    bool showVitalDialog;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await userService.GetLoggedInUserAsync();
        if (CurrentUser != null)
        {
            currentDoc = await doctorService.GetDoctorByStaffId(CurrentUser.Id);
        }

        isLoading = true;
        StateHasChanged();

        if (!isReport)
            AllPatients = await patientService.GetAllPatientsAsync();

        ApplyFilterAndSearch();

        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<PatientDto> query = AllPatients ?? Enumerable.Empty<PatientDto>();

        if (!string.IsNullOrWhiteSpace(FilterBy))
        {
            firstPart = FilterBy;
            messagePatient = $"{firstPart} Patients are not available!";
            query = query.Where(p => string.Equals(p.PatientTypeName?.Trim(), FilterBy.Trim(), StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            firstPart = string.Empty;
            messagePatient = "Patients are not available!";
        }

        if (PatientGenre == "My Patients" && currentDoc != null)
        {
            query = query.Where(p => p.DoctorPatients?.Any(dp => dp.DoctorId == currentDoc.Id) == true);
        }
        else if (PatientGenre == "Consultation Requests" && currentDoc != null)
        {
            if (string.IsNullOrWhiteSpace(FilterBy))
            {
                query = query.Where(v => v.Visits?.Any(av => av.VisitStatusId == 1 && av.PreliminaryTestId > 0
                    && av.Consultations?.Any(avc => avc.DoctorId == currentDoc.Id && avc.IsReadyForService == true) == true) == true);
            }
            else
            {
                query = query.Where(v => v.Visits?.Any(av => av.VisitStatusId == 1 && av.PreliminaryTestId > 0
                    && av.Consultations?.Any(avc => avc.DoctorId == currentDoc.Id && avc.BillItemId != null) == true) == true);
            }
        }
        else if (PatientGenre == "Vitals Requests")
        {
            query = query.Where(v => v.Visits?.Any(av => av.VisitStatusId == 1 && av.PreliminaryTestId == null
                && (((av.Consultations?.Any(avc => avc.IsReadyForService == true)) == true)
                || ((av.Prescriptions?.Any(avc => avc.IsReadyForService == true)) == true)
                || ((av.LabTests?.Any(avc => avc.IsReadyForService == true)) == true)
                || ((av.Treatments?.Any(avc => avc.IsReadyForService == true)) == true))) == true);
        }

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x =>
                (x.FisrtName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.MiddleName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.LastName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PhoneNumber?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PatientStatusName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PatientTypeName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PatientCode?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        FilteredPatients = query.ToList();
    }

    public async Task Back()
    {
        CurrentPatient = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    public async Task GoToNewPatientPage()
    {
        await InvokeAsync(StateHasChanged);

        var Parameters = new DialogParameters
        {
            {"CurrentUser" , CurrentUser},
            { "TitleIcon", Icons.Material.Filled.AssistWalker }
        };

        var dialog = await Dialog.ShowAsync<NewPatient>("Register New Patient", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null)
        {
            await OnInitializedAsync();
        }
    }

    string MRNn = string.Empty;
    private async Task PreviewPatientProfile(int patientId, string mrn)
    {
        MRNn = mrn;

        if (PatientGenre == "Vitals Requests")
        {
            var currentVisitlId = await patientService.GetVisitIdByPatientIdAsync(patientId);
            CurrentPreliminaryTest.VisitId = currentVisitlId;

            showVitalDialog = true;
            StateHasChanged();
        }
        else if (PatientGenre == "Consultation Requests")
        {
            CurrentPatient = await patientService.GetPatientByIdAsync(patientId);

            var parameters = new DialogParameters
            {
                { "CurrentPatient", CurrentPatient },
                { "CurrentUser", CurrentUser },
                { "TitleIcon", Icons.Material.Filled.AssistWalker }
            };

            var dialog = await Dialog.ShowAsync<PatientConsultation>("Patient Consultation", parameters, _maxWidth);
            var result = await dialog.Result;
            if (result != null && !result.Canceled)
            {
                await OnInitializedAsync();
            }
        }
        else
        {
            CurrentPatient = await patientService.GetPatientByIdAsync(patientId);

            var parameters = new DialogParameters
            {
                { "CurrentPatient", CurrentPatient },
                { "CurrentUser", CurrentUser },
                { "TitleIcon", Icons.Material.Filled.AssistWalker }
            };

            var dialog = await Dialog.ShowAsync<EditPatient>("Patient Profile & New Visit", parameters, _maxWidth);
            var result = await dialog.Result;
            if (result != null && !result.Canceled)
            {
                await OnInitializedAsync();
            }
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<PatientDto>
        {
            ReportType = "Patients",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredPatients
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<PatientDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        var dialog = await Dialog.ShowAsync<PdfPreview>($"Report Pdf", Parameters, _maxWidth);
    }

    private async Task SavePreliminaryTestAsync()
    {
        if (CurrentPreliminaryTest.Id == 0)
        {
            var ptest = await patientService.AddPreliminaryTestAsync(CurrentPreliminaryTest);
            Snackbar.Add("Vitals saved successfully!", Severity.Success);
            CurrentPreliminaryTest.Id = ptest.Id;
            StateHasChanged();

            var currentVisit = await patientService.GetVisitByPCodeOrFullNameAsync(CurrentPatient?.PatientCode ?? string.Empty);
            currentVisit.PreliminaryTestId = ptest.Id;
            await patientService.UpdateVisitAsync(currentVisit, currentVisit.Id);
        }
        else
        {
            await patientService.UpdatePreliminaryTestAsync(CurrentPreliminaryTest, CurrentPreliminaryTest.Id);
            var currentVisit = await patientService.GetVisitByPCodeOrFullNameAsync(CurrentPatient?.PatientCode ?? string.Empty);
            currentVisit.PreliminaryTestId = CurrentPreliminaryTest.Id;
            await patientService.UpdateVisitAsync(currentVisit, currentVisit.Id);
            Snackbar.Add("Vitals updated successfully!", Severity.Success);
        }
    }
}
