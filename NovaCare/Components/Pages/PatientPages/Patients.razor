@using NovaCare.Shared.DTOs.PatientDTOs
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<MudGrid>
    <MudItem md="12" Class="pa-0" Style="text-align: center;">
        @if (isLoading)
        {
            <MudItem Class="pa-6">
                <GlobalLoader />
            </MudItem>
        }
        else if (!isLoading && !FilteredPatients!.Any() && string.IsNullOrWhiteSpace(searchString))
        {
            <MudItem Class="pa-6">
                <MudGrid>
                    <MudItem md="12">
                        <MudGrid Justify="Justify.SpaceBetween">
                            <MudItem>
                                <MudText Typo="Typo.h6">@($"All {firstPart} Patients")</MudText>
                            </MudItem>
                            <MudItem >
                                    @if (CurrentUser != null && CurrentUser.IsCreateNewPatient)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GoToNewPatientPage" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium">Add</MudButton>
                                    }
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem md="12">
                        <NoDataNotice NoDataMessage="@messagePatient" />
                    </MudItem>
                </MudGrid>
            </MudItem>
            
        }
        else if (FilteredPatients != null)
        {
            <MudDataGrid Loading="@isSearchLoading" role="button" Hover="true" RowClick="@((args) => PreviewPatientProfile(args.Item.Id, args.Item.PatientCode))" T="PatientDto" Items="@FilteredPatients" ReadOnly="@_readOnly" Class="ps-6 pe-6 pb-6"
                         Bordered="false" Dense="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@($"All {firstPart} Patients")</MudText>
                    <MudSpacer />
                    <MudItem>
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                                      Margin="Margin.Dense" Variant="Variant.Outlined"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="me-1"></MudTextField>
                    </MudItem>
                    @if (CurrentUser != null && CurrentUser.IsCreateNewPatient && !isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GoToNewPatientPage" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium">Add</MudButton>
                    }
                    @if (isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="GeneratePdf" StartIcon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Medium">Generate Pdf</MudButton>
                    }
                </ToolBarContent>

                <Columns>
                    <TemplateColumn Title="Full Name">
                        <CellTemplate>
                            <MudItem Style="display: flex; align-items: center;">
                                <MudAvatar Size="Size.Small">
                                    <MudImage Src="Images/dp.png"></MudImage>
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Class="ps-1">
                                    @($"{context.Item.FisrtName} {context.Item.MiddleName} {context.Item.LastName}".Trim())
                                </MudText>
                            </MudItem>
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.PatientTypeName" Title="Patient Type" />
                    <PropertyColumn Property="x => x.PatientCode" Title="Patient Number" />
                    <PropertyColumn Property="x => x.PhoneNumber" Title="Phone Number" />
                    <TemplateColumn Title="Status">
                        <CellTemplate>
                            @* <MudItem Style="text-align: center;"> *@
                            <MudChip T="string" Variant="Variant.Text" Icon="@(context.Item.PatientStatusName != "Emergency" ? Icons.Material.Outlined.DoDisturbOn : Icons.Material.Outlined.Warning)" Color="@(context.Item.PatientStatusName != "Emergency" ? Color.Warning : Color.Error)" Size="Size.Small">
                                    @(context.Item.PatientStatusName)
                                </MudChip >
                            @* </MudItem> *@
                        </CellTemplate>
                    </TemplateColumn>
                    <PropertyColumn Property="x => x.RegisteredDate.ToShortDateString()" Title="Registered Date" />
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="PatientDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>


<MudDialog @bind-Visible="showVitalDialog" Options="_vMaxWidth" Style="background-color: rgba(246,246,246,1) !important;">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudGrid Justify="Justify.SpaceBetween">
                <MudItem md="6" Class="d-flex align-items-center">
                    <MudIcon Class="me-1" Icon="@Icons.Material.Filled.MonitorHeart" />

                    <MudText Typo="Typo.h6">Vitals</MudText>
                </MudItem>
                <MudItem md="2" Class="">
                    <MudText Typo="Typo.subtitle2" Class="text-center pa-1" Style="">MRN : @(string.IsNullOrWhiteSpace(MRNn) ? "######" : $"{MRNn}")</MudText>
                </MudItem>
            </MudGrid>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="1">
            <MudItem md="12">
                <MudText Style="background: linear-gradient(to right, #4e3ee0ff, rgba(0, 123, 255, 0));" Class="p-2 text-white">

                    Preliminary Tests
                </MudText>
            </MudItem>
            <MudItem md="12" Class="">
                <MudPaper Class="pa-3" Outlined="true">
                    <MudText Typo="Typo.subtitle2">
                        Preliminary Tests
                    </MudText>
                    <MudGrid Class="pa-3" Spacing="2">
                        <MudItem md="4">
                            <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryPressure)" @bind-Value="CurrentPreliminaryTest.PreliminaryPressure" Margin="Margin.Dense"
                                             Label="Pressure" Variant="Variant.Outlined" Placeholder="Pressure"
                                             UserAttributes="@(new() { { "autocomplete", "preliminarypressure" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="4">
                            <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryWeight)" @bind-Value="CurrentPreliminaryTest.PreliminaryWeight" Margin="Margin.Dense"
                                             Label="Weight" Variant="Variant.Outlined" Placeholder="Weight"
                                             UserAttributes="@(new() { { "autocomplete", "preliminaryweight" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="4">
                            <MudNumericField For="@(() => CurrentPreliminaryTest.PreliminaryHeight)" @bind-Value="CurrentPreliminaryTest.PreliminaryHeight" Margin="Margin.Dense"
                                             Label="Height" Variant="Variant.Outlined" Placeholder="Height"
                                             UserAttributes="@(new() { { "autocomplete", "preliminaryheight" }, { "aria-required", "true" } } )" />
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudGrid Spacing="1" Class="pe-7" Justify="Justify.FlexEnd">
            <MudItem>
                <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Error" OnClick="@(() => showVitalDialog = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Success" OnClick="SavePreliminaryTestAsync">Save Tests</MudButton>
            </MudItem>
        </MudGrid>
    </DialogActions>
</MudDialog>

@code {
    string? searchString;
    string messageStaff = string.Empty;
    string? pdfBase64;

    bool isSearchLoading;
    private bool _readOnly;
    private bool _isCellEditMode;



    //=====================HERE===============================

    [Parameter] public List<PatientDto>? AllPatients { get; set; } = new();
    List<PatientDto> FilteredPatients = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public bool isReport { get; set; }
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [Parameter] public string PatientGenre { get; set; } = string.Empty;
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    private readonly DialogOptions _vMaxWidth = new() { MaxWidth = MaxWidth.Large, BackdropClick = false };

    PatientDto? CurrentPatient;
    PreliminaryTestDto CurrentPreliminaryTest = new();

    string messagePatient = string.Empty;
    string firstPart = string.Empty;
    string? searchWord;

    bool isLoading;
    bool isEdit;
    bool showVitalDialog;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await userService.GetLoggedInUserAsync();
        var currentDoc = await doctorService.GetDoctorByStaffId(CurrentUser.Id);

        isLoading = true;
        StateHasChanged();

        // await Task.Delay(500);

        if (!isReport)
            AllPatients = await patientService.GetAllPatientsAsync();

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            if (PatientGenre == "My Patients")
            {
                FilteredPatients = AllPatients?.Where(p => p.DoctorPatients?.Any(dp => dp.DoctorId == currentDoc.Id) == true).ToList() ?? new();
            }
            else if (PatientGenre == "Consultation Requests")
            {
                FilteredPatients = AllPatients?.Where(v => v.Visits?.Any(av => av.VisitStatusId == 1 && av.PreliminaryTestId > 0 
                    && av.Consultations?.Any(avc => avc.DoctorId == currentDoc.Id && avc.IsReadyForService == true) == true) == true).ToList() ?? new();
            }
            else if (PatientGenre == "Vitals Requests")
            {
                FilteredPatients = AllPatients?.Where(v => v.Visits?.Any(av => av.VisitStatusId == 1 && av.PreliminaryTestId == null 
                    && (((av.Consultations?.Any(avc => avc.IsReadyForService == true)) == true)
                    || ((av.Prescriptions?.Any(avc => avc.IsReadyForService == true)) == true)
                    || ((av.LabTests?.Any(avc => avc.IsReadyForService == true)) == true)
                    || ((av.Treatments?.Any(avc => avc.IsReadyForService == true)) == true))) == true).ToList() ?? new();

            }
            else
            {
                FilteredPatients = AllPatients ?? new();
            }
            messagePatient = "Patients are not avalible!";
        }
        else
        {

            firstPart = FilterBy;
            messagePatient = $"{firstPart} Patients are not avalible!";


            if (PatientGenre == "My Patients")
            {
                FilteredPatients = AllPatients?.Where(p => p.PatientTypeName == FilterBy && p.DoctorPatients?.Any(dp => dp.DoctorId == currentDoc.Id) == true).ToList() ?? new();
            }
            else if (PatientGenre == "Consultation Requests")
            {
                FilteredPatients = AllPatients?.Where(v => v.PatientTypeName == FilterBy && v.Visits?.Any(av => av.VisitStatusId == 1 && av.PreliminaryTestId > 0 && av.Consultations?.Any(avc => avc.DoctorId == currentDoc.Id && avc.BillItemId != null) == true) == true).ToList() ?? new();
            }
            else if (PatientGenre == "Vitals Requests")
            {
                FilteredPatients = AllPatients?.Where(v => v.PatientTypeName == FilterBy && v.Visits?.Any(av => av.VisitStatusId == 1 && av.PreliminaryTestId == null
                    && (((av.Consultations?.Any(avc => avc.IsReadyForService == true)) == true)
                    || ((av.Prescriptions?.Any(avc => avc.IsReadyForService == true)) == true)
                    || ((av.LabTests?.Any(avc => avc.IsReadyForService == true)) == true)
                    || ((av.Treatments?.Any(avc => avc.IsReadyForService == true)) == true))) == true).ToList() ?? new();
            }
            else
            {
                FilteredPatients = AllPatients ?? new();
            }
        }
        isLoading = false;
        StateHasChanged();
    }

    public async Task Back()
    {
        CurrentPatient = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        // await Task.Delay(500);

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            FilteredPatients = AllPatients?.Where(x => x.FisrtName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.MiddleName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.LastName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PhoneNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PatientStatusName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PatientTypeName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PatientCode.Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
            messageStaff = "Staffs are not avalible!";
            firstPart = "Staff";
        }
        else
        {

            firstPart = FilterBy.Substring(2);
            messageStaff = $"{firstPart}s are not avalible!";

            if (FilterBy != null)
            {
                FilteredPatients = AllPatients?.Where(x => x.PatientTypeName == FilterBy && x.FisrtName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.MiddleName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.LastName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PhoneNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PatientStatusName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PatientTypeName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PatientCode.Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
            }
            else
            {
                FilteredPatients = new();
            }
        }
        isSearchLoading = false;
    }

    public async Task GoToNewPatientPage()
    {
        await InvokeAsync(StateHasChanged);

        var Parameters = new DialogParameters
        {
            {"CurrentUser" , CurrentUser},
            { "TitleIcon", Icons.Material.Filled.AssistWalker }
        };

        var dialog = await Dialog.ShowAsync<NewPatient>("Register New Patient", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null)
        {
            await OnInitializedAsync();
        }
    }

    string MRNn = string.Empty;
    private async Task PreviewPatientProfile(int patientId, string mrn)
    {
        // CurrentPatient = await patientService.GetPatientByIdAsync(patientId);
        MRNn = mrn;

        if (PatientGenre == "Vitals Requests")
        {
            var currentVisitlId = await patientService.GetVisitIdByPatientIdAsync(patientId);
            CurrentPreliminaryTest.VisitId = currentVisitlId;

            showVitalDialog = true;
            StateHasChanged();
        }
        else if (PatientGenre == "Consultation Requests")
        {

            CurrentPatient = await patientService.GetPatientByIdAsync(patientId);

            var parameters = new DialogParameters
            {
                { "CurrentPatient", CurrentPatient },
                { "CurrentUser", CurrentUser },
                { "TitleIcon", Icons.Material.Filled.AssistWalker }
            };

            var dialog = await Dialog.ShowAsync<PatientConsultation>("Patient Consultation", parameters, _maxWidth);
            var result = await dialog.Result;
            if (result != null && !result.Canceled)
            {
                await OnInitializedAsync();
            }
        }
        else
        {
            CurrentPatient = await patientService.GetPatientByIdAsync(patientId);

            var parameters = new DialogParameters
            {
                { "CurrentPatient", CurrentPatient },
                { "CurrentUser", CurrentUser },
                { "TitleIcon", Icons.Material.Filled.AssistWalker }
            };

            var dialog = await Dialog.ShowAsync<EditPatient>("Patient Profile & New Visit", parameters, _maxWidth);
            var result = await dialog.Result;
            if (result != null && !result.Canceled)
            {
                await OnInitializedAsync();
            }
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<PatientDto>
        {
            ReportType = "Patients",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredPatients
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<PatientDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        await Dialog.ShowAsync<PdfPreview>($"Report Pdf", Parameters, _maxWidth);
    }

    private async Task SavePreliminaryTestAsync()
    {
        if (CurrentPreliminaryTest.Id == 0)
        {
            var ptest =await patientService.AddPreliminaryTestAsync(CurrentPreliminaryTest);
            Snackbar.Add("Vitals saved successfully!", Severity.Success);
            CurrentPreliminaryTest.Id = ptest.Id;
            StateHasChanged();

            var currentVisit = await patientService.GetVisitByPCodeOrFullNameAsync(CurrentPatient?.PatientCode ?? string.Empty);
            currentVisit.PreliminaryTestId = ptest.Id;
            await patientService.UpdateVisitAsync(currentVisit, currentVisit.Id);
        }
        else
        {

            await patientService.UpdatePreliminaryTestAsync(CurrentPreliminaryTest, CurrentPreliminaryTest.Id);
            var currentVisit = await patientService.GetVisitByPCodeOrFullNameAsync(CurrentPatient?.PatientCode ?? string.Empty);
            currentVisit.PreliminaryTestId = CurrentPreliminaryTest.Id;
            await patientService.UpdateVisitAsync(currentVisit, currentVisit.Id);
            Snackbar.Add("Vitals updated successfully!", Severity.Success);
        }
    }
}