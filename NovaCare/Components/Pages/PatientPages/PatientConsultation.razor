    public async Task SyncConsultation()
    {
        isCreatedSuccessfully = false;

        isSaving = true;

        if (string.IsNullOrWhiteSpace(CurrentConsultation.Diagnosis))
        {
            saveMessage = "Please fill patient Diagnosis";
            isSaving = false;
            return;
        }

        try
        {
            if (CurrentVisit.Id > 0)
            {
                if (LabTestsBatch != null && LabTestsBatch.Any())
                {
                    foreach (var test in LabTestsBatch)
                    {
                        test.VisitId = CurrentVisit.Id;
                    }

                    await SaveLabTestAsync();

                    CurrentVisit.LabTests = LabTestsBatch;
                }

                if (!string.IsNullOrWhiteSpace(CurrentConsultation.Diagnosis))
                {
                    await SaveConsultationsAsync();
                }

                if (TreatmentsBatch != null && TreatmentsBatch.Any())
                {

                    foreach (var test in TreatmentsBatch)
                    {
                        test.VisitId = CurrentVisit.Id;
                    }

                    await SaveTreatmentsAsync();

                    CurrentVisit.Treatments = TreatmentsBatch;
                }

                if (PrescriptionsBatch != null && PrescriptionsBatch.Any())
                {

                    foreach (var test in PrescriptionsBatch)
                    {
                        test.VisitId = CurrentVisit.Id;
                    }

                    await SavePrescriptionsAsync();
                    CurrentVisit.Prescriptions = PrescriptionsBatch;
                }

                await patientService.UpdateVisitAsync(CurrentVisit, CurrentVisit.Id);

                // Automatically generate Interim Bill & calculate Insurance vs. Patient split
                await AutoGenerateVisitBillAsync(CurrentVisit.Id);

            }
            var visitUpdateResponse = await patientService.UpdateVisitAsync(CurrentVisit, CurrentVisit.Id);

            StateHasChanged();

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }

    }

    private async Task AutoGenerateVisitBillAsync(int visitId)
    {
        var savedVisit = await patientService.GetVisitByPCodeOrFullNameAsync(CurrentPatient.PatientCode);
        if (savedVisit == null)
            return;

        foreach (var l in savedVisit.LabTests.Where(x => x.BillItemId == null))
        {
            var billItemId = await paymentService.AppendServiceToVisitBillAsync(visitId, new BillItemDto
            {
                ItemName = $"Lab Test: {l.DiseaseName}",
                SourceType = "LabTest",
                SourceItemId = l.Id,
                Quantity = 1,
                UnitPrice = l.LabTestCost
            }, CurrentUser.Id);

            if (billItemId > 0)
            {
                l.BillItemId = billItemId;
                await labTestService.UpdateLabTestAsync(l, l.Id);
            }
        }

        foreach (var t in savedVisit.Treatments.Where(x => x.BillItemId == null))
        {
            var desc = !string.IsNullOrWhiteSpace(t.SurgeryName) ? t.SurgeryName
                     : !string.IsNullOrWhiteSpace(t.TherapyName) ? t.TherapyName
                     : !string.IsNullOrWhiteSpace(t.WardName) ? t.WardName
                     : t.TreatmentTypeName;

            var billItemId = await paymentService.AppendServiceToVisitBillAsync(visitId, new BillItemDto
            {
                ItemName = $"{t.TreatmentTypeName}: {desc}".Trim(),
                SourceType = "Treatment",
                SourceItemId = t.Id,
                Quantity = t.TreatmentQty > 0 ? t.TreatmentQty : 1,
                UnitPrice = t.TreatmentCost
            }, CurrentUser.Id);

            if (billItemId > 0)
            {
                t.BillItemId = billItemId;
                await medicineService.UpdateTreatmentAsync(t, t.Id);
            }
        }

        foreach (var p in savedVisit.Prescriptions.Where(x => x.BillItemId == null))
        {
            var billItemId = await paymentService.AppendServiceToVisitBillAsync(visitId, new BillItemDto
            {
                ItemName = $"{p.MedicineName} ({p.Quantity})",
                SourceType = "Prescription",
                SourceItemId = p.Id,
                Quantity = p.Quantity > 0 ? p.Quantity : 1,
                UnitPrice = p.UnitPrice
            }, CurrentUser.Id);

            if (billItemId > 0)
            {
                p.BillItemId = billItemId;
                await medicineService.UpdatePrescriptionAsync(p, p.Id);
            }
        }

        // Clear local batches & refresh visit so the dialog stays open without duplicate re-saves
        // LabTestsBatch?.Clear();
        // TreatmentsBatch?.Clear();
        // PrescriptionsBatch?.Clear();
        CurrentVisit = await patientService.GetVisitByPCodeOrFullNameAsync(CurrentPatient.PatientCode) ?? CurrentVisit;

        CurrentVisit = await patientService.GetVisitByPCodeOrFullNameAsync(CurrentPatient.PatientCode) ?? CurrentVisit;

        foreach (var l in LabTestsBatch ?? Enumerable.Empty<LabTestDto>())
            l.BillItemId = CurrentVisit.LabTests.FirstOrDefault(db => db.Id == l.Id)?.BillItemId ?? l.BillItemId;

        foreach (var t in TreatmentsBatch ?? Enumerable.Empty<TreatmentDto>())
            t.BillItemId = CurrentVisit.Treatments.FirstOrDefault(db => db.Id == t.Id)?.BillItemId ?? t.BillItemId;

        foreach (var p in PrescriptionsBatch ?? Enumerable.Empty<PrescriptionDto>())
            p.BillItemId = CurrentVisit.Prescriptions.FirstOrDefault(db => db.Id == p.Id)?.BillItemId ?? p.BillItemId;

        Snackbar.Add("Consultation saved and bill updated!", Severity.Success);
    }

