@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!; 
    private void Cancel() => MudDialog.Cancel();
    private ReferralLetterPrint? _referralPrintRef;

    [Parameter] public string? TitleIcon { get; set; }
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [Parameter] public PatientDto CurrentPatient { get; set; } = new();
    [Parameter] public VisitDto CurrentVisit { get; set; } = new();
    [Parameter] public ConsultationDto CurrentConsultation { get; set; } = new();
    [Parameter] public LabTestDto CurrentLabTest { get; set; } = new();
    [Parameter] public PrescriptionDto CurrentPrescription { get; set; } = new();
    [Parameter] public TreatmentDto CurrentTreatment { get; set; } = new();
    AllergyDto CurrentAllergy = new();
    ReferralDto CurrentReferral = new();

    List<DiseaseDto> AllDiseases = new();
    List<LabTestDto>? LabTestsBatch = new();
    List<MedicineGenreDto>? AllMedicineGenres = new();
    List<MedicineTypeDto>? AllMedicineTypes = new();
    List<MedicineDto>? AllMedicines = new();
    List<MedicineTypeDto>? FilteredMedicineTypes = new();
    List<MedicineDto>? FilteredMedicines = new();
    List<PrescriptionDto>? PrescriptionsBatch = new();
    List<TreatmentTypeDto>? AllTreatmentTypes = new();
    List<TreatmentDto>? TreatmentsBatch = new();
    List<MedicalDepartmentDto>? AllMedicalDepts = new();
    List<DoctorDto> AllDoctors = new();
    List<SurgeryDto>? AllSurgeries = new();
    List<TherapyDto>? AllTherapies = new();
    List<WardDto>? AllWards = new();
    List<RoomDto>? AllRooms = new();
    List<PatientStatusDto> PatientTypes = new();
    List<PatientTypeDto> PatientStatus = new();

    List<PrescriptionDto> PreviousPrescription = new();
    List<LabTestDto> PreviousLabTests = new();
    List<TreatmentDto> PreviousTreatments = new();
    List<DoctorDto> OtherDoctor = new();
    List<AllergyDto> AllAllergies = new();

    private readonly DialogOptions _maxWidthAddAllergyBox = new() { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };
    private readonly DialogOptions _maxWidthAddReferralBox = new() { MaxWidth = MaxWidth.Large, Position = DialogPosition.BottomCenter, FullWidth = true, BackdropClick = false };

    int selectedMedGenreId = 0;
    int selectedMedTypeId = 0;

    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";
    string saveMessage = string.Empty;

    bool isCreatedSuccessfully;
    bool isSaving;
    bool showAddAllergyDialog;
    bool showConditionDialog;
    bool showTransferDialog;

    bool HasMedicineId;
    bool HasSurgeryId;
    bool HasTherapyId;
    bool HasMedicalDeptId;
    bool HasWardId;
    bool HasDoctorId;
    bool HasRoomId;

    protected override async Task OnInitializedAsync()
    {
        PatientTypes = await patientService.GetAllPatientTypesAsync();
        PatientStatus = await patientService.GetAllPatientStatusesAsync();
        AllDiseases = await diseaseService.GetAllDiseasesAsync();
        AllMedicineGenres = await medicineService.GetAllMedicineGenresAsync();
        AllMedicineTypes = await medicineService.GetAllMedicineTypesAsync();
        AllMedicines = await medicineService.GetAllMedicinesAsync();
        AllTreatmentTypes = await medicineService.GetAllTreatmentTypeAsync();
        AllMedicalDepts = await medicineService.GetAllMedicalDeptsAsync();
        AllDoctors = await doctorService.GetAllDoctorsAsync();
        AllSurgeries = await medicineService.GetAllSurgeriesAsync();
        AllTherapies = await medicineService.GetAllTherapiesAsync();
        AllMedicalDepts = await medicineService.GetAllMedicalDeptsAsync();
        AllWards = await roomService.GetAllWardsAsync();
        AllRooms = await roomService.GetAllRoomsAsync();


        PreviousPrescription = await patientService.GetPreviousPrescriptionsAsync(CurrentPatient.Id);
        PreviousLabTests = await patientService.GetPreviousLabTestsAsync(CurrentPatient.Id);
        PreviousTreatments = await patientService.GetPreviousTreatmentsAsync(CurrentPatient.Id);
        AllAllergies = await patientService.GetAllergiesAsync(CurrentPatient.Id);

        OtherDoctor = AllDoctors.Where(d => d.DoctorPatients != null && d.DoctorPatients.Any(dp => dp.PatientId == CurrentPatient.Id)).ToList();

        //var docId = CurrentConsultation = CurrentPatient.Visits!.Where(v => v.VisitStatusId == 1).SelectMany(v => v.Consultations).FirstOrDefault(c => c.Doctor
        CurrentConsultation = CurrentPatient.Visits!
            .Where(v => v.VisitStatusId == 1)
            .SelectMany(v => v.Consultations)
            .FirstOrDefault(c => c.DoctorStaffId == CurrentUser.Id) ?? new();
    }

    public async Task AddLabTestToBatch(LabTestDto labTestDto)
    {
        var disease = await diseaseService.GetDiseaseByNameAsync(labTestDto.DiseaseName);
        var newLabTest = new LabTestDto
        {
            DiseaseName = labTestDto.DiseaseName,
            LabTestStatusName = "New",
            TestResult = labTestDto.TestResult,
            ResultAttachment = labTestDto.ResultAttachment,
            ConsultationId = CurrentConsultation.Id,
            RequesteeId = CurrentUser.Id,
            LabTestCost = disease?.LabTestCost ?? 0m,
            CreatedDate = DateTime.UtcNow,
            RequesteeDoctor = $"{CurrentUser.FisrtName} {CurrentUser.MiddleName} {CurrentUser.LastName}".Replace("  ", " ").Trim(),
            PatientFullName = $"{CurrentPatient.FisrtName} {CurrentPatient.MiddleName} {CurrentPatient.LastName}".Replace("  ", " ").Trim(),
            PatientId = CurrentPatient.Id
        };

        if (!string.IsNullOrWhiteSpace(newLabTest.DiseaseName))
            LabTestsBatch!.Add(newLabTest);

        await InvokeAsync(StateHasChanged);
    }


    public async Task RemoveLabTestFromBatch(LabTestDto labTestDto)
    {
        if (LabTestsBatch != null)
            LabTestsBatch.Remove(labTestDto);
    }

    public async Task SaveLabTestAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (LabTestsBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var labTest in LabTestsBatch)
            {
                if (labTest.Id > 0)
                {
                    var isSucess = await labTestService.UpdateLabTestAsync(labTest, labTest.Id);

                    if (isSucess)
                    {
                        saveMessage = $"{labTest.DiseaseName} for {labTest.PatientId} updated sucessfully";
                        Console.WriteLine(saveMessage);
                    }
                    else
                    {
                        saveMessage = $"Error: {labTest.DiseaseName} for {labTest.PatientId} not updated sucessfully!";
                        Console.WriteLine(saveMessage);
                    }
                }
                else
                {

                    var isSucess = await labTestService.AddLabTestAsync(labTest);

                    if (isSucess)
                    {
                        saveMessage = $"{labTest.DiseaseName} for {labTest.PatientId} added sucessfully";
                        Console.WriteLine(saveMessage);
                    }
                    else
                    {
                        saveMessage = $"Error: {labTest.DiseaseName} for {labTest.PatientId} not added sucessfully! Please read labTest to batch and save";
                        Console.WriteLine(saveMessage);
                    }
                }
            }

            var refreshedVisit = await patientService.GetVisitByPCodeOrFullNameAsync(CurrentPatient.PatientCode);
            if (refreshedVisit != null)
            {
                foreach (var item in LabTestsBatch.Where(x => x.Id == 0))
                {
                    var match = refreshedVisit.LabTests
                        .LastOrDefault(db => db.DiseaseName == item.DiseaseName && db.BillItemId == null);
                    if (match != null)
                    {
                        item.Id = match.Id;
                    }
                }
            }

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task ResetTests()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        LabTestsBatch?.Clear();

    }


    public async Task OnMedicineGenreChange()
    {
        FilteredMedicineTypes = AllMedicineTypes;
    }

    public async Task OnMedicineTypeChange()
    {
        FilteredMedicines = AllMedicines?.Where(gen => gen.MedicineGenreId == selectedMedGenreId && gen.MedicineTypeId == selectedMedTypeId && gen.MedicineStatusName.ToLower().Trim() == "instock").ToList();
    }

    public async Task AddPrescriptionToBatch()
    {
        var prescMededQty = await medicineService.GetMedicineByIdAsync(CurrentPrescription.MedicineId);
        if (prescMededQty.MedicineQty < CurrentPrescription.Quantity)
        {
            saveMessage = prescMededQty.MedicineQty > 0
                ? $"Only {prescMededQty.MedicineQty} of {prescMededQty.MedicineName} is in stock"
                : $"{prescMededQty.MedicineName} is out of stock";

            Snackbar.Add(saveMessage, Severity.Error);
            return;
        }

        var newPrescription = new PrescriptionDto
        {
            PrescribedDate = DateTime.UtcNow,
            Quantity = CurrentPrescription.Quantity,
            Dosage = CurrentPrescription.Dosage,
            Notes = CurrentPrescription.Notes,
            UnitPrice = CurrentPrescription.UnitPrice,
            VisitId = CurrentVisit.Id,
            ConsultationId = CurrentConsultation.Id > 0 ? CurrentConsultation.Id : null,
            MedicineId = CurrentPrescription.MedicineId,
            DoctorId = CurrentConsultation.DoctorId,
            MedicineName = CurrentPrescription.MedicineName,
            DoctorFullName = $"{CurrentUser.FisrtName} {CurrentUser.MiddleName} {CurrentUser.LastName}".Replace("  ", " ").Trim()
        };

        if (!string.IsNullOrWhiteSpace(newPrescription.MedicineName))
            PrescriptionsBatch!.Add(newPrescription);

        await InvokeAsync(StateHasChanged);
    }


    public async Task RemovePrescriptionFromBatch(PrescriptionDto prescriptionDto)
    {
        if (PrescriptionsBatch != null)
            PrescriptionsBatch.Remove(prescriptionDto);
    }

    public async Task ResetPrescriptions()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        PrescriptionsBatch?.Clear();

    }

    public async Task SavePrescriptionsAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (PrescriptionsBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var prescription in PrescriptionsBatch)
            {
