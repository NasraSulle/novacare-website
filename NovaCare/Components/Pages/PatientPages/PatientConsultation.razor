    private async Task ConfirmAsync(string word)
    {
        string message = string.Empty;
        if(word == "condition")
            showConditionDialog = true;

        if (word == "transfer")
            showTransferDialog = true;

        if (word == "closure")
        { 
            var parameters = new DialogParameters<ConfirmationModal>
            {
                { x => x.ContentText, "Are you sure you want to complete this consultation, process is irrevokable?" },
                { x => x.ButtonText, "Yes" },
                { x => x.Color, Color.Success }
            };

            var dialog = await DialogService.ShowAsync<ConfirmationModal>("Confirm", parameters);
            var result = await dialog.Result;

            if (!result.Canceled)
            {
                // await patientService.UpdatePatientAsync(CurrentPatient, CurrentPatient.Id);
                CurrentConsultation.FinishDate = DateTime.UtcNow;
                await patientService.UpdateConsultationAsync(CurrentConsultation, CurrentConsultation.Id);
            }
        }
    }

