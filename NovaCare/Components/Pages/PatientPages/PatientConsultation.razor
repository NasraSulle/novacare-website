@using NovaCare.Shared.DTOs.DiseaseDTOs
@using NovaCare.Shared.DTOs.RoomDTOs
@using NovaCare.Shared.DTOs.TreatmentDTOs

@inject ISnackbar Snackbar
@inject IDialogService DialogService



<MudDialog Style="background-color: rgba(246,246,246,1) !important;">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            @if (!string.IsNullOrEmpty(TitleIcon))
            {
                <MudIcon Icon="@TitleIcon" />
            }
            <MudText Typo="Typo.h6">@MudDialog.Title</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudGrid Class="pa-3 pt-6" Justify="Justify.Center">
            <MudItem md="10" Class="ps-0 pt-0">
                <MudPaper Elevation="0" Class="border-1 border-opacity-10 border-secondary-subtle">
                    <MudGrid Class="pa-3">
                        <MudItem md="12">
                            <MudText>
                                <MudText Inline="true">
                                    <MudText Typo="Typo.h5">@($"{CurrentPatient.PatientFullName}")</MudText>
                                    <MudText Typo="Typo.caption">MRN: @CurrentPatient.PatientCode</MudText>
                                </MudText>
                                <MudText Inline="false">
                                    <MudText Typo="Typo.caption">@CurrentPatient.Age YRS - @CurrentPatient.Gender - @CurrentPatient.PhoneNumber</MudText>
                                </MudText>
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem md="2" Class="ps-0 pt-0">
                <MudPaper Elevation="0" Class="border-1 border-opacity-10 border-secondary-subtle">
                    <MudGrid Class="pa-1 ps-2">
                        <MudItem md="12" Class="d-flex flex-column">
                            <MudText Typo="Typo.subtitle1">Vitals</MudText>
                            <MudText Typo="Typo.caption">Weight: <MudText Typo="Typo.subtitle2" Inline="true">@(CurrentVisit.PreliminaryTest?.PreliminaryWeight ?? 0)</MudText></MudText>
                            <MudText Typo="Typo.caption">Height: <MudText Typo="Typo.subtitle2" Inline="true">@(CurrentVisit.PreliminaryTest?.PreliminaryHeight ?? 0)</MudText></MudText>
                            <MudText Typo="Typo.caption">Blood Pressure: <MudText Typo="Typo.subtitle2" Inline="true">@(CurrentVisit.PreliminaryTest?.PreliminaryPressure ?? 0)</MudText></MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem md="12" Class="d-flex ps-0 pt-0">
                    <MudText Typo="Typo.subtitle2" Align="Align.Center"><MudIcon Icon="@Icons.Material.Outlined.AssistWalker" /> Patient Condition -
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Error">@CurrentPatient.PatientTypeName | @CurrentPatient.PatientStatusName</MudChip>
                    </MudText>
                    <MudSpacer />
                <MudPaper Elevation="0" Class="align-content-center bg-transparent">
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => ConfirmAsync("condition"))" Size="Size.Small">Update Patient Condition</MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => ConfirmAsync("transfer"))" Size="Size.Small">Issue Transfer</MudButton>
                    <MudDialog @bind-Visible="showTransferDialog" Options="_maxWidthAddReferralBox">
                        <DialogContent>
                            <MudGrid Spacing="1" Class="pa-0">
                                <MudGrid Spacing="5" Justify="Justify.Center" Class="pa-0" Style="border:none;">
                                    <MudItem md="12">
                                        <MudPaper Elevation="0" Class="border-1 border-opacity-10 border-secondary-subtle">
                                            <MudGrid Class="pa-3">
                                                <MudItem md="12">
                                                    <MudText Typo="Typo.subtitle2"
                                                             Style="background: linear-gradient(to right, var(--bs-danger), rgba(var(--bs-danger-rgb), 0));" Class="p-2 text-white">

                                                        + Transfer Referral Letter
                                                    </MudText>
                                                </MudItem>
                                                <MudItem md="12">
                                                    <MudGrid>
                                                        <MudItem md="8">
                                                            <ReferralLetterPrint  @ref="_referralPrintRef"
                                                                                 Patient="@CurrentPatient"
                                                                                 SpecialistClinicName="@CurrentReferral.ReferredHospital"
                                                                                 Diagnosis="@CurrentReferral.DoctorsNote"
                                                                                 ReasonForReferral="@CurrentReferral.DoctorsNote"
                                                                                 DoctorName="@CurrentReferral.DoctorFullName" />

                                                        </MudItem>
                                                        <MudItem md="4">
                                                            <MudGrid>
                                                                <MudItem md="12">
                                                                    <MudTextField @bind-Value="CurrentReferral.ReferredHospital" Margin="Margin.Dense" Immediate="true"
                                                                                  Label="Referred Hospital" Variant="Variant.Outlined" Placeholder="Enter Hospital Name" />
                                                                </MudItem>
                                                                <MudItem md="12">
                                                                    <MudTextField @bind-Value="CurrentReferral.DoctorsNote" Margin="Margin.Dense" Lines="10" Immediate="true"
                                                                                  Label="Doctor's Note" Variant="Variant.Outlined" Placeholder="Enter Doctor Note" />
                                                                </MudItem>
                                                            </MudGrid>
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    </MudItem>
                                </MudGrid>
                            </MudGrid>
                        </DialogContent>
                        <DialogActions>
                            <MudGrid Spacing="1" Class="pe-7" Justify="Justify.FlexEnd">
                                <MudItem>
                                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Error" OnClick="@(() => showTransferDialog = false)">Cancel</MudButton>
                                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Success" OnClick="SaveReferralAsync">Generate Pdf</MudButton>
                                </MudItem>
                            </MudGrid>
                        </DialogActions>
                    </MudDialog>
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => ConfirmAsync("closure"))" Size="Size.Small">Complete Consultation</MudButton>
                    <MudDialog @bind-Visible="showConditionDialog" Options="_maxWidthAddAllergyBox">
                        <DialogContent>
                            <MudGrid Spacing="1" Class="pa-0">
                                <MudGrid Spacing="5" Justify="Justify.Center" Class="pa-0" Style="border:none;">
                                    <MudItem md="12">
                                        <MudPaper Elevation="0" Class="border-1 border-opacity-10 border-secondary-subtle">
                                            <MudGrid Class="pa-3">
                                                <MudItem md="12">
                                                    <MudText Typo="Typo.subtitle2"
                                                             Style="background: linear-gradient(to right, var(--bs-danger), rgba(var(--bs-danger-rgb), 0));" Class="p-2 text-white">

                                                        + Patient's Condition
                                                    </MudText>

                                                    <MudItem md="12" Class="mt-3">
                                                        <MudSelect For="@(() => CurrentPatient.PatientTypeId)"
                                                                   @bind-Value="CurrentPatient.PatientTypeId"
                                                                   Label="Patient State" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Patient Type"
                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                            <MudSelectItem Value="0" Disabled>Patient Type</MudSelectItem>

                                                            @foreach (var item in PatientTypes)
                                                            {
                                                                <MudSelectItem Value="@item.Id">@item.PatientStatusName</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudItem>
                                                    <MudItem md="12">
                                                        <MudSelect For="@(() => CurrentPatient.PatientStatusId)"
                                                                   @bind-Value="CurrentPatient.PatientStatusId"
                                                                   Label="Patient Type" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Patient State"
                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                            <MudSelectItem Value="0" Disabled>Patient State</MudSelectItem>

                                                            @foreach (var item in PatientStatus)
                                                            {
                                                                <MudSelectItem Value="@item.Id">@item.PatientTypeName</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </MudItem>
                                                </MudItem>

                                            </MudGrid>
                                        </MudPaper>
                                    </MudItem>
                                </MudGrid>
                            </MudGrid>
                        </DialogContent>
                        <DialogActions>
                            <MudGrid Spacing="1" Class="pe-7" Justify="Justify.FlexEnd">
                                <MudItem>
                                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Error" OnClick="@(() => showConditionDialog = false)">Cancel</MudButton>
                                    <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Success" OnClick="SaveConditionAsync">Update Condition</MudButton>
                                </MudItem>
                            </MudGrid>
                        </DialogActions>
                    </MudDialog>
                </MudPaper>
            </MudItem>
            <MudItem md="12" Class="ps-0 pt-0">
                <MudGrid>
                    <MudItem md="8">
                        <MudGrid>
                            <MudItem md="12">
                                <MudPaper Elevation="0" Class="border-1 border-opacity-10 border-secondary-subtle">
                                    <MudGrid Class="pa-3">
                                        <MudItem md="12">
                                            <MudText Typo="Typo.subtitle2"
                                                     Style="background: linear-gradient(to right, #4e3ee0ff, rgba(0, 123, 255, 0));" Class="p-2 text-white">
                                                @* Style="background: linear-gradient(to right, var(--bs-primary), rgba(var(--bs-primary-rgb), 0));" Class="p-2 text-white"> *@

                                                Diagnosis
                                            </MudText>
                                            <MudTextField @bind-Value="CurrentConsultation.Diagnosis" Margin="Margin.Dense" Lines="7"
                                                          Label="Description" Variant="Variant.Outlined" Placeholder="Enter diagnosis" />
                                        </MudItem>

                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!-- Lab Tests Section -->
                            <MudItem md="12">
                                <MudPaper Elevation="0" Class="border-1 border-opacity-10 border-secondary-subtle">

                                    <MudGrid Class="pa-3">
                                        <MudItem md="12">
                                            <MudText Typo="Typo.subtitle2"
                                                Style="background: linear-gradient(to right, var(--bs-primary), rgba(var(--bs-primary-rgb), 0));" Class="p-2 text-white">
                                                Lab Tests
                                            </MudText>

                                            <MudGrid Spacing="1" Justify="Justify.Center" Class="pa-0" Style="border:none;">
                                                <MudItem md="12" Class="ps-3 pe-0 pt-3">
                                                    <MudItem Style="height:100%; border-radius:5px;" Class="pa-0 border-1 border-opacity-10  border-secondary-subtle">
                                                        <MudGrid Class="pa-3">
                                                            <MudGrid Spacing="1" Class="pa-3 ps-6 pe-0 pb-0">
                                                                <MudItem md="10">
                                                                    <MudSelect For="@(() => CurrentLabTest.DiseaseName)"
                                                                               @bind-Value="CurrentLabTest.DiseaseName"
                                                                               Label="Choose Disease" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Choose Disease</MudSelectItem>

                                                                        @foreach (var item in AllDiseases)
                                                                        {
                                                                            <MudSelectItem Value="@item.DiseaseName">@($"{item.DiseaseName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>
                                                                <MudItem md="2" Class="text-end">
                                                                    <MudIconButton OnClick="@(() => AddLabTestToBatch(CurrentLabTest))" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Add" Class="mt-2" title="Add To Batch" />
                                                                    <MudIconButton OnClick="ResetTests" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Delete" Class="mt-2" title="Reset Batch" />
                                                                </MudItem>
                                                            </MudGrid>
                                                            <MudItem md="12">
                                                                @if (!LabTestsBatch!.Any())
                                                                {
                                                                    <NoDataNotice NoDataMessage="No LabTests in Batch" />
                                                                }
                                                                else
                                                                {

                                                                    <MudTable Dense="true" FixedHeader="true" Class="shadow-none" FixedFooter="true" Items="@LabTestsBatch" Height="200px" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                                                        <HeaderContent>
                                                                            <MudTh>Lab Test</MudTh>
                                                                            <MudTh>Cost</MudTh>
                                                                            <MudTh Class="text-end">
                                                                                @* <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.FolderDelete" OnClick="ResetTests" /> *@
                                                                            </MudTh>
                                                                        </HeaderContent>
                                                                        <RowTemplate>
                                                                            <MudTd DataLabel="Lab Test">@medContext.DiseaseName</MudTd>
                                                                            <MudTd DataLabel="Patient_Id">@medContext.LabTestCost</MudTd>
                                                                            <MudTd DataLabel="" Class="text-end">
                                                                                <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveLabTestFromBatch(medContext))" />
                                                                            </MudTd>
                                                                        </RowTemplate>
                                                                        <FooterContent>
                                                                            <MudTh>Total Cost</MudTh>
                                                                            <MudTh>@LabTestsBatch.Sum(x => x.LabTestCost)</MudTh>
                                                                            <MudTh></MudTh>
                                                                        </FooterContent>
                                                                    </MudTable>
                                                                }
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!--Prescriptions-->
                            <MudItem md="12">
                                <MudPaper Elevation="0" Class="border-1 border-opacity-10 border-secondary-subtle">
                                    <MudGrid Class="pa-3">
                                        <MudItem md="12">
                                            <MudText Typo="Typo.subtitle2"
                                                     Style="background: linear-gradient(to right, #e03e8fff, rgba(var(--bs-primary-rgb), 0));" Class="p-2 text-white">
                                                Prescriptions
                                            </MudText>

                                            <MudGrid Spacing="1" Justify="Justify.Center" Class="pa-0" Style="border:none;">
                                                <MudItem md="12" Class="ps-3 pe-0 pt-3">
                                                    <MudItem Style="height:100%; border-radius:5px;" Class="pa-0 border-1 border-opacity-10  border-secondary-subtle">
                                                        <MudGrid Class="pa-3">
                                                            <MudGrid Spacing="1" Class="pa-3 ps-6 pe-0 pb-0">
                                                                <MudItem md="6">
                                                                    <MudSelect For="@(() => selectedMedGenreId)"
                                                                               @bind-Value="selectedMedGenreId"
                                                                               @bind-Value:after="OnMedicineGenreChange"
                                                                               Label="Choose Genre" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Choose Genre</MudSelectItem>

                                                                        @foreach (var item in AllMedicineGenres)
                                                                        {
                                                                            <MudSelectItem Value="@item.Id">@($"{item.MedicineGenreName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>

                                                                <MudItem md="6">
                                                                    <MudSelect For="@(() => selectedMedTypeId)"
                                                                               @bind-Value="selectedMedTypeId"
                                                                               @bind-Value:after="OnMedicineTypeChange"
                                                                               Label="Select Type" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Select Type</MudSelectItem>

                                                                        @foreach (var item in FilteredMedicineTypes)
                                                                        {
                                                                            <MudSelectItem Value="@item.Id">@($"{item.MedicineTypeName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>

                                                                <MudItem md="8">
                                                                    <MudSelect For="@(() => CurrentPrescription.MedicineId)"
                                                                               @bind-Value="CurrentPrescription.MedicineId"
                                                                               @bind-Value:after="@(() =>
                                                                                    {
                                                                                        CurrentPrescription.MedicineName = FilteredMedicines.FirstOrDefault(x => x.Id == CurrentPrescription.MedicineId)?.MedicineName ?? string.Empty;
                                                                                        CurrentPrescription.UnitPrice = FilteredMedicines.FirstOrDefault(x => x.Id == CurrentPrescription.MedicineId)?.BuyingPrice ?? 0m;
                                                                                     })"
                                                                               Label="Select Medicine" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Select Medicine</MudSelectItem>

                                                                        @foreach (var item in FilteredMedicines)
                                                                        {
                                                                            <MudSelectItem Value="@item.Id">@($"{item.MedicineName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>

                                                                <MudItem md="2">
                                                                    <MudNumericField For="@(() => CurrentPrescription.Quantity)" @bind-Value="CurrentPrescription.Quantity" Margin="Margin.Dense"
                                                                                     Label="Quantity" Variant="Variant.Outlined" Placeholder="Quantity"
                                                                                     UserAttributes="@(new() { { "autocomplete", "TreatmentQty" }, { "aria-required", "true" } } )" />
                                                                </MudItem>
                                                                <MudItem md="2" Class="text-end">
                                                                    <MudIconButton OnClick="AddPrescriptionToBatch" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Add" Class="mt-2" title="Add To Batch" />
                                                                    <MudIconButton OnClick="ResetPrescriptions" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Delete" Class="mt-2" title="Reset Batch" />
                                                                </MudItem>
                                                            </MudGrid>
                                                            <MudItem md="12">
                                                                @if (!PrescriptionsBatch!.Any())
                                                                {
                                                                    <NoDataNotice NoDataMessage="No Prescription in Batch" />
                                                                }
                                                                else
                                                                {

                                                                    <MudTable Dense="true" FixedHeader="true" FixedFooter="true" Items="@PrescriptionsBatch" Height="220px" Hover="true" Breakpoint="Breakpoint.Sm" Context="docContext">
                                                                        <HeaderContent>
                                                                            <MudTh>Name</MudTh>
                                                                            <MudTh>Price</MudTh>
                                                                            <MudTh>Qty</MudTh>
                                                                            <MudTh>Amount</MudTh>
                                                                            <MudTh Class="text-end">
                                                                                @* <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.FolderDelete" OnClick="ResetTests" /> *@
                                                                            </MudTh>
                                                                        </HeaderContent>
                                                                        <RowTemplate>
                                                                            <MudTd DataLabel="Prescription">@docContext.MedicineName</MudTd>
                                                                            <MudTd DataLabel="Quantity">@docContext.UnitPrice</MudTd>
                                                                            <MudTd DataLabel="Quantity">@docContext.Quantity</MudTd>
                                                                            <MudTd DataLabel="Quantity">@docContext.TotalPrice</MudTd>
                                                                            <MudTd DataLabel="" Class="text-end">
                                                                                <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemovePrescriptionFromBatch(docContext))" />
                                                                            </MudTd>
                                                                        </RowTemplate>
                                                                        <FooterContent>
                                                                            <MudTh>Total Cost</MudTh>
                                                                            <MudTh>@PrescriptionsBatch?.Sum(x => x.TotalPrice)</MudTh>
                                                                            <MudTh></MudTh>
                                                                        </FooterContent>
                                                                    </MudTable>
                                                                }
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudItem>
                                            </MudGrid>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            </MudItem>

                            <!--Treatments-->
                            <MudItem md="12">
                                <MudPaper Elevation="0" Class="border-1 border-opacity-10 border-secondary-subtle">

                                    <MudGrid Class="pa-3">
                                        <MudItem md="12">
                                            <MudText Typo="Typo.subtitle2"
                                                     Style="background: linear-gradient(to right, var(--bs-warning), rgba(var(--bs-primary-rgb), 0));" Class="p-2 text-white">
                                                Treatments
                                            </MudText>

                                            <MudGrid Spacing="1" Justify="Justify.Center" Class="pa-0" Style="border:none;">
                                                <MudItem md="12" Class="ps-3 pe-0 pt-3">
                                                    <MudItem Style="height:100%; border-radius:5px;" Class="pa-0 border-1 border-opacity-10  border-secondary-subtle">
                                                        <MudGrid Class="pa-3">
                                                            <MudGrid Spacing="1" Class="pa-3 ps-6 pe-0 pb-0">
                                                                <MudItem md="6">
                                                                    <MudSelect For="@(() => CurrentTreatment.TreatmentTypeId)"
                                                                               @bind-Value="CurrentTreatment.TreatmentTypeId"
                                                                               @bind-Value:after="OnTreatmentTypeChosen"
                                                                               
                                                                               Label="Choose Treatment" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                                                        <MudSelectItem Value="0" Disabled>Choose Treatment</MudSelectItem>

                                                                        @foreach (var item in AllTreatmentTypes)
                                                                        {
                                                                            <MudSelectItem Value="@item.Id">@($"{item.TreatmentTypeName}")</MudSelectItem>
                                                                        }
                                                                    </MudSelect>
                                                                </MudItem>

                                                                <MudItem md="4">
                                                                    <MudDatePicker For="@(() => CurrentTreatment.StartDate)" @bind-Date="CurrentTreatment.StartDate" Margin="Margin.Dense"
                                                                                   Label="Start On" Variant="Variant.Outlined" Placeholder="Start On"
                                                                                   UserAttributes="@(new() { { "autocomplete", "StartDate" }, { "aria-required", "true" } } )" />
                                                                </MudItem>

                                                                <MudItem md="2">
                                                                    <MudNumericField For="@(() => CurrentTreatment.TreatmentQty)" @bind-Value="CurrentTreatment.TreatmentQty" Margin="Margin.Dense"
                                                                                     Label="Quantity" Variant="Variant.Outlined" Placeholder="Quantity"
                                                                                     UserAttributes="@(new() { { "autocomplete", "TreatmentQty" }, { "aria-required", "true" } } )" />
                                                                </MudItem>

                                                                <!--HasMedicalDept-->
                                                                @if (HasMedicalDeptId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.MedicalDeptId)"
                                                                                   @bind-Value="CurrentTreatment.MedicalDeptId"
                                                                                   
                                                                                   Label="Choose Department" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Department</MudSelectItem>

                                                                            @foreach (var item in AllMedicalDepts)
                                                                            {
                                                                                <!-- 2. Explicitly cast item.Id to int? so it matches the parent MudSelect type -->
                                                                                <MudSelectItem Value="@((int?)item.Id)">@($"{item.MedicalDepartmentName}")</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudItem>
                                                                }
                                                                <!--HasDoctor-->
                                                                @if (HasDoctorId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.DoctorId)"
                                                                                   @bind-Value="CurrentTreatment.DoctorId"
                                                                                   
                                                                                   Label="Choose Doctor" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Doctor</MudSelectItem>

                                                                            @foreach (var item in AllDoctors)
                                                                            {
                                                                                <!-- 2. Explicitly cast item.Id to int? so it matches CurrentTreatment.DoctorId -->
                                                                                <MudSelectItem Value="@((int?)item.Id)">@($"{item.DoctorFullName}")</MudSelectItem>
                                                                            }
                                                                        </MudSelect>
                                                                    </MudItem>
                                                                }

                                                                <!--HasSurgery-->
                                                                @if (HasSurgeryId)
                                                                {
                                                                    <MudItem md="4">
                                                                        <MudSelect For="@(() => CurrentTreatment.SurgeryId)"
                                                                                   @bind-Value="CurrentTreatment.SurgeryId"
                                                                                   @bind-Value:after="OnSurgeryChosen"
                                                                                   
                                                                                   Label="Choose Surgery" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                                                   UserAttributes="@(new() { { "aria-required", "true" } } )">

                                                                            <!-- 1. FIXED: Cast the placeholder '0' value to int? -->
                                                                            <MudSelectItem Value="@((int?)0)" Disabled>Choose Surgery</MudSelectItem>

                                                                            @foreach (var item in AllSurgeries)
                                                                            {
                                                                                <!-- 2. FIXED: Explicitly cast item.Id to int? so it matches SurgeryId -->
