@page "/StaffIndex"

@using Microsoft.AspNetCore.Authorization
@using NovaCare.Shared.DTOs.StaffDTOs

@rendermode InteractiveServer
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@attribute [Authorize]
<PageTitle>Staffs - NovaCare</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-3 px-sm-6">
    @* Page Header *@
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center">
        <SectionTitle Icon="@icon" Title="@title" />
        <Briefer BriferNote="@briferNote" />
    </div>

    @* Main Elevated Card Container *@
    <MudPaper Elevation="0" Outlined="true" Class="overflow-hidden" Style="background-color: rgba(246,246,246,1) !important;">
        <MudTabs Elevation="0"
                 Rounded="false"
                 ApplyEffectsToContainer="true"
                 TabHeaderClass="bg-secondary-subtle"
                 SliderColor="Color.Error"
                 TabPanelsClass="pa-3 pa-sm-6"
                 Centered="false">
            @if (currentUser != null && currentUser.IsViewAllStaffs)
            {
                <MudTabPanel Text="All Staff" Icon="@Icons.Material.Outlined.Groups" Style="text-transform: none; font-weight: 500;">
                    <Staffs CurrentUser="currentUser" />
                </MudTabPanel>
            }
            @if (currentUser != null && currentUser.IsViewAllLeaders)
            {
                <MudTabPanel Text="Executives" Icon="@Icons.Material.Outlined.AdminPanelSettings" Style="text-transform: none; font-weight: 500;">
                    <Staffs FilterBy="Leaders" CurrentUser="currentUser" />
                </MudTabPanel>
            }
            @if (currentUser != null && currentUser.IsViewAllDoctors)
            {
                <MudTabPanel Text="Doctors" Icon="@Icons.Material.Outlined.MedicalServices" Style="text-transform: none; font-weight: 500;">
                    <Staffs FilterBy="Doctors" CurrentUser="currentUser" />
                </MudTabPanel>
            }
            @if (currentUser != null && currentUser.IsViewAllNurses)
            {
                <MudTabPanel Text="Nurses" Icon="@Icons.Material.Outlined.LocalHospital" Style="text-transform: none; font-weight: 500;">
                    <Staffs FilterBy="Nurses" CurrentUser="currentUser" />
                </MudTabPanel>
            }
            @if (currentUser != null && currentUser.IsViewAllHelps)
            {
                <MudTabPanel Text="Receptionists" Icon="@Icons.Material.Outlined.SupportAgent" Style="text-transform: none; font-weight: 500;">
                    <Staffs FilterBy="Helpers" CurrentUser="currentUser" />
                </MudTabPanel>
            }
            @if (currentUser != null && currentUser.IsViewAllAdmins)
            {
                <MudTabPanel Text="System Admin" Icon="@Icons.Material.Outlined.Security" Style="text-transform: none; font-weight: 500;">
                    <Staffs FilterBy="Administrators" CurrentUser="currentUser" />
                </MudTabPanel>
            }
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    StaffDto? currentUser;
    StaffDto? currentStaff;

    public string icon = Icons.Material.Filled.People;
    public string title = "Staff Directory";
    string briferNote = "Manage clinical personnel, roles, and availability status";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await userService.GetLoggedInUserAsync();
    }
}
