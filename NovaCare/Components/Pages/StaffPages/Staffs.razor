@using NovaCare.Components.Account.Pages
@using NovaCare.Shared.DTOs.StaffDTOs
@inject IDialogService Dialog

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredStaffs == null || !FilteredStaffs.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex flex-column flex-sm-row justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@($"All {firstPart}")</MudText>
                    @if (CurrentUser != null && CurrentUser.IsCreateNewStaff && !isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenRegisterModal" StartIcon="@Icons.Material.Filled.PersonAdd" Style="text-transform:none;">
                            Add Staff
                        </MudButton>
                    }
                </div>
                <NoDataNotice NoDataMessage="@messageStaff" />
            </MudPaper>
        }
        else if (FilteredStaffs != null)
        {
            @* Quick Summary Metric Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total @firstPart</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredStaffs.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.PeopleAlt" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Available</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">
                                @FilteredStaffs.Count(x => string.Equals(x.StaffStatusName, "Available", StringComparison.OrdinalIgnoreCase))
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-error);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Unavailable</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight:700;">
                                @FilteredStaffs.Count(x => !string.Equals(x.StaffStatusName, "Available", StringComparison.OrdinalIgnoreCase))
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Error" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.DoNotDisturbOn" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Main Data Table *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Striped="false"
                         Elevation="0"
                         Outlined="true"
                         RowClick="@((args) => OpenEditStaffModal(args.Item.Id))"
                         RowStyle="cursor: pointer;"
                         T="StaffDto"
                         Items="@FilteredStaffs"
                         ReadOnly="@_readOnly"
                         Class="rounded-lg"
                         Bordered="false"
                         Dense="false">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@($"All {firstPart}")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredStaffs.Count} records")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search name, email, or status..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 260px;" />

                            @if (CurrentUser != null && CurrentUser.IsCreateNewStaff && !isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           OnClick="OpenRegisterModal"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Add Staff
                                </MudButton>
                            }
                            @if (isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="GeneratePdf"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Generate Pdf
                                </MudButton>
                            }
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    @* Staff Member Avatar, Name & Role *@
                    <TemplateColumn Title="Staff Member" SortBy="@(x => x.FisrtName)">
                        <CellTemplate>
                            <div class="d-flex align-center py-1">
                                <MudAvatar Size="Size.Medium" Class="me-3 border">
                                    @if (context.Item.StaffPhoto == null || context.Item.StaffPhoto.Length == 0)
                                    {
                                        <MudImage Src="Images/dp.png" Alt="Default Avatar" />
                                    }
                                    else
                                    {
                                        <MudImage ObjectFit="ObjectFit.Cover"
                                                  Src="@($"data:image/jpeg;base64,{Convert.ToBase64String(context.Item.StaffPhoto)}")"
                                                  Alt="Profile Photo" />
                                    }
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; line-height: 1.2;">
                                        @($"{context.Item.FisrtName} {context.Item.MiddleName} {context.Item.LastName}".Replace("  ", " ").Trim())
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @(string.IsNullOrWhiteSpace(context.Item.ClinicalTitleName) ? context.Item.AdministrativeTitleName : context.Item.ClinicalTitleName)
                                    </MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Contact Email *@
                    <TemplateColumn Title="Contact Email" SortBy="@(x => x.Email)">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" Color="Color.Secondary" Class="me-2" />
                                <MudText Typo="Typo.body2">@context.Item.Email</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Department / Group *@
                    <TemplateColumn Title="Department / Group">
                        <CellTemplate>
                            <MudText Typo="Typo.body2">
                                @(string.IsNullOrWhiteSpace(context.Item.ClinicalTitleGroupName) ? context.Item.AdministrativeTitleGroupName : context.Item.ClinicalTitleGroupName)
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Status Badge *@
                    <TemplateColumn Title="Status" SortBy="@(x => x.StaffStatusName)">
                        <CellTemplate>
                            @{
                                bool isAvailable = string.Equals(context.Item.StaffStatusName, "Available", StringComparison.OrdinalIgnoreCase);
                            }
                            <MudChip T="string"
                                     Color="@(isAvailable ? Color.Success : Color.Error)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small"
                                     Style="font-weight: 500;">
                                <span style="@($"display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; background-color:{(isAvailable ? "#2e7d32" : "#d32f2f")};")"></span>
                                @(string.IsNullOrWhiteSpace(context.Item.StaffStatusName) ? "Unknown" : context.Item.StaffStatusName)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Row Action Indicator *@
                    <TemplateColumn Title="" CellStyle="width: 60px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="View / Edit Profile">
                                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => OpenEditStaffModal(context.Item.Id))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="StaffDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public EventCallback<string> OnEditStaff { get; set; }
    private bool _readOnly = true;

    [Parameter] public List<StaffDto>? AllStaffs { get; set; } = new();
    List<StaffDto> FilteredStaffs = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public StaffDto? CurrentUser { get; set; }
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;
    [Parameter] public bool isReport { get; set; }
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    StaffDto? CurrentStaff;

    string messageStaff = string.Empty;
    string firstPart = string.Empty;
    string? searchString;
    string? pdfBase64;

    bool isLoading;
    bool isSearchLoading;
    bool isEdit;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(300);

        if (!isReport)
            AllStaffs = await staffService.GetAllStaffsAsync();

        ApplyFilterAndSearch();

        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<StaffDto> query = AllStaffs ?? Enumerable.Empty<StaffDto>();

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            firstPart = "Staff";
            messageStaff = "No staff records are currently available.";
        }
        else
        {
            firstPart = FilterBy;
            messageStaff = $"No {firstPart.ToLower()} records are currently available.";
            query = query.Where(x =>
                string.Equals(x.AdministrativeTitleGroupName?.Trim(), FilterBy.Trim(), StringComparison.OrdinalIgnoreCase) ||
                string.Equals(x.ClinicalTitleGroupName?.Trim(), FilterBy.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x =>
                (x.FisrtName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.MiddleName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.LastName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Email?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.StaffStatusName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        FilteredStaffs = query.ToList();
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    public async Task EditStaff(string staffId)
    {
        await OnEditStaff.InvokeAsync(staffId);
    }

    public async Task Back()
    {
        CurrentStaff = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task OpenEditStaffModal(string staffId)
    {
        var Parameters = new DialogParameters
        {
            {"StaffId" , staffId},
            {"CurrentUser" , CurrentUser}
        };

        var dialog = await Dialog.ShowAsync<EditStaffModal>("Edit Staff Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null && result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    public async Task OpenRegisterModal()
    {
        var dialog = await Dialog.ShowAsync<Register>("Register New Staff", _maxWidth);
        var result = await dialog.Result;

        if (result != null && result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<StaffDto>
        {
            ReportType = "Staffs",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredStaffs
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<StaffDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        var dialog = await Dialog.ShowAsync<PdfPreview>($"Report Pdf", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }
}
