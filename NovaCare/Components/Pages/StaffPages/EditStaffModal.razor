                                                        <MudCardContent>
                                                            <MudText Typo="Typo.h5">From: 8am To: 4pm</MudText>
                                                        </MudCardContent>
                                                    </MudCard>
                                                </MudItem>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTabPanel>
                                    <MudTabPanel Text="Weekly Schedule" Style="display:flex; flex-wrap: wrap; justify-content:space-evenly;">
                                        <MudGrid Spacing="5" Justify="Justify.Center" Class="overflow-auto px-3" Style="max-height:220px;">
                                            <MudItem md="12" Style="display:flex; justify-content:space-between; background-color:rgba(0,0,0,0.09)" Class="pa-3 rounded-2 mb-2"><MudText>Monday</MudText><MudText>8:00 AM – 4:00 PM</MudText></MudItem>
                                            <MudItem md="12" Style="display:flex; justify-content:space-between; background-color:rgba(0,0,0,0.09)" Class="pa-3 rounded-2 mb-2"><MudText>Tuesday</MudText><MudText>8:00 AM – 4:00 PM</MudText></MudItem>
                                            <MudItem md="12" Style="display:flex; justify-content:space-between; background-color:rgba(0,0,0,0.09)" Class="pa-3 rounded-2 mb-2"><MudText>Wednesday</MudText><MudText>8:00 AM – 4:00 PM</MudText></MudItem>
                                            <MudItem md="12" Style="display:flex; justify-content:space-between; background-color:rgba(0,0,0,0.09)" Class="pa-3 rounded-2 mb-2"><MudText>Thursday</MudText><MudText>8:00 AM – 4:00 PM</MudText></MudItem>
                                            <MudItem md="12" Style="display:flex; justify-content:space-between; background-color:rgba(0,0,0,0.09)" Class="pa-3 rounded-2 mb-2"><MudText>Friday</MudText><MudText>8:00 AM – 4:00 PM</MudText></MudItem>
