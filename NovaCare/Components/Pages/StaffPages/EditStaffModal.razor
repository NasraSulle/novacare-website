                                                    <MudItem md="2"><MudText Color="Color.Success">67</MudText></MudItem><MudItem md="10">Attended patients</MudItem>
                                                    <MudItem md="2"><MudText Color="Color.Error">9</MudText></MudItem><MudItem md="10">Remaining patients</MudItem>
                                                    <MudDivider Style="border-bottom:1px solid black" />
                                                    <MudItem md="2"><MudText Color="Color.Tertiary">77</MudText></MudItem><MudItem md="10">Consultation patients</MudItem>
                                                    <MudItem md="2"><MudText Color="Color.Info">3</MudText></MudItem><MudItem md="10">Operation patients</MudItem>
