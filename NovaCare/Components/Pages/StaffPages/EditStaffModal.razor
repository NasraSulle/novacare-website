                </MudGrid>
                <MudItem md="12" Style="">
                    <MudGrid Justify="Justify.Center">
                        <MudItem md="7">
                            @if (isCreatedSuccessfully)
                            {
                                <MudAlert Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@successMessage</MudAlert>
                            }
                        </MudItem>
                        <MudItem md="5" Style="align-content:center; text-align:end">
                            @if (isEditStaff)
                            {
                                <MudStaticButton Class="" Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="(string.IsNullOrWhiteSpace(CurrentStaff.FisrtName) || string.IsNullOrWhiteSpace(CurrentStaff.MiddleName) || string.IsNullOrWhiteSpace(CurrentStaff.LastName) || string.IsNullOrWhiteSpace(CurrentStaff.Email))">Save  Staff Details</MudStaticButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Dark" OnClick="ResetPage" Class="me-1">Reset Page</MudButton>
                            }
                            else if (CurrentUser.IsUpdateOrEditStaff)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => isEditStaff = true)" Class="me-1">Edit Staff Details</MudButton>
                            }
                            @if(CurrentUser.CanChooseStaffOfTheWeek)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConfirmAsync" Class="me-1">Award Staff Of The Week</MudButton>
                            }

                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToStaffsPage" Class="">Close</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [Parameter, EditorRequired] public string StaffId { get; set; } = string.Empty;
    List<StaffTypeDto> StaffTypes = new();
    List<StaffTitleDto> StaffTitles = new();
    List<StaffStatusDto> StaffStatus = new();
    List<DoctorTypeDto> DoctorTypes = new();

    DoctorDto CurrentDoctor = new();
    StaffDto CurrentStaff { get; set; } = new();

    private IEnumerable<IdentityError>? identityErrors;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";
    string? photoString;
    string? successMessage;

    int docCode = 0;
    int emplIdCode = 0;

    bool isCreatedSuccessfully;
    bool isShowCamera;
    bool isEditStaff;
    bool isTrue;

    protected override async Task OnInitializedAsync()
    {
        CurrentStaff = await staffService.GetStaffById(StaffId);
        if (CurrentStaff.StaffPhoto != null)
        {
            var base64String = Convert.ToBase64String(CurrentStaff.StaffPhoto);
            photoString = base64String;
        }
        StaffTypes = await staffService.GetStaffTypesAsync();
        StaffTitles = await staffService.GetStaffTitlesAsync();
        DoctorTypes = await doctorService.GetDoctorTypesAsync();
        StaffStatus = await staffService.GetStaffStatusAsync();
        CurrentDoctor = await doctorService.GetDoctorByStaffId(StaffId);

    }

    public async Task ChangePhoto(IBrowserFile file)
    {
        if (file != null)
        {
            long maxFileSize = 1024 * 1024 * 3;

            using var memoryStream = new MemoryStream();
            await file.OpenReadStream(maxFileSize).CopyToAsync(memoryStream);
            byte[] fileBytes = memoryStream.ToArray();
            var base64String = Convert.ToBase64String(fileBytes);
            CurrentStaff.StaffPhoto = fileBytes;
            photoString = $"data:{file.ContentType};base64,{base64String}";

            StateHasChanged();
        }
    }

    public async Task OnDeptChange()
    {
        CurrentStaff.AdministrativeTitleName = StaffTitles.Where(x => x.Id == CurrentStaff.AdministrativeTitleId).Select(x => x.StaffTitleName).FirstOrDefault() ?? string.Empty;
        CurrentStaff.AdministrativeTitleId = StaffTitles.Where(x => x.Id == CurrentStaff.AdministrativeTitleId).Select(x => x.Id).FirstOrDefault();
        await InvokeAsync(StateHasChanged);
    }

    public async Task OnTitleChange()
    {
        CurrentStaff.ClinicalTitleName = StaffTitles.Where(x => x.Id == CurrentStaff.ClinicalTitleId).Select(x => x.StaffTitleName).FirstOrDefault() ?? string.Empty;
        CurrentStaff.ClinicalTitleId = StaffTitles.Where(x => x.Id == CurrentStaff.ClinicalTitleId).Select(x => x.Id).FirstOrDefault();

        if (CurrentStaff.ClinicalTitleName.ToLower() == "doctor")
        {
            if (string.IsNullOrWhiteSpace(CurrentDoctor.DoctorCode))
            {
                isTrue = true;
            }
            else
            {
                isTrue = false;
            }
        }
        else
        {
            isTrue = false;
        }
        await InvokeAsync(StateHasChanged);
    }
    public async Task OnGenerateEmployeeId()
    {
        emplIdCode = await staffService.AddEmployeeIdCodeAsync();
        CurrentStaff.EmployeeId = $"EMP{emplIdCode}";
    }

    public async Task OnGenerateDoctorCode()
    {
        docCode = await doctorService.AddDoctorCodeAsync();
        CurrentDoctor.DoctorCode = $"DOC{docCode}";

        if (string.IsNullOrWhiteSpace(CurrentDoctor.DoctorCode))
        {
            isTrue = true;
        }
        else
        {
            isTrue = false;
        }
    }

    public async Task UpdateIsTrue()
    {
        if (string.IsNullOrWhiteSpace(CurrentDoctor.DoctorCode))
        {
            isTrue = true;
        }
        else
        {
            isTrue = false;
        }
    }

    public async Task ResetPage()
    {
        isCreatedSuccessfully = false;
        CurrentStaff = new();
        CurrentDoctor = new();
    }

    public void ReturnToStaffsPage()
    {
        MudDialog.Cancel();
    }

    public async Task UpdateStaff()
    {
        var staffUpdateResult = await staffService.UpdateStaffAsync(CurrentStaff, CurrentStaff.Id);

        if (staffUpdateResult)
        {
            successMessage = "Staff Updated Successfully!";
            isCreatedSuccessfully = true;

            if (!string.IsNullOrWhiteSpace(CurrentDoctor.MedicalLicenseNumber))
            {
                var docUpdateResult = await doctorService.UpdateDoctorAsync(CurrentDoctor, CurrentDoctor.Id);
            }
        }
    }

    private async Task ConfirmAsync()
    {

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var parameters = new DialogParameters<ConfirmationModal>
        {
            { x => x.ContentText, $"You are about to award {CurrentStaff.FisrtName} .{CurrentStaff.MiddleName.ToUpper().Substring(0,1)}. {CurrentStaff.LastName} staff of the week. Please confirm to proceed" },
            { x => x.ButtonText, "Confirm" },
            { x => x.Color, Color.Success }


        };

        var dialog = await DialogService.ShowAsync<ConfirmationModal>("Confirmation", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await AwardStaffAsync();
        }
    }

    private async Task AwardStaffAsync()
    {
        var result = await staffService.AwardStaffOfTheWeekAsync(CurrentStaff.Id);
        successMessage = $"{CurrentStaff.FisrtName} .{CurrentStaff.MiddleName.ToUpper().Substring(0, 1)}. {CurrentStaff.LastName} is now staff of the week!";
        isCreatedSuccessfully = true;

    }
}