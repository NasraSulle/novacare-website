@page "/billDetails"

<PageTitle>BillModal</PageTitle>

<MudStack Spacing="0" Style="height: calc(100vh - 64px); overflow: hidden;">

        <MudStack Class="pa-1 flex-none" Row="true" Justify="Justify.FlexStart" AlignItems="AlignItems.Center">
            <SectionTitle Icon="@icon" Title="@title" />
        </MudStack>

    <MudContainer MaxWidth="MaxWidth.False" Class="flex-grow-1 pa-2" Style="min-height: 0; overflow-y: auto; overflow-x: hidden;">
        <EditForm Model="CurrentBill" method="post" OnValidSubmit="SaveBillAsync" FormName="newmedicine">
            <MudGrid Spacing="1">
                <MudItem md="9" xs="12">
                    <MudGrid Spacing="1">
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                <MudGrid>
                                    <MudItem md="12">
                                        <MudText Typo="Typo.subtitle2">Patient & Bill Details</MudText>
                                    </MudItem>
                                    <MudItem md="12">
                                        <MudGrid>
                                            <MudItem md="4">
                                                <MudNumericField @bind-Value="patientId" @bind-Value:after="RetrieveActiveVisitItemsAsync" Margin="Margin.Dense"
                                                                 Label="Patient Id" Variant="Variant.Outlined" Placeholder="Enter Patient Id" />
                                            </MudItem>
                                            <MudItem md="8">
                                                <MudText Typo="Typo.subtitle2">@CurrentBill.PatientFullName</MudText>
                                            </MudItem>
                                            <MudItem md="12"></MudItem>
                                            <MudItem md="12"></MudItem>
                                            <MudItem md="12"></MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 ma-2" Outlined="true"></MudPaper>
                        </MudItem>
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 ma-2" Outlined="true"></MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudItem md="3" xs="12">
                    <MudGrid Spacing="1">
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 ma-2" Outlined="true"></MudPaper>
                        </MudItem>
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 ma-2" Outlined="true"></MudPaper>
                        </MudItem>
                        <MudItem xs="12">
                            <MudPaper Class="pa-3 ma-2" Outlined="true"></MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudContainer>

        <MudStack Class="pa-1 flex-none" Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center">
            <SectionTitle Title="Buttons Section" />
        </MudStack>

</MudStack>

@code {
    public string icon = Icons.Material.Filled.Payments;
    public string title = "Bill Details";

    BillDto CurrentBill = new();
    int patientId = 0;

    public async Task RetrieveActiveVisitItemsAsync()
    {
        //loop v.cons/v.test/v.trt/v.med  : add billItems to bill from v for each v.cons/v.test/v.trt/v.med whose payFlag is not paid
    }
    public async Task SaveBillAsync() { }
}
