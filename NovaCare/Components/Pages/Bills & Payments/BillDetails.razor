    public async Task RetrieveActiveVisitItemsAsync()
    {
        CurrentVisit = await patientService.GetVisitByPCodeOrFullNameAsync(patientSearcher);

        //1. CONSULTATION
        if (CurrentVisit != null && CurrentVisit.Consultations.Any())
        {
            var Consultations = CurrentVisit.Consultations;

            foreach (var cons in Consultations.Where(bi => bi.BillItemId == null))
            {
                var newBillItem = new BillItemDto
                {
                    ItemName = $"{cons.MedicalDepartmentName} with Dct. {cons.DoctorFullName} on {cons.StartDate}",
                    SourceType = "Consultation",
                    SourceItemId = cons.Id,
                    UnitPrice = cons.ConsultationCost
                };

                billItems.Add(newBillItem);
            }
        }

        //2. CHECK-UP
        if (CurrentVisit != null && CurrentVisit.LabTests.Any())
        {
            var LabTests = CurrentVisit.LabTests;

            foreach (var cons in LabTests.Where(bi => bi.BillItemId == null))
            {
                var newBillItem = new BillItemDto
                {
                    ItemName = $"{cons.DiseaseName}",
                    SourceType = "LabTest",
                    SourceItemId = cons.Id,
                    UnitPrice = cons.LabTestCost
                };

                billItems.Add(newBillItem);
            }
        }

        //1. TREATMENT
        if (CurrentVisit != null && CurrentVisit.Treatments.Any())
        {
            var Treatments = CurrentVisit.Treatments;

            foreach (var cons in Treatments.Where(bi => bi.BillItemId == null))
            {
                var newBillItem = new BillItemDto
                {
                    ItemName = $"{cons.SurgeryName} {cons.TherapyName} {cons.MedicalDeptName} {cons.WardName}",
                    SourceType = "Treatment",
                    SourceItemId = cons.Id,
                    UnitPrice = cons.TotalCost
                };

                billItems.Add(newBillItem);
            }
        }

        //1. PRESCRIPTION
        if (CurrentVisit != null && CurrentVisit.Prescriptions.Any())
        {
            var Prescriptions = CurrentVisit.Prescriptions;

            foreach (var cons in Prescriptions.Where(bi => bi.BillItemId == null))
            {
                var newBillItem = new BillItemDto
                {
                    ItemName = $"{cons.Quantity}{cons.MedicineName}",
                    SourceType = "Prescription",
                    SourceItemId = cons.Id,
                    UnitPrice = cons.TotalPrice
                };

                billItems.Add(newBillItem);
            }
        }

    }



    private async Task OnSelectedValuesChanged(IReadOnlyCollection<BillItemDto> selectedValues)
    {
        _options = selectedValues;
        billItemsToInvoice.Clear();

        foreach (var dto in _options)
        {
            AddBillItemToInvoiceBatch(dto);
        }

        await InvokeAsync(StateHasChanged);
    }

    private string GetMultiSelectionText(IReadOnlyList<string> selectedItems)
    {
        return $"{selectedItems.Count} item{(selectedItems.Count == 1 ? " has" : "s have")} been selected";
    }

    public void AddBillItemToInvoiceBatch(BillItemDto billItemDto)
    {
        var newBillItem = new BillItemDto
        {
            ItemName = billItemDto.ItemName,
            SourceType = billItemDto.SourceType,
            SourceItemId = billItemDto.SourceItemId,
            UnitPrice = billItemDto.UnitPrice,
            IsAdded = true,
            Quantity = billItemDto.Quantity
        };

        billItemsToInvoice!.Add(newBillItem);

        CurrentBill.TotalAmount = billItemsToInvoice.Sum(bi => bi.SubTotal);
    }

    public async Task RemoveBillItemFromBatch(BillItemDto billItemDto)
    {
        if (billItemsToInvoice != null)
        {
            billItemDto.IsAdded = false;

            billItemsToInvoice.Remove(billItemDto);
            StateHasChanged();
        }
    }


    public async Task SaveBillAsync()
    {
        if (CurrentBill.Id == 0)
        {

            var newBill = new BillDto
            {
                BillDate = DateTime.Now,
                BillNumber = $"NCMH-BN-{DateTime.Now.ToString("yyMMdd")}",
                BillDescription = CurrentBill.BillDescription,
                TotalAmount = CurrentBill.TotalAmount,
                BillTypeId = 1,
                StaffId = CurrentUser.Id,
                BillItems = billItemsToInvoice
            };

            var result = await paymentService.AddBillAsync(newBill);

            if(result != null)
            {
                CurrentBill = result;
                message = $"Bill added successfully";
                CurrentVisit?.Bills.Add(result);

                await UpdateBillIdOnEachInvoicedService();
                await patientService.UpdateVisitAsync(CurrentVisit, CurrentVisit.Id);
            }
        }
        else
        {
            if (CurrentPayment.Id == 0 && CurrentPayment.ConfirmedAmount == CurrentBill.BalanceDue)
            {
                CurrentPayment.PaymentStatusId = 1;
                var result = await paymentService.AddPaymentAsync(CurrentPayment);
                CurrentBill.PaymentId = result;
            }
            else if (CurrentPayment.Id > 0 && CurrentPayment.ConfirmedAmount == CurrentBill.BalanceDue)
            {
                
            }


        }

    }

    private async Task UpdateBillIdOnEachInvoicedService()
    {
        //=============consultation==============
        var cBillItems = CurrentBill.BillItems.Where(bi => bi.SourceType.Trim().ToLower() == "consultation").ToList();

        foreach (var billItem in cBillItems)
        {
            var thisConsultation = await patientService.GetConsultationByIdAsync(billItem.SourceItemId);
            await patientService.UpdateConsultationAsync(thisConsultation ,thisConsultation.Id);
        }
        
        //=============labtest==============
        var lBillItems = CurrentBill.BillItems.Where(bi => bi.SourceType.Trim().ToLower() == "labtest").ToList();

        foreach (var billItem in lBillItems)
        {
            var thisLabTest = await labTestService.GetLabTestByIdAsync(billItem.SourceItemId);
            await labTestService.UpdateLabTestAsync(thisLabTest, thisLabTest.Id);
        }
        
        //=============prescription==============
        var pBillItems = CurrentBill.BillItems.Where(bi => bi.SourceType.Trim().ToLower() == "prescription").ToList();

        foreach (var billItem in pBillItems)
        {
            var thisPresc = await medicineService.GetPrescriptionByIdAsync(billItem.SourceItemId);
            await medicineService.UpdatePrescriptionAsync(thisPresc, thisPresc.Id);
        }

        //=============treatment==============
        var btBillItems = CurrentBill.BillItems.Where(bi => bi.SourceType.Trim().ToLower() == "treatment").ToList();

        foreach (var billItem in btBillItems)
        {
            var thisTreat = await medicineService.GetTreatmentByIdAsync(billItem.SourceItemId);
            await medicineService.UpdateTreatmentAsync(thisTreat, thisTreat.Id);
        }
    }

    private async Task OnPreviewInteraction(StepperInteractionEventArgs arg)
    {
        if (arg.Action == StepAction.Complete)
        {
            // occurrs when clicking next
            await ControlStepCompletion(arg);
        }
        else if (arg.Action == StepAction.Activate)
        {
            // occurrs when clicking a step header with the mouse
            await ControlStepNavigation(arg);
        }
    }

    private async Task ControlStepCompletion(StepperInteractionEventArgs arg)
    {
        switch (arg.StepIndex)
        {
            case 0:
                if (_step1Complete != true)
                {
                    await DialogService.ShowMessageBoxAsync("Error", "You have not flipped the switch in step 1");
                    arg.Cancel = true;
                }
                break;
            case 1:
                if ((_step2TextInput?.Length ?? 0) == 0)
                {
                    await DialogService.ShowMessageBoxAsync("Error", "You have not entered text in step 2");
                    arg.Cancel = true;
                }
                break;
        }
    }

    private async Task ControlStepNavigation(StepperInteractionEventArgs arg)
    {
        switch (arg.StepIndex)
        {
            case 1:
                if (_step1Complete != true)
                {
                    await DialogService.ShowMessageBoxAsync("Error", "Finish step 1 first");
                    arg.Cancel = true;
                }
                break;
            case 2:
                if (_step1Complete != true || (_step2TextInput?.Length ?? 0) == 0)
                {
                    await DialogService.ShowMessageBoxAsync("Error", "Finish step 1 and 2 first");
                    arg.Cancel = true;
                }
                break;
        }
    }
