    public async Task SaveInsuranceClaimAsync(bool submitImmediately)
    {
        if (CurrentBill.Id == 0 || CurrentBill.PaymentModeId != 2)
            return;

        isBusy = true;
        try
        {
            CurrentClaim = await paymentService.CreateOrSubmitClaimAsync(
                CurrentBill.Id, CurrentUser.Id, submitImmediately: submitImmediately);
            CurrentBill = await paymentService.GetBillByIdAsync(CurrentBill.Id);
            message = submitImmediately
                ? $"Claim {CurrentClaim.ClaimNumber} marked as Submitted!"
                : $"Draft Claim {CurrentClaim.ClaimNumber} prepared & ready for print/pickup!";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }


    private async Task OnPreviewInteraction(StepperInteractionEventArgs arg)
    {
        if (arg.Action == StepAction.Complete && arg.StepIndex == 0 && _step1Complete != true)
        {
            await DialogService.ShowMessageBoxAsync("Error", "Please complete the invoice step first.");
            arg.Cancel = true;
        }
    }
