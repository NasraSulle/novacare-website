@page "/billDetails"
@using NovaCare.Shared.DTOs.PaymentDTOs

@inject IDialogService DialogService

<PageTitle>BillModal</PageTitle>

<MudDialog>
    <DialogContent>
        <MudStepper NonLinear ShowResetButton OnPreviewInteraction="OnPreviewInteraction">
            <MudStep Title="Invoice" HasError="@(_step1Complete == false)">
                <MudStack Spacing="0">
                    <MudContainer MaxWidth="MaxWidth.False" Class="flex-grow-1 pa-2">
                        <EditForm Model="CurrentBill" method="post" OnValidSubmit="SaveBillAsync" FormName="newbill">
                            <MudGrid Spacing="1">
                                <MudItem md="9" xs="12">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid Spacing="1">
                                                    <MudItem md="12" sm="12">
                                                        <MudText Typo="Typo.subtitle2">Patient & Bill Details</MudText>
                                                    </MudItem>

                                                    <MudItem md="12" sm="12">
                                                        <MudGrid Spacing="1">
                                                            @if (CurrentBill.Id > 0)
                                                            {
                                                                <MudItem md="7" sm="12">
                                                                    <MudField Label="Patient" Margin="Margin.Dense" Variant="Variant.Outlined">First Middle Last</MudField>
                                                                </MudItem>
                                                                <MudItem md="3" sm="12">
                                                                    <MudField Label="Issued Date" Margin="Margin.Dense" Variant="Variant.Outlined">@DateTime.Now.ToShortDateString()</MudField>
                                                                </MudItem>
                                                                <MudItem md="2" sm="12">
                                                                    <MudField Label="Invoice_No." Margin="Margin.Dense" Variant="Variant.Outlined">#######</MudField>
                                                                </MudItem>
                                                            }
                                                            else{
                                                                <MudItem md="12" sm="12">
                                                                    <MudTextField @bind-Value="patientSearcher" @bind-Value:after="RetrieveActiveVisitItemsAsync" Margin="Margin.Dense"
                                                                                  Label="Search by Patient Code Number or Full name" Variant="Variant.Outlined" Placeholder="Search by Patient Code Number or Full name" />
                                                                </MudItem>
                                                            }
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid Spacing="1">
                                                    <MudItem md="12" sm="12" Class="pt-0 d-flex justify-content-between align-items-center">
                                                        <MudText Typo="Typo.subtitle2">Billing Items (Select for current invoice)</MudText>
                                                        <MudIconButton Size="Size.Medium" Color="Color.Primary" Icon="@Icons.Material.Outlined.Print" title="print invoice pdf" />
                                                    </MudItem>

                                                    <MudItem md="12" sm="12">
                                                        <MudGrid Spacing="1">
                                                            <MudItem md="12" sm="12">
                                                                <MudSelect T="BillItemDto"
                                                                           MultiSelection="true"
                                                                           Variant="Variant.Outlined"
                                                                           Margin="Margin.Dense"
                                                                           SelectAll="true"
                                                                           SelectAllText="Select all items"
                                                                           HelperText="Items"
                                                                           SelectedValues="_options"
                                                                           SelectedValuesChanged="OnSelectedValuesChanged"
                                                                           MultiSelectionTextFunc="GetMultiSelectionText"
                                                                           Label="Select Billing Items"
                                                                           AdornmentIcon="@Icons.Material.Filled.Search">
                                                                    @foreach (var item in billItems)
                                                                    {
                                                                        <MudSelectItem T="BillItemDto" Value="@item">@item.ItemName</MudSelectItem>
                                                                    }
                                                                </MudSelect>

                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                    <MudItem md="12" sm="12">
                                                        <MudGrid Spacing="1">
                                                            <MudItem md="12" sm="12">
                                                                <MudSimpleTable Hover="true" Dense="true" FixedHeader="true" Style="height:220px;">
                                                                    <thead class="sticky-top bg-white" tabindex="1">
                                                                        <tr class="bg-white">
                                                                            @foreach (var h in headings)
                                                                            {
                                                                                <th style="background-color: rgba(63,81,181,0.05);">@h</th>
                                                                            }
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @foreach (var row in billItemsToInvoice)
                                                                        {
                                                                            <tr>
                                                                                <td>@($"{row.SourceType} : {row.ItemName}")</td>
                                                                                <td>@row.UnitPrice</td>
                                                                                <td>@row.Quantity</td>
                                                                                <td colspan="2">@row.SubTotal</td>

                                                                            </tr>
                                                                        }
                                                                    </tbody>

                                                                    <tfoot class="sticky-bottom bg-white" tabindex="1">
                                                                        <tr style="background-color: rgba(63,81,181,0.05);">
                                                                            <th colspan="3">
                                                                                Total
                                                                            </th>
                                                                            <th class="text-start" colspan="2">
                                                                                @(billItemsToInvoice.Sum(bi => bi.SubTotal))
                                                                            </th>
                                                                        </tr>
                                                                    </tfoot>
                                                                </MudSimpleTable>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>

                                <MudItem md="3" xs="12">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid>
                                                    <MudItem md="12" sm="12">
                                                        <MudSimpleTable Hover="true" Dense="true">
                                                            <thead>
                                                                <tr>
                                                                    <th colspan="3">Invoice Summary</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody class="border-0">
                                                                <tr><td colspan="2">Subtotal</td><td>0.00</td></tr>
                                                                <tr><td colspan="2">Tax</td><td>0.00</td></tr>
                                                                <tr><td colspan="2">Insurance Coverage</td><td>0.00</td></tr>
                                                            </tbody>
                                                            <tfoot class="border-top">
                                                                <tr><th colspan="2">Total Due</th><td>0.00</td></tr>
                                                            </tfoot>
                                                        </MudSimpleTable>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid Spacing="1">
                                                    <MudItem md="12" sm="12">
                                                        <MudText Typo="Typo.subtitle2">Payment Plan</MudText>
                                                    </MudItem>

                                                    <MudItem md="12" sm="12">
                                                        <MudGrid Spacing="1">
                                                            <MudItem md="12" sm="12" Class="d-flex flex-column">
                                                                <MudText Typo="Typo.caption">Payment Status: UnPaid</MudText>
                                                                <MudText Typo="Typo.caption">Payment Mode: Cash</MudText>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid Spacing="1">
                                                    <MudItem md="12" sm="12">
                                                        <MudText Typo="Typo.subtitle2">Notes</MudText>
                                                    </MudItem>

                                                    <MudItem md="12" sm="12">
                                                        <MudGrid Spacing="1">
                                                            <MudItem md="12" sm="12">
                                                                <MudTextField Typo="Typo.caption" @bind-Value="CurrentBill.BillDescription" Margin="Margin.Dense" T="string"
                                                                              Lines="6" Sizing="InputSizing.Fixed" Text="@CurrentBill.BillDescription"
                                                                              Label="Description" Variant="Variant.Outlined" Placeholder="Additional billing notes" />

                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    </MudContainer>

                </MudStack>
            </MudStep>
            <MudStep Title="Payments" HasError="@(_step2TextInput == "")">
                <MudStack Spacing="0">
                    <MudContainer MaxWidth="MaxWidth.False" Class="flex-grow-1 pa-2">
                        <EditForm Model="CurrentBill" method="post" OnValidSubmit="SaveBillAsync" FormName="newbill">
                            <MudGrid Spacing="1">
                                <MudItem md="12" xs="12">
                                    <MudGrid Spacing="1">
                                        <MudItem md="9" xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid>
                                                    <MudItem md="12" sm="12">
                                                        <MudSimpleTable Hover="true" Dense="true">
                                                            <thead>
                                                                <tr>
                                                                    <th colspan="3">Invoice Summary</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody class="border-0">
                                                                <tr><td colspan="2">Subtotal</td><td>0.00</td></tr>
                                                                <tr><td colspan="2">Tax</td><td>0.00</td></tr>
                                                                <tr><td colspan="2">Insurance Coverage</td><td>0.00</td></tr>
                                                            </tbody>
                                                            <tfoot class="border-top">
                                                                <tr><th colspan="2">Total Due</th><td>0.00</td></tr>
                                                            </tfoot>
                                                        </MudSimpleTable>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem md="3" xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid Spacing="1">
                                                    <MudItem md="12" sm="12">
                                                        <MudText Typo="Typo.subtitle2">Payment Plan</MudText>
                                                    </MudItem>

                                                    <MudItem md="12" sm="12">
                                                        <MudGrid Spacing="1">
                                                            <MudItem md="12" sm="12" Class="d-flex flex-column">
                                                                <MudText Typo="Typo.caption">Payment Status: UnPaid</MudText>
                                                                <MudText Typo="Typo.caption">Payment Mode: Cash</MudText>
                                                            </MudItem>
                                                        </MudGrid>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                        <MudItem md="12" xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid Spacing="1">
                                                    @if (CurrentBill.PaymentModeName == "cash")
                                                    {
                                                        <MudItem md="12" sm="12">
                                                            <MudText Typo="Typo.subtitle2">Payment Details</MudText>
                                                        </MudItem>

                                                        <MudItem md="12" sm="12">
                                                            <MudGrid Spacing="1">
                                                                <MudItem md="12" sm="12">
                                                                    <div class="row">

                                                                        <div class="col-md-12 form-floating mb-3 pt-3">
                                                                            <div class="input-group">
                                                                                <span class="input-group-text">Select Payment Type</span>
                                                                                <InputSelect @bind-Value="CurrentPayment.PayType" class="form-select">
                                                                                    @foreach (var type in Enum.GetValues(typeof(PaymentType)))
                                                                                    {
                                                                                        <option value="@type">@type</option>
                                                                                    }
                                                                                </InputSelect>
                                                                            </div>
                                                                        </div>

                                                                        @if (CurrentPayment.PayType.ToString() == "Wire_Transfer")
                                                                        {
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Reference No.</span>
                                                                                    <InputText @bind-Value="CurrentPayment.WireReferenceNo" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Transfer Date</span>
                                                                                    <InputDate @bind-Value="CurrentPayment.WireTransferDate" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Source Account</span>
                                                                                    <InputText @bind-Value="CurrentPayment.WireSourceAcc" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Source Bank</span>
                                                                                    <InputSelect @bind-Value="CurrentPayment.WireSourceBank" class="form-select">
                                                                                        @foreach (var type in Enum.GetValues(typeof(BankType)))
                                                                                        {
                                                                                            <option value="@type">@type</option>
                                                                                        }
                                                                                    </InputSelect>
                                                                                </div>
                                                                            </div>
                                                                        }

                                                                        @if (CurrentPayment.PayType.ToString() == "Cash")
                                                                        {
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Reference No.</span>
                                                                                    <InputText @bind-Value="CurrentPayment.CashReferenceNumber" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Received By</span>
                                                                                    <InputText @bind-Value="CurrentPayment.CashReceivedBy" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                        }

                                                                        @if (CurrentPayment.PayType.ToString() == "Cheque")
                                                                        {
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Bank Name</span>
                                                                                    <InputSelect @bind-Value="CurrentPayment.ChequeBank" class="form-select">
                                                                                        @foreach (var type in Enum.GetValues(typeof(BankType)))
                                                                                        {
                                                                                            <option value="@type">@type</option>
                                                                                        }
                                                                                    </InputSelect>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Cheque Number</span>
                                                                                    <InputText @bind-Value="CurrentPayment.ChequeNumber" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Account Name</span>
                                                                                    <InputText @bind-Value="CurrentPayment.ChequeAccName" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Account Number</span>
                                                                                    <InputText @bind-Value="CurrentPayment.ChequeAccNumber" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        @if (CurrentPayment.PayType.ToString() == "Card")
                                                                        {
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Card Holder</span>
                                                                                    <InputText @bind-Value="CurrentPayment.CardHolder" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Card Type</span>
                                                                                    <InputSelect @bind-Value="CurrentPayment.CardOfType" class="form-select">
                                                                                        @foreach (var type in Enum.GetValues(typeof(CardType)))
                                                                                        {
                                                                                            <option value="@type">@type</option>
                                                                                        }
                                                                                    </InputSelect>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-12 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Card Number</span>
                                                                                    <InputText @bind-Value="CurrentPayment.CardNumber" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        @if (CurrentPayment.PayType.ToString() == "MNO")
                                                                        {
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Mobile Network</span>
                                                                                    <InputSelect @bind-Value="CurrentPayment.MNOOperator" class="form-select">
                                                                                        @foreach (var type in Enum.GetValues(typeof(MobileOperator)))
                                                                                        {
                                                                                            <option value="@type">@type</option>
                                                                                        }
                                                                                    </InputSelect>
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-6 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Phone Number</span>
                                                                                    <InputText @bind-Value="CurrentPayment.MNONumber" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                            <div class="col-md-12 form-floating mb-3">
                                                                                <div class="input-group">
                                                                                    <span class="input-group-text">Payment Reference No.</span>
                                                                                    <InputText @bind-Value="CurrentPayment.MNOReference" class="form-control" placeholder="" />
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                        <div class="col-md-12 d-flex justify-content-between">
                                                                            <div class="col">
                                                                                <div class="input-group mb-3">
                                                                                    <span class="input-group-text">Amount Payable</span>
                                                                                    <span class="form-control">@CurrentPayment.Amount</span>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </MudItem>
                                                            </MudGrid>
                                                        </MudItem>
                                                    }
                                                    else
                                                    {
                                                        <MudItem md="12" sm="12">
                                                            <MudText Typo="Typo.subtitle2">Insurance Claim (As per payment mode registered for this visit)</MudText>
                                                        </MudItem>

                                                        <MudItem md="12" sm="12">
                                                            <MudGrid Spacing="1">
                                                                <MudItem md="7" sm="12">
                                                                    <MudField Margin="Margin.Dense" Label="Outlined" Variant="Variant.Outlined">@($"Company: NHIF")</MudField>
                                                                </MudItem>
                                                                <MudItem md="4" sm="12">
                                                                    <MudField Margin="Margin.Dense" Label="Outlined" Variant="Variant.Outlined">@($"ID_NO: NH231")</MudField>
                                                                </MudItem>
                                                                <MudItem md="1" sm="12" Class="d-flex justify-content-end align-items-center">
                                                                    <MudIconButton Size="Size.Medium" Color="Color.Primary" Icon="@Icons.Material.Outlined.Print" title="Preview Claim Pdf" />
                                                                    <MudIconButton Size="Size.Medium" Color="Color.Primary" Icon="@Icons.Material.Outlined.Email" title="Send via email" />
                                                                </MudItem>
                                                            </MudGrid>
                                                        </MudItem>
                                                    }
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    </MudContainer>

                </MudStack>
            </MudStep>
            <MudStep Title="Closing">
                <MudStack Spacing="0">
                    <MudContainer MaxWidth="MaxWidth.False" Class="flex-grow-1 pa-2">
                        <EditForm Model="CurrentBill" method="post" OnValidSubmit="SaveBillAsync" FormName="newbill">
                            <MudGrid Spacing="1">
                                <MudItem md="4" xs="12">

                                    <MudItem md="12" xs="12">
                                        <MudPaper Class="pa-3 ma-2" Outlined="true">
                                            <MudGrid Spacing="1">
                                                <MudItem md="12" sm="12">
                                                    <MudText Typo="Typo.subtitle2">Closing Disclaimer</MudText>
                                                </MudItem>

                                                <MudItem md="12" sm="12">
                                                    <MudGrid Spacing="1">
                                                        <MudItem md="12" sm="12">
                                                            <MudItem md="12" sm="12" Class="d-flex flex-column mb-5">
                                                                <MudText Typo="Typo.caption">@($"Patient: FullName -P_code") </MudText>
                                                                <MudText Typo="Typo.caption">@($"Invoice_No: NH231") </MudText>
                                                                <MudText Typo="Typo.caption">@($"Visit_No: NH231") </MudText>
                                                                <MudText Typo="Typo.caption">@($"Note: Current visit still has 0 unpaid bills hence cashier can complete it upon patient's request'") </MudText>
                                                            </MudItem>
                                                        </MudItem>
                                                        <MudItem md="12" sm="12" Class="mt-5">
                                                            <MudItem md="12" xs="12" Class="vitals-bridge animate-rise-in">
                                                                <MudGrid Spacing="1" Class="pa-3" Style="position: relative; z-index: 2;">
                                                                    <MudItem xs="12" md="12">
                                                                        <MudText Typo="Typo.body2" Class="text-white text-opacity-75 mb-3" Style="line-height: 1.55;">
                                                                           <em>
                                                                            Dear Cashier always keep in mind that visits with unpaid bills are to be cleared by customer to be completed by the cashier
                                                                            </em>
                                                                        </MudText>
                                                                    </MudItem>
                                                                </MudGrid>
                                                            </MudItem>
                                                        </MudItem>
                                                        <MudItem md="12" sm="12" Class="d-flex justify-content-end align-items-center">
                                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Outlined.AssistWalker">Complete Visit</MudButton>
                                                            @* <MudIconButton Size="Size.Medium" Color="Color.Primary" Icon="@Icons.Material.Outlined.Print" title="Preview Claim Pdf" />
                                                            <MudIconButton Size="Size.Medium" Color="Color.Primary" Icon="@Icons.Material.Outlined.Email" title="Send via email" /> *@
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    </MudItem>
                                </MudItem>
                                <MudItem md="8" xs="12" Class="border-0 pa-3">
                                    <!--recept-->
                                    <MudGrid>
                                        <MudItem md="12" xs="12" Class="d-flex justify-content-between">
                                            <MudText>Receipt</MudText>
                                            <MudIconButton Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Outlined.Print" title="print receiptf" />
                                        </MudItem>
                                        <MudItem md="12" xs="12" Class="pt-0" Style="">
                                            <MudPaper Elevation="0">
                                                <iframe src="data:application/pdf;base64,@PdfBase64" style="height:460px;"></iframe>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    </MudContainer>

                </MudStack>
            </MudStep>
        </MudStepper>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error" Variant="Variant.Filled">Close</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SaveBillAsync">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    public string icon = Icons.Material.Filled.Payments;
    public string title = "Bill Details";
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();

    List<BillItemDto> billItems = new();
    List<BillItemDto> billItemsToInvoice = new();
    BillItemDto AdHocComposition = new();

    BillDto CurrentBill = new();
    PaymentDto CurrentPayment = new();
    VisitDto? CurrentVisit;
    string patientSearcher = string.Empty;
    string[] headings = { "Description", "Price", "Qty", "Amount", "" };
