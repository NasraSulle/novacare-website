@page "/billDetails"
@using NovaCare.Shared.DTOs.PaymentDTOs
@using NovaCare.Shared.Enums

@inject IDialogService DialogService

<PageTitle>Bill Details</PageTitle>

<MudDialog>
    <DialogContent>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="Severity.Success" Class="mb-2" ShowCloseIcon="true" CloseIconClicked="@(() => message = string.Empty)">
                @message
            </MudAlert>
        }

        <MudStepper NonLinear ShowResetButton OnPreviewInteraction="OnPreviewInteraction">
            <!-- ==================== STEP 1: INVOICE & COVERAGE SPLIT ==================== -->
            <MudStep Title="Invoice" HasError="@(_step1Complete == false)">
                <MudStack Spacing="0">
                    <MudContainer MaxWidth="MaxWidth.False" Class="flex-grow-1 pa-2">
                        <EditForm Model="CurrentBill" OnValidSubmit="SaveBillAsync" FormName="newbill">
                            <MudGrid Spacing="1">
                                <MudItem md="9" xs="12">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid Spacing="1">
                                                    <MudItem md="12" sm="12">
                                                        @* <MudText Typo="Typo.subtitle2"> *@
                                                        <MudText Typo="Typo.subtitle2"
                                                                 Style="background: linear-gradient(to right, #4e3ee0ff, rgba(0, 123, 255, 0));" Class="p-2 text-white">
                                                            Patient & Bill Details</MudText>
                                                    </MudItem>

                                                    @if (CurrentBill.Id > 0)
                                                    {
                                                        <MudItem md="6" sm="12">
                                                            <MudField Label="Patient" Margin="Margin.Dense" Variant="Variant.Outlined">@CurrentBill.PatientFullName</MudField>
                                                        </MudItem>
                                                        <MudItem md="2" sm="12">
                                                            <MudField Label="Issued Date" Margin="Margin.Dense" Variant="Variant.Outlined">@CurrentBill.BillDate.ToLocalTime().ToString("dd MMM yyyy")</MudField>
                                                        </MudItem>
                                                        <MudItem md="4" sm="12">
                                                            <MudField Label="Invoice No." Margin="Margin.Dense" Variant="Variant.Outlined">@CurrentBill.BillNumber</MudField>
                                                        </MudItem>
                                                    }
                                                    else
                                                    {
                                                        <MudItem md="12" sm="12">
                                                            <MudTextField @bind-Value="patientSearcher" @bind-Value:after="RetrieveActiveVisitItemsAsync" Margin="Margin.Dense"
                                                                          Label="Search by Patient Code Number or Full name" Variant="Variant.Outlined" Placeholder="e.g. PCN1001 or Full Name" />
                                                        </MudItem>
                                                    }
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudGrid Spacing="1">
                                                    <MudItem md="12" sm="12" Class="pt-0 d-flex justify-content-between align-items-center">
                                                        <MudText Typo="Typo.subtitle2">Billing Items & Coverage Breakdown</MudText>
                                                        <MudIconButton Size="Size.Medium" Color="Color.Primary" Icon="@Icons.Material.Outlined.Print" title="Print invoice PDF" />
                                                    </MudItem>

                                                    @if (billItems.Any())
                                                    {
                                                        <MudItem md="12" sm="12">
                                                            <MudSelect T="BillItemDto"
                                                                       MultiSelection="true"
                                                                       Variant="Variant.Outlined"
                                                                       Margin="Margin.Dense"
                                                                       SelectAll="true"
                                                                       SelectAllText="Select all unbilled items"
                                                                       SelectedValues="_options"
                                                                       SelectedValuesChanged="OnSelectedValuesChanged"
                                                                       MultiSelectionTextFunc="GetMultiSelectionText"
                                                                       Label="Add Additional Unbilled Visit Items"
                                                                       AdornmentIcon="@Icons.Material.Filled.Search">
                                                                @foreach (var item in billItems)
                                                                {
                                                                    <MudSelectItem T="BillItemDto" Value="@item">@($"{item.SourceType}: {item.ItemName} ({item.UnitPrice:N2})")</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </MudItem>
                                                    }

                                                    <MudItem md="12" sm="12">
                                                        <MudSimpleTable Hover="true" Dense="true" FixedHeader="true" Style="height:240px;">
                                                            <thead class="sticky-top bg-white">
                                                                <tr>
                                                                    @foreach (var h in headings)
                                                                    {
                                                                        <th style="background-color: rgba(63,81,181,0.08);">@h</th>
                                                                    }
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var row in billItemsToInvoice)
                                                                {
                                                                    <tr>
                                                                        <td>@($"{row.SourceType} : {row.ItemName}")</td>
                                                                        <td>@row.UnitPrice.ToString("N2")</td>
                                                                        <td>@row.Quantity</td>
                                                                        <td class="text-success">@row.InsuranceCoveredAmount.ToString("N2") (@row.InsuranceCoveragePercent.ToString("0")%)</td>
                                                                        <td class="fw-bold">@row.PatientPayableAmount.ToString("N2")</td>
                                                                        <td></td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                            <tfoot class="sticky-bottom bg-white">
                                                                <tr style="background-color: rgba(63,81,181,0.08);">
                                                                    <th colspan="3">Totals (@billItemsToInvoice.Sum(bi => bi.SubTotal).ToString("N2"))</th>
                                                                    <th class="text-success">@billItemsToInvoice.Sum(bi => bi.InsuranceCoveredAmount).ToString("N2")</th>
                                                                    <th>@billItemsToInvoice.Sum(bi => bi.PatientPayableAmount).ToString("N2")</th>
                                                                    <th></th>
                                                                </tr>
                                                            </tfoot>
                                                        </MudSimpleTable>
                                                    </MudItem>
                                                </MudGrid>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                                                                <!-- RIGHT SIDEBAR: LIVE SPLIT SUMMARY & PAYMENT PLAN -->
                                <MudItem md="3" xs="12">
                                    <MudGrid Spacing="1">
                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudSimpleTable Hover="true" Dense="true">
                                                    <thead>
                                                        <tr><th colspan="2">Invoice Summary</th></tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr><td>Total Bill</td><td class="text-end">@CurrentBill.TotalAmount.ToString("N2")</td></tr>
                                                        <tr><td>Insurance Share</td><td class="text-end text-success">- @CurrentBill.TotalInsuranceAmount.ToString("N2")</td></tr>
                                                        <tr><td>Patient Copay/Cash</td><td class="text-end">@CurrentBill.TotalPatientAmount.ToString("N2")</td></tr>
                                                        <tr><td>Paid So Far</td><td class="text-end text-primary">@CurrentBill.PaidAmount.ToString("N2")</td></tr>
                                                    </tbody>
                                                    <tfoot class="border-top">
                                                        <tr><th>Patient Due</th><th class="text-end text-danger">@CurrentBill.PatientBalanceDue.ToString("N2")</th></tr>
                                                    </tfoot>
                                                </MudSimpleTable>
                                            </MudPaper>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudText Typo="Typo.subtitle2" Class="mb-1">Payment Plan</MudText>
                                                <MudText Typo="Typo.caption" Class="d-block">Status: <b>@CurrentBill.PaymentStatusName</b></MudText>
                                                <MudText Typo="Typo.caption" Class="d-block">Mode: <b>@CurrentBill.PaymentModeName</b></MudText>
                                                @if (CurrentBill.PaymentModeId == 2 && !string.IsNullOrWhiteSpace(CurrentBill.InsuranceProviderName))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Info" Class="d-block">Insurer: <b>@CurrentBill.InsuranceProviderName</b></MudText>
                                                }
                                            </MudPaper>
                                        </MudItem>

                                        <MudItem xs="12">
                                            <MudPaper Class="pa-3 ma-2" Outlined="true">
                                                <MudText Typo="Typo.subtitle2">Notes</MudText>
                                                <MudTextField @bind-Value="CurrentBill.BillDescription" Margin="Margin.Dense" Lines="4"
                                                              Label="Description" Variant="Variant.Outlined" Placeholder="Additional billing notes" />
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    </MudContainer>
                </MudStack>
            </MudStep>

            <!-- ==================== STEP 2: PAYMENTS & INSURANCE CLAIM ==================== -->
            <MudStep Title="Payments" HasError="@(_step2TextInput == "")">
                <MudStack Spacing="0">
                    <MudContainer MaxWidth="MaxWidth.False" Class="flex-grow-1 pa-2">
                        <MudGrid Spacing="1">
                            <MudItem md="8" xs="12">
                                <MudPaper Class="pa-3 ma-2" Outlined="true">
                                    <MudSimpleTable Hover="true" Dense="true">
                                        <thead>
                                            <tr><th colspan="2" class="px-0">
                                                <MudText Typo="Typo.subtitle2"
                                                     Style="background: linear-gradient(to right, green, rgba(0, 123, 255, 0));" Class="p-2 text-white">
                                                     @* Style="background: linear-gradient(to right, #4e3ee0ff, rgba(0, 123, 255, 0));" Class="p-2 text-white"> *@
                                                Balance Breakdown</MudText></th></tr>
                                        </thead>
                                        <tbody>
                                            <tr><td>Total Invoice Amount</td><td class="text-end">@CurrentBill.TotalAmount.ToString("N2")</td></tr>
                                            <tr><td>Insurance Covered (@CurrentBill.InsuranceProviderName)</td><td class="text-end text-success">@CurrentBill.TotalInsuranceAmount.ToString("N2")</td></tr>
                                            <tr><td>Patient Payable (Copay / Uncovered)</td><td class="text-end">@CurrentBill.TotalPatientAmount.ToString("N2")</td></tr>
                                            <tr><td>Patient Paid</td><td class="text-end text-primary">@CurrentBill.PatientPaidAmount.ToString("N2")</td></tr>
                                        </tbody>
                                        <tfoot class="border-top">
                                            <tr><th>Remaining Patient Balance Due</th><th class="text-end text-danger">@CurrentBill.PatientBalanceDue.ToString("N2")</th></tr>
                                        </tfoot>
                                    </MudSimpleTable>
                                </MudPaper>
                            </MudItem>

                            <MudItem md="4" xs="12">
                                <MudPaper Class="pa-3 ma-2" Outlined="true">
                                    <MudText Typo="Typo.subtitle2" Class="mb-1">Billing Status</MudText>
                                    <MudText Typo="Typo.caption" Class="d-block">Payment Status: <b>@CurrentBill.PaymentStatusName</b></MudText>
                                    <MudText Typo="Typo.caption" Class="d-block">Payment Mode: <b>@CurrentBill.PaymentModeName</b></MudText>
                                    @if (CurrentClaim != null)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Success" Class="d-block mt-1">
                                            Claim: <b>@CurrentClaim.ClaimNumber</b> (@CurrentClaim.Status)
                                        </MudText>
                                    }
                                </MudPaper>
                            </MudItem>
                            @if (CurrentBill.PatientBalanceDue > 0 || CurrentBill.PaymentModeId != 2)
                            {
                                <MudItem md="12" xs="12">
                                    <MudPaper Class="pa-3 ma-2" Outlined="true">
                                        <MudText Typo="Typo.subtitle2" Class="mb-2">Collect Patient Payment (Cash / MNO / Card / Bank)</MudText>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <div class="input-group">
                                                    <span class="input-group-text">Payment Method</span>
                                                    <InputSelect @bind-Value="CurrentPayment.PayType" class="form-select">
                                                        @foreach (PaymentType type in Enum.GetValues(typeof(PaymentType)))
                                                        {
                                                            if (type != PaymentType.Insurance)
                                                            {
                                                                <option value="@type">@type</option>
                                                            }
                                                        }
                                                    </InputSelect>
                                                </div>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <div class="input-group">
                                                    <span class="input-group-text">Amount Paying Now</span>
                                                    <InputNumber @bind-Value="CurrentPayment.Amount" class="form-control" />
                                                </div>
                                            </div>

                                            @if (CurrentPayment.PayType == PaymentType.Cash)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Receipt / Ref No.</span>
                                                        <InputText @bind-Value="CurrentPayment.CashReferenceNumber" class="form-control" />
                                                    </div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Received By</span>
                                                        <InputText @bind-Value="CurrentPayment.CashReceivedBy" class="form-control" />
                                                    </div>
                                                </div>
                                            }
                                            else if (CurrentPayment.PayType == PaymentType.MNO)
                                            {
                                                <div class="col-md-4 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Operator</span>
                                                        <InputSelect @bind-Value="CurrentPayment.MNOOperator" class="form-select">
                                                            @foreach (MobileOperator op in Enum.GetValues(typeof(MobileOperator)))
                                                            {
                                                                <option value="@op">@op</option>
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Phone Number</span>
                                                        <InputText @bind-Value="CurrentPayment.MNONumber" class="form-control" />
                                                    </div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">MNO Transaction ID</span>
                                                        <InputText @bind-Value="CurrentPayment.MNOReference" class="form-control" />
                                                    </div>
                                                </div>
                                            }
                                            else if (CurrentPayment.PayType == PaymentType.Card)
                                            {
                                                <div class="col-md-4 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Card Holder</span>
                                                        <InputText @bind-Value="CurrentPayment.CardHolder" class="form-control" />
                                                    </div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Card Type</span>
                                                        <InputSelect @bind-Value="CurrentPayment.CardOfType" class="form-select">
                                                            @foreach (CardType ct in Enum.GetValues(typeof(CardType)))
                                                            {
                                                                <option value="@ct">@ct</option>
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                </div>
                                                <div class="col-md-4 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Card Number</span>
                                                        <InputText @bind-Value="CurrentPayment.CardNumber" class="form-control" />
                                                    </div>
                                                </div>
                                            }
                                            else if (CurrentPayment.PayType == PaymentType.Cheque)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Bank</span>
                                                        <InputSelect @bind-Value="CurrentPayment.ChequeBank" class="form-select">
                                                            @foreach (BankType bank in Enum.GetValues(typeof(BankType)))
                                                            {
                                                                <option value="@bank">@bank</option>
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Cheque No.</span>
                                                        <InputText @bind-Value="CurrentPayment.ChequeNumber" class="form-control" />
                                                    </div>
                                                </div>
                                            }
                                            else if (CurrentPayment.PayType == PaymentType.Wire_Transfer)
                                            {
                                                <div class="col-md-6 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Source Bank</span>
                                                        <InputSelect @bind-Value="CurrentPayment.WireSourceBank" class="form-select">
                                                            @foreach (BankType bank in Enum.GetValues(typeof(BankType)))
                                                            {
                                                                <option value="@bank">@bank</option>
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                </div>
                                                <div class="col-md-6 mb-3">
                                                    <div class="input-group">
                                                        <span class="input-group-text">Wire Ref No.</span>
                                                        <InputText @bind-Value="CurrentPayment.WireReferenceNo" class="form-control" />
                                                    </div>
                                                </div>
                                            }

                                            <div class="col-md-12 text-end">
                                                <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(isBusy || CurrentPayment.Amount <= 0)" OnClick="RecordPatientPaymentAsync">
                                                    Record Patient Payment (@CurrentPayment.Amount.ToString("N2"))
                                                </MudButton>
                                            </div>
                                        </div>
                                    </MudPaper>
                                </MudItem>
                            }

                            @if (CurrentBill.PaymentModeId == 2)
                            {
                                <MudItem md="12" xs="12">
                                    <MudPaper Class="pa-3 ma-2" Outlined="true">
                                        <MudGrid AlignItems="Center">
                                            <MudItem md="4" sm="12">
                                                <MudField Margin="Margin.Dense" Label="Insurance Provider" Variant="Variant.Outlined">@CurrentBill.InsuranceProviderName</MudField>
                                            </MudItem>
                                            <MudItem md="4" sm="12">
                                                <MudField Margin="Margin.Dense" Label="Claimable Amount" Variant="Variant.Outlined">@CurrentBill.TotalInsuranceAmount.ToString("N2")</MudField>
                                            </MudItem>
                                            <MudItem md="4" sm="12" Class="text-end">
                                                @* @if (CurrentClaim == null)
                                                {
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" Disabled="@isBusy" OnClick="SubmitInsuranceClaimAsync">
                                                        Submit Insurance Claim
                                                    </MudButton>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">
                                                        @($"Submitted: {CurrentClaim.ClaimNumber} ({CurrentClaim.Status})")
                                                    </MudChip>
                                                } *@
                                                @if (CurrentClaim == null || CurrentClaim.Status == ClaimStatus.Draft)
                                                {
                                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                                               Disabled="@isBusy" Class="me-1" OnClick="@(() => SaveInsuranceClaimAsync(false))">
                                                        Save Draft Claim
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                                                               Disabled="@isBusy" OnClick="@(() => SaveInsuranceClaimAsync(true))">
                                                        Mark Submitted
                                                    </MudButton>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle">
                                                        @($"{CurrentClaim.ClaimNumber} ({CurrentClaim.Status})")
                                                    </MudChip>
                                                }

                                            </MudItem>
                                        </MudGrid>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudContainer>
                </MudStack>
            </MudStep>
            <MudStep Title="Closing">
                <MudStack Spacing="0">
                    <MudContainer MaxWidth="MaxWidth.False" Class="flex-grow-1 pa-2">
                        <EditForm Model="CurrentBill" method="post" OnValidSubmit="SaveBillAsync" FormName="newbill">
                            <MudGrid Spacing="1">
                                <MudItem md="4" xs="12">

                                    <MudItem md="12" xs="12">
                                        <MudPaper Class="pa-3 ma-2" Outlined="true">
                                            <MudGrid Spacing="1">
                                                <MudItem md="12" sm="12">
                                                    <MudText Typo="Typo.subtitle2"
                                                        Style="background: linear-gradient(to right, red, rgba(0, 123, 255, 0));" Class="p-2 text-white">

                                                        Closing Disclaimer</MudText>
                                                </MudItem>

                                                <MudItem md="12" sm="12">
                                                    <MudGrid Spacing="1">
                                                        <MudItem md="12" sm="12">
                                                            <MudItem md="12" sm="12" Class="d-flex flex-column mb-5">
                                                                <MudText Typo="Typo.caption">@($"Patient: {CurrentBill.PatientFullName}")</MudText>
                                                                <MudText Typo="Typo.caption">@($"Invoice No: {CurrentBill.BillNumber}")</MudText>
                                                                <MudText Typo="Typo.caption">@($"Visit ID: #{CurrentBill.VisitId}")</MudText>
                                                                <MudText Typo="Typo.caption" Color="@(CurrentBill.PatientBalanceDue > 0 ? Color.Error : Color.Success)">
                                                                    @if (CurrentBill.PatientBalanceDue > 0)
                                                                    {
                                                                        @($"Note: Patient still owes {CurrentBill.PatientBalanceDue:N2}. Collect balance before completing visit.")
                                                                    }
                                                                    else
                                                                    {
                                                                        @("Note: Patient balance is cleared. Cashier can complete this visit upon request.")
                                                                    }
                                                                </MudText>
                                                            </MudItem>

                                                        </MudItem>
                                                        <MudItem md="12" sm="12" Class="mt-5">
                                                            <MudItem md="12" xs="12" Class="vitals-bridge animate-rise-in">
                                                                <MudGrid Spacing="1" Class="pa-3" Style="position: relative; z-index: 2;">
                                                                    <MudItem xs="12" md="12">
                                                                        <MudText Typo="Typo.body2" Class="text-white text-opacity-75 mb-3" Style="line-height: 1.55;">
                                                                            <em>
                                                                                Dear Cashier always keep in mind that visits with unpaid bills are to be cleared by customer to be completed by the cashier
                                                                            </em>
                                                                        </MudText>
                                                                    </MudItem>
                                                                </MudGrid>
                                                            </MudItem>
                                                        </MudItem>
                                                        <MudItem md="12" sm="12" Class="d-flex justify-content-end align-items-center">
                                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Outlined.AssistWalker">Complete Visit</MudButton>
                                                            @* <MudIconButton Size="Size.Medium" Color="Color.Primary" Icon="@Icons.Material.Outlined.Print" title="Preview Claim Pdf" />
                                                            <MudIconButton Size="Size.Medium" Color="Color.Primary" Icon="@Icons.Material.Outlined.Email" title="Send via email" /> *@
                                                        </MudItem>
                                                    </MudGrid>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    </MudItem>
                                </MudItem>
                                <MudItem md="8" xs="12" Class="border-0 pa-3">
                                    <!--recept-->
                                    <MudGrid>
                                        <MudItem md="12" xs="12" Class="d-flex justify-content-between">
                                            <MudText>Receipt</MudText>
                                            <MudIconButton Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Outlined.Print" title="print receiptf" />
                                        </MudItem>
                                        <MudItem md="12" xs="12" Class="pt-0" Style="">
                                            <MudPaper Elevation="0">
                                                <iframe src="data:application/pdf;base64,@PdfBase64" style="height:460px;"></iframe>
                                            </MudPaper>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            </MudGrid>
                        </EditForm>
                    </MudContainer>

                </MudStack>
            </MudStep>
        </MudStepper>

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Error" Variant="Variant.Filled">Close</MudButton>
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SaveBillAsync">Save</MudButton>
    </DialogActions>
</MudDialog>


@code {
    public string icon = Icons.Material.Filled.Payments;
    public string title = "Bill Details";

    [Parameter] public BillDto CurrentBill { get; set; } = new();
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    List<BillItemDto> billItems = new();
    List<BillItemDto> billItemsToInvoice = new();
    PaymentDto CurrentPayment = new() { PayType = PaymentType.Cash };
    InsuranceClaimDto? CurrentClaim;
    VisitDto? CurrentVisit;

    string patientSearcher = string.Empty;
    string[] headings = { "Description", "Price", "Qty", "Insurance", "Patient Due", "" };
    private IReadOnlyCollection<BillItemDto> _options = Array.Empty<BillItemDto>();

    private bool? _step1Complete = true;
    private string _step2TextInput = "ready";
