    private void Cancel() => MudDialog.Cancel();

    protected override async Task OnInitializedAsync()
    {
        if (CurrentBill.Id > 0)
        {
            // Load full bill with BillItems, Payments & Split Totals
            CurrentBill = await paymentService.GetBillByIdAsync(CurrentBill.Id);
            billItemsToInvoice = CurrentBill.BillItems.ToList();
            CurrentPayment.BillId = CurrentBill.Id;
            CurrentPayment.Amount = CurrentBill.PatientBalanceDue > 0 ? CurrentBill.PatientBalanceDue : 0m;

            if (CurrentBill.PaymentModeId == 2)
            {
                CurrentClaim = await paymentService.GetClaimByBillIdAsync(CurrentBill.Id);
            }
        }
    }

    public async Task RetrieveActiveVisitItemsAsync()
    {
        if (string.IsNullOrWhiteSpace(patientSearcher))
            return;

        CurrentVisit = await patientService.GetVisitByPCodeOrFullNameAsync(patientSearcher);
        billItems.Clear();

        if (CurrentVisit == null)
            return;

        CurrentBill.VisitId = CurrentVisit.Id;
        CurrentBill.PatientFullName = CurrentVisit.PatientFullName;
        CurrentBill.PaymentModeId = CurrentVisit.PaymentModeId;
        CurrentBill.PaymentModeName = CurrentVisit.RegisteredPaymentMode;
        CurrentBill.PatientInsuaranceId = CurrentVisit.PatientInsuaranceId;
        CurrentBill.InsuranceProviderName = CurrentVisit.InsuranceProviderName;

        // Pull any unbilled items from this visit
        foreach (var cons in CurrentVisit.Consultations.Where(bi => bi.BillItemId == null))
        {
            billItems.Add(new BillItemDto
            {
                ItemName = $"{cons.MedicalDepartmentName} with Dr. {cons.DoctorFullName}",
                SourceType = "Consultation",
                SourceItemId = cons.Id,
                Quantity = 1,
                UnitPrice = cons.ConsultationCost
            });
        }

        foreach (var lab in CurrentVisit.LabTests.Where(bi => bi.BillItemId == null))
        {
            billItems.Add(new BillItemDto
            {
                ItemName = lab.DiseaseName,
                SourceType = "LabTest",
                SourceItemId = lab.Id,
                Quantity = 1,
                UnitPrice = lab.LabTestCost
            });
        }

        foreach (var treat in CurrentVisit.Treatments.Where(bi => bi.BillItemId == null))
        {
            billItems.Add(new BillItemDto
            {
                ItemName = $"{treat.TreatmentTypeName}: {treat.SurgeryName} {treat.TherapyName} {treat.WardName}".Trim(),
                SourceType = "Treatment",
                SourceItemId = treat.Id,
                Quantity = treat.TreatmentQty > 0 ? treat.TreatmentQty : 1,
                UnitPrice = treat.TreatmentCost
            });
        }

        foreach (var presc in CurrentVisit.Prescriptions.Where(bi => bi.BillItemId == null))
        {
            billItems.Add(new BillItemDto
            {
                ItemName = $"{presc.MedicineName} ({presc.Quantity})",
                SourceType = "Prescription",
                SourceItemId = presc.Id,
                Quantity = presc.Quantity > 0 ? presc.Quantity : 1,
                UnitPrice = presc.UnitPrice
            });
        }
    }

    private async Task OnSelectedValuesChanged(IReadOnlyCollection<BillItemDto> selectedValues)
    {
        _options = selectedValues;
        var existingSavedItems = CurrentBill.BillItems.Where(i => i.Id > 0).ToList();
        billItemsToInvoice = new List<BillItemDto>(existingSavedItems);

        foreach (var dto in _options)
        {
            var copy = new BillItemDto
            {
                ItemName = dto.ItemName,
                SourceType = dto.SourceType,
                SourceItemId = dto.SourceItemId,
                Quantity = dto.Quantity,
                UnitPrice = dto.UnitPrice
            };

            // Live preview of Insurance Coverage vs. Patient Copay!
            await paymentService.CalculateBillItemCoverageAsync(copy, CurrentBill.PaymentModeId, CurrentBill.PatientInsuaranceId);
            billItemsToInvoice.Add(copy);
        }

        CurrentBill.TotalAmount = billItemsToInvoice.Sum(bi => bi.SubTotal);
        CurrentBill.TotalInsuranceAmount = billItemsToInvoice.Sum(bi => bi.InsuranceCoveredAmount);
        CurrentBill.TotalPatientAmount = billItemsToInvoice.Sum(bi => bi.PatientPayableAmount);

        await InvokeAsync(StateHasChanged);
    }

    private string GetMultiSelectionText(IReadOnlyList<string> selectedItems)
        => $"{selectedItems.Count} item{(selectedItems.Count == 1 ? "" : "s")} selected";

    public async Task SaveBillAsync()
    {
        isBusy = true;
        try
        {
            if (CurrentBill.Id == 0)
            {
                CurrentBill.BillDate = DateTime.UtcNow;
                CurrentBill.BillNumber = $"NCMH-BN-{DateTime.UtcNow:yyMMddHHmmss}";
                CurrentBill.BillTypeId = CurrentBill.BillTypeId > 0 ? CurrentBill.BillTypeId : 2;
                CurrentBill.StaffId = CurrentUser.Id;
                CurrentBill.BillItems = billItemsToInvoice;

                var saved = await paymentService.AddBillAsync(CurrentBill);
                if (saved.Id > 0)
                {
                    CurrentBill = await paymentService.GetBillByIdAsync(saved.Id);
                    billItemsToInvoice = CurrentBill.BillItems.ToList();
                    CurrentPayment.BillId = CurrentBill.Id;
                    CurrentPayment.Amount = CurrentBill.PatientBalanceDue;
                    message = "Bill created successfully.";
                }
            }
            else
            {
                // Cashier editing/updating an existing auto-generated bill
                CurrentBill.BillItems = billItemsToInvoice;
                var updated = await paymentService.UpdateBillAsync(CurrentBill, CurrentBill.Id);
                if (updated)
                {
                    CurrentBill = await paymentService.GetBillByIdAsync(CurrentBill.Id);
                    billItemsToInvoice = CurrentBill.BillItems.ToList();
                    CurrentPayment.Amount = CurrentBill.PatientBalanceDue;
                    message = "Bill updated successfully.";
                }
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    public async Task RecordPatientPaymentAsync()
    {
        if (CurrentBill.Id == 0 || CurrentPayment.Amount <= 0)
            return;

        isBusy = true;
        try
        {
            CurrentPayment.BillId = CurrentBill.Id;
            CurrentPayment.PaymentDate = DateTime.UtcNow;
            CurrentPayment.PaymentStatusId = 3; // Paid
            CurrentPayment.CashReceivedBy = string.IsNullOrWhiteSpace(CurrentPayment.CashReceivedBy)
                ? CurrentUser.FisrtName
                : CurrentPayment.CashReceivedBy;

            var payId = await paymentService.AddPaymentAsync(CurrentPayment);
            if (payId > 0)
            {
                CurrentBill = await paymentService.GetBillByIdAsync(CurrentBill.Id);
                CurrentPayment = new PaymentDto
                {
                    BillId = CurrentBill.Id,
                    PayType = PaymentType.Cash,
                    Amount = CurrentBill.PatientBalanceDue > 0 ? CurrentBill.PatientBalanceDue : 0m
                };
                message = "Payment recorded successfully!";
            }
        }
        finally
        {
            isBusy = false;
        }
    }

