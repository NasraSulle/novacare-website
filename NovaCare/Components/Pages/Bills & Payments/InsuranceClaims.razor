@using NovaCare.Shared.DTOs.PaymentDTOs
@using NovaCare.Shared.Enums
@inject ISnackbar Snackbar
@inject IDialogService Dialog

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!FilteredClaims.Any() && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <NoDataNotice NoDataMessage="No insurance claims found." />
            </MudPaper>
        }
        else
        {
            @* Claims Financial Summary Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Claimed (@FilteredClaims.Count)</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredClaims.Sum(x => x.ClaimedAmount).ToString("N2")</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.RequestQuote" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-info);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Approved</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Info" Style="font-weight:700;">@FilteredClaims.Sum(x => x.ApprovedAmount).ToString("N2")</MudText>
                        </div>
                        <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.FactCheck" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Settled</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">@FilteredClaims.Sum(x => x.SettledAmount).ToString("N2")</MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.PriceCheck" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Main Claims Grid *@
            <MudDataGrid Hover="true"
                         Elevation="0"
                         Outlined="true"
                         T="InsuranceClaimDto"
                         Items="@FilteredClaims"
                         Dense="true"
                         Class="bg-transparent">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@($"{(StatusFilter.HasValue ? StatusFilter.Value.ToString() : "All")} Insurance Claims")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredClaims.Count} claims")</MudChip>
                        </div>

                        <MudTextField T="string"
                                      Value="@searchString"
                                      ValueChanged="@OnSearch"
                                      Placeholder="Search Claim #, Patient, Insurer, Card..."
                                      Adornment="Adornment.Start"
                                      Margin="Margin.Dense"
                                      Variant="Variant.Outlined"
                                      Clearable="true"
                                      Immediate="true"
                                      DebounceInterval="300"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Small"
                                      Style="min-width: 280px;" />
                    </div>
                </ToolBarContent>

                <Columns>
                    @* Claim # & Auth *@
                    <TemplateColumn Title="Claim & Auth #" SortBy="@(x => x.ClaimNumber)">
                        <CellTemplate>
                            <div>
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary" Style="font-weight: 600;">
                                    @context.Item.ClaimNumber
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @($"Auth: {(string.IsNullOrWhiteSpace(context.Item.AuthorizationNumber) ? "N/A" : context.Item.AuthorizationNumber)}")
                                </MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Patient & Insurer *@
                    <TemplateColumn Title="Patient & Insurer" SortBy="@(x => x.PatientFullName)">
                        <CellTemplate>
                            <div>
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                    @context.Item.PatientFullName
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @($"{context.Item.InsuranceProviderName} • Card: {context.Item.MemberCardNumber}")
                                </MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.ClaimedAmount" Title="Claimed" Format="N2" />
                    <PropertyColumn Property="x => x.ApprovedAmount" Title="Approved" Format="N2" />
                    <PropertyColumn Property="x => x.SettledAmount" Title="Settled" Format="N2" />

                    <TemplateColumn Title="Status" SortBy="@(x => x.Status)">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@GetStatusColor(context.Item.Status)" Style="font-weight: 500;">
                                @context.Item.Status.ToString().Replace("_", " ")
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Actions">
                        <CellTemplate>
                            <div class="d-flex align-center gap-1 flex-wrap">
                                <MudTooltip Text="Preview / Print Claim Folio PDF">
                                    <MudIconButton Size="Size.Small" Color="Color.Primary" Icon="@Icons.Material.Outlined.Print"
                                                   OnClick="@(() => PreviewClaimPdfAsync(context.Item))" />
                                </MudTooltip>

                                @if (context.Item.Status == ClaimStatus.Draft)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Info" Style="text-transform:none;" OnClick="@(() => MarkClaimSubmittedAsync(context.Item))">
                                        Submit
                                    </MudButton>
                                }
                                @if (context.Item.Status == ClaimStatus.Submitted || context.Item.Status == ClaimStatus.Queried)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Style="text-transform:none;" OnClick="@(() => OpenAdjudicate(context.Item))">
                                        Adjudicate
                                    </MudButton>
                                }
                                @if (context.Item.Status == ClaimStatus.Approved || context.Item.Status == ClaimStatus.Partially_Approved)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Style="text-transform:none;" OnClick="@(() => OpenSettle(context.Item))">
                                        Settle
                                    </MudButton>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="InsuranceClaimDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

<!-- ==================== ADJUDICATION MODAL ==================== -->
<MudDialog @bind-Visible="showAdjudicateDialog">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Adjudicate Claim: @selectedClaim?.ClaimNumber</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudSelect T="ClaimStatus" @bind-Value="adjStatus" Label="Decision" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="ClaimStatus.Approved">Approved (Full)</MudSelectItem>
                    <MudSelectItem Value="ClaimStatus.Partially_Approved">Partially Approved</MudSelectItem>
                    <MudSelectItem Value="ClaimStatus.Queried">Queried (Needs Info)</MudSelectItem>
                    <MudSelectItem Value="ClaimStatus.Rejected">Rejected</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="adjApproved" Label="Approved Amount" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="adjRejected" Label="Rejected Amount" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="adjReason" Label="Insurer Query / Rejection Remarks" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => showAdjudicateDialog = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAdjudicationAsync">Save Decision</MudButton>
    </DialogActions>
</MudDialog>

<!-- ==================== SETTLEMENT PAYOUT MODAL ==================== -->
<MudDialog @bind-Visible="showSettleDialog">
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-2">Record Insurer Settlement: @selectedClaim?.ClaimNumber</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudNumericField @bind-Value="settleAmount" Label="Amount Paid by Insurer" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="settleRef" Label="EFT / Remittance Ref #" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="settleBatch" Label="Batch Number (Optional)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => showSettleDialog = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveSettlementAsync">Confirm Payout</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [Parameter] public ClaimStatus? StatusFilter { get; set; }

    List<InsuranceClaimDto> AllClaims = new();
    List<InsuranceClaimDto> FilteredClaims = new();
    string? searchString;
    bool isLoading;

    // Adjudication state
    bool showAdjudicateDialog;
    InsuranceClaimDto? selectedClaim;
    ClaimStatus adjStatus = ClaimStatus.Approved;
    decimal adjApproved;
    decimal adjRejected;
    string? adjReason;

    // Settlement state
    bool showSettleDialog;
    decimal settleAmount;
    string settleRef = string.Empty;
    string? settleBatch;

    protected override async Task OnInitializedAsync()
    {
        await LoadClaimsAsync();
    }

    private async Task LoadClaimsAsync()
    {
        isLoading = true;
        AllClaims = await paymentService.GetAllInsuranceClaimsAsync(StatusFilter) ?? new();
        FilteredClaims = AllClaims;
        isLoading = false;
    }

    private void OnSearch(string text)
    {
        searchString = text;
        if (string.IsNullOrWhiteSpace(searchString))
        {
            FilteredClaims = AllClaims;
            return;
        }

        FilteredClaims = AllClaims.Where(c =>
            (c.ClaimNumber?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.PatientFullName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.InsuranceProviderName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (c.MemberCardNumber?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
        ).ToList();
    }

    private void OpenAdjudicate(InsuranceClaimDto claim)
    {
        selectedClaim = claim;
        adjStatus = ClaimStatus.Approved;
        adjApproved = claim.ClaimedAmount;
        adjRejected = 0m;
        adjReason = claim.QueryOrRejectionReason;
        showAdjudicateDialog = true;
    }

    private async Task SaveAdjudicationAsync()
    {
        if (selectedClaim == null) return;

        var ok = await paymentService.UpdateClaimAdjudicationAsync(
            selectedClaim.Id, adjStatus, adjApproved, adjRejected, adjReason);

        if (ok)
        {
            Snackbar.Add($"Claim {selectedClaim.ClaimNumber} updated to {adjStatus}.", Severity.Success);
            showAdjudicateDialog = false;
            await LoadClaimsAsync();
        }
    }

    private void OpenSettle(InsuranceClaimDto claim)
    {
        selectedClaim = claim;
        settleAmount = claim.ApprovedAmount > 0 ? (claim.ApprovedAmount - claim.SettledAmount) : claim.ClaimedAmount;
        settleRef = string.Empty;
        settleBatch = string.Empty;
        showSettleDialog = true;
    }

    private async Task SaveSettlementAsync()
    {
        if (selectedClaim == null || settleAmount <= 0 || string.IsNullOrWhiteSpace(settleRef))
            return;

        var payId = await paymentService.RecordInsurerSettlementAsync(
            selectedClaim.Id, settleAmount, settleRef, settleBatch);

        if (payId > 0)
        {
            Snackbar.Add($"Insurer payout of {settleAmount:N2} recorded!", Severity.Success);
            showSettleDialog = false;
            await LoadClaimsAsync();
        }
    }

    private static Color GetStatusColor(ClaimStatus status) => status switch
    {
        ClaimStatus.Draft => Color.Default,
        ClaimStatus.Submitted => Color.Info,
        ClaimStatus.Queried => Color.Warning,
        ClaimStatus.Approved => Color.Primary,
        ClaimStatus.Partially_Approved => Color.Warning,
        ClaimStatus.Rejected => Color.Error,
        ClaimStatus.Settled => Color.Success,
        _ => Color.Default
    };

    private async Task MarkClaimSubmittedAsync(InsuranceClaimDto claim)
    {
        await paymentService.CreateOrSubmitClaimAsync(claim.BillId, CurrentUser.Id, submitImmediately: true);
        Snackbar.Add($"Claim {claim.ClaimNumber} marked as Submitted!", Severity.Success);
        await LoadClaimsAsync();
    }

    private async Task PreviewClaimPdfAsync(InsuranceClaimDto claim)
    {
        var fullBill = await paymentService.GetBillByIdAsync(claim.BillId);
        var reportDto = new ReportPreviewDto<BillItemDto>
        {
            ReportType = $"NHIF / Insurance Claim Folio - {claim.ClaimNumber} ({claim.InsuranceProviderName}) | Patient: {claim.PatientFullName} | Card: {claim.MemberCardNumber} | Auth: {claim.AuthorizationNumber}",
            FromDate = fullBill.BillDate,
            ToDate = fullBill.BillDate,
            Data = fullBill.BillItems.Where(i => i.IsInsuranceCovered).ToList()
        };

        var pdfBase64 = pdfExportService.GenerateStaffPreview<BillItemDto>(reportDto, CurrentUser);
        var parameters = new DialogParameters { { "pdfBase64", pdfBase64 } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };

        await Dialog.ShowAsync<PdfPreview>($"Claim Folio - {claim.ClaimNumber}", parameters, options);
    }
}