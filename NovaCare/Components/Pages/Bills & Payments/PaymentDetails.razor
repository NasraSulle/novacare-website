@page "/PaymentDetails"
@using Microsoft.Extensions.Options
@using NovaCare.Shared.DTOs.PaymentDTOs
@using NovaCare.Shared.Enums
@inject IOptions<HospitalInfoSettings> HospitalOptions
@inject IJSRuntime JS
@* Uncomment and match your actual Bill/Patient service interface *@
@* @inject IBillService billService *@

<MudDialog>
    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
        }

        <div class="d-flex justify-center pa-2">
            <!-- Thermal Receipt Paper Container (80mm standard width ~350px) -->
            <MudPaper id="printable-receipt" Elevation="3" Class="thermal-receipt pa-5 position-relative">

                <!-- Receipt & Bill Numbers (Top Row) -->
                <div class="d-flex justify-space-between align-center mb-2">
                    @if (!string.IsNullOrWhiteSpace(BillNumber))
                    {
                        <MudText Typo="Typo.caption" Class="text-muted">Bill: @BillNumber</MudText>
                    }
                    else
                    {
                        <span></span>
                    }
                    <MudText Typo="Typo.caption" Class="font-weight-bold">
                        Receipt No. @ReceiptNo
                    </MudText>
                </div>

                <!-- Hospital Header (Loaded from appsettings.json) -->
                <div class="text-center mb-3">
                    <MudImage Src="@Hospital.LogoPath" Height="85" Class="mb-1" />

                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-uppercase" Style="letter-spacing: 0.5px;">
                        @Hospital.Name
                    </MudText>
                    <MudText Typo="Typo.caption" Class="d-block font-italic text-muted mb-1">
                        @Hospital.Tagline
                    </MudText>
                    <MudText Typo="Typo.caption" Class="d-block">@Hospital.AddressLine1</MudText>
                    <MudText Typo="Typo.caption" Class="d-block">@Hospital.AddressLine2</MudText>
                    <MudText Typo="Typo.caption" Class="d-block">
                        Tel: @Hospital.Phone | Emergency: @Hospital.EmergencyPhone
                    </MudText>
                    <MudText Typo="Typo.caption" Class="d-block">Email: @Hospital.Email</MudText>
                </div>

                <MudDivider Class="my-2 border-dashed" />

                <!-- Patient Info Header Row -->
                <div class="d-flex justify-space-between align-center my-2">
                    <MudText Typo="Typo.caption" Class="font-weight-bold">Patient Info</MudText>
                    <MudText Typo="Typo.caption">Printed: @PrintDate.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </div>

                <!-- Patient Details -->
                <div class="patient-details mb-3">
                    <MudText Typo="Typo.caption" Class="d-block"><strong>Name:</strong> @PatientName</MudText>
                    <MudText Typo="Typo.caption" Class="d-block"><strong>MRNo:</strong> @MrNo</MudText>
                    <MudText Typo="Typo.caption" Class="d-block"><strong>Address:</strong> @Address</MudText>
                    <MudText Typo="Typo.caption" Class="d-block"><strong>Phone:</strong> @Phone</MudText>
                    @* <MudText Typo="Typo.caption" Class="d-block"><strong>Clinic:</strong> @Clinic</MudText>
                    <MudText Typo="Typo.caption" Class="d-block"><strong>Doctor:</strong> @DoctorName</MudText> *@
                    <MudText Typo="Typo.caption" Class="d-block"><strong>Paid Date:</strong> @VisitDate.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
                </div>

                <!-- Bordered Itemized Table -->
                <table class="receipt-table mb-3">
                    <thead>
                        <tr>
                            <th style="width: 12%;">S/N</th>
                            <th style="width: 48%;">Item</th>
                            <th style="width: 12%; text-align: center;">Qty</th>
                            <th style="width: 28%; text-align: right;">Sub Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Items.Count; i++)
                        {
                            var item = Items[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@item.Description</td>
                                <td style="text-align: center;">@item.Qty</td>
                                <td style="text-align: right;">@item.SubTotal.ToString("N2") Tsh</td>
                            </tr>
                        }
                        <tr class="total-row">
                            <td></td>
                            <td class="font-weight-bold">Total</td>
                            <td></td>
                            <td style="text-align: right;" class="font-weight-bold">
                                @Items.Sum(x => x.SubTotal).ToString("N2") Tsh
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Payment Method & Reference Summary -->
                @if (CurrentPayment != null)
                {
                    <div class="mb-3">
                        <MudText Typo="Typo.caption" Class="d-block">
                            <strong>Payment Method:</strong> @CurrentPayment.PayTypeName
                            @if (!string.IsNullOrWhiteSpace(CurrentPayment.MNOOperator))
                            {
                                <span> (@CurrentPayment.MNOOperator)</span>
                            }
                        </MudText>

                        @if (!string.IsNullOrWhiteSpace(PaymentReference))
                        {
                            <MudText Typo="Typo.caption" Class="d-block">
                                <strong>Ref No:</strong> @PaymentReference
                            </MudText>
                        }

                        @if (!string.IsNullOrWhiteSpace(CurrentPayment.PaymentStatusName))
                        {
                            <MudText Typo="Typo.caption" Class="d-block">
                                <strong>Status:</strong> @CurrentPayment.PaymentStatusName
                            </MudText>
                        }
                    </div>
                }

                <!-- Issued By & System Footer -->
                <div class="d-flex justify-end mb-3">
                    <MudText Typo="Typo.caption">Issued by: <strong>@IssuedBy</strong></MudText>
                </div>

                <MudDivider Class="my-2 border-dashed" />

                <div class="text-center mt-2">
                    <MudText Typo="Typo.caption" Class="text-muted" Style="font-size: 10px;">
                        @Hospital.FooterCopyright
                    </MudText>
                </div>

            </MudPaper>
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Close</MudButton>

        <MudButton OnClick="@(() => PrintReceiptAsync("thermal"))"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.ReceiptLong">
            Print 80mm
        </MudButton>

        <MudButton OnClick="@(() => PrintReceiptAsync("a4"))"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Print">
            Print A4
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    /* Standard 80mm thermal receipt paper look */
    .thermal-receipt {
        /* width: 350px; */
        width: 500px;
        background-color: #ffffff;
        color: #1a1a1a;
        border-radius: 2px;
        overflow: hidden;
    }

        .thermal-receipt .mud-typography {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11.5px;
            line-height: 1.35;
            color: #111;
        }

    .border-dashed {
        border-style: dashed !important;
        border-color: #9e9e9e !important;
    }

    /* Classic Grid Table */
    .receipt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
    }

        .receipt-table th,
        .receipt-table td {
            border: 1px solid #424242;
            padding: 5px 6px;
            vertical-align: top;
        }

        .receipt-table th {
            background-color: #f5f5f5;
            font-weight: 700;
            text-align: left;
        }

    .total-row td {
        border-top: 1.5px solid #000;
    }

    /* Print Media Query: Hides dialog backdrop and buttons when printing */
    @@media print {
        body * {
            visibility: hidden;
        }

        .thermal-receipt, .thermal-receipt * {
            visibility: visible;
        }

        .thermal-receipt {
            position: fixed;
            left: 0;
            top: 0;
            box-shadow: none !important;
            width: 80mm;
            margin: 0;
            padding: 4mm !important;
        }
    }
</style>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    // Passed from Payment.razor DialogParameters
    [Parameter] public PaymentDto? CurrentPayment { get; set; }

    // Optional overrides if passed directly
    [Parameter] public string PatientName { get; set; } = "—";
    [Parameter] public string MrNo { get; set; } = "—";
    [Parameter] public string Address { get; set; } = "—";
    [Parameter] public string Phone { get; set; } = "—";
    //[Parameter] public string Clinic { get; set; } = "GENERAL OPD";
    //[Parameter] public string DoctorName { get; set; } = "—";
    [Parameter] public List<ReceiptItem> Items { get; set; } = new();

    private HospitalInfoSettings Hospital => HospitalOptions.Value;
    private bool _isLoading = false;

    public string ReceiptNo { get; set; } = "000000";
    public string BillNumber { get; set; } = string.Empty;
    public string PaymentReference { get; set; } = string.Empty;
    public DateTime PrintDate { get; set; } = DateTime.Now;
    public DateTime VisitDate { get; set; } = DateTime.Now;
    public string IssuedBy { get; set; } = "Cashier Desk";

    protected override async Task OnInitializedAsync()
    {
        if (CurrentPayment != null && CurrentPayment.BillId > 0)
        {
            _isLoading = true;
            try
            {
                            
                  var bill = await paymentService.GetBillByIdAsync(CurrentPayment.BillId);
                  if (bill != null)
                  {
                      PatientName = bill.PatientFullName;
                      MrNo = bill.Visit.Patient.PatientCode;
                      Address = bill.Visit.Patient.HomeAddress;
                      Phone = bill.Visit.Patient.PhoneNumber;
                      //Clinic = bill.ClinicName ?? "GENERAL OPD";
                      //DoctorName = bill.DoctorName ?? "—";
                 
                      if (bill.BillItems != null && bill.BillItems.Any())
                      {
                          Items = bill.BillItems.Select(bi => new ReceiptItem
                          {
                              Description = bi.ItemName,
                              Qty = bi.Quantity,
                              SubTotal = bi.SubTotal
                          }).ToList();
                      }
                  }
                
            }
            finally
            {
                _isLoading = false;
            }
        }

        EnsureFallbackItem();
    }

    protected override void OnParametersSet()
    {
        if (CurrentPayment != null)
        {
            ReceiptNo = CurrentPayment.Id.ToString("D6");
            BillNumber = CurrentPayment.BillNumber;
            VisitDate = CurrentPayment.PaymentDate.Kind == DateTimeKind.Utc
                ? CurrentPayment.PaymentDate.ToLocalTime()
                : CurrentPayment.PaymentDate;

            if (!string.IsNullOrWhiteSpace(CurrentPayment.CashReceivedBy))
            {
                IssuedBy = CurrentPayment.CashReceivedBy;
            }

            // Pick the active transaction reference based on payment method
            PaymentReference = CurrentPayment.PayType switch
            {
                PaymentType.Cash => CurrentPayment.CashReferenceNumber ?? string.Empty,
                PaymentType.MNO => CurrentPayment.MNOReference ?? CurrentPayment.MNONumber ?? string.Empty,
                PaymentType.Wire_Transfer or PaymentType.Wire_Transfer => CurrentPayment.WireReferenceNo ?? string.Empty,
                PaymentType.Cheque => CurrentPayment.ChequeNumber ?? string.Empty,
                PaymentType.Insurance => CurrentPayment.InsurerSettlementReference ?? CurrentPayment.SettlementBatchNumber ?? string.Empty,
                _ => CurrentPayment.CashReferenceNumber ?? CurrentPayment.MNOReference ?? CurrentPayment.WireReferenceNo ?? string.Empty
            };

            EnsureFallbackItem();
        }
    }

    private void EnsureFallbackItem()
    {
        if (CurrentPayment != null && (Items == null || Items.Count == 0))
        {
            var itemTitle = !string.IsNullOrWhiteSpace(CurrentPayment.BillTypeName)
                ? $"{CurrentPayment.BillTypeName} ({CurrentPayment.BillNumber})"
                : $"Bill Payment ({CurrentPayment.BillNumber})";

            Items = new List<ReceiptItem>
            {
                new ReceiptItem
                {
                    Description = itemTitle.Trim(),
                    Qty = 1,
                    SubTotal = CurrentPayment.Amount
                }
            };
        }
    }

    private void Cancel() => MudDialog.Cancel();

    public async Task PrintReceiptAsync(string mode = "thermal")
    {
        await Task.Delay(100);
        await JS.InvokeVoidAsync("printLabResultElement", "printable-receipt", new
        {
            title = "Payment Receipt",
            mode = mode // "thermal" (80mm) or "a4"
        });
        MudDialog.Close(DialogResult.Ok(true));
    }


    public class ReceiptItem
    {
        public string Description { get; set; } = string.Empty;
        public double Qty { get; set; } = 1;
        public decimal SubTotal { get; set; }
    }
}
