@page "/PaymentDetails"
@using NovaCare.Shared.DTOs.PaymentDTOs
@inject IJSRuntime JS

<div class="d-flex justify-center pa-4">
    <!-- Thermal Receipt Paper Container (80mm standard width ~350px) -->
    <MudPaper id="printable-receipt" Elevation="3" Class="thermal-receipt pa-5 position-relative">

        <!-- Receipt Number (Top Right) -->
        <div class="d-flex justify-end mb-2">
            <MudText Typo="Typo.caption" Class="font-weight-bold">Receipt No. @ReceiptNo</MudText>
        </div>

        <!-- Hospital Header -->
        <div class="text-center mb-3">
            <MudImage Src="@Hospital.LogoPath" Height="100" />

            <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-uppercase" Style="letter-spacing: 0.5px;">
                @Hospital.Name
            </MudText>
            <MudText Typo="Typo.caption" Class="d-block font-italic text-muted mb-1">
                @Hospital.Tagline
            </MudText>
            <MudText Typo="Typo.caption" Class="d-block">@Hospital.AddressLine1</MudText>
            <MudText Typo="Typo.caption" Class="d-block">@Hospital.AddressLine2</MudText>
            <MudText Typo="Typo.caption" Class="d-block">
                Tel: @Hospital.Phone | Emergency: @Hospital.EmergencyPhone
            </MudText>
            <MudText Typo="Typo.caption" Class="d-block">Email: @Hospital.Email</MudText>
        </div>

        <MudDivider Class="my-2 border-dashed" />

        <!-- Patient Info Header Row -->
        <div class="d-flex justify-space-between align-center my-2">
            <MudText Typo="Typo.caption" Class="font-weight-bold">Patient Info</MudText>
            <MudText Typo="Typo.caption">Date: @PrintDate.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
        </div>

        <!-- Patient Details -->
        <div class="patient-details mb-3">
            <MudText Typo="Typo.caption" Class="d-block"><strong>Name:</strong> @PatientName</MudText>
            <MudText Typo="Typo.caption" Class="d-block"><strong>MRNo:</strong> @MrNo</MudText>
            <MudText Typo="Typo.caption" Class="d-block"><strong>Address:</strong> @Address</MudText>
            <MudText Typo="Typo.caption" Class="d-block"><strong>Phone:</strong> @Phone</MudText>
            <MudText Typo="Typo.caption" Class="d-block"><strong>Clinic:</strong> @Clinic</MudText>
            <MudText Typo="Typo.caption" Class="d-block"><strong>Doctor:</strong> @DoctorName</MudText>
            <MudText Typo="Typo.caption" Class="d-block"><strong>Date:</strong> @VisitDate.ToString("yyyy-MM-dd HH:mm:ss")</MudText>
        </div>

        <!-- Bordered Itemized Table -->
        <table class="receipt-table mb-3">
            <thead>
                <tr>
                    <th style="width: 12%;">S/N</th>
                    <th style="width: 48%;">Item</th>
                    <th style="width: 12%; text-align: center;">Qty</th>
                    <th style="width: 28%; text-align: right;">Sub Total</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in BillItems)
                {
                    <tr>
                        <td>@(i)</td>
                        <td>@($"{item.ItemName}")</td>
                        <td style="text-align: center;">@item.Quantity</td>
                        <td style="text-align: right;">@item.PatientPayableAmount.ToString("N2") Tsh</td>
                    </tr>

                    ++i;
                }
                <tr class="total-row">
                    <td></td>
                    <td class="font-weight-bold">Total</td>
                    <td></td>
                    <td style="text-align: right;" class="font-weight-bold">
                        @CurrentBill.TotalPatientAmount.ToString("N2") Tsh
                    </td>
                </tr>
            </tbody>
        </table>

        <!-- Issued By & System Footer -->
        <div class="d-flex justify-end">
            <MudText Typo="Typo.caption">Billed by: <strong>@CurrentBill.StaffFullName</strong></MudText>
        </div>
        <div class="d-flex justify-end mb-3">
            <MudText Typo="Typo.caption">Receipt by: <strong>@CurrentBill.StaffFullName</strong></MudText>
        </div>

        <MudDivider Class="my-2 border-dashed" />

        <div class="text-center mt-2">
            <MudText Typo="Typo.caption" Class="text-muted" Style="font-size: 10px;">
                &copy; NovaCare Health Systems Ltd
            </MudText>
        </div>

    </MudPaper>
</div>

<style>
    /* Standard 80mm thermal receipt paper look */
    .thermal-receipt {
        width: 350px;
        background-color: #ffffff;
        color: #1a1a1a;
        font-family: 'Courier New', Courier, monospace;
        border-radius: 2px;
        overflow: hidden;
    }

        .thermal-receipt .mud-typography {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11.5px;
            line-height: 1.35;
            color: #111;
        }

    .border-dashed {
        border-style: dashed !important;
        border-color: #9e9e9e !important;
    }

    /* Classic Grid Table */
    .receipt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
    }

        .receipt-table th,
        .receipt-table td {
            border: 1px solid #424242;
            padding: 5px 6px;
            vertical-align: top;
        }

        .receipt-table th {
            background-color: #f5f5f5;
            font-weight: 700;
            text-align: left;
        }

    .total-row td {
        border-top: 1.5px solid #000;
    }

    /* Print Media Query: Hides dashboard UI and prints only the receipt */
    @@media print {
        body * {
            visibility: hidden;
        }

        .thermal-receipt, .thermal-receipt * {
            visibility: visible;
        }

        .thermal-receipt {
            position: absolute;
            left: 0;
            top: 0;
            box-shadow: none !important;
            width: 80mm;
        }
    }
</style>

@code {
    private HospitalInfoSettings Hospital => HospitalOptions.Value;

    [Parameter] public string HospitalName { get; set; } = "NOVACARE MEDICAL CENTER";
    [Parameter] public string ReceiptNo { get; set; } = "214164";
    [Parameter] public DateTime PrintDate { get; set; } = DateTime.Now;
    [Parameter] public DateTime VisitDate { get; set; } = DateTime.Now;

    [Parameter] public string PatientName { get; set; } = "Nasra Abubakar Said";
    [Parameter] public string MrNo { get; set; } = "NMC/2026/86964";
    [Parameter] public string Address { get; set; } = "Mtoni Kidatu, Mjini Magharibi";
    [Parameter] public string Phone { get; set; } = "+255 777 123 456";
    [Parameter] public string Clinic { get; set; } = "GENERAL OPD";
    [Parameter] public string DoctorName { get; set; } = "Dr. Amina Abdalla";
    [Parameter] public string IssuedBy { get; set; } = "Cashier Desk 1";
    [Parameter] public PaymentDto? CurrentPayment { get; set; }
    public BillDto CurrentBill = new();

    int i = 1;


    [Parameter]
    public List<ReceiptItem> Items { get; set; } = new()
    {
        new ReceiptItem { Description = "X-Ray (Chest) PA", Qty = 1, SubTotal = 27500.00m }
    };

    List<BillItemDto> BillItems = new();

    protected override async Task OnInitializedAsync()
    {
        CurrentBill = await paymentService.GetBillByIdAsync(CurrentPayment.BillId);

        BillItems = CurrentBill.BillItems.ToList();
    }

    public async Task PrintReceiptAsync()
    {
        await Task.Delay(100);
        await JS.InvokeVoidAsync("printReferralElement", "printable-receipt");
    }

    public class ReceiptItem
    {
        public string Description { get; set; } = string.Empty;
        public int Qty { get; set; } = 1;
        public decimal SubTotal { get; set; }
    }
}
