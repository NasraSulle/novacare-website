@inject IDialogService Dialog
@using NovaCare.Shared.DTOs.PaymentDTOs

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredPayments == null || !FilteredPayments.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex flex-column flex-sm-row justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@($"All {firstPart} Payments")</MudText>
                </div>
                <NoDataNotice NoDataMessage="@messagePayment" />
            </MudPaper>
        }
        else if (FilteredPayments != null)
        {
            @* Payment Summary Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Transactions</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredPayments.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.Receipt" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Collected</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">
                                @FilteredPayments.Sum(x => x.Amount).ToString("N2")
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.Paid" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-info);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Full Settlements</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Info" Style="font-weight:700;">
                                @FilteredPayments.Count(x => x.PaymentStatusName?.Contains("full", StringComparison.OrdinalIgnoreCase) ?? false)
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.Verified" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Main Data Grid *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Elevation="0"
                         Outlined="true"
                         T="PaymentDto"
                         Items="@FilteredPayments"
                         ReadOnly="@_readOnly"
                         Class="rounded-lg"
                         Bordered="false"
                         Dense="false"
                         RowStyle="cursor: pointer;"
                         RowClick="@((args) => PreviewPaymentProfile(args.Item))">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@($"All {firstPart} Payments")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredPayments.Count} records")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search Bill ID, amount, or status..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 260px;" />

                            @if (isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="GeneratePdf"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Generate Pdf
                                </MudButton>
                            }
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    @* Bill Reference *@
                    <TemplateColumn Title="Bill Reference" SortBy="@(x => x.BillId)">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Outlined.Tag" Size="Size.Small" Color="Color.Primary" Class="me-1" />
                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                    @($"Bill #{context.Item.BillId}")
                                </MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Paid Date *@
                    <TemplateColumn Title="Paid Date" SortBy="@(x => x.PaymentDate)">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Outlined.EventAvailable" Size="Size.Small" Color="Color.Secondary" Class="me-2" />
                                <MudText Typo="Typo.body2">@context.Item.PaymentDate.ToString("dd MMM yyyy, HH:mm")</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Amount Paid *@
                    <TemplateColumn Title="Amount Paid" SortBy="@(x => x.Amount)">
                        <CellTemplate>
                            <MudText Typo="Typo.subtitle2" Color="Color.Success" Style="font-weight: 700;">
                                @context.Item.Amount.ToString("N2")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Status Badge *@
                    <TemplateColumn Title="Settlement Status" SortBy="@(x => x.PaymentStatusName)">
                        <CellTemplate>
                            @{
                                bool isFull = context.Item.PaymentStatusName?.Contains("full", StringComparison.OrdinalIgnoreCase) ?? false;
                            }
                            <MudChip T="string"
                                     Color="@(isFull ? Color.Success : Color.Warning)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small"
                                     Style="font-weight: 500;">
                                <span style="@($"display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; background-color:{(isFull ? "#2e7d32" : "#ed6c02")};")"></span>
                                @(string.IsNullOrWhiteSpace(context.Item.PaymentStatusName) ? "Recorded" : context.Item.PaymentStatusName)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Action Indicator *@
                    <TemplateColumn Title="" CellStyle="width: 60px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="View Payment Receipt">
                                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => PreviewPaymentProfile(context.Item))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="PaymentDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };

    [Parameter] public List<PaymentDto> AllPayments { get; set; } = new();
    List<PaymentDto> FilteredPayments = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public string Genre { get; set; } = string.Empty;
    [Parameter] public bool isReport { get; set; }
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;

    PaymentDto? CurrentPayment;

    string messagePayment = string.Empty;
    string firstPart = string.Empty;
    string? searchString;
    string? pdfBase64;

    bool isSearchLoading;
    bool isLoading;
    bool isEdit;
    private bool _readOnly = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(300);

        if (!isReport)
        {
            AllPayments = await paymentService.GetAllPaymentsAsync() ?? new();
        }

        ApplyFilterAndSearch();

        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<PaymentDto> query = AllPayments ?? Enumerable.Empty<PaymentDto>();

        if (isReport)
        {
            firstPart = "Report";
            messagePayment = "No payments found for the selected report period.";
        }
        else if (string.IsNullOrWhiteSpace(FilterBy))
        {
            firstPart = "Recorded";
            messagePayment = "No payment records are currently available.";
        }
        else
        {
            firstPart = FilterBy;
            messagePayment = $"No {firstPart.ToLower()} payments are currently available.";
            query = query.Where(x => x.PaymentStatusName?.Contains(FilterBy, StringComparison.OrdinalIgnoreCase) ?? false);
        }

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x =>
                x.BillId.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                x.Amount.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                (x.PaymentStatusName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        FilteredPayments = query.ToList();
    }

    public async Task Back()
    {
        CurrentPayment = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    public async Task OpenRegisterModal()
    {
        var dialog = await Dialog.ShowAsync<PaymentDetails>("Register New Payment", _maxWidth);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task PreviewPaymentProfile(PaymentDto item)
    {
        var Parameters = new DialogParameters
        {
            {"CurrentPayment" , item}
        };
        var dialog = await Dialog.ShowAsync<PaymentDetails>("Payment Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<PaymentDto>
        {
            ReportType = "Payments",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredPayments
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<PaymentDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        await Dialog.ShowAsync<PdfPreview>($"Payments Report Pdf", Parameters, _maxWidth);
    }
}