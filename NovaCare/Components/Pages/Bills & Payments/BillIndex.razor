@page "/BillsIndex"

@using Microsoft.AspNetCore.Authorization
@inject IDialogService Dialog

@rendermode InteractiveServer
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@attribute [Authorize]
<PageTitle>Billing & Payments - NovaCare</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-3 px-sm-6">
    @* Page Header *@
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center">
        <SectionTitle Icon="@icon" Title="@title" />
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mt-sm-0">
            Manage patient invoices, payment receipts, and insurance claims
        </MudText>
    </div>

    @* Main Elevated Card Container *@
    <MudPaper Elevation="0" Outlined="true" Class="overflow-hidden" Style="background-color: rgba(246,246,246,1) !important;">
        <MudTabs Elevation="0"
                 Rounded="false"
                 ApplyEffectsToContainer="true"
                 TabHeaderClass="bg-secondary-subtle"
                 SliderColor="Color.Primary"
                 TabPanelsClass="pa-0">

            @* Tab 1: Patient Bills *@
            <MudTabPanel Text="Patient Bills" Icon="@Icons.Material.Outlined.ReceiptLong" Style="text-transform: none; font-weight: 500;">
                <MudTabs Elevation="0"
                         Rounded="true"
                         ApplyEffectsToContainer="true"
                         TabHeaderClass="bg-primary-subtle  dense-tabs"
                         SliderColor="Color.Secondary"
                         TabPanelsClass="pa-4"
                         Centered="false">
                    <MudTabPanel Text="All Bills" Style="text-transform: none;">
                        <Bills CurrentUser="currentUser" Genre="Bills" />
                    </MudTabPanel>
                    <MudTabPanel Text="Interim Bills" Style="text-transform: none;">
                        <Bills CurrentUser="currentUser" FilterBy="Interim" Genre="Bills" />
                    </MudTabPanel>
                    <MudTabPanel Text="Advance Bills" Style="text-transform: none;">
                        <Bills CurrentUser="currentUser" FilterBy="Advance" Genre="Bills" />
                    </MudTabPanel>
                    <MudTabPanel Text="Final Bills" Style="text-transform: none;">
                        <Bills CurrentUser="currentUser" FilterBy="Final" Genre="Bills" />
                    </MudTabPanel>
                </MudTabs>
            </MudTabPanel>

            @* Tab 2: Payment Transactions *@
            <MudTabPanel Text="Payments" Icon="@Icons.Material.Outlined.Payments" Style="text-transform: none; font-weight: 500;">
                <MudTabs Elevation="0"
                         Rounded="true"
                         ApplyEffectsToContainer="true"
                         TabHeaderClass="bg-primary-subtle  dense-tabs"
                         SliderColor="Color.Secondary"
                         TabPanelsClass="pa-4"
                         Centered="false">
                    <MudTabPanel Text="All Payments" Style="text-transform: none;">
                        <Payments CurrentUser="currentUser" Genre="Payments" />
                    </MudTabPanel>
                    <MudTabPanel Text="Partial Payments" Style="text-transform: none;">
                        <Payments CurrentUser="currentUser" FilterBy="Partial" Genre="Payments" />
                    </MudTabPanel>
                    <MudTabPanel Text="Full Payments" Style="text-transform: none;">
                        <Payments CurrentUser="currentUser" FilterBy="Full" Genre="Payments" />
                    </MudTabPanel>
                </MudTabs>
            </MudTabPanel>

            @* Tab 3: Insurance Claims *@
            <MudTabPanel Text="Insurance Claims" Icon="@Icons.Material.Outlined.HealthAndSafety" Style="text-transform: none; font-weight: 500;">
                <MudTabs Elevation="0"
                         Rounded="true"
                         ApplyEffectsToContainer="true"
                         TabHeaderClass="bg-primary-subtle  dense-tabs"
                         SliderColor="Color.Secondary"
                         TabPanelsClass="pa-4"
                         Centered="false">
                    <MudTabPanel Text="All Claims" Style="text-transform: none;">
                        <InsuranceClaims CurrentUser="currentUser" />
                    </MudTabPanel>
                    <MudTabPanel Text="Drafts" Style="text-transform: none;">
                        <InsuranceClaims CurrentUser="currentUser" StatusFilter="ClaimStatus.Draft" />
                    </MudTabPanel>
                    <MudTabPanel Text="Submitted" Style="text-transform: none;">
                        <InsuranceClaims CurrentUser="currentUser" StatusFilter="ClaimStatus.Submitted" />
                    </MudTabPanel>
                    <MudTabPanel Text="Queried" Style="text-transform: none;">
                        <InsuranceClaims CurrentUser="currentUser" StatusFilter="ClaimStatus.Queried" />
                    </MudTabPanel>
                    <MudTabPanel Text="Approved" Style="text-transform: none;">
                        <InsuranceClaims CurrentUser="currentUser" StatusFilter="ClaimStatus.Approved" />
                    </MudTabPanel>
                    <MudTabPanel Text="Settled" Style="text-transform: none;">
                        <InsuranceClaims CurrentUser="currentUser" StatusFilter="ClaimStatus.Settled" />
                    </MudTabPanel>
                </MudTabs>
            </MudTabPanel>

        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    StaffDto currentUser = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };

    public string icon = Icons.Material.Filled.Payments;
    public string title = "Bills & Payments";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await userService.GetLoggedInUserAsync();
        await InvokeAsync(StateHasChanged);
    }
}