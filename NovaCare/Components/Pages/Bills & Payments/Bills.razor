@inject IDialogService Dialog


<MudGrid>
    <MudItem md="12" Class="pa-0" Style="text-align: center;">
        @if (isLoading)
        {
            <MudItem Class="pa-6">
                <GlobalLoader />
            </MudItem>
        }
        else if (!isLoading && !FilteredBills!.Any() && string.IsNullOrWhiteSpace(searchString))
        {
            <MudItem Class="pa-6">
                <MudGrid>
                    <MudItem md="12">
                        <MudGrid Justify="Justify.SpaceBetween">
                            <MudItem>
                                <MudText Typo="Typo.h6">@($"All {firstPart} Patients")</MudText>
                            </MudItem>
                            <MudItem>
                                @if (CurrentUser != null && CurrentUser.IsCreateNewPatient)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium" OnClick="OpenRegisterModal">Add</MudButton>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem md="12">
                        <NoDataNotice NoDataMessage="@messageBill" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        }
        else if (FilteredBills != null)
        {
            <MudDataGrid Loading="@isSearchLoading" Hover="true" T="BillDto" Items="@FilteredBills" ReadOnly="@_readOnly" Class="ps-6 pe-6 pb-6"
                         Bordered="false" Dense="true" RowClick="@((args) => PreviewBillProfile(args.Item))">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@($"All {firstPart}s")</MudText>
                    <MudSpacer />
                    <!--Filters & Search Panel Later OnDebounceIntervalElapsed="wekaAti-HandleIntervalElapsed"-->

                    <MudItem>
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                                      Margin="Margin.Dense" Variant="Variant.Outlined"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="me-1"></MudTextField>
                    </MudItem>
                    @if (CurrentUser.IsCreateNewMedicine && !isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium" OnClick="OpenRegisterModal">Add</MudButton>
                    }
                    @if (isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="GeneratePdf" StartIcon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Medium">Generate Pdf</MudButton>
                    }
                </ToolBarContent>

                <Columns>
                    <PropertyColumn Property="x => x.PatientFullName" Title="Patient Name" />
                    <PropertyColumn Property="x => x.BillTypeName" Title="Bill  Type" />
                    <PropertyColumn Property="x => x.VisitName" Title="Visit Service" />
                    <PropertyColumn Property="x => x.TotalAmount" Title="Price" />
                    <TemplateColumn>
                        <CellTemplate>
                            <MudItem Style="text-align: center;">
                                <MudChip Color="@(context.Item.PaymentStatusName.Contains("full", StringComparison.OrdinalIgnoreCase) ? Color.Success : Color.Error)" Size="Size.Small">
                                    @(context.Item.PaymentStatusName)
                                </MudChip>
                            </MudItem>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="BillDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };


    [Parameter] public List<BillDto> AllBills { get; set; } = new();
    List<BillDto> FilteredBills = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public string Genre { get; set; } = string.Empty;
    [Parameter] public bool isReport { get; set; }
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;

    BillDto? CurrentBill;

    string messageBill = string.Empty;
    string firstPart = string.Empty;
    string? searchString;
    string? pdfBase64;

    bool isSearchLoading;
    bool isLoading;
    bool isEdit;
    private bool _readOnly;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(500);

        if (!isReport)
        {
            AllBills = await paymentService.GetAllBillsAsync();

            if (string.IsNullOrWhiteSpace(FilterBy))
            {
                FilteredBills = AllBills;
                messageBill = $"All bills are not avalible!";
                firstPart = "Bill";
            }
            else
            {

                firstPart = FilterBy;
                messageBill = $"{firstPart} bills are not avalible!";

                if (FilterBy != null && Genre != null)
                {
                    FilteredBills = AllBills?.Where(x => x.BillTypeName.Contains(FilterBy, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
                }
                else
                {
                    FilteredBills = new();
                }
            }
        }
        else
        {
            firstPart = "Medicine";
            FilteredBills = AllBills;
        }

        isLoading = false;
        StateHasChanged();
    }

    public async Task Back()
    {
        CurrentBill = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        await Task.Delay(500);

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            FilteredBills = AllBills?.Where(x => x.BillTypeName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.VisitId.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
            messageBill = "Staffs are not avalible!";
            firstPart = "Staff";
        }
        else
        {
            firstPart = FilterBy.Substring(2);
            messageBill = $"{firstPart}s are not avalible!";

            if (FilterBy != null)
            {
                FilteredBills = AllBills?.Where(x => x.BillTypeName.Contains(FilterBy, StringComparison.OrdinalIgnoreCase) && x.BillTypeName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.VisitId.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
            }
            else
            {
                FilteredBills = new();
            }
        }
        isSearchLoading = false;
    }

    public async Task OpenRegisterModal()
    {
        var dialog = await Dialog.ShowAsync<BillDetails>("Register New Bill", _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task PreviewBillProfile(BillDto item)
    {
        var Parameters = new DialogParameters
        {
            {"CurrentBill" , item}
        };
        var dialog = await Dialog.ShowAsync<BillDetails>("Bill Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<BillDto>
        {
            ReportType = "Bills",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredBills
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<BillDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        await Dialog.ShowAsync<PdfPreview>($"Bills Report Pdf", Parameters, _maxWidth);
    }
}
