@inject IDialogService Dialog

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredBills == null || !FilteredBills.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex flex-column flex-sm-row justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@($"All {firstPart} Bills")</MudText>
                </div>
                <NoDataNotice NoDataMessage="@messageBill" />
            </MudPaper>
        }
        else if (FilteredBills != null)
        {
            @* Financial Summary Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total @firstPart Bills</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredBills.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-info);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Billed Value</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Info" Style="font-weight:700;">
                                @FilteredBills.Sum(x => x.TotalAmount).ToString("N2")
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountBalanceWallet" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Fully Settled</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">
                                @FilteredBills.Count(x => x.PaymentStatusName?.Contains("full", StringComparison.OrdinalIgnoreCase) ?? false)
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Main Data Grid *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Elevation="0"
                         Outlined="true"
                         T="BillDto"
                         Items="@FilteredBills"
                         ReadOnly="@_readOnly"
                         Class="bg-transparent"
                         Bordered="false"
                         Dense="true"
                         RowStyle="cursor: pointer;"
                         RowClick="@((args) => PreviewBillProfile(args.Item))">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@($"All {firstPart} Bills")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredBills.Count} records")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search patient, visit, or bill type..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 260px;" />

                            @if (isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="GeneratePdf"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Generate Pdf
                                </MudButton>
                            }
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    @* Patient & Visit Info *@
                    <TemplateColumn Title="Patient & Visit" SortBy="@(x => x.PatientFullName)">
                        <CellTemplate>
                            <div class="d-flex align-center py-1">
                                <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="me-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; line-height: 1.2;">
                                        @context.Item.PatientFullName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @($"{context.Item.VisitName} • Visit #{context.Item.VisitId}")
                                    </MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Bill Type *@
                    <TemplateColumn Title="Bill Type" SortBy="@(x => x.BillTypeName)">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Style="font-weight: 500;">
                                @context.Item.BillTypeName
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Total Amount *@
                    <TemplateColumn Title="Total Amount" SortBy="@(x => x.TotalAmount)">
                        <CellTemplate>
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">
                                @context.Item.TotalAmount.ToString("N2")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Payment Status Badge *@
                    <TemplateColumn Title="Payment Status" SortBy="@(x => x.PaymentStatusName)">
                        <CellTemplate>
                            @{
                                bool isFull = context.Item.PaymentStatusName?.Contains("full", StringComparison.OrdinalIgnoreCase) ?? false;
                            }
                            <MudChip T="string"
                                     Color="@(isFull ? Color.Success : Color.Error)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small"
                                     Style="font-weight: 500;">
                                <span style="@($"display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; background-color:{(isFull ? "#2e7d32" : "#d32f2f")};")"></span>
                                @(string.IsNullOrWhiteSpace(context.Item.PaymentStatusName) ? "Pending" : context.Item.PaymentStatusName)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Action Indicator *@
                    <TemplateColumn Title="" CellStyle="width: 60px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="Open Bill Details">
                                <MudIconButton Icon="@Icons.Material.Outlined.MoreVert"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => PreviewBillProfile(context.Item))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="BillDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };

    [Parameter] public List<BillDto> AllBills { get; set; } = new();
    List<BillDto> FilteredBills = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public string Genre { get; set; } = string.Empty;
    [Parameter] public bool isReport { get; set; }
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;

    BillDto? CurrentBill;

    string messageBill = string.Empty;
    string firstPart = string.Empty;
    string? searchString;
    string? pdfBase64;

    bool isSearchLoading;
    bool isLoading;
    bool isEdit;
    private bool _readOnly = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(300);

        if (!isReport)
        {
            AllBills = await paymentService.GetAllBillsAsync() ?? new();
        }

        ApplyFilterAndSearch();

        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<BillDto> query = AllBills ?? Enumerable.Empty<BillDto>();

        if (isReport)
        {
            firstPart = "Report";
            messageBill = "No bills found for the selected report period.";
        }
        else if (string.IsNullOrWhiteSpace(FilterBy))
        {
            firstPart = "Patient";
            messageBill = "No bills are currently available.";
        }
        else
        {
            firstPart = FilterBy;
            messageBill = $"No {firstPart.ToLower()} bills are currently available.";
            query = query.Where(x => x.BillTypeName?.Contains(FilterBy, StringComparison.OrdinalIgnoreCase) ?? false);
        }

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x =>
                (x.BillTypeName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                x.VisitId.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                (x.PatientFullName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.VisitName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PaymentStatusName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        FilteredBills = query.ToList();
    }

    public async Task Back()
    {
        CurrentBill = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    public async Task OpenRegisterModal()
    {
        var dialog = await Dialog.ShowAsync<BillDetails>("Register New Bill", _maxWidth);
        var result = await dialog.Result;

        if (result != null)
        {
            await OnInitializedAsync();
        }
    }

    private async Task PreviewBillProfile(BillDto item)
    {
        var Parameters = new DialogParameters
        {
            {"CurrentBill" , item},
            {"CurrentUser" , CurrentUser}
        };
        var dialog = await Dialog.ShowAsync<BillDetails>("Bill Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null)
        {
            await OnInitializedAsync();
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<BillDto>
        {
            ReportType = "Bills",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredBills
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<BillDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        await Dialog.ShowAsync<PdfPreview>($"Bills Report Pdf", Parameters, _maxWidth);
    }
}