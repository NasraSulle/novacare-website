@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm Model="CurrentWard" method="post" OnValidSubmit="SaveWardAsync" FormName="newward">
            <MudGrid Spacing="3" Class="pa-3">
                <MudGrid Spacing="5" Justify="Justify.Center" Class="ps-3 pt-6 pe-0" Style="border:none;">
                    <MudItem md="4" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Enter Ward Details</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    <MudStaticTextField For="@(() => CurrentWard.WardName)" @bind-Value="CurrentWard.WardName" Margin="Margin.Dense"
                                                        Label="Ward name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Ward name"
                                                        UserAttributes="@(new() { { "autocomplete", "wardname" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="12">
                                    <MudNumericField For="@(() => CurrentWard.WardCost)" @bind-Value="CurrentWard.WardCost" Margin="Margin.Dense"
                                                        Label="Ward Cost" Variant="Variant.Outlined" Placeholder="Ward Cost"
                                                        UserAttributes="@(new() { { "autocomplete", "wardname" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="12">
                                    <MudSelect T="int?" For="@(() => CurrentWard.MedicalDepartmentId)"
                                               @bind-Value="CurrentWard.MedicalDepartmentId"
                                               Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                        <MudSelectItem Value="0" Disabled>Department</MudSelectItem>

                                        @foreach (var item in AllMedicalDepartments)
                                        {
                                            <MudSelectItem T="int?" Value="@item.Id">@item.MedicalDepartmentName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem md="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(CurrentWard.WardName) || CurrentWard.WardCost == 0 || CurrentWard.MedicalDepartmentId == 0" OnClick="@(() => AddWardToBatch(CurrentWard))" Class="mt-2" FullWidth="true">Add Ward To Batch</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                    <MudItem md="8" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Wards Batch Summary</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    @if (!WardsBatch!.Any())
                                    {
                                        <NoDataNotice NoDataMessage="No Wards in Batch" />
                                    }
                                    else
                                    {

                                        <MudTable Dense="true" Height="500px" FixedHeader="true" Items="@WardsBatch" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                            <HeaderContent>
                                                <MudTh>Description</MudTh>
                                                <MudTh>Department</MudTh>
                                                <MudTh>Cost</MudTh>
                                                <MudTh></MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Description">@($"{medContext.WardName}")</MudTd>
                                                <MudTd DataLabel="Department">@medContext.MedicalDepartmentName</MudTd>
                                                <MudTd DataLabel="Cost">@medContext.WardCost</MudTd>
                                                <MudTd DataLabel="">
                                                    <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveWardFromBatch(medContext))" />
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                </MudGrid>

                <MudItem md="12" Style="text-align:end">
                    <MudItem Style="display:flex; justify-content:center; ">
                        @if (isCreatedSuccessfully)
                        {
                            <MudAlert Style="width:19%; margin-right:20px;" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">Wards Added Successfully!</MudAlert>
                        }
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@addedSuccessfully</MudAlert>
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">@notaddedSuccessfully</MudAlert>
                    </MudItem>
                    <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="isSaving" Class="mt-3">
                        @if (isSaving)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                            <MudText Class="ps-3"> Saving  Wards...</MudText>
                        }
                        else
                        {
                            <MudText> Save Wards</MudText>
                        }
                    </MudStaticButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="mt-3">Reset Page</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToStaffWardsPage" Class="mt-3">Back</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    List<WardDto>? AllWards;
    List<WardDto>? WardsBatch = new();
    List<MedicalDepartmentDto> AllMedicalDepartments = new();

    WardDto CurrentWard = new();

    string saveMessage = string.Empty;
    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";

    bool isCreatedSuccessfully;
    bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        AllWards = await roomService.GetAllWardsAsync();
        AllMedicalDepartments = await medicineService.GetAllMedicalDeptsAsync();
    }

    public async Task AddWardToBatch(WardDto wardDto)
    {

        var existingMed = await roomService.GetWardyNameAsync(wardDto.WardName);
        bool inBatch = false;
        inBatch = WardsBatch?.Any(r => r.WardName == wardDto.WardName) ?? false;

        if (existingMed.Id == 0 && !inBatch)
        {
            wardDto.MedicalDepartmentName = AllMedicalDepartments.FirstOrDefault(rt => rt.Id == wardDto.MedicalDepartmentId)?.MedicalDepartmentName ?? string.Empty;
            var newWard = new WardDto
            {
                WardName = wardDto.WardName,
                WardCost = wardDto.WardCost,
                MedicalDepartmentName = wardDto.MedicalDepartmentName,
                MedicalDepartmentId = wardDto.MedicalDepartmentId,
            };

            if (newWard != null)
                WardsBatch!.Add(newWard);
        }
        else if (existingMed.Id > 0 && !inBatch)
        {
            saveMessage = $"{existingMed.WardName} is already registered";
            Snackbar.Add<MudChip<string>>(new Dictionary<string, object>() {
                        { "Text", $"{saveMessage}" },
                        { "Color", Color.Error }
                    });
        }
        else if (existingMed.Id == 0 && inBatch)
        {
            saveMessage = $"{existingMed.WardName} is already batch";
            Snackbar.Add<MudChip<string>>(new Dictionary<string, object>() {
                        { "Text", $"{saveMessage}" },
                        { "Color", Color.Error }
                    });
        }

        await InvokeAsync(StateHasChanged);

    }

    public async Task RemoveWardFromBatch(WardDto wardDto)
    {
        if (WardsBatch != null)
            WardsBatch.Remove(wardDto);
    }

    public async Task SaveWardAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (WardsBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var ward in WardsBatch)
            {
                var existingMed = await roomService.GetWardyNameAsync(ward.WardName);

                if (existingMed.Id == 0)
                {
                    var isSucess = await roomService.AddWardAsync(ward);

                    if (isSucess)
                    {
                        saveMessage = $"{ward.WardName} added sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {ward.WardName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {ward.WardName} not added sucessfully! Please read ward to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {ward.WardName},";
                    }
                }
                else if (existingMed.Id > 0)
                {
                    var isSucess = await roomService.UpdateWardAsync(ward, existingMed.Id);

                    if (isSucess)
                    {
                        saveMessage = $"{ward.WardName} updated sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {ward.WardName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {ward.WardName} not updated sucessfully! Please read ward to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {ward.WardName},";
                    }
                }
            }
            if (notaddedSuccessfully == "Not Added:")
                isCreatedSuccessfully = true;
            CurrentWard = new();
            WardsBatch.Clear();

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task ResetPage()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        CurrentWard = new();
    }

    public void ReturnToStaffWardsPage()
    {
        MudDialog.Cancel();
    }
}