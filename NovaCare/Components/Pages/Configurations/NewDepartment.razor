@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <EditForm Model="CurrentStaffType" method="post" OnValidSubmit="SaveStaffTypeAsync" FormName="newstafftype">
            <MudGrid Spacing="3" Class="pa-3">
                <MudGrid Spacing="5" Justify="Justify.Center" Class="ps-3 pt-6 pe-0" Style="border:none;">
                    <MudItem md="4" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Enter Department Details</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    <MudStaticTextField For="@(() => CurrentStaffType.StaffTypeName)" @bind-Value="CurrentStaffType.StaffTypeName" Margin="Margin.Dense"
                                                        Label="Department name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Department name"
                                                        UserAttributes="@(new() { { "autocomplete", "staffTypename" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="12">
                                    <MudStaticTextField For="@(() => CurrentStaffType.StaffTypeCode)" @bind-Value="CurrentStaffType.StaffTypeCode" Margin="Margin.Dense"
                                                        Label="Department code" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Department code"
                                                        UserAttributes="@(new() { { "autocomplete", "staffTypecode" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddStaffTypeToBatch(CurrentStaffType))" Class="mt-2" FullWidth="true">Add Department To Batch</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                    <MudItem md="8" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Department Batch Summary</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    @if (!StaffTypesBatch!.Any())
                                    {
                                        <NoDataNotice NoDataMessage="No Departments in Batch" />
                                    }
                                    else
                                    {

                                        <MudTable Dense="true" Height="500px" FixedHeader="true" Items="@StaffTypesBatch" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                            <HeaderContent>
                                                <MudTh>Description</MudTh>
                                                <MudTh>Department Code</MudTh>
                                                <MudTh></MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Description">@($"{medContext.StaffTypeName}")</MudTd>
                                                <MudTd DataLabel="StaffType Type">@medContext.StaffTypeCode</MudTd>
                                                <MudTd DataLabel="">
                                                    <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveStaffTypeFromBatch(medContext))" />
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                </MudGrid>

                <MudItem md="12" Style="text-align:end">
                    <MudItem Style="display:flex; justify-content:center; ">
                        @if (isCreatedSuccessfully)
                        {
                            <MudAlert Style="width:19%; margin-right:20px;" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">StaffTypes Added Successfully!</MudAlert>
                        }
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@addedSuccessfully</MudAlert>
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">@notaddedSuccessfully</MudAlert>
                    </MudItem>
                    <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="isSaving" Class="mt-3">
                        @if (isSaving)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                            <MudText Class="ps-3"> Saving Department...</MudText>
                        }
                        else
                        {
                            <MudText> Save Department</MudText>
                        }
                    </MudStaticButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="mt-3">Reset Page</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToStaffTypesPage" Class="mt-3">Back</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    List<StaffTypeDto>? AllStaffTypes;
    List<StaffTypeDto>? StaffTypesBatch = new();
    StaffTypeDto CurrentStaffType = new();

    string saveMessage = string.Empty;
    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";

    bool isCreatedSuccessfully;
    bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        AllStaffTypes = await staffService.GetStaffTypesAsync();
    }

    public async Task AddStaffTypeToBatch(StaffTypeDto typeDto)
    {
        var newStaffType = new StaffTypeDto
        {
            StaffTypeName = typeDto.StaffTypeName,
            StaffTypeCode = typeDto.StaffTypeCode,
            RegisteredDate = DateTime.Now,
        };

        if (newStaffType != null)
            StaffTypesBatch!.Add(newStaffType);

        await InvokeAsync(StateHasChanged);
    }

    public async Task RemoveStaffTypeFromBatch(StaffTypeDto typeDto)
    {
        if (StaffTypesBatch != null)
            StaffTypesBatch.Remove(typeDto);
    }

    public async Task SaveStaffTypeAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (StaffTypesBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var staffType in StaffTypesBatch)
            {
                var existingMed = await staffService.GetStaffTypeIdByNameAsync(staffType.StaffTypeName);

                if (existingMed.Id == 0)
                {
                    var isSucess = await staffService.AddStaffDepartmentAsync(staffType);

                    if (isSucess)
                    {
                        saveMessage = $"{staffType.StaffTypeName} added sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {staffType.StaffTypeName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {staffType.StaffTypeName} not added sucessfully! Please read staffType to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {staffType.StaffTypeName},";
                    }
                }
                else if (existingMed.Id > 0)
                {
                    var isSucess = await staffService.UpdateStaffDepartmentAsync(staffType, existingMed.Id);

                    if (isSucess)
                    {
                        saveMessage = $"{staffType.StaffTypeName} updated sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {staffType.StaffTypeName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {staffType.StaffTypeName} not updated sucessfully! Please read staffType to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {staffType.StaffTypeName},";
                    }
                }
            }
            if (notaddedSuccessfully == "Not Added:")
                isCreatedSuccessfully = true;
            CurrentStaffType = new();
            StaffTypesBatch.Clear();

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task ResetPage()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        CurrentStaffType = new();
    }

    public void ReturnToStaffTypesPage()
    {
        MudDialog.Cancel();
    }
}