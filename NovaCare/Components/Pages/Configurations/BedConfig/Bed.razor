@using NovaCare.Shared.DTOs.StaffDTOs
@inject IDialogService Dialog

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredBeds == null || !FilteredBeds.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex flex-column flex-sm-row justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@($"All {firstPart}s")</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenRegisterModal" Style="text-transform:none;">
                        Add Bed
                    </MudButton>
                </div>
                <NoDataNotice NoDataMessage="@messageBed" />
            </MudPaper>
        }
        else if (FilteredBeds != null)
        {
            @* Summary Metric Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Beds</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredBeds.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.KingBed" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Success" Style="text-transform:uppercase; letter-spacing:0.5px;">Available Beds</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">
                                @UnusedBeds
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.SingleBed" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="12">
                    <MudPaper Outlined="true" Class="pa-3 relative-tile vitalWarning-tile--alert">
                        <div class="d-flex align-center justify-space-between mb-1">
                            <span class="d-flex align-center gap-2 text-danger text-sm">
                                <MudIcon Icon="@Icons.Material.Outlined.Bed" Size="Size.Small" Color="Color.Secondary" /> Bed Occupancy
                            </span>
                            <MudText Typo="Typo.body2" Class="font-weight-bold text-danger">@AvailableBedsPercentage%</MudText>
                        </div>
                        <MudProgressLinear Value="@AvailableBedsPercentage" Color="Color.Warning" Size="Size.Small" Rounded="true" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Staff Beds Data Table *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Elevation="0"
                         Outlined="true"
                         T="BedDto"
                         Items="@FilteredBeds"
                         ReadOnly="@_readOnly"
                         RowStyle="cursor: pointer;"
                         Class="bg-transparent"
                         Bordered="false"
                         Dense="true"
                         RowClick="@((args) => PreviewBedProfile(args.Item))">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@($"All {firstPart}s")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredBeds.Count} beds")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search title, department, or group..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 260px;" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenRegisterModal"
                                       Style="text-transform:none; white-space:nowrap;">
                                Add Bed
                            </MudButton>
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    <TemplateColumn Bed="Bed Name" SortBy="@(x => x.BedCodeNumber)">
                        <CellTemplate>
                            <div class="d-flex align-center py-1">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="me-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.Badge" Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@context.Item.BedCodeNumber</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Role Designation</MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Bed="Department" SortBy="@(x => x.WardName)">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Outlined.Domain" Size="Size.Small" Color="Color.Secondary" Class="me-2" />
                                <MudText Typo="Typo.body2">@context.Item.WardName</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Bed="" CellStyle="width: 60px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="Edit Bed">
                                <MudIconButton Icon="@Icons.Material.Outlined.MoreVert"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => PreviewBedProfile(context.Item))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="BedDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    private bool _readOnly = true;

    List<BedDto>? AllBeds;
    List<BedDto>? FilteredBeds;
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public string Genre { get; set; } = string.Empty;

    BedDto? CurrentBed;

    double AvailableBedsPercentage = 0;
    int UnusedBeds = 0;

    string messageBed = string.Empty;
    string firstPart = string.Empty;
    string? searchString;

    bool isSearchLoading;
    bool isLoading;
    bool isEdit;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(300);

        AllBeds = await roomService.GetAllBedsAsync();
        ApplyFilterAndSearch();

        UnusedBeds = AllBeds
            .Where(w => w.BedAvailability =="UnUsed")
            .Count();

       var usedBedCount = AllBeds.Where(b => b.BedAvailability.ToLower().Trim() != "unused").Count();
        var totalBeds = AllBeds.Count();
        if (totalBeds > 0)
            AvailableBedsPercentage = Math.Round(((double)usedBedCount / totalBeds) * 100);

        
        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<BedDto> query = AllBeds ?? Enumerable.Empty<BedDto>();

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            firstPart = "Bed";
            messageBed = "No staff titles are currently configured.";
        }
        else
        {
            firstPart = FilterBy;
            messageBed = $"No {firstPart.ToLower()} titles are currently available.";
            query = query.Where(x => string.Equals(x.WardName?.Trim(), FilterBy.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x =>
                (x.BedCodeNumber?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.WardName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        FilteredBeds = query.ToList();
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    private async Task PreviewBedProfile(BedDto item)
    {
        var Parameters = new DialogParameters
        {
            {"CurrentBed" , item}
        };
        var dialog = await Dialog.ShowAsync<EditBed>("Bed Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null)
        {
            await OnInitializedAsync();
        }
    }

    public async Task Back()
    {
        CurrentBed = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task OpenRegisterModal()
    {
        var dialog = await Dialog.ShowAsync<NewBed>("Register New Bed", _maxWidth);
        var result = await dialog.Result;

        if (result != null)
        {
            await OnInitializedAsync();
        }
    }
}
