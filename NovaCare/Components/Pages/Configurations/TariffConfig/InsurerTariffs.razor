@using NovaCare.Shared.DTOs.InsuranceDTOs
@using NovaCare.Shared.DTOs.PaymentDTOs

@inject ISnackbar Snackbar

<PageTitle>Insurer Tariffs - NovaCare</PageTitle>

<MudGrid Spacing="3">
    <MudItem xs="12">
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-2">
            <div>
                <MudText Typo="Typo.h6" Style="font-weight:600;">Insurer Tariffs & Coverage Rules</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Configure agreed pricing, co-pay coverage percentages, and pre-approval rules per insurer</MudText>
            </div>
        </div>
    </MudItem>

    @* Filter & Action Card *@
    <MudItem xs="12">
        <MudPaper Elevation="0" Class="pa-4 bg-transparent border">
            <MudGrid Spacing="2" AlignItems="Center">
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int" Value="@selectedInsuranceId" ValueChanged="@OnInsuranceChanged"
                               Label="Insurance Provider" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="0" Disabled>Select Insurer (NHIF, ZHIF, Jubilee...)</MudSelectItem>
                        @foreach (var ins in Insurers)
                        {
                            <MudSelectItem Value="@ins.Id">@ins.InsuaranceName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int?" Value="@selectedSchemeId" ValueChanged="@OnSchemeChanged"
                               Disabled="@(selectedInsuranceId == 0)"
                               Label="Scheme (Optional)" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="int?" Value="@((int?)null)">All Schemes (Provider-Wide)</MudSelectItem>
                        @foreach (var sch in Schemes)
                        {
                            <MudSelectItem T="int?" Value="@((int?)sch.Id)">@sch.SchemeName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4" Class="d-flex justify-start justify-md-end">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(selectedInsuranceId == 0)"
                               OnClick="OpenNewTariffModal"
                               Style="text-transform:none;">
                        Add / Map Tariff Item
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>

    @* Tariff List Table *@
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-10">
                <GlobalLoader />
            </div>
        }
        else if (!Tariffs.Any())
        {
            <MudPaper Elevation="0" Class="pa-6 border bg-transparent text-center">
                <NoDataNotice NoDataMessage="No custom tariff rules configured for this insurer yet. Scheme default coverage % will apply." />
            </MudPaper>
        }
        else
        {
            @* Summary Metrics *@
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase;">Mapped Tariffs</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@Tariffs.Count</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Color="Color.Primary" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase;">Covered Items</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">@Tariffs.Count(t => t.IsCovered)</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Outlined.VerifiedUser" Color="Color.Success" />
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-warning);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase;">Pre-Approval Req.</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Warning" Style="font-weight:700;">@Tariffs.Count(t => t.RequiresPreApproval)</MudText>
                        </div>
                        <MudIcon Icon="@Icons.Material.Outlined.Rule" Color="Color.Warning" />
                    </MudPaper>
                </MudItem>
            </MudGrid>

            <MudDataGrid T="InsurerTariffDto"
                         Items="@Tariffs"
                         Hover="true"
                         Elevation="0"
                         Outlined="true"
                         Dense="true"
                         Bordered="false"
                         Class="bg-transparent">
                <Columns>
                    <TemplateColumn Title="Category" SortBy="@(x => x.ServiceType)">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.Item.ServiceType</MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Tariff Item" SortBy="@(x => x.InsurerItemName)">
                        <CellTemplate>
                            <div>
                                <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@context.Item.InsurerItemName</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Code: @context.Item.InsurerItemCode</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <PropertyColumn Property="x => x.InsuranceSchemeName" Title="Scheme" />
                    <PropertyColumn Property="x => x.AgreedPrice" Title="Agreed Price" Format="N2" />
                    <PropertyColumn Property="x => x.CoveragePercent" Title="Coverage %" Format="0.##" />

                    <TemplateColumn Title="Coverage Status">
                        <CellTemplate>
                            <div class="d-flex flex-wrap gap-1">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.Item.IsCovered ? Color.Success : Color.Error)">
                                    @(context.Item.IsCovered ? "Covered" : "Excluded")
                                </MudChip>
                                @if (context.Item.RequiresPreApproval)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Warning">Pre-Auth</MudChip>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Edit" CellStyle="width: 60px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="Edit Tariff Rule">
                                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Edit" Color="Color.Primary"
                                               OnClick="@(() => OpenEditTariffModal(context.Item))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="InsurerTariffDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

<MudDialog @bind-Visible="showDialog" Options="_maxWidth">
    <DialogContent>
        <MudGrid Spacing="3" Class="pa-2">
            <MudItem xs="12">
                <div style="border:1px solid rgba(63,81,181,0.9); border-radius:6px; overflow:hidden;">
                    <MudText Typo="Typo.h6" Class="py-2 px-4" Style="background-color: rgba(63,81,181,0.9); color:white;">
                        Configure Insurer Tariff Rule
                    </MudText>
                    <MudGrid Class="pa-4" Spacing="2">
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string" Value="@editTariff.ServiceType" ValueChanged="@OnServiceTypeChanged"
                                       Label="Service Category" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="@("Consultation")">Consultation</MudSelectItem>
                                <MudSelectItem Value="@("LabTest")">LabTest</MudSelectItem>
                                <MudSelectItem Value="@("Prescription")">Prescription (Medicine)</MudSelectItem>
                                <MudSelectItem Value="@("Treatment")">Treatment (Surgery/Therapy/Ward)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="int" @bind-Value="editTariff.ServiceItemId" Label="Hospital Item" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="0" Disabled>Select Hospital Service/Item</MudSelectItem>
                                @foreach (var opt in ServiceItemOptions)
                                {
                                    <MudSelectItem Value="@opt.Id">@opt.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="editTariff.InsurerItemCode" Label="Insurer Official Code" Placeholder="e.g. NHIF-101" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="8">
                            <MudTextField @bind-Value="editTariff.InsurerItemName" Label="Insurer Tariff Name" Placeholder="e.g. General OPD Consultation" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="editTariff.AgreedPrice" Label="Agreed Insurer Price (0 = Hospital Price)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="editTariff.CoveragePercent" Label="Coverage % (e.g. 100 or 80)" Min="0" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSwitch @bind-Value="editTariff.IsCovered" Color="Color.Success" Label="Covered by Insurer" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSwitch @bind-Value="editTariff.RequiresPreApproval" Color="Color.Warning" Label="Requires Pre-Approval" />
                        </MudItem>
                    </MudGrid>
                </div>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudGrid Spacing="1" Class="pe-4 pb-2" Justify="Justify.FlexEnd">
            <MudItem>
                <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Error" OnClick="@(() => showDialog = false)">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Size="Size.Medium" Color="Color.Success" OnClick="SaveTariffAsync">Save Tariff</MudButton>
            </MudItem>
        </MudGrid>
    </DialogActions>
</MudDialog>

@code {
    List<InsuaranceDto> Insurers = new();
    List<InsuranceSchemeDto> Schemes = new();
    List<InsurerTariffDto> Tariffs = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };

    int selectedInsuranceId;
    int? selectedSchemeId;
    bool isLoading;
    bool showDialog;

    InsurerTariffDto editTariff = new();
    List<(int Id, string Name)> ServiceItemOptions = new();

    protected override async Task OnInitializedAsync()
    {
        Insurers = await paymentService.GetAllInsuranceCompaniesAsync();
    }

    private async Task OnInsuranceChanged(int insId)
    {
        selectedInsuranceId = insId;
        selectedSchemeId = null;
        Schemes = await paymentService.GetSchemesByInsuranceIdAsync(insId);
        await LoadTariffsAsync();
    }

    private async Task OnSchemeChanged(int? schId)
    {
        selectedSchemeId = schId;
        await LoadTariffsAsync();
    }

    private async Task LoadTariffsAsync()
    {
        if (selectedInsuranceId == 0)
        {
            Tariffs.Clear();
            return;
        }

        isLoading = true;
        Tariffs = await paymentService.GetTariffsByInsuranceAsync(selectedInsuranceId, selectedSchemeId);
        isLoading = false;
    }

    private async Task OpenNewTariffModal()
    {
        editTariff = new InsurerTariffDto
        {
            InsuaranceId = selectedInsuranceId,
            InsuranceSchemeId = selectedSchemeId,
            ServiceType = "Consultation",
            CoveragePercent = 100m,
            IsCovered = true
        };
        await OnServiceTypeChanged("Consultation");
        showDialog = true;
    }

    private async Task OpenEditTariffModal(InsurerTariffDto existing)
    {
        editTariff = new InsurerTariffDto
        {
            Id = existing.Id,
            InsuaranceId = existing.InsuaranceId,
            InsuranceSchemeId = existing.InsuranceSchemeId,
            ServiceType = existing.ServiceType,
            ServiceItemId = existing.ServiceItemId,
            InsurerItemCode = existing.InsurerItemCode,
            InsurerItemName = existing.InsurerItemName,
            AgreedPrice = existing.AgreedPrice,
            CoveragePercent = existing.CoveragePercent,
            IsCovered = existing.IsCovered,
            RequiresPreApproval = existing.RequiresPreApproval
        };
        await OnServiceTypeChanged(existing.ServiceType);
        showDialog = true;
    }

    private async Task OnServiceTypeChanged(string category)
    {
        editTariff.ServiceType = category;
        ServiceItemOptions.Clear();

        switch (category)
        {
            case "Consultation":
                var docTypes = await doctorService.GetDoctorTypesAsync();
                ServiceItemOptions = docTypes.Select(d => (d.Id, $"{d.DoctorTypeName} ({d.DeptConsultationFee:N2})")).ToList();
                break;

            case "LabTest":
                var diseases = await diseaseService.GetAllDiseasesAsync();
                ServiceItemOptions = diseases.Select(d => (d.Id, $"{d.DiseaseName} ({d.LabTestCost:N2})")).ToList();
                break;

            case "Prescription":
                var meds = await medicineService.GetAllMedicinesAsync();
                ServiceItemOptions = meds.Select(m => (m.Id, $"{m.MedicineName} ({m.BuyingPrice:N2})")).ToList();
                break;

            case "Treatment":
                var treats = await medicineService.GetAllTreatmentTypeAsync();
                ServiceItemOptions = treats.Select(t => (t.Id, t.TreatmentTypeName)).ToList();
                break;
        }
    }

    private async Task SaveTariffAsync()
    {
        if (editTariff.ServiceItemId == 0 || string.IsNullOrWhiteSpace(editTariff.InsurerItemCode))
        {
            Snackbar.Add("Please select a hospital service/item and enter the insurer item code.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(editTariff.InsurerItemName))
        {
            editTariff.InsurerItemName = ServiceItemOptions.FirstOrDefault(x => x.Id == editTariff.ServiceItemId).Name ?? editTariff.ServiceType;
        }

        await paymentService.SaveInsurerTariffAsync(editTariff);
        Snackbar.Add("Tariff rule saved successfully!", Severity.Success);
        showDialog = false;
        await LoadTariffsAsync();
    }
}
