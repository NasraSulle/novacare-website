@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <EditForm Model="CurrentGroup" method="post" OnValidSubmit="SaveStaffTitleGroupAsync" FormName="newstaffTitleGroup">
            <MudGrid Spacing="3" Class="pa-3">
                <MudGrid Spacing="5" Justify="Justify.Center" Class="ps-3 pt-6 pe-0" Style="border:none;">
                    <MudItem md="4" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Enter Group Details</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    <MudStaticTextField For="@(() => CurrentGroup.GroupName)" @bind-Value="CurrentGroup.GroupName" Margin="Margin.Dense"
                                                        Label="Title Group Name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Title Group Name"
                                                        UserAttributes="@(new() { { "autocomplete", "staffTitleGroupname" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                
                                <MudItem md="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddStaffTitleGroupToBatch(CurrentGroup))" Class="mt-2" FullWidth="true">Add Group To Batch</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                    <MudItem md="8" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Groups Batch Summary</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    @if (!StaffTitleGroupsBatch!.Any())
                                    {
                                        <NoDataNotice NoDataMessage="No Staff Title Groups in Batch" />
                                    }
                                    else
                                    {

                                        <MudTable Dense="true" Height="500px" FixedHeader="true" Items="@StaffTitleGroupsBatch" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                            <HeaderContent>
                                                <MudTh>Description</MudTh>
                                                <MudTh></MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Description">@($"{medContext.GroupName}")</MudTd>
                                                <MudTd DataLabel="">
                                                    <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveStaffTitleGroupFromBatch(medContext))" />
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                </MudGrid>

                <MudItem md="12" Style="text-align:end">
                    <MudItem Style="display:flex; justify-content:center; ">
                        @if (isCreatedSuccessfully)
                        {
                            <MudAlert Style="width:19%; margin-right:20px;" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">StaffTitleGroups Added Successfully!</MudAlert>
                        }
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@addedSuccessfully</MudAlert>
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">@notaddedSuccessfully</MudAlert>
                    </MudItem>
                    <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="isSaving" Class="mt-3">
                        @if (isSaving)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                            <MudText Class="ps-3"> Saving StaffTitleGroups...</MudText>
                        }
                        else
                        {
                            <MudText> Save StaffTitleGroups</MudText>
                        }
                    </MudStaticButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="mt-3">Reset Page</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToStaffTitleGroupsPage" Class="mt-3">Back</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    List<StaffTitleGroupDto>? AllStaffTitleGroups;
    List<StaffTitleGroupDto>? StaffTitleGroupsBatch = new();
    StaffTitleGroupDto CurrentGroup = new();

    string saveMessage = string.Empty;
    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";

    bool isCreatedSuccessfully;
    bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        AllStaffTitleGroups = await staffService.GetAllStaffTitleGroupssAsync();
    }

    public async Task AddStaffTitleGroupToBatch(StaffTitleGroupDto staffTitleGroupDto)
    {
        var newStaffTitleGroup = new StaffTitleGroupDto
        {
            GroupName = staffTitleGroupDto.GroupName,
            RegisteredDate = DateTime.Now,
        };

        if (newStaffTitleGroup != null)
            StaffTitleGroupsBatch!.Add(newStaffTitleGroup);

        await InvokeAsync(StateHasChanged);
    }

    public async Task RemoveStaffTitleGroupFromBatch(StaffTitleGroupDto staffTitleGroupDto)
    {
        if (StaffTitleGroupsBatch != null)
            StaffTitleGroupsBatch.Remove(staffTitleGroupDto);
    }

    public async Task SaveStaffTitleGroupAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (StaffTitleGroupsBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var staffTitleGroup in StaffTitleGroupsBatch)
            {
                var existingMed = await staffService.GetStaffTitleGroupIdByNameAsync(staffTitleGroup.GroupName);

                if (existingMed.Id == 0)
                {
                    var isSucess = await staffService.AddStaffTitleGroupAsync(staffTitleGroup);

                    if (isSucess)
                    {
                        saveMessage = $"{staffTitleGroup.GroupName} added sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {staffTitleGroup.GroupName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {staffTitleGroup.GroupName} not added sucessfully! Please read staffTitleGroup to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {staffTitleGroup.GroupName},";
                    }
                }
                else if (existingMed.Id > 0)
                {
                    var isSucess = await staffService.UpdateTitleGroupAsync(staffTitleGroup, existingMed.Id);

                    if (isSucess)
                    {
                        saveMessage = $"{staffTitleGroup.GroupName} updated sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {staffTitleGroup.GroupName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {staffTitleGroup.GroupName} not updated sucessfully! Please read staffTitleGroup to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {staffTitleGroup.GroupName},";
                    }
                }
            }
            if (notaddedSuccessfully == "Not Added:")
                isCreatedSuccessfully = true;
            CurrentGroup = new();
            StaffTitleGroupsBatch.Clear();

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task ResetPage()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        CurrentGroup = new();
    }

    public void ReturnToStaffTitleGroupsPage()
    {
        MudDialog.Cancel();
    }
}