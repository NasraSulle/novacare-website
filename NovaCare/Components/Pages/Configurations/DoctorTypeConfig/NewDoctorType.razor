@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm Model="CurrentDoctorType" method="post" OnValidSubmit="SaveDoctorTypeAsync" FormName="newdoctorType">
            <MudGrid Spacing="3" Class="pa-3">
                <MudGrid Spacing="5" Justify="Justify.Center" Class="ps-3 pt-6 pe-0" Style="border:none;">
                    <MudItem md="4" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Enter DoctorType Details</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    <MudStaticTextField For="@(() => CurrentDoctorType.DoctorTypeName)" @bind-Value="CurrentDoctorType.DoctorTypeName" Margin="Margin.Dense"
                                                        Label="DoctorType name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="DoctorType name"
                                                        UserAttributes="@(new() { { "autocomplete", "doctorTypename" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="12">
                                    <MudNumericField For="@(() => CurrentDoctorType.DeptConsultationFee)" @bind-Value="CurrentDoctorType.DeptConsultationFee" Margin="Margin.Dense"
                                                     Label="DoctorType Cost" Variant="Variant.Outlined" Placeholder="DoctorType Cost"
                                                     UserAttributes="@(new() { { "autocomplete", "doctorTypename" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="12">
                                    <MudSelect For="@(() => CurrentDoctorType.MedicalDeptId)"
                                               @bind-Value="CurrentDoctorType.MedicalDeptId"
                                               Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                        <MudSelectItem Value="0" Disabled>Department</MudSelectItem>

                                        @foreach (var item in AllMedicalDepartments)
                                        {
                                            <MudSelectItem Value="@item.Id">@item.MedicalDepartmentName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem md="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(CurrentDoctorType.DoctorTypeName) || CurrentDoctorType.DeptConsultationFee == 0 || CurrentDoctorType.MedicalDeptId == 0" OnClick="@(() => AddDoctorTypeToBatch(CurrentDoctorType))" Class="mt-2" FullWidth="true">Add DoctorType To Batch</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                    <MudItem md="8" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius: 5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius: 5px; background-color: rgba(63,81,181,0.9); color:white;">DoctorTypes Batch Summary</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    @if (!DoctorTypesBatch!.Any())
                                    {
                                        <NoDataNotice NoDataMessage="No DoctorTypes in Batch" />
                                    }
                                    else
                                    {

                                        <MudTable Dense="true" Height="500px" FixedHeader="true" Items="@DoctorTypesBatch" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                            <HeaderContent>
                                                <MudTh>Description</MudTh>
                                                <MudTh>Department</MudTh>
                                                <MudTh>Cost</MudTh>
                                                <MudTh></MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Description">@($"{medContext.DoctorTypeName}")</MudTd>
                                                <MudTd DataLabel="Department">@medContext.MedicalDepartmentName</MudTd>
                                                <MudTd DataLabel="Cost">@medContext.DeptConsultationFee</MudTd>
                                                <MudTd DataLabel="">
                                                    <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveDoctorTypeFromBatch(medContext))" />
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                </MudGrid>

                <MudItem md="12" Style="text-align:end">
                    <MudItem Style="display:flex; justify-content:center; ">
                        @if (isCreatedSuccessfully)
                        {
                            <MudAlert Style="width:19%; margin-right:20px;" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">DoctorTypes Added Successfully!</MudAlert>
                        }
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@addedSuccessfully</MudAlert>
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">@notaddedSuccessfully</MudAlert>
                    </MudItem>
                    <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="isSaving" Class="mt-3">
                        @if (isSaving)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                            <MudText Class="ps-3"> Saving  DoctorTypes...</MudText>
                        }
                        else
                        {
                            <MudText> Save DoctorTypes</MudText>
                        }
                    </MudStaticButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="mt-3">Reset Page</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToStaffDoctorTypesPage" Class="mt-3">Back</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    List<DoctorTypeDto>? AllDoctorTypes;
    List<DoctorTypeDto>? DoctorTypesBatch = new();
    List<MedicalDepartmentDto> AllMedicalDepartments = new();

    DoctorTypeDto CurrentDoctorType = new();

    string saveMessage = string.Empty;
    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";

    bool isCreatedSuccessfully;
    bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        AllDoctorTypes = await doctorService.GetDoctorTypesAsync();
        AllMedicalDepartments = await medicineService.GetAllMedicalDeptsAsync();
    }

    public async Task AddDoctorTypeToBatch(DoctorTypeDto doctorTypeDto)
    {

        var existingMed = await doctorService.GetDoctorTypeByNameAsync(doctorTypeDto.DoctorTypeName);
        bool inBatch = false;
        inBatch = DoctorTypesBatch?.Any(r => r.DoctorTypeName == doctorTypeDto.DoctorTypeName) ?? false;

        if (existingMed.Id == 0 && !inBatch)
        {
            doctorTypeDto.MedicalDepartmentName = AllMedicalDepartments.FirstOrDefault(rt => rt.Id == doctorTypeDto.MedicalDeptId)?.MedicalDepartmentName ?? string.Empty;
            var newDoctorType = new DoctorTypeDto
            {
                DoctorTypeName = doctorTypeDto.DoctorTypeName,
                DeptConsultationFee = doctorTypeDto.DeptConsultationFee,
                MedicalDepartmentName = doctorTypeDto.MedicalDepartmentName,
                MedicalDeptId = doctorTypeDto.MedicalDeptId,
            };

            if (newDoctorType != null)
                DoctorTypesBatch!.Add(newDoctorType);
        }
        else if (existingMed.Id > 0 && !inBatch)
        {
            saveMessage = $"{existingMed.DoctorTypeName} is already registered";
            Snackbar.Add<MudChip<string>>(new Dictionary<string, object>() {
                        { "Text", $"{saveMessage}" },
                        { "Color", Color.Error }
                    });
        }
        else if (existingMed.Id == 0 && inBatch)
        {
            saveMessage = $"{existingMed.DoctorTypeName} is already batch";
            Snackbar.Add<MudChip<string>>(new Dictionary<string, object>() {
                        { "Text", $"{saveMessage}" },
                        { "Color", Color.Error }
                    });
        }

        await InvokeAsync(StateHasChanged);

    }

    public async Task RemoveDoctorTypeFromBatch(DoctorTypeDto doctorTypeDto)
    {
        if (DoctorTypesBatch != null)
            DoctorTypesBatch.Remove(doctorTypeDto);
    }

    public async Task SaveDoctorTypeAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (DoctorTypesBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var doctorType in DoctorTypesBatch)
            {
                var existingMed = await doctorService.GetDoctorTypeByNameAsync(doctorType.DoctorTypeName);

                if (existingMed.Id == 0)
                {
                    var isSucess = await doctorService.AddDoctorTypeAsync(doctorType);

                    if (isSucess)
                    {
                        saveMessage = $"{doctorType.DoctorTypeName} added sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {doctorType.DoctorTypeName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {doctorType.DoctorTypeName} not added sucessfully! Please read doctorType to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {doctorType.DoctorTypeName},";
                    }
                }
                else if (existingMed.Id > 0)
                {
                    var isSucess = await doctorService.UpdateDoctorTypeAsync(doctorType, existingMed.Id);

                    if (isSucess)
                    {
                        saveMessage = $"{doctorType.DoctorTypeName} updated sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {doctorType.DoctorTypeName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {doctorType.DoctorTypeName} not updated sucessfully! Please read doctorType to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {doctorType.DoctorTypeName},";
                    }
                }
            }
            if (notaddedSuccessfully == "Not Added:")
                isCreatedSuccessfully = true;
            CurrentDoctorType = new();
            DoctorTypesBatch.Clear();

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task ResetPage()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        CurrentDoctorType = new();
    }

    public void ReturnToStaffDoctorTypesPage()
    {
        MudDialog.Cancel();
    }
}