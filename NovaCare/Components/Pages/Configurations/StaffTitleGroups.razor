@using NovaCare.Shared.DTOs.StaffDTOs
@inject IDialogService Dialog

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredStaffTitleGroups == null || !FilteredStaffTitleGroups.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex flex-column flex-sm-row justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@($"All {firstPart}s")</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenRegisterModal" Style="text-transform:none;">
                        Add Title Group
                    </MudButton>
                </div>
                <NoDataNotice NoDataMessage="@messageStaffTitleGroup" />
            </MudPaper>
        }
        else if (FilteredStaffTitleGroups != null)
        {
            @* Summary Metric Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Title Groups</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredStaffTitleGroups.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-info);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Mapped Titles</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Info" Style="font-weight:700;">
                                @FilteredStaffTitleGroups.Sum(x => x.GroupsCount)
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.Badge" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Title Groups Data Table *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Elevation="0"
                         Outlined="true"
                         T="StaffTitleGroupDto"
                         Items="@FilteredStaffTitleGroups"
                         ReadOnly="@_readOnly"
                         RowStyle="cursor: pointer;"
                         Class="bg-transparent"
                         Bordered="false"
                         Dense="true"
                         RowClick="@((args) => PreviewStaffTitleGroupProfile(args.Item))">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@($"All {firstPart}s")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredStaffTitleGroups.Count} groups")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search title group..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 240px;" />

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="OpenRegisterModal"
                                       Style="text-transform:none; white-space:nowrap;">
                                Add Title Group
                            </MudButton>
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    <TemplateColumn Title="Staff Title Group" SortBy="@(x => x.GroupName)">
                        <CellTemplate>
                            <div class="d-flex align-center py-1">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="me-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight:600;">@context.Item.GroupName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Role Hierarchy Group</MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="Total Titles" SortBy="@(x => x.GroupsCount)">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                @($"{context.Item.GroupsCount} titles")
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    <TemplateColumn Title="" CellStyle="width: 60px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="Edit Title Group">
                                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => PreviewStaffTitleGroupProfile(context.Item))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="StaffTitleGroupDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    private bool _readOnly = true;

    List<StaffTitleGroupDto>? AllStaffTitleGroups;
    List<StaffTitleGroupDto>? FilteredStaffTitleGroups;
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public string Genre { get; set; } = string.Empty;

    StaffTitleGroupDto? CurrentGroup;

    string messageStaffTitleGroup = string.Empty;
    string firstPart = string.Empty;
    string? searchString;

    bool isSearchLoading;
    bool isLoading;
    bool isEdit;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(300);

        AllStaffTitleGroups = await staffService.GetAllStaffTitleGroupssAsync();
        ApplyFilterAndSearch();

        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<StaffTitleGroupDto> query = AllStaffTitleGroups ?? Enumerable.Empty<StaffTitleGroupDto>();

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            firstPart = "Title Group";
            messageStaffTitleGroup = "No staff title groups are currently configured.";
        }
        else
        {
            firstPart = FilterBy;
            messageStaffTitleGroup = $"No {firstPart.ToLower()} records are currently available.";
            query = query.Where(x => string.Equals(x.GroupName?.Trim(), FilterBy.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x => x.GroupName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false);
        }

        FilteredStaffTitleGroups = query.ToList();
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    private async Task PreviewStaffTitleGroupProfile(StaffTitleGroupDto item)
    {
        var Parameters = new DialogParameters
        {
            {"CurrentGroup" , item}
        };
        var dialog = await Dialog.ShowAsync<EditTitleGroup>("Title Group Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    public async Task Back()
    {
        CurrentGroup = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task OpenRegisterModal()
    {
        var dialog = await Dialog.ShowAsync<NewGroup>("Register New Staff Title Group", _maxWidth);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }
}
