@page "/ConfigurationIndex"
@using NovaCare.Components.Pages.Configurations.BedConfig
@using NovaCare.Components.Pages.Configurations.DeptConfig
@using NovaCare.Components.Pages.Configurations.DiseaseConfig
@using NovaCare.Components.Pages.Configurations.DoctorTypeConfig
@using NovaCare.Components.Pages.Configurations.GroupConfig
@using NovaCare.Components.Pages.Configurations.RoomConfig
@using NovaCare.Components.Pages.Configurations.SurgeryConfig
@using NovaCare.Components.Pages.Configurations.TariffConfig
@using NovaCare.Components.Pages.Configurations.TherapyConfig
@using NovaCare.Components.Pages.Configurations.TitleConfig
@using NovaCare.Components.Pages.Configurations.WardConfig

@rendermode InteractiveServer
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<PageTitle>Configurations - NovaCare</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-3 px-sm-6">
    @* Page Header *@
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center">
        <SectionTitle Icon="@icon" Title="@title" />
        <Briefer BriferNote="@briferNote" />
    </div>

    @* Main Elevated Card Container *@
    <MudPaper Elevation="0" Class="pa-0 w-100" Style="background-color: rgba(246,246,246,1) !important;">
        <MudTabs Elevation="0"
                 Rounded="false"
                 ApplyEffectsToContainer="true"
                 TabHeaderClass="bg-secondary-subtle rounded-lg"
                 SliderColor="Color.Error"
                 TabPanelsClass="pa-0">
            <MudTabPanel Text="Therapies" Icon="@Icons.Material.Outlined.Accessible" Style="text-transform: none; font-weight: 500;">
                <div class="pa-3 pa-sm-6">
                    <Therapy />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Surgeries" Icon="@Icons.Material.Outlined.BabyChangingStation" Style="text-transform: none; font-weight: 500;">
                <div class="pa-3 pa-sm-6">
                    <Surgery />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Doctor Types" Icon="@Icons.Material.Outlined.Person2" Style="text-transform: none; font-weight: 500;">
                <div class="pa-3 pa-sm-6">
                    <DoctorType />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Wards" Icon="@Icons.Material.Outlined.LocalHospital" Style="text-transform: none; font-weight: 500;">
                <div class="pa-3 pa-sm-6">
                    <Ward />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Rooms" Icon="@Icons.Material.Outlined.MeetingRoom" Style="text-transform: none; font-weight: 500;">
                <div class="pa-0 pa-sm-0">
                    <RoomIndex />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Beds" Icon="@Icons.Material.Outlined.Bed" Style="text-transform: none; font-weight: 500;">
                <div class="pa-3 pa-sm-6">
                    <Bed />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Staff Titles" Icon="@Icons.Material.Outlined.Badge" Style="text-transform: none; font-weight: 500;">
                <div class="pa-3 pa-sm-6">
                <StaffTitles />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Staff Title Groups" Icon="@Icons.Material.Outlined.AccountTree" Style="text-transform: none; font-weight: 500;">
            <div class="pa-3 pa-sm-6">
                <StaffTitleGroups />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Staff Departments" Icon="@Icons.Material.Outlined.Domain" Style="text-transform: none; font-weight: 500;">
            <div class="pa-3 pa-sm-6">
                <StaffDepartments />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Lab Test Diseases" Icon="@Icons.Material.Outlined.Biotech" Style="text-transform: none; font-weight: 500;">
            <div class="pa-3 pa-sm-6">
                <Diseases />
                </div>
            </MudTabPanel>
            <MudTabPanel Text="Insurer Tariffs" Icon="@Icons.Material.Outlined.PriceChange" Style="text-transform: none; font-weight: 500;">
            <div class="pa-3 pa-sm-6">
                <InsurerTariffs />
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    public string icon = Icons.Material.Filled.SettingsApplications;
    public string title = "System Configurations";
    string briferNote = "Manage hospital wards, staff roles, diagnostic catalogs, and insurer tariffs";
}
