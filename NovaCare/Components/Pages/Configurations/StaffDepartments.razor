@using NovaCare.Shared.DTOs.StaffDTOs
@inject IDialogService Dialog

<MudGrid>
    <MudItem md="12" Class="pa-0" Style="text-align: center;">
        @if (isLoading)
        {
            <MudItem Class="pa-6">
                <GlobalLoader />
            </MudItem>
        }
        else if (!isLoading && !FilteredStaffType!.Any() && string.IsNullOrWhiteSpace(searchString))
        {
            <MudGrid Class="pa-6">
                <MudItem md="12" Class="d-flex align-center">
                    <MudText Typo="Typo.h6">@($"All {firstPart}s")</MudText>
                    <MudSpacer />

                    <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium" OnClick="OpenRegisterModal">Add</MudButton>
                </MudItem>
                <MudItem md="12">
                    <NoDataNotice NoDataMessage="@messageDepartment" />
                </MudItem>
            </MudGrid>
        }
        else if (FilteredStaffType != null)
        {
            <MudGrid Class="ps-6 pt-6" Justify="Justify.Center">
                <MudItem md="12">
                    <MudDataGrid Loading="@isSearchLoading" Hover="true" T="StaffTypeDto" Items="@FilteredStaffType" ReadOnly="@_readOnly" Class="ps-6 pe-6 pb-6"
                                 Bordered="false" Dense="true" RowClick="@((args) => PreviewDepartmentProfile(args.Item))">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6">@($"All {firstPart}s")</MudText>
                            <MudSpacer />
                            <!--Filters & Search Panel Later OnDebounceIntervalElapsed="wekaAti-HandleIntervalElapsed"-->

                            <MudItem>
                                <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                                              Margin="Margin.Dense" Variant="Variant.Outlined"
                                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="me-1"></MudTextField>
                            </MudItem>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium" OnClick="OpenRegisterModal">Add</MudButton>

                        </ToolBarContent>

                        <Columns>
                            <PropertyColumn Property="x => x.StaffTypeName" Title="Department Name" />
                            <PropertyColumn Property="x => x.StaffTypeCode" Title="Department Code" />
                            <PropertyColumn Property="x => x.StaffsTitleCount" Title="Total Staffs" />
                        </Columns>

                        <PagerContent>
                            <MudDataGridPager T="StaffTypeDto" />
                        </PagerContent>
                    </MudDataGrid>
                </MudItem>
            </MudGrid>
        }
    </MudItem>
</MudGrid>

@code {

    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    private bool _readOnly;

    private bool _isCellEditMode;
    private bool _editTriggerRowClick; //!!?

    private void StartedEditingItem(StaffTypeDto item)
    {
        isEdit = true;
    }

    private void CanceledEditingItem(StaffTypeDto item)
    {
        isEdit = false;
    }

    private async Task PreviewDepartmentProfile(StaffTypeDto item)
    {
        var Parameters = new DialogParameters
        {
            {"CurrentStaffType" , item}
        };
        var dialog = await Dialog.ShowAsync<EditDepartment>("Department Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    //=====================HERE===============================

    List<StaffTypeDto>? AllStaffType;
    List<StaffTypeDto>? FilteredStaffType;
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public string Genre { get; set; } = string.Empty;

    StaffTypeDto? CurrentStaffType;

    string messageDepartment = string.Empty;
    string firstPart = string.Empty;
    string? searchString;

    bool isSearchLoading;
    bool isLoading;
    bool isEdit;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(500);

        AllStaffType = await staffService.GetStaffTypesAsync();

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            FilteredStaffType = AllStaffType;
            messageDepartment = $"{Genre} StaffType are not avalible!";
            firstPart = "Department";
        }
        else
        {

            firstPart = FilterBy;
            messageDepartment = $"{Genre} {firstPart}s are not avalible!";

            if (FilterBy != null && Genre != null)
            {
                FilteredStaffType = AllStaffType?.Where(x => x.StaffTypeName == FilterBy).ToList();
            }
            else
            {
                FilteredStaffType = null;
            }
        }
        isLoading = false;
        StateHasChanged();
    }

    public async Task Back()
    {
        CurrentStaffType = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        await Task.Delay(500);

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            FilteredStaffType = AllStaffType?.Where(x => x.StaffTypeName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.StaffTypeCode.Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
            messageDepartment = "Staffs are not avalible!";
            firstPart = "Staff";
        }
        else
        {
            firstPart = FilterBy.Substring(2);
            messageDepartment = $"{firstPart}s are not avalible!";

            if (searchString != null)
            {
                FilteredStaffType = AllStaffType?.Where(x => x.StaffTypeName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.StaffTypeCode.Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            else
            {
                FilteredStaffType = null;
            }
        }
        isSearchLoading = false;
    }

    public async Task OpenRegisterModal()
    {
        var dialog = await Dialog.ShowAsync<NewDepartment>("Register New Department", _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnInitializedAsync();
        }
    }
}
