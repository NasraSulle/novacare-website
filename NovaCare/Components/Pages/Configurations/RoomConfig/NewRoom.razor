@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <EditForm Model="CurrentRoom" method="post" OnValidSubmit="SaveRoomAsync" FormName="newroom">
            <MudGrid Spacing="3" Class="pa-3">
                <MudGrid Spacing="5" Justify="Justify.Center" Class="ps-3 pt-6 pe-0" Style="border:none;">
                    <MudItem md="4" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Enter Room Details</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    <MudStaticTextField For="@(() => CurrentRoom.RoomName)" @bind-Value="CurrentRoom.RoomName" Margin="Margin.Dense"
                                                        Label="Title name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Title name"
                                                        UserAttributes="@(new() { { "autocomplete", "roomname" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="12">
                                    <MudSelect For="@(() => CurrentRoom.RoomTypeId)"
                                               @bind-Value="CurrentRoom.RoomTypeId"
                                               Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                        <MudSelectItem Value="0" Disabled>Type</MudSelectItem>

                                        @foreach (var item in AllRoomTypes)
                                        {
                                            <MudSelectItem Value="@item.Id">@item.RoomTypeName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem md="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(CurrentRoom.RoomName) || CurrentRoom.RoomTypeId == 0" OnClick="@(() => AddRoomToBatch(CurrentRoom))" Class="mt-2" FullWidth="true">Add Room To Batch</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                    <MudItem md="8" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Rooms Batch Summary</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    @if (!RoomsBatch!.Any())
                                    {
                                        <NoDataNotice NoDataMessage="No Rooms in Batch" />
                                    }
                                    else
                                    {

                                        <MudTable Dense="true" Height="500px" FixedHeader="true" Items="@RoomsBatch" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                            <HeaderContent>
                                                <MudTh>Name</MudTh>
                                                <MudTh>Type</MudTh>
                                                <MudTh></MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Name">@($"{medContext.RoomName}")</MudTd>
                                                <MudTd DataLabel="Type">@medContext.RoomTypeName</MudTd>
                                                <MudTd DataLabel="">
                                                    <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveRoomFromBactch(medContext))" />
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                </MudGrid>

                <MudItem md="12" Style="text-align:end">
                    <MudItem Style="display:flex; justify-content:center; ">
                        @if (isCreatedSuccessfully)
                        {
                            <MudAlert Style="width:19%; margin-right:20px;" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">StaffTitles Added Successfully!</MudAlert>
                        }
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@addedSuccessfully</MudAlert>
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">@notaddedSuccessfully</MudAlert>
                    </MudItem>
                    <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="isSaving" Class="mt-3">
                        @if (isSaving)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                            <MudText Class="ps-3"> Saving  Titles...</MudText>
                        }
                        else
                        {
                            <MudText> Save Rooms</MudText>
                        }
                    </MudStaticButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="mt-3">Reset Page</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToStaffTitlesPage" Class="mt-3">Back</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    List<RoomDto>? AllRooms;
    List<RoomDto>? RoomsBatch = new();
    List<RoomTypeDto> AllRoomTypes = new();
    RoomDto CurrentRoom = new();

    string saveMessage = string.Empty;
    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";

    bool isCreatedSuccessfully;
    bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        AllRooms = await roomService.GetAllRoomsAsync();
        AllRoomTypes = await roomService.GetAllRoomTypesAsync();
    }

    public async Task AddRoomToBatch(RoomDto roomDto)
    {
        var existingMed = await roomService.GetRoomByNameAsync(roomDto.RoomName);
        bool inBatch = false;
        inBatch = RoomsBatch?.Any(r => r.RoomName == roomDto.RoomName) ?? false;

        if (existingMed.Id == 0 && !inBatch)
        {
            roomDto.RoomTypeName = AllRoomTypes.FirstOrDefault(rt => rt.Id == roomDto.RoomTypeId)?.RoomTypeName ?? string.Empty;
            var newRoom = new RoomDto
            {
                RoomName = roomDto.RoomName,
                RoomStatusId = 2,
                RoomTypeId = roomDto.RoomTypeId,
                RoomTypeName = roomDto.RoomTypeName,
                RoomStatusName = roomDto.RoomStatusName
            };

            if (newRoom != null)
                RoomsBatch!.Add(newRoom);
        }
        else if (existingMed.Id > 0 && !inBatch)
        {
            saveMessage = $"{existingMed.RoomName} is already registered";
            Snackbar.Add<MudChip<string>>(new Dictionary<string, object>() {
                        { "Text", $"{saveMessage}" },
                        { "Color", Color.Error }
                    });
        }
        else if (existingMed.Id == 0 && inBatch)
        {
            saveMessage = $"{existingMed.RoomName} is already batch";
            Snackbar.Add<MudChip<string>>(new Dictionary<string, object>() {
                        { "Text", $"{saveMessage}" },
                        { "Color", Color.Error }
                    });
        }
        await InvokeAsync(StateHasChanged);
    }

    public async Task RemoveRoomFromBactch(RoomDto roomDto)
    {
        if (RoomsBatch != null)
            RoomsBatch.Remove(roomDto);
    }

    public async Task SaveRoomAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (RoomsBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var room in RoomsBatch)
            {
                var existingMed = await roomService.GetRoomByNameAsync(room.RoomName);

                if (existingMed.Id == 0)
                {
                    var isSucess = await roomService.AddRoomAsync(room);

                    if (isSucess)
                    {
                        saveMessage = $"{room.RoomName} added sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {room.RoomName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {room.RoomName} not added sucessfully! Please read room to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {room.RoomName},";
                    }
                }
                else if (existingMed.Id > 0)
                {
                    var isSucess = await roomService.UpdateRoomAsync(room, existingMed.Id);

                    if (isSucess)
                    {
                        saveMessage = $"{room.RoomName} updated sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {room.RoomName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {room.RoomName} not updated sucessfully! Please read room to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {room.RoomName},";
                    }
                }
            }
            if (notaddedSuccessfully == "Not Added:")
                isCreatedSuccessfully = true;
            CurrentRoom = new();
            RoomsBatch.Clear();

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task ResetPage()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        CurrentRoom = new();
        RoomsBatch?.Clear();
    }

    public void ReturnToStaffTitlesPage()
    {
        MudDialog.Cancel();
    }
}