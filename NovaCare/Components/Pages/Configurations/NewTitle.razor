@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <EditForm Model="CurrentTitle" method="post" OnValidSubmit="SaveStaffTitleAsync" FormName="newdisease">
            <MudGrid Spacing="3" Class="pa-3">
                <MudGrid Spacing="5" Justify="Justify.Center" Class="ps-3 pt-6 pe-0" Style="border:none;">
                    <MudItem md="4" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Enter Title Details</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    <MudStaticTextField For="@(() => CurrentTitle.StaffTitleName)" @bind-Value="CurrentTitle.StaffTitleName" Margin="Margin.Dense"
                                                        Label="Title name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Title name"
                                                        UserAttributes="@(new() { { "autocomplete", "diseasename" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="12">
                                    <MudSelect For="@(() => CurrentTitle.StaffTypeId)"
                                               @bind-Value="CurrentTitle.StaffTypeId"
                                               Label="Department" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                        <MudSelectItem Value="0" Disabled>Department</MudSelectItem>

                                        @foreach (var item in AllStaffTitleTypes)
                                        {
                                            <MudSelectItem Value="@item.Id">@item.StaffTypeName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem md="12">
                                    <MudSelect For="@(() => CurrentTitle.TitleGroupId)"
                                               @bind-Value="CurrentTitle.TitleGroupId"
                                               Label="Title Group" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                        <MudSelectItem Value="0" Disabled>Title Group</MudSelectItem>

                                        @foreach (var item in AllStaffTitleGroups)
                                        {
                                            <MudSelectItem Value="@item.Id">@item.GroupName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem md="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddStaffTitleToBatch(CurrentTitle))" Class="mt-2" FullWidth="true">Add Title To Batch</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                    <MudItem md="8" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9);; border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9);; color:white;">Staff Titles Batch Summary</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    @if (!StaffTitlesBatch!.Any())
                                    {
                                        <NoDataNotice NoDataMessage="No StaffTitles in Batch" />
                                    }
                                    else
                                    {

                                        <MudTable Dense="true" Height="500px" FixedHeader="true" Items="@StaffTitlesBatch" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                            <HeaderContent>
                                                <MudTh>Description</MudTh>
                                                <MudTh>Department</MudTh>
                                                <MudTh>Staff Group</MudTh>
                                                <MudTh></MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Description">@($"{medContext.StaffTitleName}")</MudTd>
                                                <MudTd DataLabel="Department">@medContext.StaffTypeName</MudTd>
                                                <MudTd DataLabel="Staff Group">@medContext.TitleGroupName</MudTd>
                                                <MudTd DataLabel="">
                                                    <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveStaffTitleFromBatch(medContext))" />
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                </MudGrid>

                <MudItem md="12" Style="text-align:end">
                    <MudItem Style="display:flex; justify-content:center; ">
                        @if (isCreatedSuccessfully)
                        {
                            <MudAlert Style="width:19%; margin-right:20px;" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">StaffTitles Added Successfully!</MudAlert>
                        }
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@addedSuccessfully</MudAlert>
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">@notaddedSuccessfully</MudAlert>
                    </MudItem>
                    <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="isSaving" Class="mt-3">
                        @if (isSaving)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                            <MudText Class="ps-3"> Saving  Titles...</MudText>
                        }
                        else
                        {
                            <MudText> Save Staff Titles</MudText>
                        }
                    </MudStaticButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="mt-3">Reset Page</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToStaffTitlesPage" Class="mt-3">Back</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    List<StaffTitleDto>? AllStaffTitles;
    List<StaffTitleDto>? StaffTitlesBatch = new();
    List<StaffTypeDto> AllStaffTitleTypes = new();
    List<StaffTitleGroupDto> AllStaffTitleGroups = new();
    StaffTitleDto CurrentTitle = new();

    string saveMessage = string.Empty;
    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";

    bool isCreatedSuccessfully;
    bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        AllStaffTitles = await staffService.GetStaffTitlesAsync();
        AllStaffTitleTypes = await staffService.GetStaffTypesAsync();
        AllStaffTitleGroups = await staffService.GetAllStaffTitleGroupssAsync();
    }

    public async Task AddStaffTitleToBatch(StaffTitleDto diseaseDto)
    {
        var newStaffTitle = new StaffTitleDto
        {
            StaffTitleName = diseaseDto.StaffTitleName,
            StaffTypeId = diseaseDto.StaffTypeId,
            TitleGroupId = diseaseDto.TitleGroupId,
            RegisteredDate = DateTime.Now,
        };

        if (newStaffTitle != null)
            StaffTitlesBatch!.Add(newStaffTitle);

        await InvokeAsync(StateHasChanged);
    }

    public async Task RemoveStaffTitleFromBatch(StaffTitleDto diseaseDto)
    {
        if (StaffTitlesBatch != null)
            StaffTitlesBatch.Remove(diseaseDto);
    }

    public async Task SaveStaffTitleAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (StaffTitlesBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var disease in StaffTitlesBatch)
            {
                var existingMed = await staffService.GetStaffTitleIdByNameAsync(disease.StaffTitleName);

                if (existingMed.Id == 0)
                {
                    var isSucess = await staffService.AddStaffTitleAsync(disease);

                    if (isSucess)
                    {
                        saveMessage = $"{disease.StaffTitleName} added sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {disease.StaffTitleName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {disease.StaffTitleName} not added sucessfully! Please read disease to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {disease.StaffTitleName},";
                    }
                }
                else if (existingMed.Id > 0)
                {
                    var isSucess = await staffService.UpdateStaffTitleAsync(disease, existingMed.Id);

                    if (isSucess)
                    {
                        saveMessage = $"{disease.StaffTitleName} updated sucessfully";
                        Console.WriteLine(saveMessage);
                        addedSuccessfully = addedSuccessfully + $" {disease.StaffTitleName},";
                    }
                    else
                    {
                        saveMessage = $"Error: {disease.StaffTitleName} not updated sucessfully! Please read disease to batch and save";
                        Console.WriteLine(saveMessage);
                        notaddedSuccessfully = notaddedSuccessfully + $" {disease.StaffTitleName},";
                    }
                }
            }
            if (notaddedSuccessfully == "Not Added:")
                isCreatedSuccessfully = true;
            CurrentTitle = new();
            StaffTitlesBatch.Clear();

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task ResetPage()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        CurrentTitle = new();
    }

    public void ReturnToStaffTitlesPage()
    {
        MudDialog.Cancel();
    }
}