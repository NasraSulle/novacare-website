@using NovaCare.Shared.DTOs.MedicineDTOs
@using NovaCare.Shared.DTOs.StaffDTOs
@using NovaCare.Shared.DTOs.TreatmentDTOs
@inject IDialogService Dialog

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredPrescriptions == null || !FilteredPrescriptions.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6">Pending Prescriptions</MudText>
                </div>
                <NoDataNotice NoDataMessage="@messageMedicine" />
            </MudPaper>
        }
        else if (FilteredPrescriptions != null)
        {
            @* Queue Summary Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-warning);background-color: rgba(246,246,246,0.01) !important;">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Warning" Style="text-transform:uppercase; letter-spacing:0.5px;">Pending Dispense Queue</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredPrescriptions.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.PendingActions" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-primary);background-color: rgba(246,246,246,0.01) !important;">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Units to Dispense</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredPrescriptions.Sum(x => x.Quantity)</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.LocalPharmacy" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Prescriptions Data Grid *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Elevation="0"
                         Outlined="true"
                         T="PrescriptionDto"
                         Items="@FilteredPrescriptions"
                         ReadOnly="@_readOnly"
                         Class="" Style="background-color: rgba(246,246,246,0.01) !important;"
                         Bordered="false"
                         Dense="true">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">Pending Prescriptions</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@($"{FilteredPrescriptions.Count} pending")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search medicine, dosage, or Visit ID..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 260px;" />

                            @if (isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="GeneratePdf"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Generate Pdf
                                </MudButton>
                            }
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    @* Medicine & Visit Reference *@
                    <TemplateColumn Title="Medication" SortBy="@(x => x.MedicineName)">
                        <CellTemplate>
                            <div class="d-flex align-center py-1">
                                <MudAvatar Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="me-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.MedicationLiquid" Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; line-height: 1.2;">
                                        @context.Item.MedicineName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @($"Visit ID: #{context.Item.VisitId}")
                                    </MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Dosage Instructions *@
                    <TemplateColumn Title="Dosage Instructions" SortBy="@(x => x.Dosage)">
                        <CellTemplate>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                @context.Item.Dosage
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Quantity *@
                    <TemplateColumn Title="Quantity" SortBy="@(x => x.Quantity)">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @($"{context.Item.Quantity} units")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Dispense Action *@
                    <TemplateColumn CellStyle="text-align: right;">
                        <CellTemplate>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.CheckCircleOutline"
                                       Size="Size.Small"
                                       Style="text-transform: none;"
                                       OnClick="@(() => DispenseAsync(context.Item))">
                                Dispense
                            </MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="PrescriptionDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    private bool _readOnly = true;

    [Parameter] public List<PrescriptionDto> AllPrescriptions { get; set; } = new();
    List<PrescriptionDto> FilteredPrescriptions = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public string Genre { get; set; } = string.Empty;
    [Parameter] public bool isReport { get; set; }
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;

    PrescriptionDto? CurrentPrescription;

    string messageMedicine = string.Empty;
    string? searchString;
    string? pdfBase64;

    bool isSearchLoading;
    bool isLoading;
    bool isEdit;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(300);

        if (!isReport)
        {
            var fetched = await medicineService.GetAllPrescriptionsAsync() ?? new();
            AllPrescriptions = fetched
                .Where(p => p.IsReadyForService && !p.IsDispensed)
                .ToList();
        }

        ApplyFilterAndSearch();

        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<PrescriptionDto> query = AllPrescriptions ?? Enumerable.Empty<PrescriptionDto>();

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x =>
                (x.MedicineName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.Dosage?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                x.VisitId.ToString().Contains(searchString.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        FilteredPrescriptions = query.ToList();

        if (!FilteredPrescriptions.Any())
            messageMedicine = "No pending prescriptions available.";
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    public async Task Back()
    {
        CurrentPrescription = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task DispenseAsync(PrescriptionDto prescription)
    {
        var parameters = new DialogParameters<ConfirmationModal>
        {
            { x => x.ContentText, "Do you really want to dispense this prescription? This process cannot be undone." },
            { x => x.ButtonText, "Yes" },
            { x => x.Color, Color.Success }
        };

        var options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };

        var dialog = await Dialog.ShowAsync<ConfirmationModal>("Confirmation", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            CurrentPrescription = prescription;
            CurrentPrescription.IsDispensed = true;
            var success = await medicineService.UpdatePrescriptionAsync(CurrentPrescription, CurrentPrescription.Id);

            if (success)
            {
                var dispensedMed = await medicineService.GetMedicineByIdAsync(CurrentPrescription.Id);
                if (dispensedMed != null)
                {
                    dispensedMed.MedicineQty = dispensedMed.MedicineQty - CurrentPrescription.Quantity;
                    await medicineService.UpdateMedicineAsync(dispensedMed, dispensedMed.Id);
                }
            }

            await OnInitializedAsync();
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<PrescriptionDto>
        {
            ReportType = "Prescriptions",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredPrescriptions
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<PrescriptionDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        await Dialog.ShowAsync<PdfPreview>($"Report Pdf", Parameters, _maxWidth);
    }
}
