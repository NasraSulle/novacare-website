@using Microsoft.AspNetCore.Authorization
@using NovaCare.Components.Account.Pages
@inject IDialogService Dialog

@attribute [Authorize]

<MudGrid Spacing="0">
    @* Left Therapeutic Category Sidebar + Form Factor Sub-Tabs *@
    <MudItem xs="12">
        <MudTabs Outlined="false"
                 Position="Position.Start"
                 Rounded="false"
                 Border="true"
                 ApplyEffectsToContainer="true"
                 TabHeaderClass="bg-transparent"
                 SliderColor="Color.Primary"
                 TabPanelsClass="p-0 pa-0 pa-sm-5">
            @foreach (var category in medicineCategories)
            {
                var currentGenre = category;
                <MudTabPanel Text="@currentGenre"
                             Style="text-transform: none; font-weight: 500; justify-content: flex-start;"
                             OnClick="@(() => SelectGenre(currentGenre))">
                    <MudPaper Elevation="0" Class="pa-0 w-100" Style="background-color: rgba(246,246,246,1) !important;">
                        <MudTabs Elevation="0"
                                 Rounded="true"
                                 ApplyEffectsToContainer="true"
                                 TabHeaderClass="bg-primary-subtle  dense-tabs"
                                 SliderColor="Color.Secondary"
                                 TabPanelsClass="pa-4"
                                 Centered="false">
                            <MudTabPanel Text="All Forms" Icon="@Icons.Material.Filled.Medication" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Tabs & Caps" Icon="@Icons.Material.Filled.Circle" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Tablets" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Injections" Icon="@Icons.Material.Filled.PushPin" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Injection" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Syrup" Icon="@Icons.Material.Filled.MedicationLiquid" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Syrup" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Cream" Icon="@Icons.Material.Filled.SportsCricket" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Cream" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Drip" Icon="@Icons.Material.Filled.WaterDrop" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Drip" Genre="@genre" />
                            </MudTabPanel>
                        </MudTabs>
                    </MudPaper>
                </MudTabPanel>
            }
        </MudTabs>
    </MudItem>
</MudGrid>

@code {
    StaffDto currentUser = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };

    readonly string[] medicineCategories =
    {
        "Painkillers",
        "Antimalarials",
        "Antibiotics",
        "Antifungals",
        "Antivirals",
        "Vaccines",
        "Anthelmintics"
    };

    string genre = "Painkillers";

    public string icon = Icons.Material.Filled.LocalPharmacy;
    public string title = "Medicines Section";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await userService.GetLoggedInUserAsync();
        genre = "Painkillers";
        await InvokeAsync(StateHasChanged);
    }

    private void SelectGenre(string selectedGenre)
    {
        genre = selectedGenre;
        StateHasChanged();
    }
}
