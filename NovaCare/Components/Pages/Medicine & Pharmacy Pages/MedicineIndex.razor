@using Microsoft.AspNetCore.Authorization
@using NovaCare.Components.Account.Pages
@inject IDialogService Dialog

@attribute [Authorize]

<MudGrid Spacing="0">
    @* Left Therapeutic Category Sidebar + Form Factor Sub-Tabs *@
    <MudItem xs="12">
        <MudTabs Outlined="false"
                 Position="Position.Start"
                 Rounded="false"
                 Border="true"
                 ApplyEffectsToContainer="true"
                 Color="Color.Primary"
                 SliderColor="Color.Primary"
                 PanelClass="pa-3 pa-sm-5">
            @foreach (var category in medicineCategories)
            {
                var currentGenre = category;
                <MudTabPanel Text="@currentGenre"
                             Style="text-transform: none; font-weight: 500; justify-content: flex-start;"
                             OnClick="@(() => SelectGenre(currentGenre))">
                    <MudPaper Elevation="0" Class="pa-0">
                        <MudTabs Elevation="0"
                                 Rounded="true"
                                 ApplyEffectsToContainer="true"
                                 Color="Color.Secondary"
                                 SliderColor="Color.Secondary"
                                 PanelClass="pt-4"
                                 Centered="false">
                            <MudTabPanel Text="All Forms" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Tabs & Caps" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Tablets" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Injections" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Injection" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Syrup" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Syrup" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Cream" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Cream" Genre="@genre" />
                            </MudTabPanel>
                            <MudTabPanel Text="Drip" Style="text-transform: none;">
                                <Medicines CurrentUser="currentUser" FilterBy="Drip" Genre="@genre" />
                            </MudTabPanel>
                        </MudTabs>
                    </MudPaper>
                </MudTabPanel>
            }
        </MudTabs>
    </MudItem>
</MudGrid>

@code {
    StaffDto currentUser = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };

    readonly string[] medicineCategories =
    {
        "Painkillers",
        "Antimalarials",
        "Antibiotics",
        "Antifungals",
        "Antivirals",
        "Vaccines",
        "Anthelmintics"
    };

    string genre = "Painkillers";

    public string icon = Icons.Material.Filled.LocalPharmacy;
    public string title = "Medicines Section";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await userService.GetLoggedInUserAsync();
        genre = "Painkillers";
        await InvokeAsync(StateHasChanged);
    }

    private void SelectGenre(string selectedGenre)
    {
        genre = selectedGenre;
        StateHasChanged();
    }
}
