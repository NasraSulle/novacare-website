    @code {

    StaffDto currentUser = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };

    string genre = string.Empty;
    bool IsNewMedicine;
    public string icon = Icons.Material.Filled.LocalPharmacy;
    public string title = "Medicines Section";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await userService.GetLoggedInUserAsync();

        genre = "Painkillers";
        await InvokeAsync(StateHasChanged);
    }

    public async Task ResetIsNewMedicine()
    {
        IsNewMedicine = false;
        await InvokeAsync(StateHasChanged);
    }

}
