@page "/MedicineIndex"

@using Microsoft.AspNetCore.Authorization
@using NovaCare.Components.Account.Pages

@inject IDialogService Dialog

@rendermode InteractiveServer
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@attribute [Authorize]
<PageTitle>Medicines - NovaCare</PageTitle>

<MudGrid Class="pa-3" Justify="Justify.FlexStart">
    <SectionTitle Icon="@icon" Title="@title" />
</MudGrid>
<MudGrid Justify="Justify.Center" Class="ps-8 pt-3 pe-1">
    <MudItem Class="pa-0" md="12">

        <MudTabs Outlined="true" Rounded="false" Border="true" ApplyEffectsToContainer="true" TabPanelsClass="">
            <MudTabPanel Style="text-transform: none;" Text="Prescriptions">
                <MudItem md="12" Class="">
                    <Prescriptions/>
                </MudItem>
            </MudTabPanel>
            <MudTabPanel Style="text-transform: none;" Text="Medicines Catalog">
                <MudItem md="12" Class="">
                    <MedicineIndex />
                </MudItem>
            </MudTabPanel>
        </MudTabs>
    </MudItem>
</MudGrid>

@code {

    public string icon = Icons.Material.Filled.LocalPharmacy;
    public string title = "Pharmacy Section";

}
