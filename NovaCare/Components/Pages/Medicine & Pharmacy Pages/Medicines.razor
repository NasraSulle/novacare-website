@using NovaCare.Shared.DTOs.MedicineDTOs
@using NovaCare.Shared.DTOs.StaffDTOs
@inject IDialogService Dialog

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredMedicines == null || !FilteredMedicines.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex flex-column flex-sm-row justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@($"{Genre} {(string.IsNullOrWhiteSpace(FilterBy) ? "" : $"- {FilterBy}")}")</MudText>
                    @if (CurrentUser != null && CurrentUser.IsCreateNewMedicine && !isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenRegisterModal" Style="text-transform:none;">
                            Add Medicine
                        </MudButton>
                    }
                </div>
                <NoDataNotice NoDataMessage="@messageMedicine" />
            </MudPaper>
        }
        else if (FilteredMedicines != null)
        {
            @* Inventory Summary Metric Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total Items</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredMedicines.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.Medication" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">In Stock</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">
                                @FilteredMedicines.Count(x => string.Equals(x.MedicineStatusName?.Trim(), "InStock", StringComparison.OrdinalIgnoreCase) && x.MedicineQty > 0)
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between" Style="border-left: 4px solid var(--mud-palette-error);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Out / Low Stock</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Error" Style="font-weight:700;">
                                @FilteredMedicines.Count(x => !string.Equals(x.MedicineStatusName?.Trim(), "InStock", StringComparison.OrdinalIgnoreCase) || x.MedicineQty <= 0)
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Error" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Medicines Data Grid *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Elevation="0"
                         Outlined="true"
                         T="MedicineDto"
                         Items="@FilteredMedicines"
                         ReadOnly="@_readOnly"
                         Class="rounded-lg"
                         Bordered="false"
                         Dense="false"
                         RowStyle="cursor: pointer;"
                         RowClick="@((args) => PreviewMedicineProfile(args.Item))">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">
                                @(isReport ? "All Medicines" : $"{Genre} {(string.IsNullOrWhiteSpace(FilterBy) ? "Catalog" : $"({FilterBy})")}")
                            </MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredMedicines.Count} items")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search medicine or status..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 240px;" />

                            @if (CurrentUser != null && CurrentUser.IsCreateNewMedicine && !isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="OpenRegisterModal"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Add Medicine
                                </MudButton>
                            }
                            @if (isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="GeneratePdf"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Generate Pdf
                                </MudButton>
                            }
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    @* Medicine Name & Form Type *@
                    <TemplateColumn Title="Medicine Name" SortBy="@(x => x.MedicineName)">
                        <CellTemplate>
                            <div class="d-flex align-center py-1">
                                <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="me-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.Medication" Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; line-height: 1.2;">
                                        @context.Item.MedicineName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @($"{context.Item.MedicineGenre} • {context.Item.MedicineType}")
                                    </MudText>
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Stock Quantity *@
                    <TemplateColumn Title="Available Qty" SortBy="@(x => x.MedicineQty)">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @($"{context.Item.MedicineQty:N0} units")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>

                    @if (CurrentUser != null && CurrentUser.IsCreateNewMedicine)
                    {
                        <TemplateColumn Title="Buying Price" SortBy="@(x => x.BuyingPrice)">
                            <CellTemplate>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @($"{context.Item.BuyingPrice:N2}")
                                </MudText>
                            </CellTemplate>
                        </TemplateColumn>
                    }

                    <TemplateColumn Title="Selling Price" SortBy="@(x => x.SellingPrice)">
                        <CellTemplate>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                @($"{context.Item.SellingPrice:N2}")
                            </MudText>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Stock Status Badge *@
                    <TemplateColumn Title="Stock Status" SortBy="@(x => x.MedicineStatusName)">
                        <CellTemplate>
                            @{
                                bool isInStock = string.Equals(context.Item.MedicineStatusName?.Trim(), "InStock", StringComparison.OrdinalIgnoreCase) && context.Item.MedicineQty > 0;
                            }
                            <MudChip T="string"
                                     Color="@(isInStock ? Color.Success : Color.Error)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small"
                                     Style="font-weight: 500;">
                                <span style="@($"display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; background-color:{(isInStock ? "#2e7d32" : "#d32f2f")};")"></span>
                                @(string.IsNullOrWhiteSpace(context.Item.MedicineStatusName) ? "Out of Stock" : context.Item.MedicineStatusName)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Row Action *@
                    <TemplateColumn Title="" CellStyle="width: 56px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="View / Edit Medicine">
                                <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                               OnClick="@(() => PreviewMedicineProfile(context.Item))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="MedicineDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    private bool _readOnly = true;

    [Parameter] public List<MedicineDto> AllMedicines { get; set; } = new();
    List<MedicineDto> FilteredMedicines = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public string Genre { get; set; } = string.Empty;
    [Parameter] public bool isReport { get; set; }
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;

    MedicineDto? CurrentMedicine;

    string messageMedicine = string.Empty;
    string firstPart = string.Empty;
    string? searchString;
    string? pdfBase64;

    bool isSearchLoading;
    bool isLoading;
    bool isEdit;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(300);

        if (!isReport)
        {
            AllMedicines = await medicineService.GetAllMedicinesAsync() ?? new();
        }

        ApplyFilterAndSearch();

        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<MedicineDto> query = AllMedicines ?? Enumerable.Empty<MedicineDto>();

        if (!isReport)
        {
            if (!string.IsNullOrWhiteSpace(Genre))
            {
                query = query.Where(x => string.Equals(x.MedicineGenre?.Trim(), Genre.Trim(), StringComparison.OrdinalIgnoreCase));
            }

            if (string.IsNullOrWhiteSpace(FilterBy))
            {
                firstPart = Genre;
                messageMedicine = $"{Genre} medicines are not available.";
            }
            else
            {
                firstPart = FilterBy;
                messageMedicine = $"{Genre} ({FilterBy}) medicines are not available.";
                query = query.Where(x => string.Equals(x.MedicineType?.Trim(), FilterBy.Trim(), StringComparison.OrdinalIgnoreCase));
            }
        }
        else
        {
            firstPart = "Medicine";
            messageMedicine = "No medicines available for the selected report period.";
        }

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x =>
                (x.MedicineName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.MedicineType?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.MedicineGenre?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.MedicineStatusName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        FilteredMedicines = query.ToList();
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    public async Task Back()
    {
        CurrentMedicine = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task OpenRegisterModal()
    {
        var dialog = await Dialog.ShowAsync<NewMedicine>("Register New Medicine", _maxWidth);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    private async Task PreviewMedicineProfile(MedicineDto item)
    {
        var Parameters = new DialogParameters
        {
            {"CurrentMedicine" , item}
        };
        var dialog = await Dialog.ShowAsync<EditMedicine>("Medicine Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<MedicineDto>
        {
            ReportType = "Medicines",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredMedicines
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<MedicineDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        await Dialog.ShowAsync<PdfPreview>($"Report Pdf", Parameters, _maxWidth);
    }
}
