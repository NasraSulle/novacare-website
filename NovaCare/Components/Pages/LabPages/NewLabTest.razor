@using NovaCare.Shared.DTOs.DiseaseDTOs
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        <EditForm Model="CurrentLabTest" method="post" OnValidSubmit="SaveLabTestAsync" FormName="newlabTest">
            <MudGrid Spacing="3" Class="pa-3">
                <MudGrid Spacing="5" Justify="Justify.Center" Class="ps-3 pt-6 pe-0" Style="border:none;">
                    <MudItem md="4" Class="ps-6 pe-0 pt-0 mb-3">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Enter LabTest Details</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    <MudSelect For="@(() => CurrentLabTest.PatientId)"
                                               @bind-Value="CurrentLabTest.PatientId"
                                               @bind-Value:after="RetrieveActiveVisitItemsAsync"
                                               Label="Choose Patient" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                        <MudSelectItem Value="0" Disabled>Choose Patient</MudSelectItem>

                                        @foreach (var item in AllPatients)
                                        {
                                            <MudSelectItem Value="@item.Id">@($"{item.Id} : {item.FisrtName} {item.MiddleName} {item.LastName}")</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem md="12">
                                    <MudSelect For="@(() => CurrentLabTest.DiseaseName)"
                                               @bind-Value="CurrentLabTest.DiseaseName"
                                               Label="Choose Disease" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                        <MudSelectItem Value="0" Disabled>Choose Disease</MudSelectItem>

                                        @foreach (var item in AllDiseases)
                                        {
                                            <MudSelectItem Value="@item.DiseaseName">@($"{item.DiseaseName}")</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem md="12">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddLabTestToBatch(CurrentLabTest))" Class="mt-2" FullWidth="true">Add LabTest To Batch</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                    <MudItem md="8" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">LabTests Batch Summary</MudText>
                            <MudGrid Class="pa-3">
                                <MudItem md="12">
                                    @if (!LabTestsBatch!.Any())
                                    {
                                        <NoDataNotice NoDataMessage="No LabTests in Batch" />
                                    }
                                    else
                                    {

                                        <MudTable Dense="true" FixedHeader="true" Items="@LabTestsBatch" Height="300px" Hover="true" Breakpoint="Breakpoint.Sm" Context="medContext">
                                            <HeaderContent>
                                                <MudTh>Patient</MudTh>
                                                <MudTh>Lab Test</MudTh>
                                                <MudTh></MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd DataLabel="Patient_Id">@medContext.PatientFullName</MudTd>
                                                <MudTd DataLabel="Lab Test">@medContext.DiseaseName</MudTd>
                                                <MudTd DataLabel="">
                                                    <MudIconButton Size="Size.Small" Color="Color.Error" Icon="@Icons.Material.Outlined.Delete" OnClick="@(() => RemoveLabTestFromBatch(medContext))" />
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    }
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudItem>
                </MudGrid>

                <MudItem md="12" Style="text-align:end">
                    <MudItem Style="display:flex; justify-content:center; ">
                        @if (isCreatedSuccessfully)
                        {
                            <MudAlert Style="width:19%; margin-right:20px;" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">LabTests Added Successfully!</MudAlert>
                        }
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@addedSuccessfully</MudAlert>
                        <MudAlert Style="@(isCreatedSuccessfully ? "width: 40%;" : "width: 50%;")" Severity="Severity.Error" ContentAlignment="HorizontalAlignment.Center">@notaddedSuccessfully</MudAlert>
                    </MudItem>
                    <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="isSaving" Class="mt-3">
                        @if (isSaving)
                        {
                            <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                            <MudText Class="ps-3"> Saving LabTests...</MudText>
                        }
                        else
                        {
                            <MudText> Save LabTests</MudText>
                        }
                    </MudStaticButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="mt-3">Reset Page</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToLabTestsPage" Class="mt-3">Back</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    List<DiseaseDto> AllDiseases = new();
    List<PatientDto> AllPatients = new();
    List<LabTestDto>? LabTestsBatch = new();
    [Parameter, EditorRequired] public LabTestDto CurrentLabTest { get; set; } = new();

    string saveMessage = string.Empty;
    string? addedSuccessfully = "Added:";
    string? notaddedSuccessfully = "Not Added:";

    bool isCreatedSuccessfully;
    bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        AllPatients = await patientService.GetAllPatientsAsync();
        AllDiseases = await diseaseService.GetAllDiseasesAsync();
    }

    public async Task AddLabTestToBatch(LabTestDto labTestDto)
    {
        var patient = await patientService.GetPatientByIdAsync(labTestDto.PatientId);
        var disease = await diseaseService.GetDiseaseByNameAsync(labTestDto.DiseaseName);
        var newLabTest = new LabTestDto
        {
            DiseaseName = labTestDto.DiseaseName,
            LabTestStatusName = "New",
            TestResult = labTestDto.TestResult,
            ResultAttachment = labTestDto.ResultAttachment,
            LabTestCost = disease.LabTestCost,
            CreatedDate = DateTime.Now,
            UpdaterLabTechnician = $"{CurrentUser.FisrtName} {CurrentUser.MiddleName} {CurrentUser.LastName}",
            PatientFullName = $"{patient.FisrtName} {patient.MiddleName} {patient.LastName}",
            PatientId = labTestDto.PatientId,
            VisitId = labTestDto.VisitId
        };

        if (newLabTest != null)
            LabTestsBatch!.Add(newLabTest);

        await InvokeAsync(StateHasChanged);
    }

    public async Task RemoveLabTestFromBatch(LabTestDto labTestDto)
    {
        if (LabTestsBatch != null)
            LabTestsBatch.Remove(labTestDto);
    }

    public async Task RetrieveActiveVisitItemsAsync()
    {
        //CurrentLabTest.PatientId
        var patientFound = await patientService.GetPatientByIdAsync(CurrentLabTest.PatientId);
        var visit = await patientService.GetVisitByPCodeOrFullNameAsync(patientFound.PatientCode);
        CurrentLabTest.VisitId = visit.Id;
    }

    public async Task SaveLabTestAsync()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isSaving = true;

        if (LabTestsBatch!.Count == 0)
        {
            isSaving = false;
            return;
        }

        saveMessage = string.Empty;

        try
        {
            foreach (var labTest in LabTestsBatch)
            {
                var isSucess = await labTestService.AddLabTestAsync(labTest);

                if (isSucess)
                {
                    saveMessage = $"{labTest.DiseaseName} for {labTest.PatientId} added sucessfully";
                    Console.WriteLine(saveMessage);
                }
                else
                {
                    saveMessage = $"Error: {labTest.DiseaseName} for {labTest.PatientId} not added sucessfully! Please read labTest to batch and save";
                    Console.WriteLine(saveMessage);
                }
            }
            if (notaddedSuccessfully == "Not Added:")
                isCreatedSuccessfully = true;
            CurrentLabTest = new();
            LabTestsBatch.Clear();

        }
        catch (Exception ex)
        {
            saveMessage = "Save failed: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task ResetPage()
    {
        addedSuccessfully = "Added:";
        notaddedSuccessfully = "Not Added:";
        isCreatedSuccessfully = false;
        CurrentLabTest = new();
    }

    public void ReturnToLabTestsPage()
    {
        isCreatedSuccessfully = false;
        MudDialog.Cancel();
    }
}
