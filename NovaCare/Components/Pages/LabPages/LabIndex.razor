@page "/LabTestIndex"

@using Microsoft.AspNetCore.Authorization
@using NovaCare.Shared.DTOs.StaffDTOs

@rendermode InteractiveServer
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@attribute [Authorize]
<PageTitle>Lab Tests - NovaCare</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-3 px-sm-6">
    @* Page Header *@
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center">
        <SectionTitle Icon="@icon" Title="@title" />
        <Briefer BriferNote="@briferNote" />
    </div>

    @* Main Elevated Card Container *@
    <MudPaper Elevation="0" Outlined="true" Class="overflow-hidden" Style="background-color: rgba(246,246,246,1) !important;">
        <MudTabs Elevation="0"
                 Rounded="false"
                 ApplyEffectsToContainer="true"
                 TabHeaderClass="bg-secondary-subtle"
                 SliderColor="Color.Error"
                 TabPanelsClass="pa-3 pa-sm-6"
                 Centered="false">
            <MudTabPanel Text="All Lab Tests" Icon="@Icons.Material.Outlined.Biotech" Style="text-transform: none; font-weight: 500;">
                <LabTests CurrentUser="currentUser" />
            </MudTabPanel>
            <MudTabPanel Text="New Lab Tests" Icon="@Icons.Material.Outlined.PendingActions" Style="text-transform: none; font-weight: 500;">
                <LabTests CurrentUser="currentUser" FilterBy="New" />
            </MudTabPanel>
            <MudTabPanel Text="Updated Lab Tests" Icon="@Icons.Material.Outlined.TaskAlt" Style="text-transform: none; font-weight: 500;">
                <LabTests CurrentUser="currentUser" FilterBy="Updated" />
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    bool IsNewLabTest;
    StaffDto currentUser = new();
    public string icon = Icons.Material.Filled.Biotech;
    public string title = "Laboratory Tests";
    string briferNote = "Track diagnostic requests, pending lab work, and completed test reports";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await userService.GetLoggedInUserAsync();
        await InvokeAsync(StateHasChanged);
    }
}
