@page "/LabTestIndex"

@using Microsoft.AspNetCore.Authorization
@using NovaCare.Shared.DTOs.StaffDTOs

@rendermode InteractiveServer
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@attribute [Authorize]
<PageTitle>Lab Tests - NovaCare</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4 px-3 px-sm-6">
    @* Page Header *@
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-4">
        <SectionTitle Icon="@icon" Title="@title" />
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mt-sm-0">
            Track diagnostic requests, pending lab work, and completed test reports
        </MudText>
    </div>

    @* Main Elevated Card Container *@
    <MudPaper Elevation="2" Outlined="true" Class="rounded-lg overflow-hidden">
        <MudTabs Elevation="0"
                 Rounded="false"
                 ApplyEffectsToContainer="true"
                 Color="Color.Primary"
                 SliderColor="Color.Primary"
                 PanelClass="pa-3 pa-sm-6"
                 Centered="false">
            <MudTabPanel Text="All Lab Tests" Icon="@Icons.Material.Outlined.Biotech" Style="text-transform: none; font-weight: 500;">
                <LabTests CurrentUser="currentUser" />
            </MudTabPanel>
            <MudTabPanel Text="New Lab Tests" Icon="@Icons.Material.Outlined.PendingActions" Style="text-transform: none; font-weight: 500;">
                <LabTests CurrentUser="currentUser" FilterBy="New" />
            </MudTabPanel>
            <MudTabPanel Text="Updated Lab Tests" Icon="@Icons.Material.Outlined.TaskAlt" Style="text-transform: none; font-weight: 500;">
                <LabTests CurrentUser="currentUser" FilterBy="Updated" />
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    bool IsNewLabTest;
    StaffDto currentUser = new();
    public string icon = Icons.Material.Filled.Biotech;
    public string title = "Laboratory Tests";

    protected override async Task OnInitializedAsync()
    {
        currentUser = await userService.GetLoggedInUserAsync();
        await InvokeAsync(StateHasChanged);
    }
}
