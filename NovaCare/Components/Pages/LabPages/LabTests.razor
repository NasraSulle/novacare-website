@using NovaCare.Shared.DTOs.LabTestDTOs
@inject IDialogService Dialog

<MudGrid>
    <MudItem md="12" Class="pa-0" Style="text-align: center;">
        @if (isLoading)
        {
            <MudItem Class="pa-6">
                <GlobalLoader />
            </MudItem>
        }
        else if (!isLoading && !FilteredLabTests!.Any() && string.IsNullOrWhiteSpace(searchString))
        {
            <MudItem Class="pa-6">
                <MudGrid>
                    <MudItem md="12">
                        <MudGrid Justify="Justify.SpaceBetween">
                            <MudItem>
                                <MudText Typo="Typo.h6">@($"All {firstPart} Tests")</MudText>
                            </MudItem>
                            <MudItem>
                                @if (CurrentUser != null && CurrentUser.IsCreateNewLabTest)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="OpenNewLabTestModal" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium">Add</MudButton>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem md="12">
                        <NoDataNotice NoDataMessage="@messageLabTest" />
                    </MudItem>
                </MudGrid>
            </MudItem>
        }
        else if (FilteredLabTests != null)
        {
            <MudDataGrid Loading="@isSearchLoading" Hover="true" RowClick="@((args) => PreviewLabTestProfile(args.Item.Id))" T="LabTestDto" Items="@FilteredLabTests" ReadOnly="@_readOnly" Class="ps-6 pe-6 pb-6"
                         Bordered="false" Dense="true">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">@($"All {firstPart}s")</MudText>
                    <MudSpacer />
                    <!--Filters & Search Panel Later OnDebounceIntervalElapsed="wekaAti-HandleIntervalElapsed"-->

                    <MudItem>
                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                                      Margin="Margin.Dense" Variant="Variant.Outlined"
                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="me-1"></MudTextField>
                    </MudItem>
                    @if (CurrentUser != null && CurrentUser.IsCreateNewStaff && !isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Size="Size.Medium" OnClick="OpenNewLabTestModal"> Add</MudButton>
                    }
                    @if (isReport)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="GeneratePdf" StartIcon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Medium">Generate Pdf</MudButton>
                    }
                </ToolBarContent>

                <Columns>
                    <PropertyColumn Property="x => x.DiseaseName" Title="Disease Name" />
                    <PropertyColumn Property="x => x.PatientFullName" Title="Patient Full Name" />
                    <PropertyColumn Property="x => x.CreatedDate.ToShortDateString()" Title="Date" />
@*                  <PropertyColumn Property="x => x.PatientId" Title="Patient Id" />
                    <PropertyColumn Property="x => x.TestResult" Title="Test Result" />
                    <PropertyColumn Property="x => x.RequesteeDoctor" Title="Doctor" />
                    <PropertyColumn Property="x => x.UpdaterLabTechnician" Title="Lab Personnel" />
                    <PropertyColumn Property="x => x.ConsultationId" Title="Consultation Id" /> *@
                    <TemplateColumn>
                        <CellTemplate>
                            <MudItem Style="text-align: center;">
                                <MudChip Color="@(context.Item.LabTestStatusName == "New" ? Color.Success : Color.Error)" Size="Size.Small">
                                    @(context.Item.LabTestStatusName)
                                </MudChip>
                            </MudItem>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <PagerContent>
                    <MudDataGridPager T="LabTestDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private bool _readOnly;
    private bool _isCellEditMode;
    private bool _editTriggerRowClick;
    [Parameter] public bool isReport { get; set; }

    [Parameter] public List<LabTestDto>? AllLabTests { get; set; } = new();
    List<LabTestDto> FilteredLabTests = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;
    LabTestDto? CurrentLabTest;

    string messageLabTest = string.Empty;
    string firstPart = string.Empty;
    string? searchString;
    string? pdfBase64;

    bool isLoading;
    bool isSearchLoading;
    bool isEdit;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(500);

        if (!isReport)
            AllLabTests = await labTestService.GetAllLabTestsAsync();

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            FilteredLabTests = AllLabTests;
            messageLabTest = "Lab Tests are not avalible!";
            firstPart = "Lab";
        }
        else
        {
            firstPart = FilterBy;
            messageLabTest = $"{firstPart} Lab Tests are not avalible!";

            if (FilterBy != null)
            {
                FilteredLabTests = AllLabTests?.Where(x => x.LabTestStatusName == FilterBy).ToList();
            }
            else
            {
                FilteredLabTests = new();
            }
        }
        isLoading = false;
        StateHasChanged();
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        await Task.Delay(500);

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            FilteredLabTests = AllLabTests?.Where(x => x.LabTestStatusName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PatientFullName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.DiseaseName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.CreatedDate.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
            messageLabTest = "Staffs are not avalible!";
            firstPart = "Staff";
        }
        else
        {
            var prop = typeof(StaffDto).GetProperty(FilterBy);

            firstPart = FilterBy.Substring(2);
            messageLabTest = $"{firstPart}s are not avalible!";

            if (prop != null)
            {
                FilteredLabTests = AllLabTests?.Where(x => (bool?)prop.GetValue(x, null) == true && x.LabTestStatusName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.PatientFullName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.DiseaseName.Contains(searchString, StringComparison.OrdinalIgnoreCase) || x.CreatedDate.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase)).ToList();
            }
            else
            {
                FilteredLabTests = null;
            }
        }
        isSearchLoading = false;
    }

    private async Task PreviewLabTestProfile(int testId)
    {
        var Parameters = new DialogParameters
        {
            {"TestId" , testId},
            {"CurrentUser" , CurrentUser}
        };

        var dialog = await Dialog.ShowAsync<EditLabTest>("Lab Test Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

        public async Task Back()
    {
        CurrentLabTest = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task OpenNewLabTestModal()
    {
        await InvokeAsync(StateHasChanged);

        var Parameters = new DialogParameters
        {
            {"CurrentUser" , CurrentUser}
        };

        var dialog = await Dialog.ShowAsync<NewLabTest>("New Lab Test", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null)
        {
            await OnInitializedAsync();
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<LabTestDto>
        {
            ReportType = "LabTests",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredLabTests
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<LabTestDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        await Dialog.ShowAsync<PdfPreview>($"Report Pdf", Parameters, _maxWidth);
    }
}