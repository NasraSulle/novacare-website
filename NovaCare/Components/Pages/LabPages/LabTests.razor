@using NovaCare.Shared.DTOs.LabTestDTOs
@using NovaCare.Shared.DTOs.StaffDTOs
@inject IDialogService Dialog

<MudGrid Spacing="3">
    <MudItem xs="12">
        @if (isLoading)
        {
            <div class="d-flex justify-center align-center py-12">
                <GlobalLoader />
            </div>
        }
        else if (!isLoading && (FilteredLabTests == null || !FilteredLabTests.Any()) && string.IsNullOrWhiteSpace(searchString))
        {
            <MudPaper Elevation="0" Class="pa-6 border rounded-lg text-center" Style="background-color: rgba(63,81,181,0.02);">
                <div class="d-flex flex-column flex-sm-row justify-space-between align-center mb-4 gap-2">
                    <MudText Typo="Typo.h6">@($"All {firstPart} Lab Tests")</MudText>
                </div>
                <NoDataNotice NoDataMessage="@messageLabTest" />
            </MudPaper>
        }
        else if (FilteredLabTests != null)
        {
            @* Lab Summary Metric Strip *@
            <MudGrid Spacing="2" Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Total @firstPart Tests</MudText>
                            <MudText Typo="Typo.h5" Style="font-weight:700;">@FilteredLabTests.Count</MudText>
                        </div>
                        <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.Science" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-warning);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Pending / New</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Warning" Style="font-weight:700;">
                                @FilteredLabTests.Count(x => string.Equals(x.LabTestStatusName, "New", StringComparison.OrdinalIgnoreCase))
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.HourglassEmpty" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
                <MudItem xs="6" sm="4">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded-lg d-flex align-center justify-space-between bg-transparent" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform:uppercase; letter-spacing:0.5px;">Completed / Updated</MudText>
                            <MudText Typo="Typo.h5" Color="Color.Success" Style="font-weight:700;">
                                @FilteredLabTests.Count(x => !string.Equals(x.LabTestStatusName, "New", StringComparison.OrdinalIgnoreCase))
                            </MudText>
                        </div>
                        <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" />
                        </MudAvatar>
                    </MudPaper>
                </MudItem>
            </MudGrid>

            @* Main Lab Tests Data Table *@
            <MudDataGrid Loading="@isSearchLoading"
                         Hover="true"
                         Striped="false"
                         Elevation="0" 
                         Outlined="true"
                         RowClick="@((args) => {if(!isReport)PreviewLabTestProfile(args.Item.Id);})"
                         RowStyle="cursor: pointer;"
                         T="LabTestDto"
                         Items="@FilteredLabTests"
                         ReadOnly="@_readOnly"
                         Class="bg-transparent"
                         Bordered="false"
                         Dense="true">
                <ToolBarContent>
                    <div class="d-flex flex-column flex-md-row justify-space-between align-stretch align-md-center w-100 gap-2 py-2">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Style="font-weight:600;">@($"All {firstPart} Lab Tests")</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@($"{FilteredLabTests.Count} records")</MudChip>
                        </div>

                        <div class="d-flex flex-column flex-sm-row align-stretch align-sm-center gap-2">
                            <MudTextField T="string"
                                          Value="@searchString"
                                          ValueChanged="@(s => OnSearch(s))"
                                          Placeholder="Search test, patient, or status..."
                                          Adornment="Adornment.Start"
                                          Margin="Margin.Dense"
                                          Variant="Variant.Outlined"
                                          Clearable="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          AdornmentIcon="@Icons.Material.Filled.Search"
                                          IconSize="Size.Small"
                                          Style="min-width: 260px;" />

                            @if (isReport)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           OnClick="GeneratePdf"
                                           StartIcon="@Icons.Material.Filled.PictureAsPdf"
                                           Style="text-transform:none; white-space:nowrap;">
                                    Generate Pdf
                                </MudButton>
                            }
                        </div>
                    </div>
                </ToolBarContent>

                <Columns>
                    @* Diagnostic Test & Category *@
                    <TemplateColumn Title="Diagnostic Test" SortBy="@(x => x.DiseaseName)">
                        <CellTemplate>
                            <div class="d-flex align-center py-1">
                                <MudAvatar Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="me-3">
                                    <MudIcon Icon="@Icons.Material.Outlined.Biotech" Size="Size.Small" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; line-height: 1.2;">
                                        @context.Item.DiseaseName
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(context.Item.DiseaseTypeName))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @context.Item.DiseaseTypeName
                                        </MudText>
                                    }
                                </div>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Patient Name *@
                    <TemplateColumn Title="Patient" SortBy="@(x => x.PatientFullName)">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudAvatar Size="Size.Small" Class="me-2 border">
                                    <MudImage Src="Images/dp.png" Alt="Patient Avatar" />
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">
                                    @context.Item.PatientFullName
                                </MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Requested / Created Date *@
                    <TemplateColumn Title="Requested Date" SortBy="@(x => x.CreatedDate)">
                        <CellTemplate>
                            <div class="d-flex align-center">
                                <MudIcon Icon="@Icons.Material.Outlined.CalendarToday" Size="Size.Small" Color="Color.Secondary" Class="me-2" />
                                <MudText Typo="Typo.body2">@context.Item.CreatedDate.ToShortDateString()</MudText>
                            </div>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Status Pill *@
                    <TemplateColumn Title="Status" SortBy="@(x => x.LabTestStatusName)">
                        <CellTemplate>
                            @{
                                bool isNew = string.Equals(context.Item.LabTestStatusName, "New", StringComparison.OrdinalIgnoreCase);
                            }
                            <MudChip T="string"
                                     Color="@(isNew ? Color.Warning : Color.Success)"
                                     Variant="Variant.Outlined"
                                     Size="Size.Small"
                                     Style="font-weight: 500;">
                                <span style="@($"display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:6px; background-color:{(isNew ? "#ed6c02" : "#2e7d32")};")"></span>
                                @(string.IsNullOrWhiteSpace(context.Item.LabTestStatusName) ? "Unknown" : context.Item.LabTestStatusName)
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>

                    @* Row Action Indicator *@
                    @if (!isReport)
                    {
                    <TemplateColumn Title="" CellStyle="width: 60px; text-align: right;">
                        <CellTemplate>
                            <MudTooltip Text="View / Update Results">
                                <MudIconButton Icon="@Icons.Material.Outlined.MoreVert"
                                               Size="Size.Small"
                                               Color="Color.Default"
                                                   OnClick="@(() => PreviewLabTestProfile(context.Item.Id))" />
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    }
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="LabTestDto" />
                </PagerContent>
            </MudDataGrid>
        }
    </MudItem>
</MudGrid>

@code {
    private readonly DialogOptions _maxWidth = new() { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false };
    [Parameter] public StaffDto CurrentUser { get; set; } = new();
    private bool _readOnly = true;
    private bool _isCellEditMode;
    private bool _editTriggerRowClick;
    [Parameter] public bool isReport { get; set; }

    [Parameter] public List<LabTestDto> AllLabTests { get; set; } = new();
    List<LabTestDto> FilteredLabTests = new();
    [Parameter] public string FilterBy { get; set; } = string.Empty;
    [Parameter] public DateTime? fromDate { get; set; } = DateTime.Now.AddMonths(-3);
    [Parameter] public DateTime? toDate { get; set; } = DateTime.Now;
    LabTestDto? CurrentLabTest;

    string messageLabTest = string.Empty;
    string firstPart = string.Empty;
    string? searchString;
    string? pdfBase64;

    bool isLoading;
    bool isSearchLoading;
    bool isEdit;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        await Task.Delay(300);

        if (!isReport)
        {
            AllLabTests = await labTestService.GetAllLabTestsAsync();
            AllLabTests = AllLabTests?
                .Where(x => x.IsReadyForService)
                .ToList() ?? new();
        }

        ApplyFilterAndSearch();

        isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilterAndSearch()
    {
        IEnumerable<LabTestDto> query = AllLabTests ?? Enumerable.Empty<LabTestDto>();

        if (string.IsNullOrWhiteSpace(FilterBy))
        {
            firstPart = "Diagnostic";
            messageLabTest = "No lab tests are currently available.";
        }
        else
        {
            firstPart = FilterBy;
            messageLabTest = $"No {firstPart.ToLower()} lab tests are currently available.";
            query = query.Where(x => string.Equals(x.LabTestStatusName?.Trim(), FilterBy.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(searchString))
        {
            query = query.Where(x =>
                (x.DiseaseName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.DiseaseTypeName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.PatientFullName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.LabTestStatusName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) ||
                x.CreatedDate.ToShortDateString().Contains(searchString, StringComparison.OrdinalIgnoreCase));
        }

        FilteredLabTests = query.ToList();
    }

    private async Task OnSearch(string text)
    {
        searchString = text;
        isSearchLoading = true;
        ApplyFilterAndSearch();
        isSearchLoading = false;
        await Task.CompletedTask;
    }

    private async Task PreviewLabTestProfile(int testId)
    {
        var Parameters = new DialogParameters
        {
            {"TestId" , testId},
            {"CurrentUser" , CurrentUser}
        };

        var dialog = await Dialog.ShowAsync<EditLabTest>("Lab Test Details", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await OnInitializedAsync();
        }
    }

    public async Task Back()
    {
        CurrentLabTest = new();
        isEdit = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task OpenNewLabTestModal()
    {
        await InvokeAsync(StateHasChanged);

        var Parameters = new DialogParameters
        {
            {"CurrentUser" , CurrentUser}
        };

        var dialog = await Dialog.ShowAsync<NewLabTest>("New Lab Test", Parameters, _maxWidth);
        var result = await dialog.Result;

        if (result != null)
        {
            await OnInitializedAsync();
        }
    }

    public async Task GeneratePdf()
    {
        var reportDto = new ReportPreviewDto<LabTestDto>
        {
            ReportType = "LabTests",
            FromDate = fromDate,
            ToDate = toDate,
            Data = FilteredLabTests
        };

        pdfBase64 = pdfExportService.GenerateStaffPreview<LabTestDto>(reportDto, CurrentUser);

        var Parameters = new DialogParameters
        {
            {"pdfBase64" , pdfBase64}
        };

        await Dialog.ShowAsync<PdfPreview>($"Report Pdf", Parameters, _maxWidth);
    }
}