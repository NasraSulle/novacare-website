@using Microsoft.AspNetCore.Identity
@using NovaCare.Data

@inject SignInManager<Staff> SignInManager

<MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="mt-1 vitals-bridge">
    <MudNavLink Href="Account/Manage" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Person">
        Profile
    </MudNavLink>
    <MudNavLink Href="Account/Manage/Email" Icon="@Icons.Material.Outlined.Email">
        Email Address
    </MudNavLink>
    <MudNavLink Href="Account/Manage/ChangePassword" Icon="@Icons.Material.Outlined.Lock" Class="">
        Password
    </MudNavLink>
    @if (hasExternalLogins)
    {
        <MudNavLink Href="Account/Manage/ExternalLogins" Icon="@Icons.Material.Outlined.PhoneLocked">
            External Logins
        </MudNavLink>
    }
    <MudNavLink Href="Account/Manage/TwoFactorAuthentication" Icon="@Icons.Material.Outlined.VerifiedUser">
        Two-Factor Auth
    </MudNavLink>
    <MudNavLink Href="Account/Manage/Passkeys" Icon="@Icons.Material.Outlined.Key">
        Passkeys
    </MudNavLink>
    <MudDivider Class="my-2" />
    <MudNavLink Href="Account/Manage/PersonalData" Icon="@Icons.Material.Outlined.FolderShared" IconColor="Color.Error">
        Personal Data
    </MudNavLink>
</MudNavMenu>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
