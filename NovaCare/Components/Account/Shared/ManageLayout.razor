@inherits LayoutComponentBase
@layout NovaCare.Components.Layout.MainLayout

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6 px-3 px-sm-6">
    @* Page Header *@
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-5">
        <div class="d-flex align-center">
            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium" Class="me-3">
                <MudIcon Icon="@Icons.Material.Outlined.ManageAccounts" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h5" Style="font-weight: 700;">Account Settings</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Manage your staff profile, security credentials, and personal account data
                </MudText>
            </div>
        </div>
    </div>

    <MudGrid Spacing="4">
        @* Left Navigation Sidebar *@
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Elevation="2" Outlined="true" Class="pa-3 rounded-lg">
                <MudText Typo="Typo.overline" Color="Color.Secondary" Class="px-3 pb-1 d-block" Style="font-weight: 600; letter-spacing: 0.8px;">
                    Settings Menu
                </MudText>
                <ManageNavMenu />
            </MudPaper>
        </MudItem>

        @* Right Active Settings Card *@
        <MudItem xs="12" md="8" lg="9">
            <MudPaper Elevation="2" Outlined="true" Class="pa-4 pa-sm-6 rounded-lg">
                @Body
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
