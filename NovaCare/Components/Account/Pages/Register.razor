    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        StaffTypes = await staffService.GetStaffTypesAsync();
        StaffTitles = await staffService.GetStaffTitlesAsync();
        DoctorTypes = await doctorService.GetDoctorTypesAsync();
        StaffStatus = await staffService.GetStaffStatusAsync();
    }

    public async Task OnDeptChange()
    {
        Input.AdministrativeTitleName = StaffTitles.Where(x => x.Id == Input.AdministrativeTitleId).Select(x => x.StaffTitleName).FirstOrDefault() ?? string.Empty;
        Input.AdministrativeTitleId = StaffTitles.Where(x => x.Id == Input.AdministrativeTitleId).Select(x => x.Id).FirstOrDefault();
        await InvokeAsync(StateHasChanged);
    }

    public async Task OnTitleChange()
    {
        Input.ClinicalTitleName = StaffTitles.Where(x => x.Id == Input.ClinicalTitleId).Select(x => x.StaffTitleName).FirstOrDefault() ?? string.Empty;
        Input.ClinicalTitleId = StaffTitles.Where(x => x.Id == Input.ClinicalTitleId).Select(x => x.Id).FirstOrDefault();

        if (Input.ClinicalTitleName.ToLower() == "doctor")
        {
            if (string.IsNullOrWhiteSpace(CurrentDoctor.DoctorCode))
            {
                isTrue = true;
            }
            else
            {
                isTrue = false;
            }
        }
        else
        {
            isTrue = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    public async Task OnGenerateEmployeeId()
    {
        emplIdCode = await staffService.AddEmployeeIdCodeAsync();
        Input.EmployeeId = $"EMP{emplIdCode}";
    }

    public async Task OnGenerateDoctorCode()
    {
        docCode = await doctorService.AddDoctorCodeAsync();
        CurrentDoctor.DoctorCode = $"DOC{docCode}";

        if (string.IsNullOrWhiteSpace(CurrentDoctor.DoctorCode))
        {
            isTrue = true;
        }
        else
        {
            isTrue = false;
        }
    }

    public async Task UpdateIsTrue()
    {
        if (string.IsNullOrWhiteSpace(CurrentDoctor.DoctorCode))
        {
            isTrue = true;
        }
        else
        {
            isTrue = false;
        }
    }

    public async Task ResetPage()
    {
        isCreatedSuccessfully = false;
        Input = new();
        CurrentDoctor = new();
    }

