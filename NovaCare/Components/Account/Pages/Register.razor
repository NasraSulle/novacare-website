@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using MudBlazor.Internal
@using NovaCare.Shared.DTOs.StaffDTOs

@inject UserManager<Staff> UserManager
@inject IUserStore<Staff> UserStore
@inject SignInManager<Staff> SignInManager
@inject IEmailSender<Staff> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Register</PageTitle>

<MudDialog>
    <DialogContent>
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <MudGrid Spacing="3" Class="pa-3" Style="">

                <MudItem md="12" Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0 mb-3">
                    <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Personal Information</MudText>
                    <MudGrid Spacing="2" Class="pa-3">
                        <MudItem md="4">
                            <MudStaticTextField For="@(() => Input.FisrtName)" @bind-Value="Input.FisrtName" Margin="Margin.Dense"
                                                Label="First Name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="first name"
                                                UserAttributes="@(new() { { "autocomplete", "fisrtname webauthn" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="4">
                            <MudStaticTextField For="@(() => Input.MiddleName)" @bind-Value="Input.MiddleName" Margin="Margin.Dense"
                                                Label="Middle Name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="middle name"
                                                UserAttributes="@(new() { { "autocomplete", "middlename" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="4">
                            <MudStaticTextField For="@(() => Input.LastName)" @bind-Value="Input.LastName" Margin="Margin.Dense"
                                                Label="Last Name" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="last name"
                                                UserAttributes="@(new() { { "autocomplete", "middlename" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="2">
                            <MudNumericField For="@(() => Input.Age)" @bind-Value="Input.Age" Margin="Margin.Dense"
                                             Label="Age" Variant="Variant.Outlined" Placeholder="age"
                                             UserAttributes="@(new() { { "autocomplete", "age" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="2">
                            <MudSelect T="Gender"
                                       For="@(() => Input.Gender)"
                                       @bind-Value="Input.Gender"
                                       Label="Gender" Variant="Variant.Outlined" Margin="Margin.Dense"
                                       UserAttributes="@(new() { { "aria-required", "true" } } )">
                                @foreach (Gender item in Enum.GetValues(typeof(Gender)))
                                {
                                    <MudSelectItem T="Gender" Value="@item">@item.ToString()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem md="4">
                            <MudStaticTextField For="@(() => Input.Email)" @bind-Value="Input.Email" Margin="Margin.Dense"
                                                Label="Email Address" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="email"
                                                UserAttributes="@(new() { { "autocomplete", "email webauthn" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="4">
                            <MudStaticTextField For="@(() => Input.PhoneNumber)" @bind-Value="Input.PhoneNumber" Margin="Margin.Dense"
                                                Label="Phone Number" Variant="Variant.Outlined" InputType="InputType.Number" Placeholder="phone number"
                                                UserAttributes="@(new() { { "autocomplete", "phonenumber" }, { "aria-required", "true" } } )" />
                        </MudItem>
                        <MudItem md="12">
                            <MudStaticTextField For="@(() => Input.Address)" @bind-Value="Input.Address" Margin="Margin.Dense"
                                                Label="Home Address" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="address"
                                                UserAttributes="@(new() { { "autocomplete", "middlename" }, { "aria-required", "true" } } )" />
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <MudGrid Spacing="5" Justify="Justify.Center" Class="ps-6 pt-6 pe-0">
                    <MudItem md="5" Style="height:100%;border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;" Class="pa-0">
                        <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border-radius:5px; background-color: rgba(63,81,181,0.9); color:white;">Staff Position</MudText>
                        <MudGrid Spacing="2" Class="pa-3">
                            <MudItem md="@(Input.ClinicalTitleName?.ToLower() == "doctor" ? 6 : 12)">
                                <MudSelect For="@(() => Input.AdministrativeTitleId)"
                                           @bind-Value="Input.AdministrativeTitleId"
                                           @bind-Value:after="OnDeptChange"
                                           Immediate="true"
                                           Label="Administrative Title" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           UserAttributes="@(new() { { "aria-required", "true" } } )">
                                    <MudSelectItem Value="0" Disabled>Select Administrative Title</MudSelectItem>
                                    @foreach (var item in StaffTitles.Where(st => st.StaffTypeId == 1))
                                    {
                                        <MudSelectItem Value="@item.Id">@item.StaffTitleName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem md="@(Input.ClinicalTitleName?.ToLower() == "doctor" ? 6 : 12)">
                                <MudSelect For="@(() => Input.ClinicalTitleId)"
                                           @bind-Value="Input.ClinicalTitleId"
                                           @bind-Value:after="OnTitleChange"
                                           Label="Clinical Title" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           UserAttributes="@(new() { { "aria-required", "true" } } )">
                                    <MudSelectItem Value="0" Disabled>Select Clinical Title</MudSelectItem>

                                    @foreach (var item in StaffTitles.Where(st => st.StaffTypeId == 2))
                                    {
                                        <MudSelectItem Value="@item.Id">@item.StaffTitleName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem md="@(Input.ClinicalTitleName?.ToLower() == "doctor" ? 8 : 12)">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="mud-width-full">
                                    <MudStaticTextField For="@(() => Input.EmployeeId)" @bind-Value="Input.EmployeeId" Margin="Margin.Dense" Class="mt-1"
                                                        Label="Enter or generate Employee Id" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="Enter or generate Employee Id"
                                                        UserAttributes="@(new() { { "autocomplete", "employeeid" }, { "aria-required", "true" } } )" />
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               OnClick="OnGenerateEmployeeId"
                                               Style="height: 40px; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 4px; border-bottom-right-radius: 4px; box-shadow: none;">
                                        Generate
                                    </MudButton>
                                </MudStack>
                            </MudItem>
                            <MudItem md="@(Input.ClinicalTitleName?.ToLower() == "doctor" ? 4 : 12)">
                                <MudSelect For="@(() => Input.StaffStatusId)"
                                           @bind-Value="Input.StaffStatusId"
                                           Label="Availability State" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           UserAttributes="@(new() { { "aria-required", "true" } } )">
                                    <MudSelectItem Value="0" Disabled>Availability State</MudSelectItem>

                                    @foreach (var item in StaffStatus)
                                    {
                                        <MudSelectItem Value="@item.Id">@item.StaffStatusName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            @if (Input.ClinicalTitleName?.ToLower() == "doctor")
                            {
                                <MudItem md="8">
                                    <MudStaticTextField For="@(() => CurrentDoctor.MedicalLicenseNumber)" @bind-Value="CurrentDoctor.MedicalLicenseNumber" Margin="Margin.Dense"
                                                        Label="Medical Licence Number" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="medical licence number"
                                                        UserAttributes="@(new() { { "autocomplete", "medicallicencenumber" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="4">
                                    <MudDatePicker For="@(() => CurrentDoctor.LicenceExpDate)" @bind-Date="CurrentDoctor.LicenceExpDate" Margin="Margin.Dense"
                                                   Label="Exp Date" Variant="Variant.Outlined" Placeholder="Exp Date"
                                                   UserAttributes="@(new() { { "autocomplete", "licenceexpdate" }, { "aria-required", "true" } } )" />
                                </MudItem>
                                <MudItem md="8">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="mud-width-full">
                                        <MudStaticTextField For="@(() => CurrentDoctor.DoctorCode)" @bind-Value="CurrentDoctor.DoctorCode" Margin="Margin.Dense" Class="mt-1"
                                                            @bind-Value:after="UpdateIsTrue"
                                                        Label="Doctor Code Number" Variant="Variant.Outlined" InputType="InputType.Text" Placeholder="doctor code number"
                                                        UserAttributes="@(new() { { "autocomplete", "doctorcodenumber" }, { "aria-required", "true" } } )" />
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="OnGenerateDoctorCode"
                                                   Style="height: 40px; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 4px; border-bottom-right-radius: 4px; box-shadow: none;">
                                            Generate
                                        </MudButton>
                                    </MudStack>
                                </MudItem>
                                <MudItem md="4">
                                    <MudSelect For="@(() => CurrentDoctor.DoctorTypeId)"
                                               @bind-Value="CurrentDoctor.DoctorTypeId"
                                               Label="Specialization" Variant="Variant.Outlined" Margin="Margin.Dense"
                                               UserAttributes="@(new() { { "aria-required", "true" } } )">
                                        <MudSelectItem Value="0" Disabled>Specialization</MudSelectItem>

                                        @foreach (var item in DoctorTypes)
                                        {
                                            <MudSelectItem Value="@item.Id">@item.DoctorTypeName</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem md="12">
                                    <MudNumericField For="@(() => CurrentDoctor.DoctorConsultationFee)" @bind-Value="CurrentDoctor.DoctorConsultationFee" Margin="Margin.Dense"
                                                        Label="Doctor Consultation Fee" Variant="Variant.Outlined" Placeholder="doctor consultation fee"
                                                     UserAttributes="@(new() { { "autocomplete", "doctorconsultatioFee" }, { "aria-required", "true" } } )" />
                                </MudItem>
                            }

                        </MudGrid>
                    </MudItem>
                    <MudItem md="7" Class="ps-6 pe-0 pt-0">
                        <MudItem Style="height:100%;" Class="pa-0">
                            <MudText Typo="Typo.h6" Class="text-center ps-3" Style="border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-bottom:none; border-bottom-right-radius:0px;  border-bottom-left-radius:0px;">Grant Permissions</MudText>
                            <MudTabs Elevation="2" ApplyEffectsToContainer="true" Centered="true" Color="Color.Primary" TabPanelsClass="pa-6" Class="opacity-75 shadow-none" Style="border:1px solid rgba(63,81,181,0.9); border-radius:5px; border-top:none;height:90%; border-radius:5px;">
                                 <MudTabPanel Text="Staffs Permissions" Style="display:flex; flex-wrap: wrap; justify-content:space-evenly;">
                                        <MudGrid Spacing="5" Class="overflow-auto px-3" Style="max-height:200px;">
                                            <MudItem md="12" Class="d-flex flex-wrap gap-2">
                                                <MudChip T="bool" OnClick="@(() => {Input.IsGetStaffModules = !Input.IsGetStaffModules; StateHasChanged();})" @bind-Selected="Input.IsGetStaffModules" Variant="Variant.Outlined" Color="@(Input.IsGetStaffModules ? Color.Primary : Color.Default)" Icon="@(Input.IsGetStaffModules ? Icons.Material.Filled.Check : null)">Get Staff Module</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllStaffs = !Input.IsViewAllStaffs; StateHasChanged(); })" @bind-Selected="Input.IsViewAllStaffs" Variant="Variant.Outlined" Color="@(Input.IsViewAllStaffs ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllStaffs ? Icons.Material.Filled.Check : null)">View all staffs</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsCreateNewStaff = !Input.IsCreateNewStaff; StateHasChanged(); })" @bind-Selected="Input.IsCreateNewStaff" Variant="Variant.Outlined" Color="@(Input.IsCreateNewStaff ? Color.Primary : Color.Default)" Icon="@(Input.IsCreateNewStaff ? Icons.Material.Filled.Check : null)">Create New Staff</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsUpdateOrEditStaff = !Input.IsUpdateOrEditStaff; StateHasChanged(); })" @bind-Selected="Input.IsUpdateOrEditStaff" Variant="Variant.Outlined" Color="@(Input.IsUpdateOrEditStaff ? Color.Primary : Color.Default)" Icon="@(Input.IsUpdateOrEditStaff ? Icons.Material.Filled.Check : null)">Edit Staff Details</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewStaffById = !Input.IsViewStaffById; StateHasChanged(); })" @bind-Selected="Input.IsViewStaffById" Variant="Variant.Outlined" Color="@(Input.IsViewStaffById ? Color.Primary : Color.Default)" Icon="@(Input.IsViewStaffById ? Icons.Material.Filled.Check : null)">View Staff Profile</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.CanChooseStaffOfTheWeek = !Input.CanChooseStaffOfTheWeek; StateHasChanged(); })" @bind-Selected="Input.CanChooseStaffOfTheWeek" Variant="Variant.Outlined" Color="@(Input.CanChooseStaffOfTheWeek ? Color.Primary : Color.Default)" Icon="@(Input.CanChooseStaffOfTheWeek ? Icons.Material.Filled.Check : null)">Award Staff Of The Week</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllHelps = !Input.IsViewAllHelps; StateHasChanged(); })" @bind-Selected="Input.IsViewAllHelps" Variant="Variant.Outlined" Color="@(Input.IsViewAllHelps ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllHelps ? Icons.Material.Filled.Check : null)">View All Helpdesk</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewHelpById = !Input.IsViewHelpById; StateHasChanged(); })" @bind-Selected="Input.IsViewHelpById" Variant="Variant.Outlined" Color="@(Input.IsViewHelpById ? Color.Primary : Color.Default)" Icon="@(Input.IsViewHelpById ? Icons.Material.Filled.Check : null)">View Helpdesk Profile</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllLeaders = !Input.IsViewAllLeaders; StateHasChanged(); })" @bind-Selected="Input.IsViewAllLeaders" Variant="Variant.Outlined" Color="@(Input.IsViewAllLeaders ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllLeaders ? Icons.Material.Filled.Check : null)">View All Leaders</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewLeaderById = !Input.IsViewLeaderById; StateHasChanged(); })" @bind-Selected="Input.IsViewLeaderById" Variant="Variant.Outlined" Color="@(Input.IsViewLeaderById ? Color.Primary : Color.Default)" Icon="@(Input.IsViewLeaderById ? Icons.Material.Filled.Check : null)">View Leader Profile</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllNurses = !Input.IsViewAllNurses; StateHasChanged(); })" @bind-Selected="Input.IsViewAllNurses" Variant="Variant.Outlined" Color="@(Input.IsViewAllNurses ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllNurses ? Icons.Material.Filled.Check : null)">View All Nurses</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllAdmins = !Input.IsViewAllAdmins; StateHasChanged(); })" @bind-Selected="Input.IsViewAllAdmins" Variant="Variant.Outlined" Color="@(Input.IsViewAllAdmins ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllAdmins ? Icons.Material.Filled.Check : null)">View All System Admins</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllDoctors = !Input.IsViewAllDoctors; StateHasChanged(); })" @bind-Selected="Input.IsViewAllDoctors" Variant="Variant.Outlined" Color="@(Input.IsViewAllDoctors ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllDoctors ? Icons.Material.Filled.Check : null)">View All Doctors</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewDoctorById = !Input.IsViewDoctorById; StateHasChanged(); })" @bind-Selected="Input.IsViewDoctorById" Variant="Variant.Outlined" Color="@(Input.IsViewDoctorById ? Color.Primary : Color.Default)" Icon="@(Input.IsViewDoctorById ? Icons.Material.Filled.Check : null)">View Doctor Profile</MudChip>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTabPanel>

                                    <MudTabPanel Text="Patients Permissions" Style="display:flex; flex-wrap: wrap; justify-content:space-evenly;">
                                        <MudGrid Spacing="5" Class="overflow-auto px-3" Style="max-height:200px;">
                                            <MudItem md="12" Class="d-flex flex-wrap gap-2">
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllPatients = !Input.IsViewAllPatients; StateHasChanged(); })" @bind-Selected="Input.IsViewAllPatients" Variant="Variant.Outlined" Color="@(Input.IsViewAllPatients ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllPatients ? Icons.Material.Filled.Check : null)">View all patients</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsCreateNewPatient = !Input.IsCreateNewPatient; StateHasChanged(); })" @bind-Selected="Input.IsCreateNewPatient" Variant="Variant.Outlined" Color="@(Input.IsCreateNewPatient ? Color.Primary : Color.Default)" Icon="@(Input.IsCreateNewPatient ? Icons.Material.Filled.Check : null)">Create New Patient</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsUpdateOrEditPatient = !Input.IsUpdateOrEditPatient; StateHasChanged(); })" @bind-Selected="Input.IsUpdateOrEditPatient" Variant="Variant.Outlined" Color="@(Input.IsUpdateOrEditPatient ? Color.Primary : Color.Default)" Icon="@(Input.IsUpdateOrEditPatient ? Icons.Material.Filled.Check : null)">Edit Patient Details</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewPatientById = !Input.IsViewPatientById; StateHasChanged(); })" @bind-Selected="Input.IsViewPatientById" Variant="Variant.Outlined" Color="@(Input.IsViewPatientById ? Color.Primary : Color.Default)" Icon="@(Input.IsViewPatientById ? Icons.Material.Filled.Check : null)">View Patient Profile</MudChip>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTabPanel>

                                    <MudTabPanel Text="Medicines Permissions" Style="display:flex; flex-wrap: wrap; justify-content:space-evenly;">
                                        <MudGrid Spacing="5" Class="overflow-auto px-3" Style="max-height:200px;">
                                            <MudItem md="12" Class="d-flex flex-wrap gap-2">
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllMedicines = !Input.IsViewAllMedicines; StateHasChanged(); })" @bind-Selected="Input.IsViewAllMedicines" Variant="Variant.Outlined" Color="@(Input.IsViewAllMedicines ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllMedicines ? Icons.Material.Filled.Check : null)">View all medicines</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsCreateNewMedicine = !Input.IsCreateNewMedicine; StateHasChanged(); })" @bind-Selected="Input.IsCreateNewMedicine" Variant="Variant.Outlined" Color="@(Input.IsCreateNewMedicine ? Color.Primary : Color.Default)" Icon="@(Input.IsCreateNewMedicine ? Icons.Material.Filled.Check : null)">Create New Medicine</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsUpdateOrEditMedicine = !Input.IsUpdateOrEditMedicine; StateHasChanged(); })" @bind-Selected="Input.IsUpdateOrEditMedicine" Variant="Variant.Outlined" Color="@(Input.IsUpdateOrEditMedicine ? Color.Primary : Color.Default)" Icon="@(Input.IsUpdateOrEditMedicine ? Icons.Material.Filled.Check : null)">Edit Medicine Details</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewMedicineById = !Input.IsViewMedicineById; StateHasChanged(); })" @bind-Selected="Input.IsViewMedicineById" Variant="Variant.Outlined" Color="@(Input.IsViewMedicineById ? Color.Primary : Color.Default)" Icon="@(Input.IsViewMedicineById ? Icons.Material.Filled.Check : null)">View Medicine Profile</MudChip>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTabPanel>

                                    <MudTabPanel Text="LabTests Permissions" Style="display:flex; flex-wrap: wrap; justify-content:space-evenly;">
                                        <MudGrid Spacing="5" Class="overflow-auto px-3" Style="max-height:200px;">
                                            <MudItem md="12" Class="d-flex flex-wrap gap-2">
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllLabTests = !Input.IsViewAllLabTests; StateHasChanged(); })" @bind-Selected="Input.IsViewAllLabTests" Variant="Variant.Outlined" Color="@(Input.IsViewAllLabTests ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllLabTests ? Icons.Material.Filled.Check : null)">View all lab tests</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsCreateNewLabTest = !Input.IsCreateNewLabTest; StateHasChanged(); })" @bind-Selected="Input.IsCreateNewLabTest" Variant="Variant.Outlined" Color="@(Input.IsCreateNewLabTest ? Color.Primary : Color.Default)" Icon="@(Input.IsCreateNewLabTest ? Icons.Material.Filled.Check : null)">Create New lab test</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsUpdateOrEditLabTest = !Input.IsUpdateOrEditLabTest; StateHasChanged(); })" @bind-Selected="Input.IsUpdateOrEditLabTest" Variant="Variant.Outlined" Color="@(Input.IsUpdateOrEditLabTest ? Color.Primary : Color.Default)" Icon="@(Input.IsUpdateOrEditLabTest ? Icons.Material.Filled.Check : null)">Update lab result</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewLabTestById = !Input.IsViewLabTestById; StateHasChanged(); })" @bind-Selected="Input.IsViewLabTestById" Variant="Variant.Outlined" Color="@(Input.IsViewLabTestById ? Color.Primary : Color.Default)" Icon="@(Input.IsViewLabTestById ? Icons.Material.Filled.Check : null)">View Lab Test</MudChip>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTabPanel>

                                    <MudTabPanel Text="Rooms Permissions" Style="display:flex; flex-wrap: wrap; justify-content:space-evenly;">
                                        <MudGrid Spacing="5" Class="overflow-auto px-3" Style="max-height:200px;">
                                            <MudItem md="12" Class="d-flex flex-wrap gap-2">
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewAllRooms = !Input.IsViewAllRooms; StateHasChanged(); })" @bind-Selected="Input.IsViewAllRooms" Variant="Variant.Outlined" Color="@(Input.IsViewAllRooms ? Color.Primary : Color.Default)" Icon="@(Input.IsViewAllRooms ? Icons.Material.Filled.Check : null)">View all rooms</MudChip>
                                                <MudChip T="bool" OnClick="@(() => { Input.IsViewRoomById = !Input.IsViewRoomById; StateHasChanged(); })" @bind-Selected="Input.IsViewRoomById" Variant="Variant.Outlined" Color="@(Input.IsViewRoomById ? Color.Primary : Color.Default)" Icon="@(Input.IsViewRoomById ? Icons.Material.Filled.Check : null)">Create New Room</MudChip>
                                            </MudItem>
                                        </MudGrid>
                                    </MudTabPanel>
                            </MudTabs>
                        </MudItem>
                    </MudItem>
                </MudGrid>
                <MudItem md="12" Style="text-align:end">
                    @if (isCreatedSuccessfully)
                    {
                        <MudAlert Severity="Severity.Success" ContentAlignment="HorizontalAlignment.Center">@outMessage</MudAlert>
                    }
                    <MudStaticButton Variant="Variant.Filled" Color="Color.Success" FormAction="FormAction.Submit" Disabled="((string.IsNullOrWhiteSpace(Input.AdministrativeTitleName) && string.IsNullOrWhiteSpace(Input.ClinicalTitleName)) || string.IsNullOrWhiteSpace(Input.FisrtName) || string.IsNullOrWhiteSpace(Input.MiddleName) || string.IsNullOrWhiteSpace(Input.LastName) || string.IsNullOrWhiteSpace(Input.Email) || (Input.StaffStatusId == 0) || string.IsNullOrWhiteSpace(Input.EmployeeId) || isTrue)">Save  Staff Details</MudStaticButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ResetPage" Class="">Reset Page</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ReturnToStaffsPage" Class="">Back</MudButton>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [Parameter] public EventCallback<bool> OnBack { get; set; }
    [SupplyParameterFromForm] StaffDto Input { get; set; } = default!;
    List<StaffTypeDto> StaffTypes = new();
    List<StaffTitleDto> StaffTitles = new();
    List<StaffStatusDto> StaffStatus = new();
    List<DoctorTypeDto> DoctorTypes = new();
    List<StaffTitle> staffTitlesToAdd = new();
    DoctorDto CurrentDoctor = new();

    private IEnumerable<IdentityError>? identityErrors;

    //[SupplyParameterFromForm] private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private string? Message => identityErrors is null ? null : $"Error: {string.Join(", ", identityErrors.Select(error => error.Description))}";
    string outMessage = string.Empty;

    int docCode = 0;
    int emplIdCode = 0;
    bool isCreatedSuccessfully;
    bool isTrue;


