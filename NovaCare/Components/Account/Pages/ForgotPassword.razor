@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using NovaCare.Data

@inject UserManager<Staff> UserManager
@inject IEmailSender<Staff> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Forgot your password?</PageTitle>


<style>
    /* Full-Viewport Bright Daylight Stage */
    .nc-daylight-stage {
        min-height: 100vh;
        width: 100%;
        position: relative;
        overflow-x: hidden;
        background-color: #F8FAFC;
    }

    /* Full-Screen Background Carousel Layer */
    .nc-bg-carousel {
        position: fixed;
        inset: 0;
        z-index: 0;
        width: 100vw;
        height: 100vh;
    }

        .nc-bg-carousel > *,
        .nc-bg-carousel .mud-carousel {
            width: 100% !important;
            height: 100% !important;
        }

        .nc-bg-carousel img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* Crystal-Clear Scrim (Shows Carousel Pictures Clearly) */
    .nc-daylight-scrim {
        position: fixed;
        inset: 0;
        z-index: 1;
        background: linear-gradient( 180deg, rgba(15, 23, 42, 0.14) 0%, rgba(255, 255, 255, 0) 25%, rgba(255, 255, 255, 0) 75%, rgba(15, 23, 42, 0.14) 100% );
        pointer-events: none;
    }

    /* Bright Frosted-Glass Login Card */
    .nc-light-glass-card {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: 440px;
        background: rgba(255, 255, 255, 0.90) !important;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.95) !important;
        border-bottom: 1px solid rgba(203, 213, 225, 0.6) !important;
        border-radius: 24px !important;
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.25), 0 8px 24px -6px rgba(15, 23, 42, 0.12) !important;
    }

    /* Light-Theme MudBlazor Static Inputs */
    .nc-light-glass-form .mud-input-outlined {
        background-color: rgba(255, 255, 255, 0.85) !important;
        border-radius: 12px !important;
        transition: all 0.2s ease;
    }

        .nc-light-glass-form .mud-input-outlined .mud-input-outlined-border {
            border-color: #CBD5E1 !important;
            border-radius: 12px !important;
        }

    .nc-light-glass-form .mud-input-control:hover .mud-input-outlined {
        background-color: #FFFFFF !important;
    }

    .nc-light-glass-form .mud-input-control:hover .mud-input-outlined-border {
        border-color: #94A3B8 !important;
    }

    .nc-light-glass-form .mud-input-outlined.mud-input-focused {
        background-color: #FFFFFF !important;
    }

        .nc-light-glass-form .mud-input-outlined.mud-input-focused .mud-input-outlined-border {
            border-color: #162368 !important;
            border-width: 1.5px !important;
            box-shadow: 0 0 0 4px rgba(22, 35, 104, 0.10) !important;
        }

    .nc-light-glass-form .mud-input-slot,
    .nc-light-glass-form input {
        color: #0F172A !important;
        padding-top: 11px !important;
        padding-bottom: 11px !important;
    }

        .nc-light-glass-form .mud-input-slot::placeholder,
        .nc-light-glass-form input::placeholder {
            color: #94A3B8 !important;
            opacity: 1 !important;
        }

    .nc-light-glass-form .mud-input-adornment .mud-icon-root {
        color: #475569 !important;
    }

    /* Brand Navy Primary CTA */
    .nc-navy-glow-btn {
        background: linear-gradient(135deg, #162368 0%, #1E3A8A 100%) !important;
        color: #FFFFFF !important;
        border-radius: 12px !important;
        height: 48px !important;
        font-weight: 700 !important;
        letter-spacing: 0.02em !important;
        box-shadow: 0 10px 22px -5px rgba(22, 35, 104, 0.35) !important;
        transition: transform 0.15s ease, box-shadow 0.2s ease !important;
    }

        .nc-navy-glow-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 14px 28px -5px rgba(22, 35, 104, 0.45) !important;
            filter: brightness(1.06);
        }

    /* Light Frosted Passkey Button */
    .nc-light-passkey-btn {
        background-color: rgba(255, 255, 255, 0.8) !important;
        border: 1px solid #CBD5E1 !important;
        color: #1E293B !important;
        border-radius: 12px !important;
        height: 44px !important;
        transition: all 0.2s ease !important;
    }

        .nc-light-passkey-btn:hover {
            background-color: #FFFFFF !important;
            border-color: #162368 !important;
            color: #162368 !important;
        }

    /* Distinct Live Blink + Beacon Pulse */
    @@keyframes nc-beacon-pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(255, 0, 0, 0.75);
        }

        50% {
            opacity: 0.25;
            transform: scale(0.85);
            box-shadow: 0 0 0 6px rgba(22, 35, 104, 0);
        }
    }

    .nc-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: red;
        display: inline-block;
        flex-shrink: 0;
        animation: nc-beacon-pulse 1.5s infinite ease-in-out;
    }
</style>

@* <div class="nc-daylight-stage d-flex flex-column justify-space-between align-center pa-4 pa-sm-6"> *@
<div class="nc-daylight-stage d-flex justify-content-center align-center">

    @* Full-Screen Background Carousel *@
    <div class="nc-bg-carousel">
        @* <LoginCarousel /> *@
    </div>

    @* Crystal-Clear Edge Scrim Overlay *@
    <div class="nc-daylight-scrim"></div>


    @* Centered Bright Frosted-Glass Login Card *@
    <MudPaper Elevation="0" Class="nc-light-glass-card pa-7 pa-sm-9">

        @* Logo & Clean Header *@
        <MudStack AlignItems="AlignItems.Center" Class="mb-6">
            <MudImage Src="Images/logo2.png" Height="48" ObjectFit="ObjectFit.Contain" Alt="NovaCare" Class="" />

            <MudText Typo="Typo.h5" Align="Align.Center" Class="font-weight-bold" Style="color: #0F172A; letter-spacing: -0.02em;">
                Reset Password
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Style="color: #475569;">
                Enter your email address and we'll send you instructions to reset your password.
            </MudText>
        </MudStack>

        @* Static SSR Login Form *@
        <div class="nc-light-glass-form">
            @* Form *@
            <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />

                <MudGrid Spacing="3">
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="font-weight-bold d-block mb-1" Style="color: #4B5563; letter-spacing: 0.5px;">
                            EMAIL
                        </MudText>
                        <MudStaticTextField @bind-Value="Input.Email"
                                            For="@(() => Input.Email)"
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense"
                                            Placeholder="name@example.com"
                                            Adornment="Adornment.Start"
                                            AdornmentIcon="@Icons.Material.Outlined.Email"
                                            UserAttributes="@(new() { { "autocomplete", "username" }, { "aria-required", "true" } })" />
                    </MudItem>

                    <MudItem xs="12" Class="mt-2">
                        <MudStaticButton Variant="Variant.Filled"
                                         FullWidth="true"
                                         FormAction="FormAction.Submit"
                                         EndIcon="@Icons.Material.Rounded.ArrowForward"
                                         Class="py-2.5 rounded-lg text-none font-weight-bold"
                                         Style="background-color: rgba(22, 35, 104, 1); color: #FFFFFF; box-shadow: 0 4px 12px rgba(22, 35, 104, 0.25);">
                            Reset Password
                        </MudStaticButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
            @* Back to Sign In Link *@
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-6">
                <MudLink Href="Account/Login" Underline="Underline.None" Class="d-flex align-center gap-1" Style="color: #4B5563; font-size: 0.875rem; font-weight: 500;">
                    <MudIcon Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" />
                    Back to sign in
                </MudLink>
            </MudStack>
        </div>

    </MudPaper>

</div>


@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized() => Input ??= new();

    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null || !(await UserManager.IsEmailConfirmedAsync(user)))
        {
            // Don't reveal that the user does not exist or is not confirmed
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        // For more information on how to enable account confirmation and password reset please
        // visit https://go.microsoft.com/fwlink/?LinkID=532713
        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
            new Dictionary<string, object?> { ["code"] = code });

        await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
